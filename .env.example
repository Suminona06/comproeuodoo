# ========================================================
# ENVIRONMENT CONFIGURATION - PT EUODOO
# ========================================================

# Server Runtime
NODE_ENV=development
PORT=3000

# Database Configuration (MySQL 8 / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=euodoo_db
DB_CONNECTION_LIMIT=10

# Security & Authentication (JWT & Cookies)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1h
COOKIE_SECRET=super_secret_cookie_key_change_in_production

# Mailer Configuration (SMTP cPanel / Mail Service)
SMTP_HOST=mail.euodoo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notification@euodoo.com
SMTP_PASS=your_email_password
MAIL_FROM="PT Euodoo Web" <notification@euodoo.com>
SALES_NOTIFICATION_EMAIL=sales@euodoo.com

# Media Upload & Storage Driver Configuration
STORAGE_DRIVER=local # 'local' or 's3'
UPLOAD_MAX_SIZE=31457280 # 30MB in bytes
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif,image/svg+xml
ALLOWED_VIDEO_TYPES=video/mp4,video/webm

# S3 Storage Configuration (Required only when STORAGE_DRIVER=s3)
S3_BUCKET=euodoo-media
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=your_aws_or_s3_access_key
S3_SECRET_KEY=your_aws_or_s3_secret_key
S3_ENDPOINT= # Optional custom endpoint for MinIO/Cloudflare R2/Wasabi
S3_CDN_URL= # Optional CDN distribution URL e.g. https://cdn.euodoo.co.id

# Default Admin Seed Credentials (used in initial_seed.js)
ADMIN_DEFAULT_NAME="Super Administrator"
ADMIN_DEFAULT_EMAIL=admin@euodoo.com
ADMIN_DEFAULT_PASSWORD=AdminEuodoo2026!

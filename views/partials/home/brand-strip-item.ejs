<div class="brand-strip-item js-brand-preview-trigger" role="button" tabindex="<%= isDuplicate ? '-1' : '0' %>"<% if (!isDuplicate) { %> aria-haspopup="dialog"<% } %> aria-label="<%= t('home.brand_preview_aria', { name: brand.name }) %>" data-brand-name="<%= brand.name %>" data-brand-logo="<%= brand.logoUrl %>" data-brand-initials="<%= brand.initials %>">
  <div class="brand-strip-logo-box">
    <% if (brand.logoUrl) { %>
      <% if (isDuplicate) { %>
        <img src="<%= brand.logoUrl %>" alt="" tabindex="-1" loading="lazy" class="brand-strip-logo">
      <% } else { %>
        <img src="<%= brand.logoUrl %>" alt="<%= t('home.brand_logo_alt', { name: brand.name }) %>" title="<%= brand.name %>" loading="lazy" class="brand-strip-logo">
      <% } %>
    <% } else { %>
      <span class="brand-strip-text"<% if (isDuplicate) { %> tabindex="-1"<% } %>><%= brand.name %></span>
    <% } %>
    <span class="brand-zoom-hint" aria-hidden="true"<% if (!isDuplicate) { %> title="<%= t('home.brand_zoom_hint') %>"<% } %>>
      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="11" y1="8" x2="11" y2="14"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
    </span>
  </div>
</div>

<section class="sec-news" id="berita">
  <div class="container">
    <div class="hnc-header reveal">
      <div class="hnc-heading-group">
        <h2><%= t('home.news_heading') %></h2>
        <a href="/news" class="hnc-view-all">
          <span><%= t('home.news_view_all') %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      <% if (news.items.length > 0) { %>
        <div class="hnc-controls">
          <button type="button" class="hnc-arrow-btn hnc-arrow-prev" id="hncPrevBtn" aria-label="<%= t('home.news_prev_aria') %>">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>
          <button type="button" class="hnc-arrow-btn hnc-arrow-next" id="hncNextBtn" aria-label="<%= t('home.news_next_aria') %>">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      <% } %>
    </div>

    <% if (news.items.length > 0) { %>
      <div class="hnc-carousel reveal" id="hncCarousel" role="region" aria-roledescription="carousel" aria-label="<%= t('home.news_carousel_aria') %>" data-autoplay-ms="3000">
        <div class="hnc-viewport">
          <div class="hnc-track" id="hncTrack" aria-live="off">
            <% news.items.forEach((post, idx) => { %>
              <div class="hnc-slide <%= idx % 2 === 0 ? 'hnc-slide--wide' : 'hnc-slide--compact' %>" role="group" aria-roledescription="slide" aria-label="<%= t('home.news_slide_aria', { current: idx + 1, total: news.items.length }) %>">
                <a href="<%= post.href %>" class="hnc-card">
                  <div class="hnc-media">
                    <img src="<%= post.imageUrl %>" alt="<%= post.title %>" loading="lazy" data-fallback-src="<%= post.fallbackImage %>">
                  </div>
                  <div class="hnc-scrim"></div>
                  <% if (post.typeLabel) { %>
                    <span class="hnc-type"><%= post.typeLabel %></span>
                  <% } %>
                  <div class="hnc-content">
                    <h3 class="hnc-title"><%= post.title %></h3>
                  </div>
                </a>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="news-empty-state" role="status">
        <p><%= t('home.news_empty') %></p>
      </div>
    <% } %>
  </div>
</section>

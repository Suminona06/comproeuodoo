<div class="nwl-tab-bar" role="tablist" aria-label="Tipe Publikasi">
  <a href="<%= buildQuery(1, 'all', null) %>"
     class="nwl-tab-item <%= activeType === 'all' ? 'active' : '' %>"
     role="tab"
     aria-selected="<%= activeType === 'all' %>"
     data-type="all">
    <%= currentLangCode === 'en' ? 'All Publications' : 'Semua Publikasi' %>
  </a>
  <a href="<%= buildQuery(1, 'berita', null) %>"
     class="nwl-tab-item <%= activeType === 'berita' ? 'active' : '' %>"
     role="tab"
     aria-selected="<%= activeType === 'berita' %>"
     data-type="berita">
    <%= currentLangCode === 'en' ? 'Corporate News' : 'Berita Perusahaan' %>
  </a>
  <a href="<%= buildQuery(1, 'pers', null) %>"
     class="nwl-tab-item <%= activeType === 'pers' ? 'active' : '' %>"
     role="tab"
     aria-selected="<%= activeType === 'pers' %>"
     data-type="pers">
    <%= currentLangCode === 'en' ? 'Press Releases' : 'Siaran Pers' %>
  </a>
  <a href="<%= buildQuery(1, 'blog', null) %>"
     class="nwl-tab-item <%= activeType === 'blog' ? 'active' : '' %>"
     role="tab"
     aria-selected="<%= activeType === 'blog' %>"
     data-type="blog">
    <% if (currentLangCode === 'en') { %>Articles & Blog<% } else { %>Artikel & Blog<% } %>
  </a>
</div>

<div class="nwl-filter-row">
  <div class="nwl-cat-pills" id="nwlCatPills" role="navigation" aria-label="<%= currentLangCode === 'en' ? 'Topics' : 'Topik' %>">
    <a href="<%= buildQuery(1, activeType, null) %>"
       class="nwl-cat-pill <%= !activeCategory ? 'active' : '' %>"
       data-category="">
      <%= currentLangCode === 'en' ? 'All' : 'Semua' %>
    </a>
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(cat => { %>
        <% const catName = currentLangCode === 'en' ? (cat.name_en || cat.name_id) : cat.name_id; %>
        <a href="<%= buildQuery(1, activeType, cat.slug) %>"
           class="nwl-cat-pill <%= activeCategory === cat.slug ? 'active' : '' %>"
           data-category="<%= cat.slug %>">
          <%= catName %>
        </a>
      <% }); %>
    <% } %>
  </div>

  <form action="/news" method="GET" class="nwl-search-form" id="newsSearchForm" role="search">
    <input type="hidden" name="type" id="newsSearchType" value="<%= activeType %>">
    <input type="hidden" name="category" id="newsSearchCategory" value="<%= activeCategory || '' %>">
    <div class="nwl-search-input-wrap">
      <input type="search"
             name="search"
             id="newsSearchInput"
             class="nwl-search-input"
             value="<%= search || '' %>"
             placeholder="<%= currentLangCode === 'en' ? 'Search articles...' : 'Cari artikel...' %>"
             aria-label="<%= currentLangCode === 'en' ? 'Search articles' : 'Cari artikel publikasi' %>">
      <button type="submit" class="nwl-search-btn" aria-label="<%= currentLangCode === 'en' ? 'Submit search' : 'Kirim pencarian' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </div>
    <a href="<%= buildQuery(1, activeType, activeCategory).replace(/[?&]search=[^&]*/, '') %>"
       class="nwl-search-reset"
       id="newsSearchReset"
       <%= search ? '' : 'hidden' %>
       title="<%= currentLangCode === 'en' ? 'Reset search' : 'Hapus pencarian' %>">
      Reset
    </a>
  </form>
</div>


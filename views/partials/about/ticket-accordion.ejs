<%
  const values = (typeof about !== 'undefined' && about && about.values) ? about.values : (typeof data !== 'undefined' && data.values ? data.values : []);
  const acronym = (typeof ticketAcronym !== 'undefined' && ticketAcronym) ? ticketAcronym : (values.length > 0 ? values.map(function(v) { return v.letter; }).join(' - ') : 'T - I - C - K - E - T');
  const currentLocale = typeof lang !== 'undefined' ? lang : (typeof currentLang !== 'undefined' ? currentLang : 'id');
  const pillText = currentLocale === 'en'
    ? ((about && about.values_pill_en) || 'Corporate Culture')
    : ((about && about.values_pill_id) || 'Budaya Kerja');
  const subtitleText = currentLocale === 'en'
    ? ((about && about.values_subtitle_en) || 'The values that shape our journey towards a better future')
    : ((about && about.values_subtitle_id) || 'Nilai-nilai yang membentuk langkah kami menuju masa depan yang lebih baik');
  const bgImg = (about && about.values_bg_image) ? about.values_bg_image : '/images/hero-factory.jpg';
%>
<section class="abt-tkt-section" id="core-values" data-active-index="2">
  <div class="abt-tkt-bg-wrap" aria-hidden="true">
    <img src="<%= bgImg %>" alt="" class="abt-tkt-bg-img" loading="lazy">
    <div class="abt-tkt-bg-scrim"></div>
  </div>
  <div class="container abt-tkt-container">
    <header class="abt-tkt-header">
      <div class="abt-tkt-pill-wrap">
        <span class="abt-tkt-line"></span>
        <span class="abt-tkt-pill"><%= pillText %></span>
        <span class="abt-tkt-line"></span>
      </div>
      <h2 class="abt-tkt-title"><%= acronym %></h2>
      <p class="abt-tkt-subtitle"><%= subtitleText %></p>
    </header>

    <div class="abt-tkt-accordion" role="tablist" aria-label="<%= t('about.values_tablist_label') %>">
      <% values.forEach(function(val, idx) { %>
        <%
          const isActive = idx === 2;
          const valTitle = currentLocale === 'en' ? val.title_en : val.title_id;
          const valDesc = currentLocale === 'en' ? val.desc_en : val.desc_id;
          const panelId = 'abt-tkt-panel-' + idx;
          const tabId = 'abt-tkt-tab-' + idx;
        %>
        <article
          class="abt-tkt-panel <%= isActive ? 'is-active' : '' %>"
          id="<%= tabId %>"
          role="tab"
          tabindex="<%= isActive ? '0' : '-1' %>"
          aria-selected="<%= isActive ? 'true' : 'false' %>"
          aria-expanded="<%= isActive ? 'true' : 'false' %>"
          aria-controls="<%= panelId %>"
          data-index="<%= idx %>"
        >
          <div class="abt-tkt-media-wrap">
            <img src="<%= val.image_url || '/images/hero-factory.jpg' %>" alt="<%= valTitle %>" class="abt-tkt-img" loading="<%= idx <= 2 ? 'eager' : 'lazy' %>">
            <div class="abt-tkt-overlay"></div>
          </div>

          <div class="abt-tkt-top">
            <span class="abt-tkt-symbol">
              <%- include('../icons/ticket/index', { icon: val.icon_key, className: 'abt-tkt-icon-svg' }) %>
            </span>
            <div class="abt-tkt-letter"><%= val.letter %></div>
          </div>

          <div class="abt-tkt-vertical-name">
            <span class="abt-tkt-vert-line" aria-hidden="true"></span>
            <span class="abt-tkt-vert-text"><%= valTitle %></span>
            <span class="abt-tkt-vert-line" aria-hidden="true"></span>
          </div>

          <div class="abt-tkt-content" id="<%= panelId %>" role="tabpanel" aria-labelledby="<%= tabId %>">
            <h3 class="abt-tkt-content-title"><%= valTitle %></h3>
            <p class="abt-tkt-content-desc"><%= valDesc %></p>
          </div>

          <div class="abt-tkt-baseline" aria-hidden="true"></div>
        </article>
      <% }); %>
    </div>

    <nav class="abt-tkt-dots" role="tablist" aria-label="<%= t('about.values_dots_label') %>">
      <% values.forEach(function(val, idx) { %>
        <%
          const isDotActive = idx === 2;
          const valTitle = currentLocale === 'en' ? val.title_en : val.title_id;
        %>
        <button
          type="button"
          class="abt-tkt-dot <%= isDotActive ? 'is-active' : '' %>"
          data-dot-index="<%= idx %>"
          role="tab"
          aria-selected="<%= isDotActive ? 'true' : 'false' %>"
          aria-label="<%= t('about.values_dot_aria') + ': ' + val.letter + ' - ' + valTitle %>"
          tabindex="<%= isDotActive ? '0' : '-1' %>"
        ></button>
      <% }); %>
    </nav>
  </div>
</section>


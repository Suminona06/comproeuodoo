<%
  const lang = typeof currentLang !== 'undefined' ? currentLang : 'id';
  const items = (typeof timeline !== 'undefined' && Array.isArray(timeline)) ? timeline : [];
  const groups = typeof groupTimelineByYear === 'function'
    ? groupTimelineByYear(items, lang, 'asc')
    : (typeof timelineGroups !== 'undefined' && Array.isArray(timelineGroups) ? timelineGroups : []);
  const tlHdr = typeof timelineHeader !== 'undefined' && timelineHeader ? timelineHeader : {};
  const taglineText = (lang === 'en' ? tlHdr.tagline_en : tlHdr.tagline_id)
    || t('about.timeline_default_tagline');
  const titleText = (lang === 'en' ? tlHdr.title_en : tlHdr.title_id)
    || t('about.timeline_default_title');
  const descText = (lang === 'en' ? tlHdr.desc_en : tlHdr.desc_id)
    || t('about.timeline_default_desc');
%>
<div class="abt-htl-block reveal" data-od-id="company-timeline" role="region" aria-label="<%= t('about.timeline_region_label') %>">
  <header class="abt-htl-header">
    <div class="abt-htl-header-copy">
      <span class="abt-htl-tagline"><%= taglineText %></span>
      <h2 class="abt-htl-title"><%= titleText %></h2>
      <p class="abt-htl-desc"><%= descText %></p>
    </div>
  </header>

  <div class="abt-htl-live sr-only" aria-live="polite" aria-atomic="true"></div>

  <% if (groups.length === 0) { %>
    <div class="abt-htl-empty"><%= t('about.timeline_empty') %></div>
  <% } %>

  <div class="abt-htl-layout" data-sort-dir="asc"<%= groups.length === 0 ? ' hidden' : '' %>>
    <aside class="abt-htl-sidebar">
      <div class="abt-htl-sort-box">
        <span class="abt-htl-sidebar-label" id="abt-htl-sort-label"><%= t('about.timeline_sort_label') %></span>
        <div class="abt-htl-sort-group" role="group" aria-labelledby="abt-htl-sort-label">
          <button type="button" class="abt-htl-sort-btn" data-sort-dir="desc" aria-pressed="false"><%= t('about.timeline_sort_latest') %></button>
          <button type="button" class="abt-htl-sort-btn is-active" data-sort-dir="asc" aria-pressed="true"><%= t('about.timeline_sort_oldest') %></button>
        </div>
      </div>

      <div class="abt-htl-year-box">
        <span class="abt-htl-sidebar-label"><%= t('about.timeline_year_label') %></span>
        <nav class="abt-htl-year-nav" aria-label="<%= t('about.timeline_year_nav_label') %>">
          <% groups.forEach(function(group, idx) { %>
            <button
              type="button"
              class="abt-htl-year-pill<%= idx === 0 ? ' is-active' : '' %>"
              data-year-target="abt-htl-yr-<%= group.yearKey %>"
              data-year-key="<%= group.yearKey %>"
              aria-current="<%= idx === 0 ? 'true' : 'false' %>">
              <span class="abt-htl-pill-text"><%= group.yearLabel %></span>
              <span class="abt-htl-pill-dot" aria-hidden="true"></span>
            </button>
          <% }); %>
        </nav>
      </div>
    </aside>

    <div class="abt-htl-main">
      <div class="abt-htl-rail" aria-hidden="true"><span class="abt-htl-rail-fill"></span></div>
      <ol class="abt-htl-list" id="abt-htl-list">
        <% groups.forEach(function(group, idx) { %>
          <%
            const eventWord = group.count === 1 ? t('about.timeline_event_singular') : t('about.timeline_event_plural');
          %>
          <li
            class="abt-htl-group<%= idx === 0 ? ' is-active' : '' %>"
            id="abt-htl-yr-<%= group.yearKey %>"
            data-year-key="<%= group.yearKey %>"
            tabindex="-1">
            <div class="abt-htl-group-head">
              <span class="abt-htl-dot" aria-hidden="true"></span>
              <h3 class="abt-htl-year"><%= group.yearLabel %></h3>
              <span class="abt-htl-count"><%= group.count %> <%= eventWord %></span>
            </div>
            <div class="abt-htl-cards">
              <% group.milestones.forEach(function(item) { %>
                <article class="abt-htl-card">
                  <div class="abt-htl-card-head">
                    <span class="abt-htl-card-marker" aria-hidden="true"></span>
                    <h4 class="abt-htl-item-title"><%= item.title %></h4>
                  </div>
                  <hr class="abt-htl-card-divider">
                  <p class="abt-htl-item-desc"<%= item.description ? '' : ' hidden' %>><%= item.description %></p>
                </article>
              <% }); %>
            </div>
          </li>
        <% }); %>
      </ol>
    </div>
  </div>
</div>

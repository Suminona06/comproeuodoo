  <div class="container flex items-center justify-between">
    <div class="flex items-center gap-md">
      <span>Presisi Manufaktur Plastik Berkualitas Tinggi</span>
    </div>
    <div class="flex items-center gap-md">
      <span>Email: info@euodoo.com</span>
      <span>|</span>
      <div class="lang-switch flex items-center gap-xs">
        <a href="/lang/id" class="<%= currentLang === 'id' ? 'font-bold text-white' : '' %>">ID</a>
        <span>/</span>
        <a href="/lang/en" class="<%= currentLang === 'en' ? 'font-bold text-white' : '' %>">EN</a>
      </div>
    </div>
  </div>
</div>


<div class="header-wrap" id="headerWrap">
  <div class="top-bar-wrap">
    <div class="top-bar">
      <div class="container top-bar-inner">
        <span class="top-tagline">
          <%= typeof settings !== 'undefined' && settings && (currentLang === 'en' ? settings.company_tagline_en : settings.company_tagline_id) ? (currentLang === 'en' ? settings.company_tagline_en : settings.company_tagline_id) : 'Passion To Build A Better Quality of Life' %>
        </span>
        <div class="top-right">
          <span>Email: <a href="mailto:<%= typeof settings !== 'undefined' && settings && settings.company_email ? settings.company_email : 'info@euodoo.com' %>" style="color: inherit; text-decoration: none;"><%= typeof settings !== 'undefined' && settings && settings.company_email ? settings.company_email : 'info@euodoo.com' %></a></span>
          <span style="opacity:.4">|</span>
          <div class="lang-sw">
            <a href="/lang/id" class="<%= currentLang === 'id' ? 'active' : '' %>" aria-label="Bahasa Indonesia">ID</a>
            <span style="opacity:.4">/</span>
            <a href="/lang/en" class="<%= currentLang === 'en' ? 'active' : '' %>" aria-label="English">EN</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <header class="site-header" id="siteHeader">
    <div class="container">
      <nav class="navbar" aria-label="Navigasi Utama">
        <a href="/" class="brand" aria-label="Beranda PT Euodoo">
          <% if (typeof settings !== 'undefined' && settings && settings.site_logo_header) { %>
            <img src="<%= settings.site_logo_header %>" alt="<%= typeof settings !== 'undefined' && settings.company_name ? settings.company_name : 'PT Euodoo' %>" class="brand-logo-header" style="max-height: 38px; width: auto; object-fit: contain; display: block;">
          <% } else { %>
            <span class="brand-name">PT EUODOO</span>
            <span class="brand-badge">MANUFACTURING</span>
          <% } %>
        </a>

        <ul class="nav-menu" id="navMenu">
          <li>
            <a href="/" class="nav-link <%= path === '/' ? 'active' : '' %>">
              <%= currentLang === 'en' ? 'Home' : 'Beranda' %>
            </a>
          </li>
          <li>
            <a href="/products" class="nav-link <%= path === '/products' || path.startsWith('/products/') ? 'active' : '' %>">
              <%= currentLang === 'en' ? 'Products' : 'Produk' %>
            </a>
          </li>
          <li>
            <a href="/about" class="nav-link <%= path === '/about' ? 'active' : '' %>">
              <%= currentLang === 'en' ? 'About Us' : 'Tentang' %>
            </a>
          </li>
          <li>
            <a href="/news" class="nav-link <%= path === '/news' || path.startsWith('/news/') ? 'active' : '' %>">
              <%= currentLang === 'en' ? 'News' : 'Berita' %>
            </a>
          </li>
          <li>
            <a href="/contact" class="nav-link <%= path === '/contact' ? 'active' : '' %>">
              <%= currentLang === 'en' ? 'Contact' : 'Kontak' %>
            </a>
          </li>
          <li class="nav-menu-cta">
            <a href="/contact" class="btn btn-primary btn-nav-mobile">
              <%= currentLang === 'en' ? 'Request a Quote' : 'Minta Penawaran' %>
            </a>
          </li>
        </ul>

        <div class="nav-actions">
          <a href="/contact" class="btn btn-primary">
            <%= currentLang === 'en' ? 'Request a Quote' : 'Minta Penawaran' %>
          </a>
          <button type="button" class="mobile-toggle" id="mobileToggle" aria-label="Buka menu navigasi"
                  aria-expanded="false" aria-controls="navMenu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </nav>
    </div>
  </header>
</div>
<div class="menu-backdrop" id="menuBackdrop"></div>

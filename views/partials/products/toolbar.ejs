<div class="plp-toolbar">
  <button type="button" class="plp-drawer-trigger" id="plp-filter-drawer-open" aria-controls="plp-sidebar" aria-expanded="false" aria-label="<%= t('products.open_filter') %>">
    <svg class="plp-drawer-trigger-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="4" y1="21" x2="4" y2="14"></line>
      <line x1="4" y1="10" x2="4" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12" y2="3"></line>
      <line x1="20" y1="21" x2="20" y2="16"></line>
      <line x1="20" y1="12" x2="20" y2="3"></line>
      <line x1="1" y1="14" x2="7" y2="14"></line>
      <line x1="9" y1="8" x2="15" y2="8"></line>
      <line x1="17" y1="16" x2="23" y2="16"></line>
    </svg>
    <span class="plp-drawer-trigger-text"><%= t('products.filter_button') %></span>
    <% if (selectedCategory) { %>
      <span class="plp-drawer-trigger-badge" aria-hidden="true">1</span>
    <% } %>
  </button>

  <form action="/products" method="GET" class="plp-search-wrap" id="plp-search-form" role="search" aria-label="<%= t('products.search_label') %>">
    <% if (selectedCategory) { %>
      <input type="hidden" name="category" value="<%= selectedCategory.slug %>" />
    <% } %>
    <input type="search"
           name="search"
           id="plp-search-input"
           class="plp-search-input"
           value="<%= search || '' %>"
           placeholder="<%= t('products.search_placeholder') %>"
           aria-label="<%= t('products.search_label') %>"
           autocomplete="off" />
    <button type="button" class="plp-search-clear <%= search ? 'visible' : '' %>" id="plp-search-clear" aria-label="<%= t('products.clear_search') %>" title="<%= t('products.clear_search') %>">
      <svg class="plp-search-clear-icon" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <button type="submit" class="plp-search-btn" id="plp-search-btn" aria-label="<%= t('products.search_btn') %>" title="<%= t('products.search_btn') %>">
      <svg class="plp-search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
  </form>

  <div class="plp-sort-wrap">
    <label for="plp-sort-select" class="sr-only"><%= t('products.sort_label') %></label>
    <select name="sort" id="plp-sort-select" class="plp-sort-select"
            data-eu-dropdown="elevated"
            data-prefix="<%= t('products.sort_label') %>"
            data-eu-size="sm"
            aria-label="<%= t('products.sort_aria_label') %>">
      <option value="newest" <%= (!sort || sort === 'newest') ? 'selected' : '' %>>
        <%= t('products.sort_newest') %>
      </option>
      <option value="catalog" <%= sort === 'catalog' ? 'selected' : '' %>>
        <%= t('products.sort_popularity') %>
      </option>
      <option value="alpha-asc" <%= sort === 'alpha-asc' ? 'selected' : '' %>>
        <%= t('products.sort_alpha_asc') %>
      </option>
      <option value="alpha-desc" <%= sort === 'alpha-desc' ? 'selected' : '' %>>
        <%= t('products.sort_alpha_desc') %>
      </option>
    </select>
  </div>
</div>


<% const currentLangCode = typeof lang !== 'undefined' ? lang : (typeof currentLang !== 'undefined' ? currentLang : 'id'); %>
<aside class="plp-sidebar" id="plp-sidebar" aria-label="<%= t('products.filter_by') %>">
  <div class="plp-drawer-header">
    <h2 class="plp-sidebar-title plp-drawer-title"><%= t('products.filter_by') %></h2>
    <button type="button" class="plp-drawer-close" id="plp-filter-drawer-close" aria-label="<%= t('products.close_filter') %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <ul class="plp-sidebar-list" role="list" id="plp-sidebar-list">
    <li class="plp-sidebar-item">
      <a href="/products<%= search ? '?search=' + encodeURIComponent(search) : '' %><%= sort && sort !== 'newest' ? (search ? '&' : '?') + 'sort=' + encodeURIComponent(sort) : '' %>"
         class="plp-sidebar-link <%= !selectedCategory ? 'active' : '' %>"
         data-category=""
         aria-current="<%= !selectedCategory ? 'true' : 'false' %>">
        <span class="plp-sidebar-name"><%= t('products.all_products') %></span>
        <% if (typeof totalAllProducts !== 'undefined' && totalAllProducts !== null) { %>
          <span class="plp-cat-count" id="plp-total-all-count">(<%= totalAllProducts %>)</span>
        <% } %>
      </a>
    </li>
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(cat => { %>
        <% const isActiveCat = selectedCategory && selectedCategory.id === cat.id; %>
        <% const catHref = '/products?category=' + encodeURIComponent(cat.slug) + (search ? '&search=' + encodeURIComponent(search) : '') + (sort && sort !== 'newest' ? '&sort=' + encodeURIComponent(sort) : ''); %>
        <li class="plp-sidebar-item">
          <a href="<%= catHref %>"
             class="plp-sidebar-link <%= isActiveCat ? 'active' : '' %>"
             data-category="<%= cat.slug %>"
             data-category-id="<%= cat.id %>"
             aria-current="<%= isActiveCat ? 'true' : 'false' %>">
            <span class="plp-sidebar-name"><%= currentLangCode === 'en' ? (cat.name_en || cat.name_id) : cat.name_id %></span>
            <span class="plp-cat-count">(<%= cat.product_count || 0 %>)</span>
          </a>
        </li>
      <% }); %>
    <% } %>
  </ul>
</aside>


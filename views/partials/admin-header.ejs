<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'CMS Admin' %> - PT Euodoo</title>
  <meta name="description" content="Dashboard CMS Admin modern dan minimalis untuk operasional PT Euodoo.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="icon" href="<%= (typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/favicon.ico' %>">
  <link rel="stylesheet" href="/css/admin.css">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
</head>
<body class="admin-body">
  <!-- Mobile Drawer Backdrop -->
  <div class="admin-backdrop" id="adminBackdrop" aria-hidden="true"></div>

  <div class="app-layout">
    <!-- Modern Light Sidebar -->
    <aside class="app-sidebar" id="adminSidebar" aria-label="Navigasi Menu Utama">
      <div class="sidebar-brand-box">
        <a href="/admin/dashboard" class="brand-link">
          <div class="brand-icon-sq">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <div>
            <div class="brand-main-text">EUODOO</div>
            <div class="brand-sub-badge">CMS Panel</div>
          </div>
        </a>
      </div>

      <nav class="sidebar-nav-scroll" aria-label="Menu CMS">
        <!-- 1. Operasional Utama -->
        <div class="nav-section-title">OPERASIONAL</div>

        <a href="/admin/dashboard" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? 'active' : '' %>">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="3" width="7" height="9" rx="1"></rect>
            <rect x="14" y="3" width="7" height="5" rx="1"></rect>
            <rect x="14" y="12" width="7" height="9" rx="1"></rect>
            <rect x="3" y="16" width="7" height="5" rx="1"></rect>
          </svg>
          <span class="nav-item-label">Dashboard</span>
        </a>

        <% if (typeof user !== 'undefined' && user && ['superadmin', 'admin'].includes(user.role)) { %>
          <a href="/admin/inquiries" class="nav-item <%= typeof activeNav !== 'undefined' && (activeNav === 'inquiries' || activeNav === 'leads') ? 'active' : '' %>">
            <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span class="nav-item-label">Inquiry & RFQ</span>
            <% if (typeof pendingInquiriesCount !== 'undefined' && pendingInquiriesCount > 0) { %>
              <span class="nav-badge" id="sidePendingCount"><%= pendingInquiriesCount %></span>
            <% } %>
          </a>
        <% } %>

        <!-- 2. Katalog & Showcase (Superadmin & Admin) -->
        <% if (typeof user !== 'undefined' && user && ['superadmin', 'admin'].includes(user.role)) { %>
          <div class="nav-section-title">KATALOG & MEREK</div>

          <a href="/admin/banners" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'banners' ? 'active' : '' %>">
            <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            <span class="nav-item-label">Banner Hero</span>
          </a>

          <a href="/admin/product-categories" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'product-categories' ? 'active' : '' %>">
            <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M4 6h16M4 12h16M4 18h7"></path>
            </svg>
            <span class="nav-item-label">Kategori Produk</span>
          </a>

          <a href="/admin/products" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'products' ? 'active' : '' %>">
            <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span class="nav-item-label">Katalog Produk</span>
          </a>

          <a href="/admin/brands" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'brands' ? 'active' : '' %>">
            <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="12" cy="8" r="6"></circle>
              <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
            </svg>
            <span class="nav-item-label">Merek Terdaftar</span>
          </a>
        <% } %>

        <!-- 3. Konten & Publikasi (Superadmin, Admin, Editor) -->
        <div class="nav-section-title">KONTEN & MEDIA</div>

        <a href="/admin/post-categories" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'post-categories' ? 'active' : '' %>">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          <span class="nav-item-label">Kategori Berita</span>
        </a>

        <a href="/admin/posts" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'posts' ? 'active' : '' %>">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
          </svg>
          <span class="nav-item-label">Berita & Artikel</span>
        </a>

        <a href="/admin/media" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'media' ? 'active' : '' %>">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span class="nav-item-label">Media Library</span>
        </a>

        <% if (typeof user !== 'undefined' && user && ['superadmin', 'admin'].includes(user.role)) { %>
          <a href="/admin/about" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'about' ? 'active' : '' %>">
            <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M3 21h18"></path>
              <path d="M5 21V7l8-4v18"></path>
              <path d="M19 21V11l-6-4"></path>
            </svg>
            <span class="nav-item-label">Tentang Kami</span>
          </a>

          <a href="/admin/contact" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'contact-cms' ? 'active' : '' %>">
            <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span class="nav-item-label">Halaman Kontak</span>
          </a>
        <% } %>

        <!-- 4. Pengaturan & Sistem -->
        <div class="nav-section-title">SISTEM & AKUN</div>

        <% if (typeof user !== 'undefined' && user && user.role === 'superadmin') { %>
          <a href="/admin/users" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'users' ? 'active' : '' %>">
            <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span class="nav-item-label">Kelola User</span>
          </a>

          <a href="/admin/settings" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'settings' ? 'active' : '' %>">
            <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span class="nav-item-label">Pengaturan Situs</span>
          </a>
        <% } %>

        <a href="/admin/change-password" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'password' ? 'active' : '' %>">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span class="nav-item-label">Ganti Sandi</span>
        </a>
      </nav>

      <!-- User Profile Sidebar Footer -->
      <div class="sidebar-user-footer">
        <div class="user-profile-wrap">
          <div class="user-avatar-badge">
            <%= (typeof user !== 'undefined' && user && user.name ? user.name.charAt(0) : 'U').toUpperCase() %>
          </div>
          <div>
            <div class="user-name"><%= typeof user !== 'undefined' && user && user.name ? user.name : 'User' %></div>
            <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">
              <%= typeof user !== 'undefined' && user && user.role ? user.role : 'Staff' %>
            </div>
          </div>
        </div>
        <a href="/admin/logout" class="user-signout-btn" title="Keluar dari sesi admin">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>
    </aside>

    <!-- Main Shell Content -->
    <main class="app-main">
      <!-- Topbar Header -->
      <header class="app-topbar">
        <div class="topbar-left">
          <button type="button" class="mobile-menu-toggle" aria-label="Buka Navigasi">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div class="topbar-title">
            <%= typeof pageTitle !== 'undefined' ? pageTitle : (typeof title !== 'undefined' ? title : 'PT Euodoo CMS') %>
          </div>
        </div>

        <div class="topbar-right">
          <a href="/" target="_blank" class="btn-topbar-link">
            <span>Lihat Website</span>
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
          <span class="badge-role <%= typeof user !== 'undefined' && user && user.role ? user.role : 'editor' %>">
            <%= typeof user !== 'undefined' && user && user.role ? user.role : 'guest' %>
          </span>
        </div>
      </header>

      <!-- Flash Notifications -->
      <div class="admin-alerts-container">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error" role="alert">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span><%= error %></span>
          </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success" role="alert">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span><%= success %></span>
          </div>
        <% } %>
      </div>

      <!-- Main Canvas Starts -->
      <div class="app-content">

<div id="universalMediaPickerModal" class="admin-modal-backdrop media-picker-modal" aria-hidden="true" role="dialog" aria-labelledby="mediaPickerTitle">
  <div class="admin-modal-box">
    <div class="media-picker-modal-header">
      <div>
        <h3 id="mediaPickerTitle" class="adm-picker-title">Pilih Media dari Library</h3>
        <p class="adm-picker-desc">Pilih aset visual yang sudah tersedia atau unggah berkas baru secara langsung.</p>
      </div>
      <button type="button" class="admin-modal-close" id="btnCloseMediaPicker" aria-label="Tutup Modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="media-picker-tabs" role="tablist">
      <button type="button" class="media-picker-tab-btn active" data-tab="library" data-type="all">Semua Media</button>
      <button type="button" class="media-picker-tab-btn" data-tab="library" data-type="image">Gambar</button>
      <button type="button" class="media-picker-tab-btn" data-tab="library" data-type="video">Video</button>
      <button type="button" class="media-picker-tab-btn" data-tab="library" data-type="youtube">YouTube</button>
      <button type="button" class="media-picker-tab-btn adm-picker-tab-upload" data-tab="upload">
        <svg class="adm-picker-tab-upload-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        Unggah Berkas Baru
      </button>
    </div>

    <div class="media-picker-body">
      <div id="mediaPickerTabLibrary">
        <div class="adm-picker-search-bar">
          <div class="adm-picker-search-wrap">
            <input type="text" id="mediaPickerSearch" class="form-input adm-picker-search-input" placeholder="Cari nama berkas atau URL...">
            <svg class="adm-picker-search-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </div>
          <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm" id="btnRefreshMediaPicker" title="Muat Ulang" aria-label="Muat ulang media library">
            <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"></path><path d="M1 20v-6h6"></path><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          </button>
        </div>

        <div id="mediaPickerLoading" class="adm-picker-loading adm-d-none">
          <div class="spinner adm-picker-spinner"></div>
          <span>Memuat aset media...</span>
        </div>

        <div id="mediaPickerGrid" class="media-picker-grid"></div>

        <div id="mediaPickerEmpty" class="adm-picker-empty adm-d-none">
          <svg class="adm-picker-empty-icon" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <div class="adm-picker-empty-title">Tidak ada berkas media ditemukan</div>
          <p class="adm-picker-empty-text">Coba ubah kata kunci pencarian atau unggah berkas baru.</p>
        </div>

        <div id="mediaPickerPagination" class="adm-picker-pagination">
          <span id="mediaPickerPageInfo" class="adm-picker-page-info">Halaman 1 dari 1</span>
          <div class="adm-picker-pagination-btns">
            <button type="button" class="adm-btn adm-btn-neutral adm-btn-sm" id="btnMediaPickerPrev" aria-label="Halaman sebelumnya">Sebelumnya</button>
            <button type="button" class="adm-btn adm-btn-neutral adm-btn-sm" id="btnMediaPickerNext" aria-label="Halaman berikutnya">Berikutnya</button>
          </div>
        </div>
      </div>

      <div id="mediaPickerTabUpload" class="adm-d-none">
        <div id="pickerUploadDropzone" class="adm-picker-dropzone">
          <svg class="adm-picker-dropzone-icon" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          <div class="adm-picker-dropzone-title">Pilih Berkas atau Tarik ke Sini</div>
          <p class="adm-picker-dropzone-hint">Mendukung format gambar (JPG, PNG, WebP, SVG), video (MP4, WebM), atau PDF (Maks 15MB).</p>
          <input type="file" id="pickerFileInput" class="adm-d-none" accept="image/*,video/*,application/pdf">
          <button type="button" class="adm-btn adm-btn-primary adm-btn-sm" id="btnTriggerBrowseFile" aria-label="Pilih berkas dari komputer">
            <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            <span>Pilih Berkas</span>
          </button>
        </div>

        <div id="pickerUploadProgress" class="adm-picker-upload-progress adm-d-none">
          <div id="pickerUploadProgressText" class="adm-picker-progress-text">Mengunggah &amp; mengoptimasi berkas...</div>
          <div class="adm-picker-progress-track">
            <div id="pickerUploadProgressBar" class="adm-picker-progress-bar"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="media-picker-footer">
      <div class="media-picker-selected-info" id="pickerSelectedInfo">
        <span class="media-picker-empty-hint">Belum ada media dipilih</span>
      </div>
      <div class="adm-picker-footer-actions">
        <button type="button" class="adm-btn adm-btn-neutral adm-btn-sm" id="btnCancelMediaPicker" aria-label="Batalkan pemilihan media">
          <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
          <span>Batal</span>
        </button>
        <button type="button" class="adm-btn adm-btn-primary adm-btn-sm" id="btnConfirmSelectMedia" disabled aria-label="Konfirmasi gunakan media terpilih">
          <svg class="adm-btn-icon adm-btn-icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Pilih</span>
        </button>
      </div>
    </div>
  </div>
</div>

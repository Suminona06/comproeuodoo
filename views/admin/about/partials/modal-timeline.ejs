<div class="admin-modal-backdrop" id="timelineModal">
  <div class="admin-modal-card adm-abt-modal-timeline">
    <div class="admin-modal-header">
      <div class="admin-modal-title" id="timelineModalTitle">Tambah Milestone Linimasa</div>
      <button type="button" class="modal-close-btn admin-modal-close" data-modal-close="timelineModal" aria-label="Tutup Dialog">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <form id="timelineForm" method="POST" action="/admin/about/timeline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" id="timeline_id" name="id" value="">

      <div class="admin-modal-body">
        <div class="form-row-2">
          <div class="form-group adm-abt-mb-0">
            <label for="timeline_year_label_id" class="form-label">Label Tahun / Era (ID) *</label>
            <input type="text" id="timeline_year_label_id" name="year_label_id" class="form-input" required placeholder="contoh: 1990 — Awal Berdiri">
          </div>
          <div class="form-group adm-abt-mb-0">
            <label for="timeline_year_label_en" class="form-label">Label Tahun / Era (EN)</label>
            <input type="text" id="timeline_year_label_en" name="year_label_en" class="form-input" placeholder="contoh: 1990 — Inception">
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group adm-abt-mb-0">
            <label for="timeline_title_id" class="form-label">Judul Milestone (ID) *</label>
            <input type="text" id="timeline_title_id" name="title_id" class="form-input" required placeholder="contoh: Perintisan Pabrik & Modernisasi">
          </div>
          <div class="form-group adm-abt-mb-0">
            <label for="timeline_title_en" class="form-label">Judul Milestone (EN)</label>
            <input type="text" id="timeline_title_en" name="title_en" class="form-input" placeholder="contoh: Inception & Modernization">
          </div>
        </div>

        <div class="form-group adm-abt-mb-0">
          <label for="timeline_description_id" class="form-label">Deskripsi Milestone (Indonesia)</label>
          <textarea id="timeline_description_id" name="description_id" class="form-textarea adm-abt-textarea-modal-desc" placeholder="Penjelasan sejarah dan pencapaian era ini..."></textarea>
        </div>

        <div class="form-group adm-abt-mb-0">
          <label for="timeline_description_en" class="form-label">Deskripsi Milestone (English)</label>
          <textarea id="timeline_description_en" name="description_en" class="form-textarea adm-abt-textarea-modal-desc" placeholder="Historical highlights in English..."></textarea>
        </div>

        <div class="form-row-2">
          <div class="form-group adm-abt-mb-0">
            <label for="timeline_sort_order" class="form-label">Urutan</label>
            <input type="number" id="timeline_sort_order" name="sort_order" class="form-input" value="0" min="0" step="1">
          </div>
          <div class="form-group adm-abt-checkbox-wrap">
            <label class="form-label">Status</label>
            <label class="adm-abt-checkbox-label">
              <input type="checkbox" id="timeline_is_active" name="is_active" value="1" checked class="adm-abt-checkbox">
              <span>Aktif</span>
            </label>
          </div>
        </div>
      </div>

      <div class="admin-modal-footer">
        <button type="button" class="adm-btn adm-btn-neutral" data-modal-close="timelineModal" aria-label="Batalkan perubahan milestone linimasa">
          <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
          <span>Batal</span>
        </button>
        <button type="submit" class="adm-btn adm-btn-primary" aria-label="Simpan milestone linimasa">
          <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Simpan</span>
        </button>
      </div>
    </form>
  </div>
</div>

<div class="adm-abt-val-card" data-card-index="<%= idx %>">
  <div class="adm-abt-val-header">
    <span class="adm-abt-val-letter" id="badge_letter_<%= formKey %>"><%= val.letter %></span>
    <div class="adm-abt-val-icon-box" id="icon_box_<%= formKey %>" title="Pratinjau Ikon">
      <%- include('../../../partials/icons/ticket/index', { icon: val.icon_key || 'praying-hands', className: 'adm-abt-icon-svg' }) %>
    </div>
    <div class="adm-abt-val-info">
      <strong class="adm-abt-val-title">Pilar Ke-<%= idx + 1 %></strong>
    </div>
  </div>

  <div class="form-row-2 adm-abt-val-row">
    <div class="form-group adm-abt-mb-0">
      <label class="form-label adm-abt-form-label-sm" for="val_letter_<%= formKey %>">Huruf Pilar (1 Karakter)</label>
      <input type="text" id="val_letter_<%= formKey %>" name="val_letter_<%= formKey %>" class="form-input adm-abt-val-letter-input" value="<%= val.letter %>" maxlength="1" required data-badge-target="badge_letter_<%= formKey %>">
    </div>
    <div class="form-group adm-abt-mb-0">
      <label class="form-label adm-abt-form-label-sm" for="val_icon_key_<%= formKey %>">Ikon Pilar (SVG Whitelist)</label>
      <select name="val_icon_key_<%= formKey %>" id="val_icon_key_<%= formKey %>" class="form-select eu-dd-native" data-eu-dropdown="outlined" data-preview-target="icon_box_<%= formKey %>">
        <% 
          const iconList = (ticketIconKeys && ticketIconKeys.length > 0) ? ticketIconKeys : ['praying-hands', 'shield-check', 'chat-dots', 'heart', 'star', 'handshake'];
          iconList.forEach(function(k) { 
            const optLabel = ticketIcons && ticketIcons[k] ? ticketIcons[k].label_id : k;
        %>
          <option value="<%= k %>" <%= val.icon_key === k ? 'selected' : '' %>><%= optLabel %></option>
        <% }); %>
      </select>
    </div>
  </div>

  <div class="form-row-2 adm-abt-val-row">
    <div class="form-group adm-abt-mb-0">
      <label class="form-label adm-abt-form-label-sm" for="val_title_id_<%= formKey %>">Nama Nilai (ID)</label>
      <input type="text" id="val_title_id_<%= formKey %>" name="val_title_id_<%= formKey %>" class="form-input" value="<%= val.title_id %>" maxlength="50" required>
    </div>
    <div class="form-group adm-abt-mb-0">
      <label class="form-label adm-abt-form-label-sm" for="val_title_en_<%= formKey %>">Nama Nilai (EN)</label>
      <input type="text" id="val_title_en_<%= formKey %>" name="val_title_en_<%= formKey %>" class="form-input" value="<%= val.title_en %>" maxlength="50" required>
    </div>
  </div>

  <div class="form-row-2 adm-abt-val-row">
    <div class="form-group adm-abt-mb-0">
      <label class="form-label adm-abt-form-label-sm" for="val_desc_id_<%= formKey %>">Penjelasan / Makna (ID)</label>
      <textarea id="val_desc_id_<%= formKey %>" name="val_desc_id_<%= formKey %>" class="form-textarea adm-abt-textarea-pill" maxlength="250"><%= val.desc_id %></textarea>
    </div>
    <div class="form-group adm-abt-mb-0">
      <label class="form-label adm-abt-form-label-sm" for="val_desc_en_<%= formKey %>">Penjelasan / Makna (EN)</label>
      <textarea id="val_desc_en_<%= formKey %>" name="val_desc_en_<%= formKey %>" class="form-textarea adm-abt-textarea-pill" maxlength="250"><%= val.desc_en %></textarea>
    </div>
  </div>

  <div class="form-group adm-abt-mb-0">
    <label class="form-label adm-abt-form-label-sm">Foto Kartu Pilar</label>
    <div class="media-picker-component">
      <input type="hidden" id="val_image_url_<%= formKey %>" name="val_image_url_<%= formKey %>" value="<%= val.image_url || '' %>">
      <div class="media-picker-preview-box">
        <img src="<%= val.image_url || '' %>" alt="Pratinjau Pilar <%= val.letter %>" class="media-picker-preview-img <%= val.image_url ? '' : 'hidden' %>">
        <div class="media-picker-empty <%= val.image_url ? 'hidden' : '' %>">
          <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span>Belum ada foto dipilih</span>
        </div>
      </div>
      <div class="media-picker-ctrls">
        <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="val_image_url_<%= formKey %>" data-picker-type="image" aria-label="Pilih foto pilar <%= val.letter %> dari Media Library">
          <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span>Pilih Media</span>
        </button>
        <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media <%= val.image_url ? '' : 'hidden' %>" aria-label="Hapus foto pilar <%= val.letter %>">
          <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          <span>Hapus</span>
        </button>
      </div>
    </div>
  </div>
</div>


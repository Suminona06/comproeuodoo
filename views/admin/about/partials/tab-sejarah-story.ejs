<div class="about-glass-card">
  <div class="form-card-title adm-abt-card-title">
    <span>Latar Belakang &amp; Sejarah Pabrik</span>
    <span class="badge badge-info adm-abt-badge-xs">Jejak Langkah 1990</span>
  </div>

  <div class="form-row-2">
    <div class="form-group">
      <label for="founded_year" class="form-label">Tahun Berdiri *</label>
      <input type="text" id="founded_year" name="founded_year" class="form-input" value="<%= about.founded_year || '1990' %>" required placeholder="1990">
      <div class="form-hint">Sesuai Company Profile: Didirikan pada tahun 1990.</div>
    </div>
    <div class="form-group">
      <label for="former_names" class="form-label">Nama Terdahulu / Dikenal Sebagai</label>
      <input type="text" id="former_names" name="former_names" class="form-input" value="<%= about.former_names || 'PT. Sahabat Baru & PT. Pelita Baru' %>" placeholder="PT. Sahabat Baru & PT. Pelita Baru">
      <div class="form-hint">Entitas awal perintisan bisnis pabrik kantong plastik.</div>
    </div>
  </div>

  <div class="form-row-2">
    <div class="form-group">
      <label for="about_story_kicker_id" class="form-label">Label Kicker Sejarah (Indonesia)</label>
      <input type="text" id="about_story_kicker_id" name="about_story_kicker_id" class="form-input" value="<%= (typeof storyHeader !== 'undefined' && storyHeader.kicker_id) || '' %>" placeholder="Kisah Kami">
      <div class="form-hint">Label kecil di atas judul sejarah (contoh: Kisah Kami).</div>
    </div>
    <div class="form-group">
      <label for="about_story_kicker_en" class="form-label">Label Kicker Sejarah (English)</label>
      <input type="text" id="about_story_kicker_en" name="about_story_kicker_en" class="form-input" value="<%= (typeof storyHeader !== 'undefined' && storyHeader.kicker_en) || '' %>" placeholder="Our Story">
      <div class="form-hint">Kicker text in English (e.g. Our Story).</div>
    </div>
  </div>

  <div class="form-row-2">
    <div class="form-group">
      <label for="history_title_id" class="form-label">Judul Bagian Sejarah (Indonesia)</label>
      <input type="text" id="history_title_id" name="history_title_id" class="form-input" value="<%= about.history_title_id || '' %>" placeholder="Latar Belakang & Sejarah Perusahaan">
    </div>
    <div class="form-group">
      <label for="history_title_en" class="form-label">Judul Bagian Sejarah (English)</label>
      <input type="text" id="history_title_en" name="history_title_en" class="form-input" value="<%= about.history_title_en || '' %>" placeholder="Company Background & History">
    </div>
  </div>

  <div class="form-group">
    <label for="history_id" class="form-label">Narasi Latar Belakang (Bahasa Indonesia) *</label>
    <textarea id="history_id" name="history_id" class="form-textarea adm-abt-textarea-history" required placeholder="Tuliskan narasi sejarah lengkap dalam Bahasa Indonesia..."><%= about.history_id || '' %></textarea>
  </div>

  <div class="form-group">
    <label for="history_en" class="form-label">Narasi Latar Belakang (English)</label>
    <textarea id="history_en" name="history_en" class="form-textarea adm-abt-textarea-history" placeholder="Write corporate history narration in English..."><%= about.history_en || '' %></textarea>
  </div>

  <div class="form-group adm-abt-mb-0">
    <label class="form-label">Foto Dokumentasi Pabrik / Fasilitas (Media Library)</label>
    <div class="media-picker-component">
      <input type="hidden" id="about_image_url" name="image_url" value="<%= about.image_url || '' %>">
      <div class="media-picker-preview-box">
        <img src="<%= about.image_url || '' %>" alt="Pratinjau Fasilitas" class="media-picker-preview-img <%= about.image_url ? '' : 'hidden' %>">
        <div class="media-picker-empty <%= about.image_url ? 'hidden' : '' %>">
          <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span>Belum ada foto fasilitas dipilih</span>
        </div>
      </div>
      <div class="media-picker-ctrls">
        <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="about_image_url" data-picker-type="image" aria-label="Pilih foto fasilitas dari Media Library">
          <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span>Pilih Media</span>
        </button>
        <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media <%= about.image_url ? '' : 'hidden' %>" aria-label="Hapus foto fasilitas">
          <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          <span>Hapus</span>
        </button>
      </div>
    </div>
  </div>
</div>


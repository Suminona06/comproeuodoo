<div class="about-glass-card adm-abt-mt-lg">
  <div class="form-card-title adm-abt-card-title">
    <div class="adm-abt-card-title-left">
      <span>Statistik &amp; Prestasi Utama</span>
      <span class="badge <%= (stats && stats.length >= 8) ? 'badge-warning' : 'badge-info' %> adm-abt-badge-xs">
        <%= (stats ? stats.length : 0) %>/8 Item
      </span>
    </div>
    <% if (!stats || stats.length < 8) { %>
      <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm" data-action="open-stats-modal" aria-label="Tambah data statistik baru">
        <svg class="adm-btn-icon adm-btn-icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span>Tambah</span>
      </button>
    <% } else { %>
      <span class="adm-abt-stat-limit-text">Maksimal 8 item statistik tercapai</span>
    <% } %>
  </div>
  <p class="adm-abt-card-desc">
    Kotak angka statistik yang tampil mencolok di samping narasi sejarah publik (contoh: 30+, 5, 4, 3).
  </p>

  <% if (stats && stats.length > 0) { %>
    <div class="adm-abt-table-wrap">
      <table class="admin-table adm-abt-table">
        <thead>
          <tr>
            <th class="adm-abt-col-order">Urutan</th>
            <th class="adm-abt-col-val">Nilai / Angka</th>
            <th>Label (ID)</th>
            <th>Label (EN)</th>
            <th class="adm-abt-col-status">Status</th>
            <th class="adm-abt-col-actions">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% stats.forEach(function(item) { %>
            <tr>
              <td class="adm-abt-col-order"><%= item.sort_order %></td>
              <td>
                <span class="adm-abt-stat-pill"><%= item.stat_value %></span>
              </td>
              <td class="adm-abt-stat-label-id"><%= item.label_id %></td>
              <td class="adm-abt-stat-label-en"><%= item.label_en || '-' %></td>
              <td class="adm-abt-col-center">
                <% if (item.is_active) { %>
                  <span class="badge-status active">Aktif</span>
                <% } else { %>
                  <span class="badge-status inactive">Nonaktif</span>
                <% } %>
              </td>
              <td class="adm-abt-col-right">
                <div class="table-actions">
                  <button type="button" class="btn-action btn-action-edit" title="Edit Statistik" data-action="edit-stat" data-stat="<%= encodeURIComponent(JSON.stringify(item)) %>">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                    <span>Edit</span>
                  </button>
                  <button type="button" class="btn-action btn-action-delete" title="Hapus Statistik" data-action="delete-about-item" data-action-url="/admin/about/stats/<%= item.id %>/delete" data-title="<%= item.stat_value %> - <%= item.label_id %>">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <span>Hapus</span>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="adm-abt-empty-box">
      Belum ada data statistik ditambahkan. Klik tombol <strong>Tambah Statistik</strong> di atas untuk membuat item baru.
    </div>
  <% } %>
</div>


<div class="about-tab-pane" id="tab-visi-misi" role="tabpanel">
  <div class="about-glass-card">
    <div class="form-card-title">Visi &amp; Misi Korporasi</div>
    <div class="form-row-2">
      <div class="form-group">
        <label for="vision_id" class="form-label">Visi Perusahaan (Indonesia) *</label>
        <textarea id="vision_id" name="vision_id" class="form-textarea adm-abt-textarea-vision" required><%= about.vision_id || '' %></textarea>
        <div class="form-hint">Visi luhur yang mengarahkan komitmen masa depan.</div>
      </div>
      <div class="form-group">
        <label for="vision_en" class="form-label">Visi Perusahaan (English)</label>
        <textarea id="vision_en" name="vision_en" class="form-textarea adm-abt-textarea-vision"><%= about.vision_en || '' %></textarea>
        <div class="form-hint">Corporate long-term vision in English.</div>
      </div>
    </div>
    <div class="form-row-2">
      <div class="form-group">
        <label for="mission_id" class="form-label">Misi Perusahaan (Indonesia) *</label>
        <textarea id="mission_id" name="mission_id" class="form-textarea adm-abt-textarea-mission" required><%= about.mission_id || '' %></textarea>
        <div class="form-hint">Ketik baris baru (Enter) untuk setiap butir misi.</div>
      </div>
      <div class="form-group">
        <label for="mission_en" class="form-label">Misi Perusahaan (English)</label>
        <textarea id="mission_en" name="mission_en" class="form-textarea adm-abt-textarea-mission"><%= about.mission_en || '' %></textarea>
        <div class="form-hint">Separate each mission point with a new line.</div>
      </div>
    </div>
  </div>

  <div class="about-glass-card adm-abt-mt-lg">
    <div class="form-card-title adm-abt-card-title">
      <span>Foto Ilustrasi &amp; Dokumentasi Visi Misi</span>
      <span class="badge badge-info adm-abt-badge-xs">Media Library</span>
    </div>
    <p class="adm-abt-card-desc">
      Foto dokumentasi fasilitas atau aktivitas produksi yang ditampilkan mendampingi kartu Visi dan Misi pada halaman publik.
    </p>

    <div class="form-row-2">
      <% const vmCards = [
        { id: 'vision_image_url', val: (typeof visionMissionImages !== 'undefined' && visionMissionImages.vision_image_url) || '', label: 'Foto Ilustrasi Visi', hint: 'Muncul di samping kartu Visi (format WebP/JPG resolusi tinggi).' },
        { id: 'mission_image_url', val: (typeof visionMissionImages !== 'undefined' && visionMissionImages.mission_image_url) || '', label: 'Foto Ilustrasi Misi', hint: 'Muncul di samping kartu Misi (format WebP/JPG resolusi tinggi).' }
      ]; %>
      <% vmCards.forEach(function(item) { %>
        <div class="form-group adm-abt-mb-0">
          <label class="form-label"><%= item.label %></label>
          <div class="media-picker-component">
            <input type="hidden" id="<%= item.id %>" name="<%= item.id %>" value="<%= item.val %>">
            <div class="media-picker-preview-box">
              <img src="<%= item.val %>" alt="Pratinjau <%= item.label %>" class="media-picker-preview-img <%= item.val ? '' : 'hidden' %>">
              <div class="media-picker-empty <%= item.val ? 'hidden' : '' %>">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                <span>Belum ada foto dipilih</span>
              </div>
            </div>
            <div class="media-picker-ctrls">
              <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="<%= item.id %>" data-picker-type="image" aria-label="Pilih <%= item.label %> dari Media Library">
                <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                <span>Pilih Media</span>
              </button>
              <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media <%= item.val ? '' : 'hidden' %>" aria-label="Hapus <%= item.label %>">
                <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                <span>Hapus</span>
              </button>
            </div>
          </div>
          <div class="form-hint"><%= item.hint %></div>
        </div>
      <% }); %>
    </div>
  </div>

  <div class="about-glass-card adm-abt-mt-lg">
    <div class="form-card-title">Slogan, Motto &amp; Target (Goal)</div>
    <div class="form-row-2">
      <div class="form-group">
        <label for="slogan_id" class="form-label">Slogan Korporat (Indonesia)</label>
        <input type="text" id="slogan_id" name="slogan_id" class="form-input" value="<%= about.slogan_id || '' %>">
      </div>
      <div class="form-group">
        <label for="slogan_en" class="form-label">Slogan Korporat (English)</label>
        <input type="text" id="slogan_en" name="slogan_en" class="form-input" value="<%= about.slogan_en || '' %>">
      </div>
    </div>
    <div class="form-row-2">
      <div class="form-group">
        <label for="motto_id" class="form-label">Motto Kerja (Indonesia)</label>
        <textarea id="motto_id" name="motto_id" class="form-textarea adm-abt-textarea-motto"><%= about.motto_id || '' %></textarea>
      </div>
      <div class="form-group">
        <label for="goal_id" class="form-label">Target / Tujuan (Goal)</label>
        <textarea id="goal_id" name="goal_id" class="form-textarea adm-abt-textarea-motto"><%= about.goal_id || '' %></textarea>
      </div>
    </div>
  </div>
</div>

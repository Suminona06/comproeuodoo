<div class="about-glass-card adm-abt-mt-lg">
  <div class="form-card-title adm-abt-card-title">
    <span>Header &amp; Pengantar Linimasa Sejarah</span>
    <span class="badge badge-info adm-abt-badge-xs">Tampilan Publik</span>
  </div>

  <div class="form-row-2">
    <div class="form-group">
      <label for="about_timeline_tagline_id" class="form-label">Tagline Linimasa (Indonesia)</label>
      <input type="text" id="about_timeline_tagline_id" name="about_timeline_tagline_id" class="form-input" maxlength="50" value="<%= (typeof timelineHeader !== 'undefined' && timelineHeader.tagline_id) || '' %>" placeholder="Perjalanan Kami">
    </div>
    <div class="form-group">
      <label for="about_timeline_tagline_en" class="form-label">Tagline Linimasa (English)</label>
      <input type="text" id="about_timeline_tagline_en" name="about_timeline_tagline_en" class="form-input" maxlength="50" value="<%= (typeof timelineHeader !== 'undefined' && timelineHeader.tagline_en) || '' %>" placeholder="Our Journey">
    </div>
  </div>

  <div class="form-row-2">
    <div class="form-group">
      <label for="about_timeline_title_id" class="form-label">Judul Utama Linimasa (Indonesia)</label>
      <input type="text" id="about_timeline_title_id" name="about_timeline_title_id" class="form-input" maxlength="120" value="<%= (typeof timelineHeader !== 'undefined' && timelineHeader.title_id) || '' %>" placeholder="Jejak Langkah &amp; Tonggak Sejarah">
    </div>
    <div class="form-group">
      <label for="about_timeline_title_en" class="form-label">Judul Utama Linimasa (English)</label>
      <input type="text" id="about_timeline_title_en" name="about_timeline_title_en" class="form-input" maxlength="120" value="<%= (typeof timelineHeader !== 'undefined' && timelineHeader.title_en) || '' %>" placeholder="Milestones &amp; Historical Journey">
    </div>
  </div>

  <div class="form-group adm-abt-mb-0">
    <label for="about_timeline_desc_id" class="form-label">Deskripsi Pengantar Linimasa (Indonesia)</label>
    <textarea id="about_timeline_desc_id" name="about_timeline_desc_id" class="form-textarea adm-abt-textarea-desc" maxlength="300" placeholder="Menelusuri pertumbuhan PT Euodoo dari awal berdiri..."><%= (typeof timelineHeader !== 'undefined' && timelineHeader.desc_id) || '' %></textarea>
  </div>

  <div class="form-group adm-abt-mt-md">
    <label for="about_timeline_desc_en" class="form-label">Deskripsi Pengantar Linimasa (English)</label>
    <textarea id="about_timeline_desc_en" name="about_timeline_desc_en" class="form-textarea adm-abt-textarea-desc" maxlength="300" placeholder="Tracing PT Euodoo's growth from its founding..."><%= (typeof timelineHeader !== 'undefined' && timelineHeader.desc_en) || '' %></textarea>
  </div>
</div>


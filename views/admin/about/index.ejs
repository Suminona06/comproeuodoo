<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Manajemen Halaman Tentang Kami</h1>
    <p>Kelola narasi profil perusahaan, sejarah pendirian 1990, visi misi, nilai budaya T-I-C-K-E-T, dan sertifikasi ramah lingkungan.</p>
  </div>
  <div class="header-actions">
    <a href="/about" target="_blank" class="adm-btn adm-btn-secondary" aria-label="Buka halaman tentang kami publik">
      <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      <span>Pratinjau</span>
    </a>
  </div>
</div>

<form action="/admin/about?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="about-tabs-nav" role="tablist">
    <button type="button" class="about-tab-btn active" data-tab="tab-sejarah" role="tab" aria-selected="true">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      <span>1. Sejarah</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-visi-misi" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      <span>2. Visi, Misi &amp; Slogan</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-ticket" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
      <span>3. Nilai Budaya T-I-C-K-E-T</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-sertifikasi" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      <span>4. Sertifikasi &amp; Lingkungan</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-gallery" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
      <span>5. Galeri Fasilitas</span>
    </button>
  </div>

  <%- include('./partials/tab-sejarah') %>
  <%- include('./partials/tab-visi-misi') %>
  <%- include('./partials/tab-nilai') %>
  <%- include('./partials/tab-sertifikasi') %>
  <%- include('./partials/tab-galeri') %>
  <%- include('./partials/sticky-actions') %>
</form>

<%- include('./partials/delete-form') %>
<%- include('./partials/modal-galeri') %>
<%- include('./partials/modal-statistik') %>
<%- include('./partials/modal-timeline') %>

<%- include('../../partials/admin-footer') %>

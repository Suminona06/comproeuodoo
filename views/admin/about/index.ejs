<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Manajemen Halaman Tentang Kami</h1>
    <p>Kelola narasi profil perusahaan, sejarah pendirian 1990, visi misi, nilai budaya T-I-C-K-E-T, dan sertifikasi ramah lingkungan.</p>
  </div>
  <div class="header-actions">
    <a href="/about" target="_blank" class="btn btn-secondary" title="Lihat Halaman Publik">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      <span>Pratinjau Publik</span>
    </a>
  </div>
</div>

<form action="/admin/about?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <!-- Interactive Segmented Navigation -->
  <div class="about-tabs-nav" role="tablist">
    <button type="button" class="about-tab-btn active" data-tab="tab-sejarah" role="tab" aria-selected="true">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      <span>1. Sejarah</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-visi-misi" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      <span>2. Visi, Misi &amp; Slogan</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-ticket" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
      <span>3. Nilai Budaya T-I-C-K-E-T</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-sertifikasi" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      <span>4. Sertifikasi &amp; Lingkungan</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-gallery" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
      <span>5. Galeri Fasilitas</span>
    </button>
  </div>

  <!-- TAB PANE 1: SEJARAH -->
  <div class="about-tab-pane active" id="tab-sejarah" role="tabpanel">
    <!-- Card 1: Latar Belakang & Sejarah Pabrik -->
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Latar Belakang &amp; Sejarah Pabrik</span>
        <span class="badge badge-info" style="font-size: 11px;">Jejak Langkah 1990</span>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="founded_year" class="form-label">Tahun Berdiri *</label>
          <input type="text" id="founded_year" name="founded_year" class="form-input" value="<%= about.founded_year || '1990' %>" required placeholder="1990">
          <div class="form-hint">Sesuai Company Profile: Didirikan pada tahun 1990.</div>
        </div>
        <div class="form-group">
          <label for="former_names" class="form-label">Nama Terdahulu / Dikenal Sebagai</label>
          <input type="text" id="former_names" name="former_names" class="form-input" value="<%= about.former_names || 'PT. Sahabat Baru & PT. Pelita Baru' %>" placeholder="PT. Sahabat Baru & PT. Pelita Baru">
          <div class="form-hint">Entitas awal perintisan bisnis pabrik kantong plastik.</div>
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="about_story_kicker_id" class="form-label">Label Kicker Sejarah (Indonesia)</label>
          <input type="text" id="about_story_kicker_id" name="about_story_kicker_id" class="form-input" value="<%= (typeof storyHeader !== 'undefined' && storyHeader.kicker_id) || '' %>" placeholder="Kisah Kami">
          <div class="form-hint">Label kecil di atas judul sejarah (contoh: Kisah Kami).</div>
        </div>
        <div class="form-group">
          <label for="about_story_kicker_en" class="form-label">Label Kicker Sejarah (English)</label>
          <input type="text" id="about_story_kicker_en" name="about_story_kicker_en" class="form-input" value="<%= (typeof storyHeader !== 'undefined' && storyHeader.kicker_en) || '' %>" placeholder="Our Story">
          <div class="form-hint">Kicker text in English (e.g. Our Story).</div>
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="history_title_id" class="form-label">Judul Bagian Sejarah (Indonesia)</label>
          <input type="text" id="history_title_id" name="history_title_id" class="form-input" value="<%= about.history_title_id || '' %>" placeholder="Latar Belakang & Sejarah Perusahaan">
        </div>
        <div class="form-group">
          <label for="history_title_en" class="form-label">Judul Bagian Sejarah (English)</label>
          <input type="text" id="history_title_en" name="history_title_en" class="form-input" value="<%= about.history_title_en || '' %>" placeholder="Company Background & History">
        </div>
      </div>

      <div class="form-group">
        <label for="history_id" class="form-label">Narasi Latar Belakang (Bahasa Indonesia) *</label>
        <textarea id="history_id" name="history_id" class="form-textarea" style="min-height: 120px;" required placeholder="Tuliskan narasi sejarah lengkap dalam Bahasa Indonesia..."><%= about.history_id || '' %></textarea>
      </div>

      <div class="form-group">
        <label for="history_en" class="form-label">Narasi Latar Belakang (English)</label>
        <textarea id="history_en" name="history_en" class="form-textarea" style="min-height: 120px;" placeholder="Write corporate history narration in English..."><%= about.history_en || '' %></textarea>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Foto Dokumentasi Pabrik / Fasilitas (Media Library)</label>
        <div class="media-picker-component">
          <input type="hidden" id="about_image_url" name="image_url" value="<%= about.image_url || '' %>">
          <div class="media-picker-preview-box">
            <img src="<%= about.image_url || '' %>" alt="Pratinjau Fasilitas" style="<%= about.image_url ? 'display: block;' : 'display: none;' %>">
            <div class="media-picker-empty" style="<%= about.image_url ? 'display: none;' : '' %>">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <span>Belum ada foto fasilitas dipilih</span>
            </div>
          </div>
          <div class="media-picker-ctrls">
            <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="about_image_url" data-picker-type="image">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              Pilih dari Media Library
            </button>
            <button type="button" class="btn btn-ghost btn-sm btn-clear-media" style="<%= about.image_url ? '' : 'display: none;' %>">Hapus</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Statistik Utama (4 Kotak Angka - Maksimal 8 Item) -->
    <div class="about-glass-card" style="margin-top: 1.5rem;">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span>Statistik &amp; Prestasi Utama</span>
          <span class="badge <%= (stats && stats.length >= 8) ? 'badge-warning' : 'badge-info' %>" style="font-size: 11px;">
            <%= (stats ? stats.length : 0) %>/8 Item
          </span>
        </div>
        <% if (!stats || stats.length < 8) { %>
          <button type="button" class="btn btn-secondary btn-sm" onclick="openStatsModal()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Tambah Statistik</span>
          </button>
        <% } else { %>
          <span style="font-size: 12px; color: var(--text-muted); font-style: italic;">Maksimal 8 item statistik tercapai</span>
        <% } %>
      </div>
      <p style="font-size: 13px; color: var(--text-muted); margin: -0.5rem 0 1.25rem 0;">
        Kotak angka statistik yang tampil mencolok di samping narasi sejarah publik (contoh: 30+, 5, 4, 3).
      </p>

      <% if (stats && stats.length > 0) { %>
        <div style="overflow-x: auto; border: 1px solid var(--border-main); border-radius: var(--r-lg);">
          <table class="admin-table" style="width: 100%; margin-bottom: 0;">
            <thead>
              <tr>
                <th style="width: 70px; text-align: center;">Urutan</th>
                <th style="width: 120px;">Nilai / Angka</th>
                <th>Label (ID)</th>
                <th>Label (EN)</th>
                <th style="width: 100px; text-align: center;">Status</th>
                <th style="width: 110px; text-align: right;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% stats.forEach(function(item) { %>
                <tr>
                  <td style="text-align: center; font-weight: 600; color: var(--text-muted);">
                    <%= item.sort_order %>
                  </td>
                  <td>
                    <span style="display: inline-block; font-size: 16px; font-weight: 800; color: var(--primary); background: var(--primary-subtle); padding: 4px 10px; border-radius: var(--r-md); border: 1px solid var(--primary-border);">
                      <%= item.stat_value %>
                    </span>
                  </td>
                  <td style="font-weight: 600; color: var(--text-main);">
                    <%= item.label_id %>
                  </td>
                  <td style="color: var(--text-secondary); font-size: 13px;">
                    <%= item.label_en || '-' %>
                  </td>
                  <td style="text-align: center;">
                    <% if (item.is_active) { %>
                      <span class="badge badge-success" style="font-size: 11px;">Aktif</span>
                    <% } else { %>
                      <span class="badge" style="font-size: 11px; background: #e2e8f0; color: #64748b;">Nonaktif</span>
                    <% } %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                      <button type="button" class="btn btn-secondary btn-sm" style="padding: 4px 8px;" title="Edit Statistik" onclick="openStatsModal(JSON.parse(decodeURIComponent(this.getAttribute('data-stat'))))" data-stat="<%= encodeURIComponent(JSON.stringify(item)) %>">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                      </button>
                      <button type="button" class="btn btn-danger btn-sm" style="padding: 4px 8px;" title="Hapus Statistik" onclick="confirmDeleteAboutItem(this.getAttribute('data-action'), this.getAttribute('data-title'))" data-action="/admin/about/stats/<%= item.id %>/delete" data-title="<%= item.stat_value %> - <%= item.label_id %>">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div style="text-align: center; padding: 2rem; border: 1px dashed var(--border-main); border-radius: var(--r-lg); color: var(--text-muted); font-size: 13px;">
          Belum ada data statistik ditambahkan. Klik tombol <strong>Tambah Statistik</strong> di atas untuk membuat item baru.
        </div>
      <% } %>
    </div>

    <!-- Card 3: Linimasa Jejak Langkah & Sejarah (Timeline) -->
    <div class="about-glass-card" style="margin-top: 1.5rem;">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span>Linimasa Jejak Langkah &amp; Milestone Sejarah</span>
          <span class="badge badge-primary" style="font-size: 11px;"><%= (timeline ? timeline.length : 0) %> Milestone</span>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" onclick="openTimelineModal()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Tambah Milestone</span>
        </button>
      </div>
      <p style="font-size: 13px; color: var(--text-muted); margin: -0.5rem 0 1.25rem 0;">
        Daftar linimasa perjalanan sejarah korporasi dari perintisan 1990 hingga era modern berkelanjutan.
      </p>

      <% if (timeline && timeline.length > 0) { %>
        <div style="overflow-x: auto; border: 1px solid var(--border-main); border-radius: var(--r-lg);">
          <table class="admin-table" style="width: 100%; margin-bottom: 0;">
            <thead>
              <tr>
                <th style="width: 70px; text-align: center;">Urutan</th>
                <th style="width: 180px;">Label Tahun / Era</th>
                <th>Judul Milestone (ID/EN)</th>
                <th>Deskripsi Singkat</th>
                <th style="width: 100px; text-align: center;">Status</th>
                <th style="width: 110px; text-align: right;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% timeline.forEach(function(item) { %>
                <tr>
                  <td style="text-align: center; font-weight: 600; color: var(--text-muted);">
                    <%= item.sort_order %>
                  </td>
                  <td>
                    <span style="font-weight: 700; color: var(--secondary); font-size: 13px; display: block;">
                      <%= item.year_label_id %>
                    </span>
                    <% if (item.year_label_en) { %>
                      <span style="font-size: 11.5px; color: var(--text-muted); font-style: italic;">
                        <%= item.year_label_en %>
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <div style="font-weight: 600; color: var(--text-main); font-size: 13.5px;">
                      <%= item.title_id %>
                    </div>
                    <% if (item.title_en) { %>
                      <div style="font-size: 12px; color: var(--text-muted);">
                        <%= item.title_en %>
                      </div>
                    <% } %>
                  </td>
                  <td style="color: var(--text-secondary); font-size: 12.5px; max-width: 280px; line-height: 1.5;">
                    <%= item.description_id || '-' %>
                  </td>
                  <td style="text-align: center;">
                    <% if (item.is_active) { %>
                      <span class="badge badge-success" style="font-size: 11px;">Aktif</span>
                    <% } else { %>
                      <span class="badge" style="font-size: 11px; background: #e2e8f0; color: #64748b;">Nonaktif</span>
                    <% } %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                      <button type="button" class="btn btn-secondary btn-sm" style="padding: 4px 8px;" title="Edit Milestone" onclick="openTimelineModal(JSON.parse(decodeURIComponent(this.getAttribute('data-timeline'))))" data-timeline="<%= encodeURIComponent(JSON.stringify(item)) %>">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                      </button>
                      <button type="button" class="btn btn-danger btn-sm" style="padding: 4px 8px;" title="Hapus Milestone" onclick="confirmDeleteAboutItem(this.getAttribute('data-action'), this.getAttribute('data-title'))" data-action="/admin/about/timeline/<%= item.id %>/delete" data-title="<%= item.year_label_id %>">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div style="text-align: center; padding: 2rem; border: 1px dashed var(--border-main); border-radius: var(--r-lg); color: var(--text-muted); font-size: 13px;">
          Belum ada milestone linimasa ditambahkan. Klik tombol <strong>Tambah Milestone</strong> di atas untuk membuat jejak langkah baru.
        </div>
      <% } %>
    </div>
  </div>

  <!-- TAB PANE 2: VISI, MISI & SLOGAN -->
  <div class="about-tab-pane" id="tab-visi-misi" role="tabpanel">
    <div class="about-glass-card">
      <div class="form-card-title">Visi &amp; Misi Korporasi</div>

      <!-- Visi -->
      <div class="form-row-2">
        <div class="form-group">
          <label for="vision_id" class="form-label">Visi Perusahaan (Indonesia) *</label>
          <textarea id="vision_id" name="vision_id" class="form-textarea" style="min-height: 85px;" required><%= about.vision_id || '' %></textarea>
          <div class="form-hint">Visi luhur yang mengarahkan komitmen masa depan.</div>
        </div>
        <div class="form-group">
          <label for="vision_en" class="form-label">Visi Perusahaan (English)</label>
          <textarea id="vision_en" name="vision_en" class="form-textarea" style="min-height: 85px;"><%= about.vision_en || '' %></textarea>
          <div class="form-hint">Corporate long-term vision in English.</div>
        </div>
      </div>

      <!-- Misi -->
      <div class="form-row-2">
        <div class="form-group">
          <label for="mission_id" class="form-label">Misi Perusahaan (Indonesia) *</label>
          <textarea id="mission_id" name="mission_id" class="form-textarea" style="min-height: 105px;" required><%= about.mission_id || '' %></textarea>
          <div class="form-hint">Ketik baris baru (Enter) untuk setiap butir misi.</div>
        </div>
        <div class="form-group">
          <label for="mission_en" class="form-label">Misi Perusahaan (English)</label>
          <textarea id="mission_en" name="mission_en" class="form-textarea" style="min-height: 105px;"><%= about.mission_en || '' %></textarea>
          <div class="form-hint">Separate each mission point with a new line.</div>
        </div>
      </div>
    </div>

    <!-- Card Foto Dokumentasi Visi & Misi (Media Library Picker) -->
    <div class="about-glass-card" style="margin-top: 1.5rem;">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Foto Ilustrasi &amp; Dokumentasi Visi Misi</span>
        <span class="badge badge-info" style="font-size: 11px;">Media Library</span>
      </div>
      <p style="font-size: 13px; color: var(--text-muted); margin: -0.5rem 0 1.25rem 0;">
        Foto dokumentasi fasilitas atau aktivitas produksi yang ditampilkan mendampingi kartu Visi dan Misi pada halaman publik.
      </p>

      <div class="form-row-2">
        <!-- Foto Visi -->
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label">Foto Ilustrasi Visi</label>
          <div class="media-picker-component">
            <input type="hidden" id="vision_image_url" name="vision_image_url" value="<%= (typeof visionMissionImages !== 'undefined' && visionMissionImages.vision_image_url) || '' %>">
            <div class="media-picker-preview-box">
              <img src="<%= (typeof visionMissionImages !== 'undefined' && visionMissionImages.vision_image_url) || '' %>" alt="Pratinjau Foto Visi" style="<%= (typeof visionMissionImages !== 'undefined' && visionMissionImages.vision_image_url) ? 'display: block;' : 'display: none;' %>">
              <div class="media-picker-empty" style="<%= (typeof visionMissionImages !== 'undefined' && visionMissionImages.vision_image_url) ? 'display: none;' : '' %>">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                <span>Belum ada foto visi dipilih</span>
              </div>
            </div>
            <div class="media-picker-ctrls">
              <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="vision_image_url" data-picker-type="image">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                Pilih Foto Visi
              </button>
              <button type="button" class="btn btn-ghost btn-sm btn-clear-media" style="<%= (typeof visionMissionImages !== 'undefined' && visionMissionImages.vision_image_url) ? '' : 'display: none;' %>">Hapus</button>
            </div>
          </div>
          <div class="form-hint">Muncul di samping kartu Visi (format WebP/JPG resolusi tinggi).</div>
        </div>

        <!-- Foto Misi -->
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label">Foto Ilustrasi Misi</label>
          <div class="media-picker-component">
            <input type="hidden" id="mission_image_url" name="mission_image_url" value="<%= (typeof visionMissionImages !== 'undefined' && visionMissionImages.mission_image_url) || '' %>">
            <div class="media-picker-preview-box">
              <img src="<%= (typeof visionMissionImages !== 'undefined' && visionMissionImages.mission_image_url) || '' %>" alt="Pratinjau Foto Misi" style="<%= (typeof visionMissionImages !== 'undefined' && visionMissionImages.mission_image_url) ? 'display: block;' : 'display: none;' %>">
              <div class="media-picker-empty" style="<%= (typeof visionMissionImages !== 'undefined' && visionMissionImages.mission_image_url) ? 'display: none;' : '' %>">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                <span>Belum ada foto misi dipilih</span>
              </div>
            </div>
            <div class="media-picker-ctrls">
              <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="mission_image_url" data-picker-type="image">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                Pilih Foto Misi
              </button>
              <button type="button" class="btn btn-ghost btn-sm btn-clear-media" style="<%= (typeof visionMissionImages !== 'undefined' && visionMissionImages.mission_image_url) ? '' : 'display: none;' %>">Hapus</button>
            </div>
          </div>
          <div class="form-hint">Muncul di samping kartu Misi (format WebP/JPG resolusi tinggi).</div>
        </div>
      </div>
    </div>

    <div class="about-glass-card">
      <div class="form-card-title">Slogan, Motto &amp; Target (Goal)</div>

      <!-- Slogan -->
      <div class="form-row-2">
        <div class="form-group">
          <label for="slogan_id" class="form-label">Slogan Korporat (Indonesia)</label>
          <input type="text" id="slogan_id" name="slogan_id" class="form-input" value="<%= about.slogan_id || '' %>">
        </div>
        <div class="form-group">
          <label for="slogan_en" class="form-label">Slogan Korporat (English)</label>
          <input type="text" id="slogan_en" name="slogan_en" class="form-input" value="<%= about.slogan_en || '' %>">
        </div>
      </div>

      <!-- Motto & Goal -->
      <div class="form-row-2">
        <div class="form-group">
          <label for="motto_id" class="form-label">Motto Kerja (Indonesia)</label>
          <textarea id="motto_id" name="motto_id" class="form-textarea" style="min-height: 80px;"><%= about.motto_id || '' %></textarea>
        </div>
        <div class="form-group">
          <label for="goal_id" class="form-label">Target / Tujuan (Goal)</label>
          <textarea id="goal_id" name="goal_id" class="form-textarea" style="min-height: 80px;"><%= about.goal_id || '' %></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB PANE 3: NILAI T-I-C-K-E-T -->
  <div class="about-tab-pane" id="tab-ticket" role="tabpanel">
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Nilai Budaya Kerja: T - I - C - K - E - T</span>
        <span class="badge badge-primary" style="font-size: 11px;">6 Pilar Utama</span>
      </div>
      <p style="font-size: 13px; color: var(--text-muted); margin: -0.5rem 0 1.25rem 0;">
        Nilai fundamental yang menjadi pedoman perilaku seluruh staf PT Euodoo sesuai Company Profile resmi.
      </p>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% const actualLetters = ['T', 'I', 'C', 'K', 'E', 'T']; %>
        <% (about.values || []).forEach(function(val, idx) { %>
          <% const formKey = idx === 5 ? 'T_2' : val.letter; %>
          <div style="background: #ffffff; border: 1px solid var(--border-main); border-radius: var(--r-lg); padding: 1.25rem; box-shadow: var(--shadow-xs);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 0.85rem;">
              <span style="font-size: 14px; width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: 800; background: var(--primary); color: #ffffff;">
                <%= val.letter %>
              </span>
              <div>
                <strong style="color: var(--secondary); font-size: 14px;">Pilar Huruf <%= val.letter %> (<%= idx === 5 ? 'Pilar Ke-6' : 'Pilar Ke-' + (idx + 1) %>)</strong>
              </div>
            </div>

            <div class="form-row-2" style="margin-bottom: 0.75rem;">
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Nama Nilai (ID)</label>
                <input type="text" name="val_title_id_<%= formKey %>" class="form-input" value="<%= val.title_id %>">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Nama Nilai (EN)</label>
                <input type="text" name="val_title_en_<%= formKey %>" class="form-input" value="<%= val.title_en %>">
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Penjelasan / Makna (ID)</label>
                <textarea name="val_desc_id_<%= formKey %>" class="form-textarea" style="min-height: 60px; font-size: 12.5px;"><%= val.desc_id %></textarea>
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Penjelasan / Makna (EN)</label>
                <textarea name="val_desc_en_<%= formKey %>" class="form-textarea" style="min-height: 60px; font-size: 12.5px;"><%= val.desc_en %></textarea>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- TAB PANE 4: SERTIFIKASI & LINGKUNGAN -->
  <div class="about-tab-pane" id="tab-sertifikasi" role="tabpanel">
    <!-- Eco Statement -->
    <div class="about-glass-card">
      <div class="form-card-title">Komitmen Pelestarian Lingkungan Hidup</div>

      <div class="form-row-2">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="eco_statement_id" class="form-label">Pernyataan Komitmen Lingkungan (ID)</label>
          <textarea id="eco_statement_id" name="eco_statement_id" class="form-textarea" style="min-height: 75px;"><%= about.eco_statement_id || '' %></textarea>
          <div class="form-hint">Mari selamatkan bumi kita! Produk 100% degradable.</div>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="eco_statement_en" class="form-label">Pernyataan Komitmen Lingkungan (EN)</label>
          <textarea id="eco_statement_en" name="eco_statement_en" class="form-textarea" style="min-height: 75px;"><%= about.eco_statement_en || '' %></textarea>
          <div class="form-hint">Let's save our earth! 100% degradable commitment.</div>
        </div>
      </div>
    </div>

    <!-- Daftar Sertifikasi Resmi -->
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Daftar Sertifikasi Resmi Standar Mutu</span>
        <span class="badge badge-info" style="font-size: 11px;">SNI, OXIUM, InSWA</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% (about.certifications || []).forEach(function(cert, idx) { %>
          <div style="background: #ffffff; border: 1px solid var(--border-main); border-radius: var(--r-lg); padding: 1.25rem; box-shadow: var(--shadow-xs);">
            <div class="form-row-3" style="margin-bottom: 0.75rem;">
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Nama Sertifikasi</label>
                <input type="text" name="cert_name_<%= idx %>" class="form-input" value="<%= cert.name %>">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Penerbit / Asosiasi</label>
                <input type="text" name="cert_issuer_<%= idx %>" class="form-input" value="<%= cert.issuer %>">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Label / Badge</label>
                <input type="text" name="cert_badge_<%= idx %>" class="form-input" value="<%= cert.badge %>">
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Keterangan Standar (ID)</label>
                <input type="text" name="cert_desc_id_<%= idx %>" class="form-input" value="<%= cert.desc_id %>">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Keterangan Standar (EN)</label>
                <input type="text" name="cert_desc_en_<%= idx %>" class="form-input" value="<%= cert.desc_en %>">
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- TAB PANE 5: GALERI FASILITAS (T-116) -->
  <div class="about-tab-pane" id="tab-gallery" role="tabpanel">
    <!-- Card 1: Header Section Galeri Publik -->
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Header &amp; Pengantar Section Galeri</span>
        <span class="badge badge-info" style="font-size: 11px;">Tampilan Publik</span>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="about_gallery_kicker_id" class="form-label">Label Kicker Galeri (Indonesia)</label>
          <input type="text" id="about_gallery_kicker_id" name="about_gallery_kicker_id" class="form-input" value="<%= (typeof galleryHeader !== 'undefined' && galleryHeader.kicker_id) || '' %>" placeholder="Galeri Kami">
          <div class="form-hint">Label kecil di atas judul galeri (contoh: Galeri Kami).</div>
        </div>
        <div class="form-group">
          <label for="about_gallery_kicker_en" class="form-label">Label Kicker Galeri (English)</label>
          <input type="text" id="about_gallery_kicker_en" name="about_gallery_kicker_en" class="form-input" value="<%= (typeof galleryHeader !== 'undefined' && galleryHeader.kicker_en) || '' %>" placeholder="Our Gallery">
          <div class="form-hint">English kicker label (e.g. Our Gallery).</div>
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="about_gallery_title_id" class="form-label">Judul Utama Galeri (Indonesia)</label>
          <input type="text" id="about_gallery_title_id" name="about_gallery_title_id" class="form-input" value="<%= (typeof galleryHeader !== 'undefined' && galleryHeader.title_id) || '' %>" placeholder="Di Dalam Operasional Kami">
        </div>
        <div class="form-group">
          <label for="about_gallery_title_en" class="form-label">Judul Utama Galeri (English)</label>
          <input type="text" id="about_gallery_title_en" name="about_gallery_title_en" class="form-input" value="<%= (typeof galleryHeader !== 'undefined' && galleryHeader.title_en) || '' %>" placeholder="Inside Our Operations">
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label for="about_gallery_body_id" class="form-label">Deskripsi Pengantar Galeri (Indonesia)</label>
        <textarea id="about_gallery_body_id" name="about_gallery_body_id" class="form-textarea" style="min-height: 75px;" placeholder="Sepintas aktivitas produksi, lini ekstrusi film mutakhir..."><%= (typeof galleryHeader !== 'undefined' && galleryHeader.body_id) || '' %></textarea>
      </div>

      <div class="form-group" style="margin-top: 1rem; margin-bottom: 0;">
        <label for="about_gallery_body_en" class="form-label">Deskripsi Pengantar Galeri (English)</label>
        <textarea id="about_gallery_body_en" name="about_gallery_body_en" class="form-textarea" style="min-height: 75px;" placeholder="A glimpse of our daily manufacturing, modern blown film extrusion..."><%= (typeof galleryHeader !== 'undefined' && galleryHeader.body_en) || '' %></textarea>
      </div>
    </div>

    <!-- Card 2: Daftar Slide Galeri Fasilitas -->
    <div class="about-glass-card" style="margin-top: 1.5rem;">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span>Daftar Slide Galeri Fasilitas</span>
          <span class="badge badge-primary" style="font-size: 11px;">
            <%= (gallerySlides ? gallerySlides.length : 0) %> Slide
          </span>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" onclick="openGalleryModal()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Tambah Slide Galeri</span>
        </button>
      </div>
      <p style="font-size: 13px; color: var(--text-muted); margin: -0.5rem 0 1.25rem 0;">
        Kelola slide gambar fasilitas manufaktur dan teknologi pabrik yang tampil pada slider interaktif halaman Tentang Kami.
      </p>

      <% if (gallerySlides && gallerySlides.length > 0) { %>
        <div style="overflow-x: auto; border: 1px solid var(--border-main); border-radius: var(--r-lg);">
          <table class="admin-table" style="width: 100%; margin-bottom: 0;">
            <thead>
              <tr>
                <th style="width: 65px; text-align: center;">Urutan</th>
                <th style="width: 90px; text-align: center;">Pratinjau</th>
                <th style="width: 160px;">Kategori / Tag</th>
                <th>Judul &amp; Subjudul Slide (ID/EN)</th>
                <th style="width: 95px; text-align: center;">Status</th>
                <th style="width: 110px; text-align: right;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% gallerySlides.forEach(function(slide) { %>
                <tr>
                  <td style="text-align: center; font-weight: 600; color: var(--text-muted);">
                    <%= slide.sort_order %>
                  </td>
                  <td style="text-align: center;">
                    <div style="width: 72px; height: 48px; border-radius: var(--r-sm); overflow: hidden; background: #e2e8f0; border: 1px solid var(--border-main); display: inline-flex; align-items: center; justify-content: center;">
                      <% if (slide.image_url) { %>
                        <img src="<%= slide.image_url %>" alt="<%= slide.title_id %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/hero-factory.jpg'">
                      <% } else { %>
                        <span style="font-size: 10px; color: var(--text-muted);">No image</span>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <% if (slide.category_id) { %>
                      <span class="badge badge-info" style="font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;">
                        <%= slide.category_id %>
                      </span>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 12px;">-</span>
                    <% } %>
                    <% if (slide.category_en) { %>
                      <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                        <%= slide.category_en %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <div style="font-weight: 700; color: var(--text-main); font-size: 13.5px; margin-bottom: 2px;">
                      <%= slide.title_id %>
                    </div>
                    <% if (slide.title_en) { %>
                      <div style="font-size: 12px; color: var(--secondary); font-weight: 500;">
                        <%= slide.title_en %>
                      </div>
                    <% } %>
                    <% if (slide.subtitle_id) { %>
                      <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px; line-height: 1.4; max-width: 380px;">
                        <%= slide.subtitle_id %>
                      </div>
                    <% } %>
                  </td>
                  <td style="text-align: center;">
                    <% if (slide.is_active) { %>
                      <span class="badge badge-success" style="font-size: 11px;">Aktif</span>
                    <% } else { %>
                      <span class="badge" style="font-size: 11px; background: #e2e8f0; color: #64748b;">Nonaktif</span>
                    <% } %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                      <button type="button" class="btn btn-secondary btn-sm" style="padding: 4px 8px;" title="Edit Slide" onclick="openGalleryModal(JSON.parse(decodeURIComponent(this.getAttribute('data-slide'))))" data-slide="<%= encodeURIComponent(JSON.stringify(slide)) %>">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                      </button>
                      <button type="button" class="btn btn-danger btn-sm" style="padding: 4px 8px;" title="Hapus Slide" onclick="confirmDeleteAboutItem(this.getAttribute('data-action'), this.getAttribute('data-title'))" data-action="/admin/about/gallery/<%= slide.id %>/delete" data-title="<%= slide.title_id %>">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div style="text-align: center; padding: 2rem; border: 1px dashed var(--border-main); border-radius: var(--r-lg); color: var(--text-muted); font-size: 13px;">
          Belum ada slide galeri ditambahkan. Klik tombol <strong>Tambah Slide Galeri</strong> di atas untuk menambahkan slide baru.
        </div>
      <% } %>
    </div>
  </div>

  <!-- Sticky Actions Bar -->
  <div class="about-sticky-actions">
    <div class="actions-left" style="display: flex; align-items: center; gap: 8px;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
      <span style="font-size: 13px; color: var(--text-muted); font-weight: 500;">
        Semua tab tersimpan dalam satu klik.
      </span>
    </div>
    <div class="actions-right" style="display: flex; align-items: center; gap: 10px;">
      <a href="/admin/dashboard" class="btn btn-secondary">
        Batal
      </a>
      <button type="submit" class="btn btn-primary" style="min-width: 220px;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
        <span>Simpan Perubahan</span>
      </button>
    </div>
  </div>
</form>

<!-- Form Delete Global untuk Item Galeri, Statistik, dan Timeline -->
<form id="genericDeleteForm" method="POST" style="display: none;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>

<!-- Modal 1: Tambah / Edit Slide Galeri (T-116) -->
<div class="admin-modal-backdrop" id="galleryModal">
  <div class="admin-modal-card" style="max-width: 680px;">
    <div class="admin-modal-header">
      <div class="admin-modal-title" id="galleryModalTitle">Tambah Slide Galeri Baru</div>
      <button type="button" class="modal-close-btn admin-modal-close" onclick="closeAdminModal('galleryModal')" aria-label="Tutup Dialog">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <form id="galleryForm" method="POST" action="/admin/about/gallery">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" id="gallery_slide_id" name="slide_id" value="">

      <div class="admin-modal-body" style="display: flex; flex-direction: column; gap: 1.15rem;">
        <!-- Gambar Slide via Media Library Picker -->
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label">Foto / Gambar Slide *</label>
          <div class="media-picker-component">
            <input type="hidden" id="gallery_image_url" name="image_url" value="" required>
            <div class="media-picker-preview-box" style="height: 160px;">
              <img id="gallery_preview_img" src="" alt="Pratinjau Slide" style="display: none; height: 100%; width: 100%; object-fit: cover;">
              <div class="media-picker-empty" id="gallery_preview_empty">
                <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                <span>Pilih gambar dari Media Library</span>
              </div>
            </div>
            <div class="media-picker-ctrls">
              <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="gallery_image_url" data-picker-type="image">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                Pilih dari Media Library
              </button>
              <button type="button" class="btn btn-ghost btn-sm btn-clear-media" id="gallery_btn_clear" style="display: none;">Hapus Gambar</button>
            </div>
          </div>
          <div class="form-hint">Disarankan rasio landscape 16:9 atau 4:3 (minimal 1200x800px).</div>
        </div>

        <!-- Kategori / Tag Badge -->
        <div class="form-row-2">
          <div class="form-group" style="margin-bottom: 0;">
            <label for="gallery_category_id" class="form-label">Kategori / Tag (Indonesia)</label>
            <input type="text" id="gallery_category_id" name="category_id" class="form-input" placeholder="contoh: TEKNOLOGI EKSTRUSI">
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label for="gallery_category_en" class="form-label">Kategori / Tag (English)</label>
            <input type="text" id="gallery_category_en" name="category_en" class="form-input" placeholder="contoh: EXTRUSION TECHNOLOGY">
          </div>
        </div>

        <!-- Judul Slide -->
        <div class="form-row-2">

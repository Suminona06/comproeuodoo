<%- include('../../partials/admin-header') %>
<link rel="stylesheet" href="/css/admin-tinymce.css">

<div class="content-header">
  <div class="content-title-text">
    <h1>Edit Artikel: <%= post.title_id %></h1>
    <p>Perbarui konten berita, tanggal jadwal rilis, atau foto sampul.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/posts" class="btn btn-secondary">&larr; Kembali ke Daftar</a>
  </div>
</div>

<form action="/admin/posts/<%= post.id %>?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
  <!-- Card 1: Pengaturan Artikel -->
  <div class="form-card">
    <div class="form-card-title">1. Kategori &amp; Jadwal Publikasi</div>

    <div class="form-row-3">
      <div class="form-group">
        <label class="form-label" for="type">Tipe Konten *</label>
        <select id="type" name="type" class="form-select" required>
          <option value="berita" <%= post.type === 'berita' ? 'selected' : '' %>>Berita Perusahaan &amp; CSR</option>
          <option value="pers" <%= post.type === 'pers' ? 'selected' : '' %>>Siaran Pers Resmi</option>
          <option value="blog" <%= post.type === 'blog' ? 'selected' : '' %>>Blog &amp; Edukasi Industri</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="category_id">Kategori Artikel</label>
        <select id="category_id" name="category_id" class="form-select">
          <option value="">Pilih Kategori...</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>" <%= post.category_id === cat.id ? 'selected' : '' %>><%= cat.name_id %> (<%= cat.type %>)</option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="status">Status</label>
        <select id="status" name="status" class="form-select" onchange="toggleScheduled(this.value)">
          <option value="published" <%= post.status === 'published' ? 'selected' : '' %>>Published (Tayang)</option>
          <option value="draft" <%= post.status === 'draft' ? 'selected' : '' %>>Draft (Draf)</option>
          <option value="scheduled" <%= post.status === 'scheduled' ? 'selected' : '' %>>Scheduled (Terjadwal)</option>
        </select>
      </div>
    </div>

    <div class="form-row-2" id="scheduledRow" <%- post.status === 'scheduled' ? 'style="display: grid;"' : 'style="display: none;"' %>>
      <div class="form-group">
        <label class="form-label" for="scheduled_at">Tanggal &amp; Waktu Terjadwal</label>
        <%
          let scheduleFormatted = '';
          if (post.scheduled_at) {
            const d = new Date(post.scheduled_at);
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
            scheduleFormatted = d.toISOString().slice(0, 16);
          }
        %>
        <input type="datetime-local" id="scheduled_at" name="scheduled_at" class="form-input" value="<%= scheduleFormatted %>">
      </div>
    </div>

    <div class="form-group">
      <label class="form-check">
        <input type="checkbox" name="is_headline" value="1" <%= post.is_headline ? 'checked' : '' %>>
        <span>Tampilkan sebagai Berita Utama (Top Headline Slider)</span>
      </label>
    </div>
  </div>

  <!-- Card 2: Judul & Konten -->
  <div class="form-card">
    <div class="form-card-title">2. Judul &amp; Isi Artikel</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="title_id">Judul Artikel (Bahasa Indonesia) *</label>
        <input type="text" id="title_id" name="title_id" class="form-input" required value="<%= post.title_id %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="title_en">Judul Artikel (English)</label>
        <input type="text" id="title_en" name="title_en" class="form-input" value="<%= post.title_en || '' %>">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="slug">URL Slug Kustom *</label>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 13px; color: var(--text-muted, #64748b); background: #f1f5f9; padding: 7px 12px; border: 1px solid var(--border-color, #cbd5e1); border-radius: 6px; font-family: monospace;">/news/</span>
        <input type="text" id="slug" name="slug" class="form-input" style="flex: 1;" pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$" required value="<%= post.slug %>">
      </div>
      <div class="form-hint" style="font-size: 11.5px; margin-top: 4px;">Jika slug diubah, sistem otomatis membuat redirect permanen 301 dari slug lama ke slug baru untuk menjaga SEO.</div>
    </div>

    <div class="form-group">
      <label class="form-label">Foto Sampul Utama (Media Library)</label>
      <div class="media-picker-component">
        <input type="hidden" id="post_image_url" name="image_url" value="<%= post.display_image || '' %>">
        <div class="media-picker-preview-box">
          <img src="<%= post.display_image || '' %>" alt="Pratinjau Sampul" style="<%= post.display_image ? 'display: block;' : 'display: none;' %>">
          <div class="media-picker-empty" style="<%= post.display_image ? 'display: none;' : '' %>">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Belum ada foto sampul dipilih</span>
          </div>
        </div>
        <div class="media-picker-ctrls">
          <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="post_image_url" data-picker-type="image">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            Pilih dari Media Library
          </button>
          <button type="button" class="btn btn-ghost btn-sm btn-clear-media" style="<%= post.display_image ? '' : 'display: none;' %>">Hapus</button>
        </div>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="content_id">Isi Artikel (Bahasa Indonesia) *</label>
      <textarea id="content_id" name="content_id" class="form-textarea" style="min-height: 200px;"><%= post.content_id || '' %></textarea>
    </div>

    <div class="form-group">
      <label class="form-label" for="content_en">Isi Artikel (English)</label>
      <textarea id="content_en" name="content_en" class="form-textarea" style="min-height: 150px;"><%= post.content_en || '' %></textarea>
    </div>
  </div>

  <!-- Card 3: SEO Meta -->
  <div class="form-card">
    <div class="form-card-title">3. Pengaturan SEO &amp; Open Graph</div>
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="meta_title_id">Meta Title (ID)</label>
        <input type="text" id="meta_title_id" name="meta_title_id" class="form-input" value="<%= post.meta_title_id || '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="meta_title_en">Meta Title (EN)</label>
        <input type="text" id="meta_title_en" name="meta_title_en" class="form-input" value="<%= post.meta_title_en || '' %>">
      </div>
    </div>
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="meta_desc_id">Meta Description (ID)</label>
        <textarea id="meta_desc_id" name="meta_desc_id" class="form-textarea"><%= post.meta_desc_id || '' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="meta_desc_en">Meta Description (EN)</label>
        <textarea id="meta_desc_en" name="meta_desc_en" class="form-textarea"><%= post.meta_desc_en || '' %></textarea>
      </div>
    </div>
  </div>

  <div class="form-actions-bar" style="margin-bottom: 2rem;">
    <a href="/admin/posts" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary" style="padding: 8px 20px; font-size: 13px;">Simpan Perubahan</button>
  </div>
</form>

<script>
  function toggleScheduled(val) {
    const row = document.getElementById('scheduledRow');
    if (val === 'scheduled') {
      row.style.display = 'grid';
    } else {
      row.style.display = 'none';
    }
  }
</script>

<script src="/tinymce/tinymce.min.js"></script>
<script src="/js/admin-editor.js"></script>

<%- include('../../partials/admin-footer') %>

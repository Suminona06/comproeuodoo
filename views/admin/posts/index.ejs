<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Manajemen Berita, Siaran Pers &amp; Blog</h1>
    <p>Kelola publikasi korporasi, berita CSR, siaran pers resmi, dan artikel blog edukasi kemasan.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/post-categories" class="adm-btn adm-btn-secondary" aria-label="Buka daftar kategori berita">
      <svg class="adm-btn-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
      <span>Kategori</span>
    </a>
    <a href="/admin/posts/create" class="adm-btn adm-btn-primary" aria-label="Tulis artikel berita baru">
      <svg class="adm-btn-icon adm-btn-icon-plus" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <span>Tambah</span>
    </a>
  </div>
</div>

<div class="table-card">
  <div class="table-toolbar">
    <div class="filter-tabs-wrap">
      <a href="/admin/posts" class="tab-btn <%= !currentType ? 'active' : '' %>">Semua Tipe</a>
      <a href="/admin/posts?type=berita" class="tab-btn <%= currentType === 'berita' ? 'active' : '' %>">Berita Perusahaan</a>
      <a href="/admin/posts?type=pers" class="tab-btn <%= currentType === 'pers' ? 'active' : '' %>">Siaran Pers</a>
      <a href="/admin/posts?type=blog" class="tab-btn <%= currentType === 'blog' ? 'active' : '' %>">Blog Industri</a>
    </div>

    <div class="search-input-wrap">
      <svg class="search-icon-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="liveSearchInput" placeholder="Cari judul artikel..." aria-label="Cari artikel">
    </div>
  </div>

  <div class="table-scroll-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width: 70px;">Cover</th>
          <th>Judul Artikel</th>
          <th>Tipe &amp; Kategori</th>
          <th style="width: 90px; text-align: center;">Headline</th>
          <th>Waktu Publikasi</th>
          <th style="width: 100px;">Status</th>
          <th style="text-align: right; width: 120px;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (posts && posts.length > 0) { %>
          <% posts.forEach(function(post) { %>
            <tr>
              <td>
                <div style="width: 54px; height: 38px; background: #fafbfc; border: 1px solid var(--border-main); border-radius: var(--r-sm); overflow: hidden; display: flex; align-items: center; justify-content: center;">
                  <% if (post.display_image) { %>
                    <img src="<%= post.display_image %>" alt="<%= post.title_id %>" style="width: 100%; height: 100%; object-fit: cover;">
                  <% } else { %>
                    <span style="font-size: 10px; color: var(--text-tertiary); font-weight: 700;">NO PIC</span>
                  <% } %>
                </div>
              </td>
              <td>
                <div class="td-client-title"><%= post.title_id %></div>
                <div class="adm-slug-text" title="<%= post.slug %>"><%= post.slug %></div>
              </td>
              <td>
                <span class="badge-role <%= post.type === 'berita' ? 'admin' : (post.type === 'pers' ? 'superadmin' : 'editor') %>" style="font-size: 11px;">
                  <%= (post.type || 'berita').toUpperCase() %>
                </span>
                <% if (post.category_name_id) { %>
                  <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                    <%= post.category_name_id %>
                  </div>
                <% } %>
              </td>
              <td style="text-align: center;">
                <% if (post.is_headline) { %>
                  <span class="badge-status badge-status--primary">Top Slider</span>
                <% } else { %>
                  <span style="color: var(--text-tertiary); font-size: 12px;">-</span>
                <% } %>
              </td>
              <td>
                <div style="font-size: 12px; color: var(--text-main);">
                  <%= new Date(post.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </div>
                <% if (post.status === 'scheduled' && post.scheduled_at) { %>
                  <div style="font-size: 10.5px; color: #b45309; font-weight: 600;">
                    Jadwal: <%= new Date(post.scheduled_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %>
                  </div>
                <% } %>
              </td>
              <td>
                <span class="badge-status <%= post.status === 'published' ? 'badge-status--success' : (post.status === 'scheduled' ? 'badge-status--warning' : 'badge-status--neutral') %>">
                  <%= post.status === 'published' ? 'Published' : (post.status === 'scheduled' ? 'Terjadwal' : 'Draft') %>
                </span>
              </td>
              <td style="text-align: right;">
                <div class="table-actions">
                  <a href="/admin/posts/<%= post.id %>/edit" class="btn-action btn-action-edit" title="Edit Berita">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    <span>Edit</span>
                  </a>
                  <form action="/admin/posts/<%= post.id %>/delete?_csrf=<%= csrfToken %>" method="POST" data-confirm-delete="true" data-confirm-message="Hapus artikel ini secara permanen?" data-confirm-title="Hapus Artikel">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-action btn-action-delete" title="Hapus Berita">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      <span>Hapus</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
              Tidak ada artikel yang sesuai dengan filter.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/admin-footer') %>

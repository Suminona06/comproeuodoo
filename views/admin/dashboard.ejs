<%- include('../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Ringkasan Operasional CMS</h1>
    <p>Pantau metrik harian, kelola antrean inquiry RFQ, dan tinjau status portal perusahaan.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/inquiries/export" class="btn btn-secondary">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span>Ekspor CSV</span>
    </a>
    <% if (typeof user !== 'undefined' && user && ['superadmin', 'admin'].includes(user.role)) { %>
      <a href="/admin/products/create" class="btn btn-primary">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span>Tambah Produk</span>
      </a>
    <% } %>
  </div>
</div>

<!-- 1. Key Metrics Cards -->
<section class="metrics-row" aria-label="Metrik Utama">
  <div class="metric-box">
    <span class="metric-label-txt">Inquiry RFQ Baru</span>
    <span class="metric-num-txt" id="heroPendingCount"><%= stats.pendingLeads %></span>
    <% if (stats.pendingLeads > 0) { %>
      <span class="metric-meta-txt highlight"><%= stats.pendingLeads %> permintaan butuh respon</span>
    <% } else { %>
      <span class="metric-meta-txt">Semua telah ditindaklanjuti</span>
    <% } %>
  </div>

  <div class="metric-box">
    <span class="metric-label-txt">Katalog Produk Aktif</span>
    <span class="metric-num-txt"><%= stats.activeProducts %></span>
    <span class="metric-meta-txt"><%= stats.activeBrandsCount %> merek terdaftar aktif</span>
  </div>

  <div class="metric-box">
    <span class="metric-label-txt">Publikasi Konten</span>
    <span class="metric-num-txt"><%= stats.publishedPosts %></span>
    <span class="metric-meta-txt">Artikel berita &amp; blog aktif</span>
  </div>

  <div class="metric-box">
    <span class="metric-label-txt">Banner Hero Aktif</span>
    <span class="metric-num-txt"><%= stats.activeBanners %></span>
    <span class="metric-meta-txt">Slider beranda publik</span>
  </div>
</section>

<!-- 2. RFQ / Inquiry Table -->
<section class="table-card" id="tableSection">
  <div class="table-toolbar">
    <h2 class="toolbar-title">Permintaan Penawaran Terkini (RFQ)</h2>

    <div class="toolbar-right-tools">
      <div class="filter-tabs-wrap" role="group" aria-label="Filter status">
        <button type="button" class="tab-btn active" data-filter="all">Semua</button>
        <button type="button" class="tab-btn" data-filter="baru">Baru</button>
        <button type="button" class="tab-btn" data-filter="dibaca">Dibaca</button>
        <button type="button" class="tab-btn" data-filter="ditindaklanjuti">Selesai</button>
      </div>

      <div class="search-input-wrap">
        <svg class="search-icon-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="liveSearchInput" placeholder="Cari nama, perusahaan..." aria-label="Cari data">
      </div>
    </div>
  </div>

  <div class="table-scroll-wrapper">
    <table class="data-table" id="rfqDataTable">
      <thead>
        <tr>
          <th style="width: 100px;">Waktu</th>
          <th>Klien / Perusahaan</th>
          <th>Kontak</th>
          <th>Kebutuhan / Produk</th>
          <th style="width: 140px;">Status</th>
          <th style="width: 80px; text-align: right;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof recentInquiries !== 'undefined' && recentInquiries.length > 0) { %>
          <% recentInquiries.forEach(function(item) { %>
            <tr data-status="<%= item.status %>" id="row-<%= item.id %>">
              <td>
                <span style="font-weight: 600; color: var(--text-main);">
                  <%= new Date(item.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %>
                </span>
                <div style="font-size: 11px; color: var(--text-tertiary);">
                  <%= new Date(item.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %>
                </div>
              </td>
              <td>
                <div class="td-client-title"><%= item.company || '-' %></div>
                <div class="td-client-sub"><%= item.name %></div>
              </td>
              <td>
                <div style="font-size: 12px; color: var(--text-main);"><%= item.phone %></div>
                <div class="td-muted-text"><%= item.email %></div>
              </td>
              <td>
                <div class="td-req-text" title="<%= item.message || '' %>">
                  <% if (item.product_name_id) { %>
                    <strong><%= item.product_name_id %></strong> &bull;
                  <% } %>
                  <%= item.message ? item.message.substring(0, 60) + '...' : 'Tidak ada rincian' %>
                </div>
              </td>
              <td>
                <select class="status-select st-<%= item.status === 'ditindaklanjuti' ? 'selesai' : (item.status === 'dibaca' ? 'diproses' : item.status) %>"
                        onchange="updateInquiryStatus(<%= item.id %>, this.value)" aria-label="Ubah status">
                  <option value="baru" <%= item.status === 'baru' ? 'selected' : '' %>>Baru</option>
                  <option value="dibaca" <%= item.status === 'dibaca' ? 'selected' : '' %>>Dibaca</option>
                  <option value="ditindaklanjuti" <%= item.status === 'ditindaklanjuti' ? 'selected' : '' %>>Selesai</option>
                  <option value="ditolak" <%= item.status === 'ditolak' ? 'selected' : '' %>>Ditolak</option>
                </select>
              </td>
              <td style="text-align: right;">
                <button type="button" class="btn-action-view" onclick="viewInquiryDetail(<%= JSON.stringify(item).replace(/"/g, '&quot;') %>)">
                  Tinjau
                </button>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">
              Belum ada permintaan penawaran masuk saat ini.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div class="table-footer">
    <span>Menampilkan <%= recentInquiries.length %> data inquiry terkini</span>
    <a href="/admin/inquiries" style="font-weight: 600; color: var(--primary);">Lihat Seluruh Inquiry &rarr;</a>
  </div>
</section>

<!-- Detail Slide-Over Modal / Card -->
<div class="admin-modal-backdrop" id="inquiryDetailModal">
  <div class="admin-modal-card">
    <div class="admin-modal-header">
      <div class="admin-modal-title">
        <svg width="18" height="18" fill="none" stroke="var(--primary)" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        <span>Detail Permintaan Penawaran RFQ</span>
      </div>
      <button type="button" class="admin-modal-close" onclick="closeAdminModal('inquiryDetailModal')">&times;</button>
    </div>
    <div class="admin-modal-body">
      <div style="background: #fafbfc; border: 1px solid var(--border-main); border-radius: var(--r-md); padding: 1rem;">
        <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--text-muted); margin-bottom: 4px;">Informasi Klien</div>
        <div id="modalClientCompany" style="font-size: 15px; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">-</div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 12.5px;">
          <div><span style="color: var(--text-muted);">PIC:</span> <strong id="modalClientName">-</strong></div>
          <div><span style="color: var(--text-muted);">Telepon:</span> <strong id="modalClientPhone">-</strong></div>
          <div><span style="color: var(--text-muted);">Email:</span> <span id="modalClientEmail">-</span></div>
          <div><span style="color: var(--text-muted);">Produk:</span> <span id="modalClientProduct">-</span></div>
        </div>
      </div>

      <div>
        <label class="form-label">Rincian Kebutuhan / Pesan Konsultasi:</label>
        <div id="modalClientMessage" style="background: var(--bg-surface); border: 1px solid var(--border-main); border-left: 3px solid var(--primary); border-radius: var(--r-sm); padding: 10px; font-size: 12.5px; line-height: 1.6; color: var(--text-secondary); max-height: 140px; overflow-y: auto;">
          -
        </div>
      </div>

      <form id="modalNotesForm" onsubmit="saveInquiryNotes(event)">
        <input type="hidden" id="modalInquiryId" name="inquiryId">
        <div class="form-group">
          <label class="form-label" for="modalAdminNotes">Catatan Internal Sales / Admin:</label>
          <textarea id="modalAdminNotes" class="form-textarea" placeholder="Tuliskan catatan tindak lanjut, kesepakatan harga, atau jadwal meeting dengan klien..."></textarea>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px;">
          <button type="button" class="btn btn-secondary btn-sm" onclick="closeAdminModal('inquiryDetailModal')">Tutup</button>
          <button type="submit" class="btn btn-primary btn-sm">Simpan Catatan</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function viewInquiryDetail(item) {
    document.getElementById('modalInquiryId').value = item.id;
    document.getElementById('modalClientCompany').textContent = item.company || 'Pribadi / Retail';
    document.getElementById('modalClientName').textContent = item.name;
    document.getElementById('modalClientPhone').textContent = item.phone;
    document.getElementById('modalClientEmail').textContent = item.email;
    document.getElementById('modalClientProduct').textContent = item.product_name_id || 'Umum (Katalog)';
    document.getElementById('modalClientMessage').textContent = item.message || 'Tidak ada pesan tertulis.';
    document.getElementById('modalAdminNotes').value = item.admin_notes || '';
    openAdminModal('inquiryDetailModal');
  }

  async function updateInquiryStatus(id, newStatus) {
    try {
      const res = await fetch('/admin/inquiries/' + id + '/status', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ status: newStatus })
      });
      const data = await res.json();
      if (data.success) {
        showToast('Status inquiry #' + id + ' berhasil diperbarui ke: ' + newStatus);
        const row = document.getElementById('row-' + id);
        if (row) {
          row.setAttribute('data-status', newStatus);
          const sel = row.querySelector('.status-select');
          if (sel) {
            sel.className = 'status-select st-' + (newStatus === 'ditindaklanjuti' ? 'selesai' : (newStatus === 'dibaca' ? 'diproses' : newStatus));
          }
        }
      } else {
        alert(data.message || 'Gagal mengubah status.');
      }
    } catch (err) {
      console.error(err);
      alert('Terjadi kesalahan jaringan.');
    }
  }

  async function saveInquiryNotes(e) {
    e.preventDefault();
    const id = document.getElementById('modalInquiryId').value;
    const notes = document.getElementById('modalAdminNotes').value;

    try {
      const res = await fetch('/admin/inquiries/' + id + '/status', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ admin_notes: notes })
      });
      const data = await res.json();
      if (data.success) {
        showToast('Catatan admin berhasil disimpan!');
        closeAdminModal('inquiryDetailModal');
      } else {
        alert(data.message || 'Gagal menyimpan catatan.');
      }
    } catch (err) {
      console.error(err);
      alert('Gagal menyimpan catatan.');
    }
  }
</script>

<%- include('../partials/admin-footer') %>

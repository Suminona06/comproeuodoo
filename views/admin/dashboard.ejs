<%- include('../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Ringkasan Operasional CMS</h1>
    <p>Pantau metrik harian, kelola antrean inquiry RFQ, dan tinjau status portal perusahaan.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/inquiries/export" class="adm-btn adm-btn-secondary" aria-label="Ekspor data RFQ ke CSV">
      <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span>Ekspor</span>
    </a>
    <% if (typeof user !== 'undefined' && user && ['superadmin', 'admin'].includes(user.role)) { %>
      <a href="/admin/products/create" class="adm-btn adm-btn-primary" aria-label="Tambah produk baru">
        <svg class="adm-btn-icon adm-btn-icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span>Tambah</span>
      </a>
    <% } %>
  </div>
</div>

<section class="metrics-row" aria-label="Metrik Utama">
  <div class="metric-box">
    <span class="metric-label-txt">Inquiry RFQ Baru</span>
    <span class="metric-num-txt" id="heroPendingCount"><%= stats.pendingLeads %></span>
    <% if (stats.pendingLeads > 0) { %>
      <span class="metric-meta-txt highlight"><%= stats.pendingLeads %> permintaan butuh respon</span>
    <% } else { %>
      <span class="metric-meta-txt">Semua telah ditindak lanjuti</span>
    <% } %>
  </div>

  <div class="metric-box">
    <span class="metric-label-txt">Katalog Produk Aktif</span>
    <span class="metric-num-txt"><%= stats.activeProducts %></span>
    <span class="metric-meta-txt"><%= stats.activeBrandsCount %> merek terdaftar aktif</span>
  </div>

  <div class="metric-box">
    <span class="metric-label-txt">Publikasi Konten</span>
    <span class="metric-num-txt"><%= stats.publishedPosts %></span>
    <span class="metric-meta-txt">Artikel berita &amp; blog aktif</span>
  </div>

  <div class="metric-box">
    <span class="metric-label-txt">Banner Hero Aktif</span>
    <span class="metric-num-txt"><%= stats.activeBanners %></span>
    <span class="metric-meta-txt">Slider beranda publik</span>
  </div>
</section>

<section class="table-card" id="tableSection">
  <div class="table-toolbar">
    <h2 class="toolbar-title">Permintaan Penawaran Terkini (RFQ)</h2>

    <div class="toolbar-right-tools">
      <div class="filter-tabs-wrap" role="group" aria-label="Filter status">
        <button type="button" class="tab-btn active" data-filter="all">Semua</button>
        <button type="button" class="tab-btn" data-filter="baru">Baru</button>
        <button type="button" class="tab-btn" data-filter="dibaca">Dibaca</button>
        <button type="button" class="tab-btn" data-filter="ditindaklanjuti">Selesai</button>
      </div>

      <div class="search-input-wrap">
        <svg class="search-icon-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="liveSearchInput" placeholder="Cari nama, perusahaan..." aria-label="Cari data">
      </div>
    </div>
  </div>

  <div class="table-scroll-wrapper table-scroll-wrapper--mobile-only">
    <table class="data-table" id="rfqDataTable">
      <thead>
        <tr>
          <th class="adm-dash-th-time">Waktu</th>
          <th>Klien / Perusahaan</th>
          <th>Kontak</th>
          <th>Kebutuhan</th>
          <th class="adm-dash-th-status">Status</th>
          <th class="adm-dash-th-actions">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof recentInquiries !== 'undefined' && recentInquiries.length > 0) { %>
          <% recentInquiries.forEach(function(item) { %>
            <tr data-status="<%= item.status %>" id="row-<%= item.id %>">
              <td>
                <span class="adm-dash-time-val">
                  <%= new Date(item.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %>
                </span>
                <div class="adm-dash-date-val">
                  <%= new Date(item.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %>
                </div>
              </td>
              <td>
                <div class="td-client-title"><%= item.company || '-' %></div>
                <div class="td-client-sub"><%= item.name %></div>
              </td>
              <td>
                <div class="adm-dash-phone-val"><%= item.phone %></div>
                <div class="td-muted-text"><%= item.email %></div>
              </td>
              <td>
                <div class="td-req-text" title="<%= item.message || '' %>">
                  <%= item.message ? item.message.substring(0, 60) + '...' : 'Tidak ada rincian' %>
                </div>
              </td>
              <td>
                <select class="status-select inquiry-status-select st-<%= item.status === 'ditindaklanjuti' ? 'selesai' : (item.status === 'dibaca' ? 'diproses' : item.status) %>"
                        data-id="<%= item.id %>" data-eu-dropdown="filled" data-eu-size="sm" data-inline="true" aria-label="Ubah status">
                  <option value="baru" <%= item.status === 'baru' ? 'selected' : '' %>>Baru</option>
                  <option value="dibaca" <%= item.status === 'dibaca' ? 'selected' : '' %>>Dibaca</option>
                  <option value="ditindaklanjuti" <%= item.status === 'ditindaklanjuti' ? 'selected' : '' %>>Selesai</option>
                  <option value="ditolak" <%= item.status === 'ditolak' ? 'selected' : '' %>>Ditolak</option>
                </select>
              </td>
              <td class="adm-dash-td-actions">
                <div class="table-actions">
                  <button type="button" class="btn-action btn-action-view" data-inquiry-id="<%= item.id %>" title="Tinjau Rincian Permintaan">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <span>Tinjau</span>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="adm-dash-empty-cell">
              Belum ada permintaan penawaran masuk saat ini.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div class="table-footer">
    <span>Menampilkan <strong><%= recentInquiries.length %></strong> data inquiry terkini</span>
    <a href="/admin/inquiries">
      <span>Lihat Seluruh Inquiry</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
  </div>
</section>

<div class="admin-modal-backdrop" id="inquiryDetailModal">
  <div class="admin-modal-card">
    <div class="admin-modal-header">
      <div class="admin-modal-title">
        <svg width="18" height="18" fill="none" stroke="var(--primary)" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        <span>Detail Permintaan Penawaran RFQ</span>
      </div>
      <button type="button" class="modal-close-btn admin-modal-close" data-modal-close="inquiryDetailModal" aria-label="Tutup Dialog">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form id="modalNotesForm">
      <input type="hidden" id="modalInquiryId" name="inquiryId">
      <div class="admin-modal-body">
        <div class="adm-dash-modal-card-box">
          <div class="adm-dash-modal-label">Informasi Klien</div>
          <div id="modalClientCompany" class="adm-dash-modal-company">-</div>
          <div class="adm-dash-modal-grid">
            <div><span class="adm-dash-muted-text">PIC:</span> <strong id="modalClientName">-</strong></div>
            <div><span class="adm-dash-muted-text">Telepon:</span> <strong id="modalClientPhone">-</strong></div>
            <div><span class="adm-dash-muted-text">Email:</span> <span id="modalClientEmail">-</span></div>
            <div><span class="adm-dash-muted-text">Produk:</span> <span id="modalClientProduct">-</span></div>
          </div>
        </div>

        <div>
          <label class="form-label">Rincian Kebutuhan / Pesan Konsultasi:</label>
          <div id="modalClientMessage" class="adm-dash-modal-message-box">
            -
          </div>
        </div>

        <div class="form-group adm-dash-mb-0">
          <label class="form-label" for="modalAdminNotes">Catatan Internal Sales / Admin:</label>
          <textarea id="modalAdminNotes" class="form-textarea" placeholder="Tuliskan catatan tindak lanjut, kesepakatan harga, atau jadwal meeting dengan klien..."></textarea>
        </div>
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="adm-btn adm-btn-neutral adm-btn-sm" data-modal-close="inquiryDetailModal" aria-label="Tutup jendela rincian pesan">
          <span>Tutup</span>
        </button>
        <button type="submit" class="adm-btn adm-btn-primary adm-btn-sm" aria-label="Simpan catatan tindak lanjut">
          <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Simpan</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script type="application/json" id="dashboardInquiriesJson"><%- safeJson(recentInquiries || []) %></script>
<script src="/js/admin-dashboard.js" defer></script>

<%- include('../partials/admin-footer') %>

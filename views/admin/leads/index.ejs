<%- include('../../partials/admin-header') %>

<main class="section-sm" style="flex: 1;">
  <div class="container">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Permintaan Penawaran & Kemitraan (Leads)</h1>
        <p class="admin-page-subtitle">Kelola pesan masuk dari calon mitra bisnis, atur status penawaran, dan ekspor arsip.</p>
      </div>
      <div>
        <a href="/admin/leads/export" class="btn btn-secondary btn-sm" download>
          Unduh Laporan CSV
        </a>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="card" style="margin-bottom: var(--space-lg); box-shadow: var(--shadow-level-0);">
      <div class="card-body" style="padding: var(--space-md) var(--space-lg);">
        <form action="/admin/leads" method="GET" class="flex flex-wrap items-center gap-md">
          <div style="min-width: 180px;">
            <select name="status" class="form-select">
              <option value="">Semua Status</option>
              <option value="baru" <%= selectedStatus === 'baru' ? 'selected' : '' %>>Baru (Pending)</option>
              <option value="diproses" <%= selectedStatus === 'diproses' ? 'selected' : '' %>>Sedang Diproses</option>
              <option value="selesai" <%= selectedStatus === 'selesai' ? 'selected' : '' %>>Selesai / Quoted</option>
              <option value="ditolak" <%= selectedStatus === 'ditolak' ? 'selected' : '' %>>Ditolak</option>
            </select>
          </div>
          <div style="min-width: 180px;">
            <select name="type" class="form-select">
              <option value="">Semua Tipe</option>
              <option value="inquiry" <%= selectedType === 'inquiry' ? 'selected' : '' %>>Penawaran (RFQ)</option>
              <option value="partnership" <%= selectedType === 'partnership' ? 'selected' : '' %>>Kemitraan</option>
              <option value="general" <%= selectedType === 'general' ? 'selected' : '' %>>Umum</option>
            </select>
          </div>
          <div>
            <button type="submit" class="btn btn-secondary btn-md">Filter Data</button>
            <% if (selectedStatus || selectedType) { %>
              <a href="/admin/leads" class="btn btn-ghost btn-md">Reset</a>
            <% } %>
          </div>
        </form>
      </div>
    </div>

    <!-- Leads Table -->
    <div class="admin-table-card">
      <div class="admin-table-header">
        <h2 style="font-size: 1.125rem; color: var(--color-text-navy);">Daftar Permintaan Masuk</h2>
        <span class="badge badge-neutral"><%= leads.length %> Data Ditemukan</span>
      </div>
      <div class="table-responsive" style="border: none; border-radius: 0;">
        <table class="table">
          <thead>
            <tr>
              <th class="th-neutral" style="width: 110px;">Tanggal</th>
              <th class="th-neutral">Pengirim & Perusahaan</th>
              <th class="th-neutral">Kontak</th>
              <th class="th-neutral">Pesan / Spesifikasi</th>
              <th class="th-neutral" style="width: 130px;">Status Saat Ini</th>
              <th class="th-neutral" style="width: 220px;">Ubah Status & Catatan</th>
            </tr>
          </thead>
          <tbody>
            <% if (leads && leads.length > 0) { %>
              <% leads.forEach(function(lead) { %>
                <tr>
                  <td>
                    <span style="font-size: 12px; color: var(--color-text-muted);">
                      <%= new Date(lead.created_at).toLocaleDateString('id-ID') %>
                    </span>
                  </td>
                  <td>
                    <strong><%= lead.name %></strong><br>
                    <small style="color: var(--color-text-muted);"><%= lead.company %></small>
                    <% if (lead.product_name_id) { %>
                      <br><small style="color: var(--color-primary);">Produk: <%= lead.product_name_id %></small>
                    <% } %>
                  </td>
                  <td>
                    <a href="mailto:<%= lead.email %>" style="color: var(--color-primary);"><%= lead.email %></a><br>
                    <a href="https://wa.me/<%= lead.phone.replace(/[^0-9]/g, '') %>" target="_blank" style="color: #16a34a; font-size: 12px;">
                      WA: <%= lead.phone %> &nearr;
                    </a>
                  </td>
                  <td>
                    <p style="font-size: 13px; line-height: 1.4; max-width: 320px; margin-bottom: 4px;">
                      <%= lead.message %>
                    </p>
                    <% if (lead.admin_notes) { %>
                      <div style="background: #f1f5f9; padding: 4px 8px; border-radius: 4px; font-size: 11px; color: #475569;">
                        <strong>Catatan Admin:</strong> <%= lead.admin_notes %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <% if (lead.status === 'baru') { %>
                      <span class="badge badge-warning">Baru</span>
                    <% } else if (lead.status === 'diproses') { %>
                      <span class="badge badge-info">Diproses</span>
                    <% } else if (lead.status === 'selesai') { %>
                      <span class="badge badge-success">Selesai</span>
                    <% } else { %>
                      <span class="badge badge-error">Ditolak</span>
                    <% } %>
                  </td>
                  <td>
                    <form action="/admin/leads/<%= lead.id %>/status?_csrf=<%= csrfToken %>" method="POST" class="flex flex-col gap-xs">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="flex gap-xs">
                        <select name="status" class="form-select" style="min-height: 36px; font-size: 12px; padding: 2px 6px;">
                          <option value="baru" <%= lead.status === 'baru' ? 'selected' : '' %>>Baru</option>
                          <option value="diproses" <%= lead.status === 'diproses' ? 'selected' : '' %>>Diproses</option>
                          <option value="selesai" <%= lead.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
                          <option value="ditolak" <%= lead.status === 'ditolak' ? 'selected' : '' %>>Ditolak</option>
                        </select>
                        <button type="submit" class="btn btn-secondary btn-sm" style="min-height: 36px;">
                          Simpan
                        </button>
                      </div>
                      <input type="text" name="admin_notes" class="form-control" style="min-height: 30px; font-size: 11px; padding: 2px 6px;" placeholder="Tambah catatan sales..." value="<%= lead.admin_notes || '' %>">
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center" style="padding: var(--space-xl); color: var(--color-text-muted);">
                  Belum ada pesan leads yang cocok dengan kriteria filter.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/admin-footer') %>

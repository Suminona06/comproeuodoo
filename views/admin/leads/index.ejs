<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Permintaan Penawaran &amp; Kemitraan (Leads)</h1>
    <p>Kelola pesan masuk dari calon mitra bisnis, atur status penawaran, dan ekspor arsip data sales.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/leads/export" class="adm-btn adm-btn-secondary" aria-label="Unduh laporan leads ke CSV" download>
      <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span>Ekspor</span>
    </a>
  </div>
</div>

<div class="form-card adm-leads-filter-card">
  <form action="/admin/leads" method="GET" class="adm-leads-filter-form">
    <div class="adm-leads-filter-select-wrap">
      <select name="status" class="form-select" data-eu-dropdown="filled" data-eu-size="sm">
        <option value="">Semua Status</option>
        <option value="baru" <%= selectedStatus === 'baru' ? 'selected' : '' %>>Baru (Pending)</option>
        <option value="diproses" <%= selectedStatus === 'diproses' ? 'selected' : '' %>>Sedang Diproses</option>
        <option value="selesai" <%= selectedStatus === 'selesai' ? 'selected' : '' %>>Selesai / Quoted</option>
        <option value="ditolak" <%= selectedStatus === 'ditolak' ? 'selected' : '' %>>Ditolak</option>
      </select>
    </div>
    <div class="adm-leads-filter-select-wrap">
      <select name="type" class="form-select" data-eu-dropdown="filled" data-eu-size="sm">
        <option value="">Semua Tipe</option>
        <option value="inquiry" <%= selectedType === 'inquiry' ? 'selected' : '' %>>Penawaran (RFQ)</option>
        <option value="partnership" <%= selectedType === 'partnership' ? 'selected' : '' %>>Kemitraan</option>
        <option value="general" <%= selectedType === 'general' ? 'selected' : '' %>>Umum</option>
      </select>
    </div>
    <div class="adm-leads-filter-actions">
      <button type="submit" class="adm-btn adm-btn-secondary" aria-label="Terapkan filter data leads">
        <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
        <span>Filter</span>
      </button>
      <% if (selectedStatus || selectedType) { %>
        <a href="/admin/leads" class="adm-btn adm-btn-neutral" aria-label="Reset filter pencarian leads">
          <span>Reset</span>
        </a>
      <% } %>
    </div>
  </form>
</div>

<div class="table-card">
  <div class="table-toolbar">
    <h2 class="toolbar-title">Daftar Permintaan Masuk</h2>
    <span class="badge badge-info"><%= leads.length %> Data Ditemukan</span>
  </div>
  <div class="table-scroll-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th class="adm-leads-th-date">Tanggal</th>
          <th>Pengirim &amp; Perusahaan</th>
          <th>Kontak</th>
          <th>Pesan / Spesifikasi</th>
          <th class="adm-leads-th-status">Status</th>
          <th class="adm-leads-th-actions">Ubah Status &amp; Catatan</th>
        </tr>
      </thead>
      <tbody>
        <% if (leads && leads.length > 0) { %>
          <% leads.forEach(function(lead) { %>
            <tr>
              <td>
                <span class="adm-leads-date-text">
                  <%= new Date(lead.created_at).toLocaleDateString('id-ID') %>
                </span>
              </td>
              <td>
                <strong><%= lead.name %></strong>
                <% if (lead.company) { %>
                  <div class="adm-leads-company-text"><%= lead.company %></div>
                <% } %>
                <% if (lead.product_name_id) { %>
                  <div class="adm-leads-product-text">Produk: <%= lead.product_name_id %></div>
                <% } %>
              </td>
              <td>
                <div><a href="mailto:<%= lead.email %>" class="adm-leads-email-link"><%= lead.email %></a></div>
                <% if (lead.phone) { %>
                  <div>
                    <a href="https://wa.me/<%= lead.phone.replace(/[^0-9]/g, '') %>" target="_blank" class="adm-leads-wa-link">
                      WA: <%= lead.phone %> &nearr;
                    </a>
                  </div>
                <% } %>
              </td>
              <td>
                <p class="adm-leads-message-text">
                  <%= lead.message %>
                </p>
                <% if (lead.admin_notes) { %>
                  <div class="adm-leads-notes-box">
                    <strong>Catatan Sales:</strong> <%= lead.admin_notes %>
                  </div>
                <% } %>
              </td>
              <td>
                <% if (lead.status === 'baru') { %>
                  <span class="badge badge-warning">Baru</span>
                <% } else if (lead.status === 'diproses') { %>
                  <span class="badge badge-info">Diproses</span>
                <% } else if (lead.status === 'selesai') { %>
                  <span class="badge badge-success">Selesai</span>
                <% } else { %>
                  <span class="badge badge-error">Ditolak</span>
                <% } %>
              </td>
              <td>
                <form action="/admin/leads/<%= lead.id %>/status?_csrf=<%= csrfToken %>" method="POST" class="adm-leads-status-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="adm-leads-form-row">
                    <select name="status" class="form-select adm-leads-status-select" data-eu-dropdown="filled" data-eu-size="sm">
                      <option value="baru" <%= lead.status === 'baru' ? 'selected' : '' %>>Baru</option>
                      <option value="diproses" <%= lead.status === 'diproses' ? 'selected' : '' %>>Diproses</option>
                      <option value="selesai" <%= lead.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
                      <option value="ditolak" <%= lead.status === 'ditolak' ? 'selected' : '' %>>Ditolak</option>
                    </select>
                    <button type="submit" class="adm-btn adm-btn-primary adm-btn-sm" aria-label="Simpan perubahan status lead">
                      <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <span>Simpan</span>
                    </button>
                  </div>
                  <input type="text" name="admin_notes" class="form-input adm-leads-notes-input" placeholder="Catatan sales..." value="<%= lead.admin_notes || '' %>">
                </form>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="adm-leads-empty-cell">
              Belum ada pesan leads yang cocok dengan kriteria filter.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/admin-footer') %>

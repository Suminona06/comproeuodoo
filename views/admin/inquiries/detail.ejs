<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Permintaan RFQ: <%= inquiry.name %></h1>
    <p><%= inquiry.company ? inquiry.company + ' &bull; ' : '' %>Masuk pada <%= new Date(inquiry.created_at).toLocaleString('id-ID') %></p>
  </div>
  <div class="header-actions">
    <a href="/admin/inquiries" class="adm-btn adm-btn-neutral" aria-label="Kembali ke daftar inquiry">
      <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      <span>Kembali</span>
    </a>
  </div>
</div>

<div class="adm-inq-detail-layout">
  <div>
    <div class="form-card">
      <div class="form-card-title">Rincian Kebutuhan &amp; Konsultasi Klien</div>
      
      <div class="adm-inq-detail-message-box">
        <%= inquiry.message || 'Tidak ada pesan tertulis dari pengirim.' %>
      </div>

      <div class="form-card-title adm-inq-mt-md">Catatan Tindak Lanjut Tim Penjualan / Internal</div>
      <form action="/admin/inquiries/<%= inquiry.id %>/status?_csrf=<%= csrfToken %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="form-label" for="admin_notes">Catatan &amp; Riwayat Interaksi</label>
          <textarea id="admin_notes" name="admin_notes" class="form-textarea adm-inq-textarea-tall" placeholder="Tuliskan hasil pembicaraan telepon, negosiasi harga, kuantiti yang disepakati, dll..."><%= inquiry.admin_notes || '' %></textarea>
        </div>

        <div class="adm-inq-actions-end">
          <button type="submit" class="adm-btn adm-btn-primary" aria-label="Simpan catatan tindak lanjut">
            <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Simpan</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <div>
    <div class="form-card">
      <div class="form-card-title">Status Penanganan</div>

      <form action="/admin/inquiries/<%= inquiry.id %>/status?_csrf=<%= csrfToken %>" method="POST" class="adm-inq-status-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="form-label" for="status">Ubah Status</label>
          <select id="status" name="status" class="form-select" data-eu-dropdown="outlined" data-auto-submit="true">
            <option value="baru" <%= inquiry.status === 'baru' ? 'selected' : '' %>>Baru</option>
            <option value="dibaca" <%= inquiry.status === 'dibaca' ? 'selected' : '' %>>Dibaca / Diproses</option>
            <option value="ditindaklanjuti" <%= inquiry.status === 'ditindaklanjuti' ? 'selected' : '' %>>Selesai / Ditindaklanjuti</option>
            <option value="ditolak" <%= inquiry.status === 'ditolak' ? 'selected' : '' %>>Ditolak</option>
          </select>
        </div>
      </form>

      <div class="form-card-title adm-inq-mt-md">Kontak &amp; Identitas Klien</div>
      <div class="adm-inq-info-list">
        <div>
          <div class="adm-inq-info-label">NAMA PIC</div>
          <div class="adm-inq-info-val"><%= inquiry.name %></div>
        </div>
        <div>
          <div class="adm-inq-info-label">PERUSAHAAN / LEMBAGA</div>
          <div class="adm-inq-info-val"><%= inquiry.company || 'Personal / Tidak disebutkan' %></div>
        </div>
        <div>
          <div class="adm-inq-info-label">WHATSAPP / TELEPON</div>
          <div>
            <a href="https://wa.me/<%= inquiry.phone ? inquiry.phone.replace(/[^0-9]/g, '') : '' %>" target="_blank" class="adm-btn adm-btn-secondary adm-btn-sm adm-inq-wa-btn" aria-label="Hubungi klien via WhatsApp">
              <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              <span>WhatsApp</span>
            </a>
          </div>
        </div>
        <div>
          <div class="adm-inq-info-label">EMAIL</div>
          <div><a href="mailto:<%= inquiry.email %>" class="adm-inq-email-link"><%= inquiry.email %></a></div>
        </div>
        <div>
          <div class="adm-inq-info-label">PRODUK TERKAIT</div>
          <div><%= inquiry.product_name_id || 'Umum (Katalog)' %></div>
        </div>
        <div>
          <div class="adm-inq-info-label">SUMBER INQUIRY</div>
          <div><%= inquiry.source || 'Website' %></div>
        </div>
        <% if (inquiry.ip_address) { %>
          <div>
            <div class="adm-inq-info-label">ALAMAT IP PENGIRIM</div>
            <code><%= inquiry.ip_address %></code>
          </div>
        <% } %>
      </div>

      <div class="adm-inq-danger-zone">
        <form action="/admin/inquiries/<%= inquiry.id %>/delete?_csrf=<%= csrfToken %>" method="POST" data-confirm-delete="true" data-confirm-message="Hapus permanen inquiry ini?" data-confirm-title="Hapus Pesan Masuk">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="adm-btn adm-btn-danger adm-btn-block adm-btn-sm" aria-label="Hapus pesan masuk ini">
            <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <span>Hapus</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/admin-footer') %>

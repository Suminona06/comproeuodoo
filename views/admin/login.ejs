<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Login Admin - PT Euodoo' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin.css">

  <% 
    const fav32 = (typeof settings !== 'undefined' && settings && settings.site_favicon_32) ? settings.site_favicon_32 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-32x32.png');
    const fav16 = (typeof settings !== 'undefined' && settings && settings.site_favicon_16) ? settings.site_favicon_16 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-16x16.png');
    const fav180 = (typeof settings !== 'undefined' && settings && settings.site_favicon_180) ? settings.site_favicon_180 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-180x180.png');
    const fav192 = (typeof settings !== 'undefined' && settings && settings.site_favicon_192) ? settings.site_favicon_192 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-192x192.png');
  %>
  <link rel="icon" type="image/png" sizes="32x32" href="<%= fav32 %>?v=2">
  <link rel="icon" type="image/png" sizes="16x16" href="<%= fav16 %>?v=2">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= fav180 %>?v=2">
  <link rel="icon" type="image/png" sizes="192x192" href="<%= fav192 %>?v=2">
</head>
<body style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: var(--color-workspace-bg); padding: var(--space-md);">
  <div style="width: 100%; max-width: 420px;">
    <div style="text-align: center; margin-bottom: var(--space-xl);">
     <div class="loginForm">
          <% if (typeof settings !== 'undefined' && settings && settings.site_logo_header && settings.site_logo_header.trim() !== '') { %>
            <img src="<%= settings.site_logo_header %>" 
                 alt="<%= typeof settings !== 'undefined' && settings.company_name ? settings.company_name : 'PT Euodoo' %>" 
                 class="brand-logo-header" 
                 style="max-height: 38px; width: auto; object-fit: contain; display: block;"
                 onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-flex';">
            <span class="brand-text-fallback" style="display: none; align-items: center; gap: 8px;">
              <span class="brand-name">PT EUODOO</span>
              <span class="brand-badge">MANUFACTURING</span>
            </span>
          <% } else { %>
            <span class="brand-name">PT EUODOO</span>
            <span class="brand-badge">MANUFACTURING</span>
          <% } %>
      <h1 style="font-size: 1.75rem; color: var(--color-secondary-navy); margin-bottom: var(--space-xs);">PT EUODOO</h1>
     </div>
      <p style="font-size: var(--font-size-body-sm); color: var(--color-text-muted);">Content Management System (CMS)</p>
    </div>

    <div class="card" style="box-shadow: var(--shadow-level-2);">
      <div class="card-body">
        <h2 style="font-size: 1.25rem; margin-bottom: var(--space-md); color: var(--color-text-navy);">Masuk ke Portal Admin</h2>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error" role="alert">
            <%= error %>
          </div>
        <% } %>

        <form action="/admin/login?_csrf=<%= csrfToken %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group">
            <label for="email" class="form-label form-label-required">Alamat Email</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="admin@euodoo.com" required autocomplete="email" autofocus>
          </div>

          <div class="form-group">
            <label for="password" class="form-label form-label-required">Kata Sandi</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password">
          </div>

          <button type="submit" class="btn btn-primary btn-md btn-block" style="margin-top: var(--space-lg);">
            Masuk ke Sistem
          </button>
        </form>
      </div>
      <div class="card-footer text-center" style="font-size: var(--font-size-label-sm); color: var(--color-text-muted);">
        Akses khusus staf internal berwenang PT Euodoo
      </div>
    </div>

    <div class="text-center" style="margin-top: var(--space-lg);">
      <a href="/" style="font-size: var(--font-size-body-sm); color: var(--color-text-muted);">&larr; Kembali ke Website Publik</a>
    </div>
  </div>
</body>
</html>

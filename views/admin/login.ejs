<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Login Admin - PT Euodoo' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin.css">

  <% 
    const fav32 = (typeof settings !== 'undefined' && settings && settings.site_favicon_32) ? settings.site_favicon_32 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-32x32.png');
    const fav16 = (typeof settings !== 'undefined' && settings && settings.site_favicon_16) ? settings.site_favicon_16 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-16x16.png');
    const fav180 = (typeof settings !== 'undefined' && settings && settings.site_favicon_180) ? settings.site_favicon_180 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-180x180.png');
    const fav192 = (typeof settings !== 'undefined' && settings && settings.site_favicon_192) ? settings.site_favicon_192 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-192x192.png');
  %>
  <link rel="icon" type="image/png" sizes="32x32" href="<%= fav32 %>?v=3">
  <link rel="icon" type="image/png" sizes="16x16" href="<%= fav16 %>?v=3">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= fav180 %>?v=3">
  <link rel="icon" type="image/png" sizes="192x192" href="<%= fav192 %>?v=3">
</head>
<body class="adm-login-body">
  <div class="adm-login-wrapper">
    <div class="adm-login-header">
      <div class="loginForm">
        <% if (typeof settings !== 'undefined' && settings && settings.site_logo_header && settings.site_logo_header.trim() !== '') { %>
          <img src="<%= settings.site_logo_header %>" 
               alt="<%= typeof settings !== 'undefined' && settings.company_name ? settings.company_name : 'PT Euodoo' %>" 
               class="brand-logo-header adm-login-logo">
          <span class="brand-text-fallback adm-login-fallback">
            <span class="brand-name">PT EUODOO</span>
            <span class="brand-badge">MANUFACTURING</span>
          </span>
        <% } else { %>
          <span class="brand-name">PT EUODOO</span>
          <span class="brand-badge">MANUFACTURING</span>
        <% } %>
        <h1 class="adm-login-title">PT EUODOO</h1>
      </div>
      <p class="adm-login-subtitle">Content Management System (CMS)</p>
    </div>

    <div class="card adm-login-card">
      <div class="card-body">
        <h2 class="adm-login-card-title">Masuk ke Portal Admin</h2>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error" role="alert">
            <%= error %>
          </div>
        <% } %>

        <form action="/admin/login?_csrf=<%= csrfToken %>" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group">
            <label for="email" class="form-label form-label-required">Alamat Email</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="admin@euodoo.com" required autocomplete="email" autofocus>
          </div>

          <div class="form-group">
            <label for="password" class="form-label form-label-required">Kata Sandi</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password">
          </div>

          <button type="submit" class="adm-btn adm-btn-primary adm-btn-block adm-login-btn-submit" aria-label="Masuk ke Sistem">
            <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
            <span>Masuk</span>
          </button>
        </form>
      </div>
      <div class="card-footer text-center adm-login-card-footer">
        Akses khusus staf internal berwenang PT Euodoo
      </div>
    </div>

    <div class="text-center adm-login-back-wrapper">
      <a href="/" class="adm-login-back-link">&larr; Kembali ke Website Publik</a>
    </div>
  </div>
  <script src="/js/admin-login.js?v=1.0"></script>
  <script src="/js/admin-form-validation.js?v=1.0"></script>
</body>
</html>

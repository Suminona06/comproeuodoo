<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Edit Merek: <%= brand.name %></h1>
    <p>Perbarui rincian merek, urutan, atau ganti logo.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/brands" class="btn btn-secondary">&larr; Kembali ke Daftar</a>
  </div>
</div>

<div class="form-card" style="max-width: 680px; margin: 0 auto;">
  <div class="form-card-title">Perbarui Informasi Merek</div>

  <form action="/admin/brands/<%= brand.id %>?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="name">Nama Merek *</label>
        <input type="text" id="name" name="name" class="form-input" required value="<%= brand.name %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="sort_order">Nomor Urutan Tampil</label>
        <input type="number" id="sort_order" name="sort_order" class="form-input" value="<%= brand.sort_order %>" min="0">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="logo_file">Logo Merek</label>
      <div class="custom-file-upload" data-initial-preview="<%= brand.logo_url || '' %>">
        <input type="file" id="logo_file" name="logo_file" accept="image/*">
        <div class="file-upload-dropzone" tabindex="0" role="button" aria-label="Pilih atau seret logo merek">
          <div class="file-upload-preview">
            <img src="<%= brand.logo_url || '' %>" alt="Pratinjau Logo" style="display: none;">
            <div class="preview-placeholder-icon">
              <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            </div>
          </div>
          <div class="file-upload-content">
            <div class="file-upload-header">
              <span class="file-upload-btn-pill">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                <span>Pilih Berkas</span>
              </span>
              <span class="file-upload-label">atau seret dan lepas ke sini</span>
            </div>
            <div class="file-upload-filename"><%= brand.logo_url ? 'Logo aktif tersimpan' : 'Belum ada berkas dipilih' %></div>
            <div class="file-upload-meta">PNG, JPG, WebP. Maks 5MB (otomatis dikompresi ke WebP 400x400px).</div>
          </div>
          <button type="button" class="file-upload-clear-btn" title="Hapus berkas" style="display: none;">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="description_id">Deskripsi Singkat (Bahasa Indonesia)</label>
        <textarea id="description_id" name="description_id" class="form-textarea"><%= brand.description_id || '' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="description_en">Deskripsi Singkat (English)</label>
        <textarea id="description_en" name="description_en" class="form-textarea"><%= brand.description_en || '' %></textarea>
      </div>
    </div>

    <div class="form-group">
      <label class="form-check">
        <input type="checkbox" name="is_active" value="1" <%= brand.is_active ? 'checked' : '' %>>
        <span>Aktifkan dan tampilkan merek ini pada halaman publik</span>
      </label>
    </div>

    <div class="form-actions-bar">
      <a href="/admin/brands" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
    </div>
  </form>
</div>

<%- include('../../partials/admin-footer') %>

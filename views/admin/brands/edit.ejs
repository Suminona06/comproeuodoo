<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Edit Merek: <%= brand.name %></h1>
    <p>Perbarui rincian merek, urutan, atau ganti logo.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/brands" class="btn btn-secondary">&larr; Kembali ke Daftar</a>
  </div>
</div>

<div class="form-card" style="max-width: 680px; margin: 0 auto;">
  <div class="form-card-title">Perbarui Informasi Merek</div>

  <form action="/admin/brands/<%= brand.id %>?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="name">Nama Merek *</label>
        <input type="text" id="name" name="name" class="form-input" required value="<%= brand.name %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="sort_order">Nomor Urutan Tampil</label>
        <input type="number" id="sort_order" name="sort_order" class="form-input" value="<%= brand.sort_order %>" min="0">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Logo Merek (Media Library)</label>
      <div class="media-picker-component">
        <input type="hidden" id="brand_logo_url" name="logo_url" value="<%= brand.logo_url || '' %>">
        <div class="media-picker-preview-box" style="height: 120px;">
          <img src="<%= brand.logo_url || '' %>" alt="Pratinjau Logo" style="<%= brand.logo_url ? 'display: block; max-height: 80px; object-fit: contain;' : 'display: none;' %>">
          <div class="media-picker-empty" style="<%= brand.logo_url ? 'display: none;' : '' %>">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Belum ada logo dipilih</span>
          </div>
        </div>
        <div class="media-picker-ctrls">
          <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="brand_logo_url" data-picker-type="image">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            Pilih dari Media Library
          </button>
          <button type="button" class="btn btn-ghost btn-sm btn-clear-media" style="<%= brand.logo_url ? '' : 'display: none;' %>">Hapus</button>
        </div>
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="description_id">Deskripsi Singkat (Bahasa Indonesia)</label>
        <textarea id="description_id" name="description_id" class="form-textarea"><%= brand.description_id || '' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="description_en">Deskripsi Singkat (English)</label>
        <textarea id="description_en" name="description_en" class="form-textarea"><%= brand.description_en || '' %></textarea>
      </div>
    </div>

    <div class="form-group">
      <label class="form-check">
        <input type="checkbox" name="is_active" value="1" <%= brand.is_active ? 'checked' : '' %>>
        <span>Aktifkan dan tampilkan merek ini pada halaman publik</span>
      </label>
    </div>

    <div class="form-actions-bar">
      <a href="/admin/brands" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
    </div>
  </form>
</div>

<%- include('../../partials/admin-footer') %>

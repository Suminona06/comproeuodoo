<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Tambah Merek Baru</h1>
    <p>Daftarkan merek terdaftar PT Euodoo dengan logo teroptimasi WebP.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/brands" class="adm-btn adm-btn-neutral" aria-label="Kembali ke daftar merek">
      <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      <span>Kembali</span>
    </a>
  </div>
</div>

<div class="form-card" style="max-width: 680px; margin: 0 auto;">
  <div class="form-card-title">Informasi Merek</div>

  <form action="/admin/brands?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="name">Nama Merek *</label>
        <input type="text" id="name" name="name" class="form-input" required placeholder="Contoh: Plastik Bawang (PB)" value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="sort_order">Nomor Urutan Tampil</label>
        <input type="number" id="sort_order" name="sort_order" class="form-input" value="0" min="0">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Logo Merek (Media Library)</label>
      <div class="media-picker-component">
        <input type="hidden" id="brand_logo_url" name="logo_url" value="<%= typeof formData !== 'undefined' && formData?.logo_url ? formData.logo_url : '' %>">
        <div class="media-picker-preview-box" style="height: 120px;">
          <img src="<%= typeof formData !== 'undefined' && formData?.logo_url ? formData.logo_url : '' %>" alt="Pratinjau Logo" style="<%= typeof formData !== 'undefined' && formData?.logo_url ? 'display: block; max-height: 80px; object-fit: contain;' : 'display: none;' %>">
          <div class="media-picker-empty" style="<%= typeof formData !== 'undefined' && formData?.logo_url ? 'display: none;' : '' %>">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Belum ada logo dipilih</span>
          </div>
        </div>
        <div class="media-picker-ctrls">
          <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="brand_logo_url" data-picker-type="image" aria-label="Pilih logo dari Media Library">
            <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Pilih Media</span>
          </button>
          <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media" style="<%= typeof formData !== 'undefined' && formData?.logo_url ? '' : 'display: none;' %>" aria-label="Hapus logo terpilih">
            <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <span>Hapus</span>
          </button>
        </div>
      </div>
    </div>

    <div class="form-group">
      <label class="form-check">
        <input type="checkbox" name="is_active" value="1" checked>
        <span>Aktifkan dan tampilkan merek ini pada halaman publik</span>
      </label>
    </div>

    <div class="form-actions-bar">
      <a href="/admin/brands" class="adm-btn adm-btn-neutral" aria-label="Batalkan penambahan merek">
        <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        <span>Batal</span>
      </a>
      <button type="submit" class="adm-btn adm-btn-primary" aria-label="Simpan merek baru">
        <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Simpan</span>
      </button>
    </div>
  </form>
</div>

<%- include('../../partials/admin-footer') %>

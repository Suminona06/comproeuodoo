<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Edit Produk: <%= product.name_id %></h1>
    <p>Perbarui rincian spesifikasi material, varian ukuran, atau galeri gambar produk.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/products" class="adm-btn adm-btn-neutral" aria-label="Kembali ke daftar produk">
      <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      <span>Kembali</span>
    </a>
  </div>
</div>

<form action="/admin/products/<%= product.id %>?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" id="productEditForm" novalidate>
  <%- include('partials/basic-info') %>
  <%- include('partials/gallery') %>
  <%- include('partials/size-table') %>
  <%- include('partials/seo') %>

  <div class="form-actions-bar form-actions-sticky">
    <a href="/admin/products" class="adm-btn adm-btn-neutral" aria-label="Batalkan perubahan produk">
      <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      <span>Batal</span>
    </a>
    <button type="submit" class="adm-btn adm-btn-primary btn-submit-form" aria-label="Simpan perubahan produk">
      <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
      <span>Simpan</span>
    </button>
  </div>
</form>

<script src="/js/admin-products.js"></script>
<script src="/js/admin-size-table.js"></script>
<script src="/tinymce/tinymce.min.js"></script>
<script src="/js/admin-editor.js"></script>

<%- include('../../partials/admin-footer') %>

<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Katalog Produk Manufaktur</h1>
    <p>Kelola spesifikasi teknis, varian ukuran, dan status publikasi katalog kemasan plastik PT Euodoo.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/products/export" class="adm-btn adm-btn-secondary" aria-label="Ekspor data katalog ke CSV">
      <svg class="adm-btn-icon adm-btn-icon-download" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span>Ekspor</span>
    </a>
    <a href="/admin/products/create" class="adm-btn adm-btn-primary" aria-label="Tambah produk baru">
      <svg class="adm-btn-icon adm-btn-icon-plus" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <span>Tambah</span>
    </a>
  </div>
</div>

<div class="table-card">
  <div class="table-toolbar">
    <div class="adm-prod-toolbar-left">
      <h2 class="toolbar-title adm-prod-toolbar-title">Daftar Produk</h2>
      
      <form action="/admin/products" method="GET" class="adm-prod-filter-form" id="prodFilterForm">
        <select name="category" id="prodCategorySelect" class="form-select" data-eu-dropdown="elevated" data-prefix="Kategori" data-eu-size="sm" data-inline="true">
          <option value="">Semua Kategori</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>" <%= selectedCategory === cat.id ? 'selected' : '' %>>
              <%= cat.name_id %>
            </option>
          <% }); %>
        </select>
        <% if (selectedStatus) { %><input type="hidden" name="status" value="<%= selectedStatus %>"><% } %>
      </form>

      <div class="filter-tabs-wrap" id="prodFilterTabs">
        <a href="/admin/products<%= selectedCategory ? '?category=' + selectedCategory : '' %>" data-status="" class="tab-btn <%= !selectedStatus ? 'active' : '' %>">Semua</a>
        <a href="/admin/products?status=published<%= selectedCategory ? '&category=' + selectedCategory : '' %>" data-status="published" class="tab-btn <%= selectedStatus === 'published' ? 'active' : '' %>">Published</a>
        <a href="/admin/products?status=draft<%= selectedCategory ? '&category=' + selectedCategory : '' %>" data-status="draft" class="tab-btn <%= selectedStatus === 'draft' ? 'active' : '' %>">Draft</a>
      </div>
    </div>

    <form action="/admin/products" method="GET" class="search-input-wrap adm-prod-search-form" id="prodSearchForm">
      <input type="hidden" name="category" value="<%= selectedCategory || '' %>">
      <input type="hidden" name="status" value="<%= selectedStatus || '' %>">
      <svg class="search-icon-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="prodSearchInput" name="q" placeholder="Cari nama produk..." value="<%= searchQuery || '' %>" aria-label="Cari produk">
    </form>
  </div>

  <div class="table-scroll-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th class="adm-prod-th-thumb">Foto</th>
          <th>Nama Produk</th>
          <th>Kategori</th>
          <th class="adm-prod-th-status">Status</th>
          <th class="adm-prod-th-action">Aksi</th>
        </tr>
      </thead>
      <tbody id="productTableBody">
        <%- include('partials/table-rows', { products: products, csrfToken: csrfToken }) %>
      </tbody>
    </table>
  </div>

  <div class="adm-prod-pagination-wrap" id="productPaginationWrap">
    <%- include('../../partials/pagination', {
      id: 'productPaginationBar',
      pagination: {
        page: currentPage,
        perPage: perPage,
        totalRows: totalCount,
        totalPages: totalPages,
        baseUrl: '/admin/products',
        queryParams: {
          category: selectedCategory,
          status: selectedStatus,
          q: searchQuery
        }
      }
    }) %>
  </div>
</div>

<script src="/js/pagination.js" defer></script>
<script src="/js/admin-products.js" defer></script>

<%- include('../../partials/admin-footer') %>

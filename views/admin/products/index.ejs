<%- include('../../partials/admin-header') %>

<main class="section-sm" style="flex: 1;">
  <div class="container">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Katalog Produk & Komponen</h1>
        <p class="admin-page-subtitle">
          Kelola daftar produk cetakan plastik presisi, spesifikasi material, dan galeri teknis.
        </p>
      </div>
      <div>
        <a href="/admin/products/create" class="btn btn-primary btn-sm">+ Tambah Produk Baru</a>
      </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card" style="margin-bottom: var(--space-lg); box-shadow: var(--shadow-level-0);">
      <div class="card-body" style="padding: var(--space-md) var(--space-lg);">
        <form action="/admin/products" method="GET" class="flex flex-wrap items-center gap-md">
          <div style="flex: 1; min-width: 200px;">
            <input type="text" name="search" class="form-control" placeholder="Cari nama produk atau slug..." value="<%= searchQuery || '' %>">
          </div>
          <div style="min-width: 220px;">
            <select name="category" class="form-select">
              <option value="">Semua Kategori</option>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat.id %>" <%= selectedCategory === cat.id ? 'selected' : '' %>>
                    <%= cat.name_id %>
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div>
            <button type="submit" class="btn btn-secondary btn-md">Filter</button>
            <% if (selectedCategory || searchQuery) { %>
              <a href="/admin/products" class="btn btn-ghost btn-md">Reset</a>
            <% } %>
          </div>
        </form>
      </div>
    </div>

    <!-- Table of Products -->
    <div class="admin-table-card">
      <div class="admin-table-header">
        <h2 style="font-size: 1.125rem; color: var(--color-text-navy);">Daftar Produk</h2>
        <span class="badge badge-neutral"><%= products.length %> Produk Ditemukan</span>
      </div>
      <div class="table-responsive" style="border: none; border-radius: 0;">
        <table class="table">
          <thead>
            <tr>
              <th class="th-neutral" style="width: 80px;">Foto</th>
              <th class="th-neutral">Nama Produk</th>
              <th class="th-neutral">Kategori</th>
              <th class="th-neutral">Unggulan</th>
              <th class="th-neutral">Status</th>
              <th class="th-neutral text-right">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (products && products.length > 0) { %>
              <% products.forEach(function(product) { %>
                <tr>
                  <td>
                    <% if (product.main_image) { %>
                      <img src="<%= product.main_image %>" alt="<%= product.name_id %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px; border: 1px solid var(--color-border);">
                    <% } else { %>
                      <div style="width: 60px; height: 60px; background: #e2e8f0; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #64748b;">
                        Tanpa Foto
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <strong><%= product.name_id %></strong><br>
                    <small style="color: var(--color-text-muted);"><%= product.name_en || '-' %></small>
                    <br><small style="color: var(--color-primary);">Slug: /products/<%= product.slug %></small>
                  </td>
                  <td>
                    <span class="badge badge-primary"><%= product.category_name_id || 'Umum' %></span>
                  </td>
                  <td>
                    <% if (product.is_featured) { %>
                      <span class="badge badge-warning">Unggulan</span>
                    <% } else { %>
                      <span style="color: var(--color-text-muted); font-size: 12px;">Biasa</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (product.is_active) { %>
                      <span class="badge badge-success">Aktif</span>
                    <% } else { %>
                      <span class="badge badge-neutral">Draf</span>
                    <% } %>
                  </td>
                  <td class="text-right">
                    <div class="flex gap-xs justify-end">
                      <a href="/admin/products/<%= product.id %>/edit" class="btn btn-secondary btn-sm">
                        Edit
                      </a>
                      <form action="/admin/products/<%= product.id %>/delete" method="POST" class="form-delete" data-confirm="Hapus produk '<%= product.name_id %>' secara permanen?" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--color-error);">
                          Hapus
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center" style="padding: var(--space-xl); color: var(--color-text-muted);">
                  Belum ada produk yang cocok dengan pencarian / filter.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/admin-footer') %>

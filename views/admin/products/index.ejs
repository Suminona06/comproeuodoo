<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Katalog Produk Manufaktur</h1>
    <p>Kelola spesifikasi teknis, varian ukuran, dan status publikasi katalog kemasan plastik PT Euodoo.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/products/export" class="btn btn-secondary">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span>Ekspor CSV</span>
    </a>
    <a href="/admin/products/create" class="btn btn-primary">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <span>Tambah Produk</span>
    </a>
  </div>
</div>

<div class="table-card">
  <div class="table-toolbar">
    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
      <h2 class="toolbar-title" style="margin-right: 6px;">Daftar Produk</h2>
      
      <!-- Category Filter Dropdown -->
      <form action="/admin/products" method="GET" style="display: flex; gap: 6px; align-items: center;">
        <select name="category" class="form-select" style="font-size: 11.5px; padding: 4px 8px; height: 30px; width: auto;" onchange="this.form.submit()">
          <option value="">Semua Kategori</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>" <%= selectedCategory === cat.id ? 'selected' : '' %>>
              <%= cat.name_id %>
            </option>
          <% }); %>
        </select>
        <% if (selectedStatus) { %><input type="hidden" name="status" value="<%= selectedStatus %>"><% } %>
      </form>

      <div class="filter-tabs-wrap">
        <a href="/admin/products<%= selectedCategory ? '?category=' + selectedCategory : '' %>" class="tab-btn <%= !selectedStatus ? 'active' : '' %>">Semua</a>
        <a href="/admin/products?status=published<%= selectedCategory ? '&category=' + selectedCategory : '' %>" class="tab-btn <%= selectedStatus === 'published' ? 'active' : '' %>">Published</a>
        <a href="/admin/products?status=draft<%= selectedCategory ? '&category=' + selectedCategory : '' %>" class="tab-btn <%= selectedStatus === 'draft' ? 'active' : '' %>">Draft</a>
      </div>
    </div>

    <div class="search-input-wrap">
      <svg class="search-icon-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="liveSearchInput" placeholder="Cari nama produk..." aria-label="Cari produk">
    </div>
  </div>

  <div class="table-scroll-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width: 70px;">Foto</th>
          <th>Nama Produk</th>
          <th>Kategori</th>
          <th>Spesifikasi Material</th>
          <th style="width: 90px; text-align: center;">Unggulan</th>
          <th style="width: 100px;">Status</th>
          <th style="text-align: right; width: 120px;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (products && products.length > 0) { %>
          <% products.forEach(function(p) { %>
            <tr>
              <td>
                <div style="width: 52px; height: 52px; background: #fafbfc; border: 1px solid var(--border-main); border-radius: var(--r-sm); display: flex; align-items: center; justify-content: center; overflow: hidden;">
                  <% if (p.image_url) { %>
                    <img src="<%= p.image_url %>" alt="<%= p.name_id %>" style="width: 100%; height: 100%; object-fit: cover;">
                  <% } else { %>
                    <span style="font-size: 10px; color: var(--text-tertiary); font-weight: 700;">NO PIC</span>
                  <% } %>
                </div>
              </td>
              <td>
                <div class="td-client-title"><%= p.name_id %></div>
                <div class="td-client-sub"><%= p.name_en || '-' %> &bull; <code><%= p.slug %></code></div>
              </td>
              <td>
                <span class="badge-role editor" style="font-size: 11px;">
                  <%= p.category_name_id || 'Umum' %>
                </span>
              </td>
              <td>
                <div class="td-req-text" title="<%= p.material_specs || '' %>">
                  <%= p.material_specs || '-' %>
                </div>
              </td>
              <td style="text-align: center;">
                <% if (p.featured || p.is_featured) { %>
                  <span class="badge-status st-baru" style="font-size: 10.5px; padding: 2px 6px; border-radius: 4px;">Featured</span>
                <% } else { %>
                  <span style="color: var(--text-tertiary); font-size: 12px;">-</span>
                <% } %>
              </td>
              <td>
                <span class="badge-status <%= p.status === 'published' ? 'st-selesai' : (p.status === 'draft' ? 'st-baru' : 'st-ditolak') %>" style="font-size: 11px; padding: 2px 6px; border-radius: 4px;">
                  <%= p.status || 'published' %>
                </span>
              </td>
              <td style="text-align: right;">
                <div class="table-actions">
                  <a href="/admin/products/<%= p.id %>/edit" class="btn-action btn-action-edit" title="Edit Produk">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    <span>Edit</span>
                  </a>
                  <form action="/admin/products/<%= p.id %>/delete?_csrf=<%= csrfToken %>" method="POST" data-confirm-delete="true" data-confirm-message="Hapus produk <%= p.name_id %> secara permanen?" data-confirm-title="Hapus Produk">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-action btn-action-delete" title="Hapus Produk">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      <span>Hapus</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
              Tidak ada produk yang sesuai dengan filter.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/admin-footer') %>

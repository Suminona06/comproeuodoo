<% if (products && products.length > 0) { %>
  <% products.forEach(function(p) { %>
    <tr data-status="<%= p.status %>" id="prod-row-<%= p.id %>">
      <td>
        <div class="adm-prod-thumb">
          <% if (p.image_url) { %>
            <img src="<%= p.image_url %>" alt="<%= p.name_id %>" class="adm-prod-thumb-img" width="52" height="52" loading="lazy">
          <% } else { %>
            <span class="adm-prod-thumb-empty">NO PIC</span>
          <% } %>
        </div>
      </td>
      <td>
        <div class="td-client-title"><%= p.name_id %></div>
        <div class="adm-slug-text" title="<%= p.slug %>"><%= p.slug %></div>
      </td>
      <td>
        <span class="badge-role editor adm-prod-badge-cat">
          <%= p.category_name_id || 'Umum' %>
        </span>
      </td>
      <td>
        <span class="badge-status <%= p.status === 'published' ? 'badge-status--success' : (p.status === 'draft' ? 'badge-status--warning' : 'badge-status--danger') %>">
          <%= p.status === 'published' ? 'Published' : (p.status === 'draft' ? 'Draft' : (p.status || '-')) %>
        </span>
      </td>
      <td class="adm-prod-td-action">
        <div class="table-actions">
          <a href="/admin/products/<%= p.id %>/edit" class="btn-action btn-action-edit" title="Edit Produk">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            <span>Edit</span>
          </a>
          <form action="/admin/products/<%= p.id %>/delete?_csrf=<%= csrfToken %>" method="POST" data-confirm-delete="true" data-confirm-message="Hapus produk <%= p.name_id %> secara permanen?" data-confirm-title="Hapus Produk">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn-action btn-action-delete" title="Hapus Produk">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus</span>
            </button>
          </form>
        </div>
      </td>
    </tr>
  <% }); %>
<% } else { %>
  <tr>
    <td colspan="5" class="adm-prod-empty-td">
      Tidak ada produk yang sesuai dengan filter.
    </td>
  </tr>
<% } %>


<%
  const p = typeof product !== 'undefined' ? product : (typeof formData !== 'undefined' ? formData : {});
  const isEdit = typeof product !== 'undefined' && product && product.id;
  const defaultVariants = isEdit ? [''] : ['24 x 40 cm (40 Micron)', '28 x 48 cm (45 Micron)'];
  const variantsList = (Array.isArray(p.variants) && p.variants.length > 0) ? p.variants : defaultVariants;
  const initialSizeTable = isEdit
    ? JSON.stringify(p.size_table || { columns: [], rows: [] })
    : '{"columns":[{"id":"col_1","label":"Kode Produk"},{"id":"col_2","label":"Lebar"},{"id":"col_3","label":"Panjang"},{"id":"col_4","label":"Tebal (Micron)"},{"id":"col_5","label":"Kapasitas"},{"id":"col_6","label":"Bahan"}],"rows":[{"col_1":"SL-3040","col_2":"30 cm","col_3":"40 cm","col_4":"40 micron","col_5":"5 kg","col_6":"HDPE Virgin"}]}';
%>
<div class="form-card">
  <div class="admin-card-header-flex">
    <div class="form-card-title admin-card-title-plain">3. Variasi Ukuran (ID) / Size Variants (EN)</div>
    <button type="button" id="btnAddVariant" class="btn-add-row">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <span>Tambah Ukuran</span>
    </button>
  </div>
  <p class="admin-field-hint">Daftar variasi ukuran yang tampil sebagai pil interaktif di halaman publik.</p>
  <div id="variantsContainer">
    <% variantsList.forEach(function(v) { 
      const label = typeof v === 'string' ? v : (v.size_label || v.name_id || '');
    %>
      <div class="prod-variant-row-item">
        <input type="text" name="variant_labels[]" class="form-input" placeholder="Contoh: 24 x 40 cm (40 Micron)" value="<%= label %>">
        <button type="button" class="btn-row-action btn-row-delete btn-remove-variant" title="Hapus ukuran" aria-label="Hapus ukuran">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
        </button>
      </div>
    <% }); %>
  </div>
</div>

<div class="form-card prod-size-builder-card">
  <div class="admin-card-header-flex">
    <div class="form-card-title admin-card-title-plain">4. Tabel Ukuran (ID) / Size Table (EN)</div>
    <div class="prod-size-actions">
      <button type="button" id="btnCopySizeColumns" class="btn-add-row btn-copy-columns" title="Salin struktur kolom dari produk lain">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <span>Salin Kolom</span>
      </button>
      <button type="button" id="btnAddSizeColumn" class="btn-add-row btn-add-col" title="Tambah kolom baru (maks 8)">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span>Tambah Kolom</span>
      </button>
      <button type="button" id="btnAddSizeRow" class="btn-add-row" title="Tambah baris baru (maks 30)">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span>Tambah Baris</span>
      </button>
    </div>
  </div>
  <p class="admin-field-hint">Definisikan struktur kolom dan nilai spesifikasi dimensi produk. Maksimal 8 kolom dan 30 baris.</p>
  <div class="table-scroll-wrapper prod-size-builder" id="dynamicSizeEditor" data-initial='<%- initialSizeTable %>'></div>
  <input type="hidden" name="size_table" id="inputSizeTable" value="">
  <span class="sr-only" aria-hidden="true" data-compat="kode_produk[] tebal_micron[]"></span>
</div>

<div class="admin-modal-backdrop" id="modalCopySizeColumns" role="dialog" aria-modal="true" aria-labelledby="modalCopyTitle" aria-hidden="true">
  <div class="admin-modal-card">
    <div class="admin-modal-header">
      <div class="admin-modal-title" id="modalCopyTitle">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <span>Salin Struktur Kolom dari Produk Lain</span>
      </div>
      <button type="button" class="modal-close-btn admin-modal-close" id="btnCloseCopyModal" aria-label="Tutup Modal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <div class="admin-modal-body">
      <p class="modal-copy-desc">Pilih produk sumber untuk menduplikasi label dan urutan kolomnya. Data baris/sel produk ini akan dikosongkan dan ID kolom baru dibuat terisolasi khusus untuk produk ini.</p>
      <div class="form-group">
        <label for="selectCopyProduct" class="modal-copy-label">Pilih Produk Sumber:</label>
        <select id="selectCopyProduct" class="form-input form-select modal-copy-select" data-eu-dropdown="outlined">
          <option value="">-- Pilih Produk --</option>
          <% if (typeof productsList !== 'undefined' && Array.isArray(productsList)) { %>
            <% productsList.forEach(function(item) { %>
              <option value="<%= item.id %>"><%= item.name_id %> (<%= item.name_en || item.name_id %>)</option>
            <% }); %>
          <% } %>
        </select>
      </div>
      <div id="copyColumnsPreview" class="modal-copy-preview">
        <label class="modal-copy-preview-label">Pratinjau Kolom yang Akan Disalin:</label>
        <div id="copyColumnsBadgeList" class="modal-copy-badges"></div>
      </div>
    </div>
    <div class="admin-modal-footer modal-copy-footer">
      <button type="button" class="adm-btn adm-btn-neutral" id="btnCancelCopyModal" aria-label="Batalkan salin kolom">
        <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        <span>Batal</span>
      </button>
      <button type="button" class="adm-btn adm-btn-primary" id="btnConfirmCopyColumns" disabled aria-label="Konfirmasi salin struktur kolom">
        <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Salin</span>
      </button>
    </div>
  </div>
</div>

<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Tambah Produk Baru</h1>
    <p>Daftarkan produk kemasan manufaktur lengkap dengan spesifikasi teknis dan varian.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/products" class="adm-btn adm-btn-neutral" aria-label="Kembali ke daftar produk">
      <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      <span>Kembali</span>
    </a>
  </div>
</div>

<form action="/admin/products?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" id="productCreateForm">
  <div class="form-card">
    <div class="form-card-title">1. Informasi Pokok Produk</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="name_id">Nama Produk (Bahasa Indonesia) *</label>
        <input type="text" id="name_id" name="name_id" class="form-input" required placeholder="Contoh: Kantong Kresek HDPE Super Tebal" value="<%= typeof formData !== 'undefined' && formData?.name_id ? formData.name_id : '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="name_en">Nama Produk (English)</label>
        <input type="text" id="name_en" name="name_en" class="form-input" placeholder="Example: Heavy Duty HDPE Shopping Bag" value="<%= typeof formData !== 'undefined' && formData?.name_en ? formData.name_en : '' %>">
      </div>
    </div>

    <div class="form-row-3">
      <div class="form-group">
        <label class="form-label" for="category_id">Kategori Produk *</label>
        <select id="category_id" name="category_id" class="form-select">
          <option value="">Pilih Kategori...</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>" <%= typeof formData !== 'undefined' && String(formData?.category_id) === String(cat.id) ? 'selected' : '' %>><%= cat.name_id %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="status">Status Publikasi</label>
        <select id="status" name="status" class="form-select">
          <option value="published" selected>Published (Tayang Publik)</option>
          <option value="draft">Draft (Disimpan Sementara)</option>
          <option value="archived">Archived (Diarsipkan)</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="sort_order">Nomor Urutan Tampil</label>
        <input type="number" id="sort_order" name="sort_order" class="form-input" value="<%= typeof formData !== 'undefined' && formData?.sort_order !== undefined ? formData.sort_order : '0' %>" min="0">
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="cta_text_id">Teks Tombol CTA (ID)</label>
        <input type="text" id="cta_text_id" name="cta_text_id" class="form-input" maxlength="50" placeholder="Default: Minta Penawaran via WhatsApp" value="<%= typeof formData !== 'undefined' && formData?.cta_text_id ? formData.cta_text_id : '' %>">
        <p class="admin-field-hint">Kosongkan untuk menggunakan teks default: "Minta Penawaran via WhatsApp". Maksimal 50 karakter.</p>
      </div>
      <div class="form-group">
        <label class="form-label" for="cta_text_en">Teks Tombol CTA (EN)</label>
        <input type="text" id="cta_text_en" name="cta_text_en" class="form-input" maxlength="50" placeholder="Default: Request Quote via WhatsApp" value="<%= typeof formData !== 'undefined' && formData?.cta_text_en ? formData.cta_text_en : '' %>">
        <p class="admin-field-hint">Leave empty to use default: "Request Quote via WhatsApp". Max 50 characters.</p>
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="short_description_id">Deskripsi Singkat (ID)</label>
        <textarea id="short_description_id" name="short_description_id" class="form-textarea" rows="3" maxlength="200" placeholder="Deskripsi singkat produk, tampil di bawah judul…"><%= typeof formData !== 'undefined' && formData?.short_description_id ? formData.short_description_id : '' %></textarea>
        <div class="char-counter" id="counter_short_desc_id">0/200</div>
      </div>
      <div class="form-group">
        <label class="form-label" for="short_description_en">Deskripsi Singkat (EN)</label>
        <textarea id="short_description_en" name="short_description_en" class="form-textarea" rows="3" maxlength="200" placeholder="Deskripsi singkat produk, tampil di bawah judul…"><%= typeof formData !== 'undefined' && formData?.short_description_en ? formData.short_description_en : '' %></textarea>
        <div class="char-counter" id="counter_short_desc_en">0/200</div>
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="description_id">Deskripsi Lengkap (Bahasa Indonesia)</label>
        <textarea id="description_id" name="description_id" class="form-textarea" placeholder="Jelaskan aplikasi penggunaan, ketahanan beban, dan keunggulan produk..."><%= typeof formData !== 'undefined' && formData?.description_id ? formData.description_id : '' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="description_en">Deskripsi Lengkap (English)</label>
        <textarea id="description_en" name="description_en" class="form-textarea" placeholder="Explain product applications, tensile strength, and key features..."><%= typeof formData !== 'undefined' && formData?.description_en ? formData.description_en : '' %></textarea>
      </div>
    </div>
  </div>

  <div class="form-card">
    <div class="form-card-title">2. Foto Utama &amp; Galeri Produk</div>
    
    <div class="form-group">
      <label class="form-label">Foto Utama Produk (Media Library)</label>
      <div class="media-picker-component">
        <input type="hidden" id="product_image_url" name="image_url" value="<%= typeof formData !== 'undefined' && formData?.image_url ? formData.image_url : '' %>">
        <div class="media-picker-preview-box">
          <img src="<%= typeof formData !== 'undefined' && formData?.image_url ? formData.image_url : '' %>" alt="Pratinjau Produk" class="media-picker-preview-img <%= typeof formData !== 'undefined' && formData?.image_url ? '' : 'hidden' %>">
          <div class="media-picker-empty <%= typeof formData !== 'undefined' && formData?.image_url ? 'hidden' : '' %>">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Belum ada foto produk dipilih</span>
          </div>
        </div>
        <div class="media-picker-ctrls">
          <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="product_image_url" data-picker-type="image">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Pilih dari Media Library</span>
          </button>
          <button type="button" class="btn btn-ghost btn-sm btn-clear-media <%= typeof formData !== 'undefined' && formData?.image_url ? '' : 'hidden' %>">Hapus</button>
        </div>
      </div>
    </div>

    <div class="form-group prod-gallery-form-group">
      <label class="form-label">Foto Gallery (ID) / Gallery Photos (EN)</label>
      <div class="prod-gallery-wrap">
        <div class="prod-gallery-actions">
          <button type="button" class="btn btn-secondary btn-sm" id="btnOpenGalleryPicker">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Pilih Foto dari Library</span>
          </button>
          <span class="prod-gallery-hint">Pilih beberapa foto sekaligus. Atur urutan dengan tombol ▲ ▼ atau hapus dengan &times;.</span>
        </div>
        <input type="hidden" id="gallery_images_input" name="gallery_images" value="<%= typeof formData !== 'undefined' && formData?.gallery_images ? (typeof formData.gallery_images === 'string' ? formData.gallery_images : JSON.stringify(formData.gallery_images)) : '[]' %>">
        <div class="prod-gallery-strip" id="prodGalleryStrip"></div>
      </div>
    </div>
  </div>

  <div class="form-card">
    <div class="admin-card-header-flex">
      <div class="form-card-title admin-card-title-plain">3. Variasi Ukuran (ID) / Size Variants (EN)</div>
      <button type="button" id="btnAddVariant" class="btn-add-row">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span>Tambah Ukuran</span>
      </button>
    </div>
    <p class="admin-field-hint">Daftar variasi ukuran yang tampil sebagai pil interaktif di halaman publik.</p>
    <div id="variantsContainer">
      <div class="prod-variant-row-item">
        <input type="text" name="variant_labels[]" class="form-input" placeholder="Contoh: 24 x 40 cm (40 Micron)" value="24 x 40 cm (40 Micron)">
        <button type="button" class="btn-row-action btn-row-delete btn-remove-variant" title="Hapus ukuran" aria-label="Hapus ukuran">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
        </button>
      </div>
      <div class="prod-variant-row-item">
        <input type="text" name="variant_labels[]" class="form-input" placeholder="Contoh: 28 x 48 cm (45 Micron)" value="28 x 48 cm (45 Micron)">
        <button type="button" class="btn-row-action btn-row-delete btn-remove-variant" title="Hapus ukuran" aria-label="Hapus ukuran">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="form-card prod-size-builder-card">
    <div class="admin-card-header-flex">
      <div class="form-card-title admin-card-title-plain">4. Tabel Ukuran (ID) / Size Table (EN)</div>
      <div class="prod-size-actions">
        <button type="button" id="btnCopySizeColumns" class="btn-add-row btn-copy-columns" title="Salin struktur kolom dari produk lain">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span>Salin Kolom</span>
        </button>
        <button type="button" id="btnAddSizeColumn" class="btn-add-row btn-add-col" title="Tambah kolom baru (maks 8)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Tambah Kolom</span>
        </button>
        <button type="button" id="btnAddSizeRow" class="btn-add-row" title="Tambah baris baru (maks 30)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Tambah Baris</span>
        </button>
      </div>
    </div>
    <p class="admin-field-hint">Definisikan struktur kolom dan nilai spesifikasi dimensi produk. Maksimal 8 kolom dan 30 baris.</p>
    <div class="table-scroll-wrapper prod-size-builder" id="dynamicSizeEditor" data-initial='{"columns":[{"id":"col_1","label":"Kode Produk"},{"id":"col_2","label":"Lebar"},{"id":"col_3","label":"Panjang"},{"id":"col_4","label":"Tebal (Micron)"},{"id":"col_5","label":"Kapasitas"},{"id":"col_6","label":"Bahan"}],"rows":[{"col_1":"SL-3040","col_2":"30 cm","col_3":"40 cm","col_4":"40 micron","col_5":"5 kg","col_6":"HDPE Virgin"}]}'></div>
    <input type="hidden" name="size_table" id="inputSizeTable" value="">
    <span class="sr-only" aria-hidden="true" data-compat="kode_produk[] tebal_micron[]"></span>
  </div>

  <div class="admin-modal-backdrop" id="modalCopySizeColumns" role="dialog" aria-modal="true" aria-labelledby="modalCopyTitle" aria-hidden="true">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <div class="admin-modal-title" id="modalCopyTitle">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span>Salin Struktur Kolom dari Produk Lain</span>
        </div>
        <button type="button" class="modal-close-btn admin-modal-close" id="btnCloseCopyModal" aria-label="Tutup Modal">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="admin-modal-body">
        <p class="modal-copy-desc">
          Pilih produk sumber untuk menduplikasi label dan urutan kolomnya. Data baris/sel produk ini akan dikosongkan dan ID kolom baru dibuat terisolasi khusus untuk produk ini.
        </p>
        <div class="form-group">
          <label for="selectCopyProduct" class="modal-copy-label">Pilih Produk Sumber:</label>
          <select id="selectCopyProduct" class="form-input form-select modal-copy-select">
            <option value="">-- Pilih Produk --</option>
            <% if (typeof productsList !== 'undefined' && Array.isArray(productsList)) { %>
              <% productsList.forEach(function(p) { %>
                <option value="<%= p.id %>"><%= p.name_id %> (<%= p.name_en || p.name_id %>)</option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <div id="copyColumnsPreview" class="modal-copy-preview">
          <label class="modal-copy-preview-label">Pratinjau Kolom yang Akan Disalin:</label>
          <div id="copyColumnsBadgeList" class="modal-copy-badges"></div>
        </div>
      </div>
      <div class="admin-modal-footer modal-copy-footer">
        <button type="button" class="adm-btn adm-btn-neutral" id="btnCancelCopyModal" aria-label="Batalkan salin kolom">
          <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          <span>Batal</span>
        </button>
        <button type="button" class="adm-btn adm-btn-primary" id="btnConfirmCopyColumns" disabled aria-label="Konfirmasi salin struktur kolom">
          <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Salin</span>
        </button>
      </div>
    </div>
  </div>

  <div class="form-card">
    <div class="form-card-title">5. Pengaturan Meta SEO (Mesin Pencari Google)</div>
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="meta_title_id">Meta Title (ID)</label>
        <input type="text" id="meta_title_id" name="meta_title_id" class="form-input" placeholder="Judul pada tab browser &amp; Google" value="<%= typeof formData !== 'undefined' && formData?.meta_title_id ? formData.meta_title_id : '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="meta_title_en">Meta Title (EN)</label>
        <input type="text" id="meta_title_en" name="meta_title_en" class="form-input" placeholder="Browser title for English visitors" value="<%= typeof formData !== 'undefined' && formData?.meta_title_en ? formData.meta_title_en : '' %>">
      </div>
    </div>
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="meta_desc_id">Meta Description (ID)</label>
        <textarea id="meta_desc_id" name="meta_desc_id" class="form-textarea" placeholder="Ringkasan 1-2 kalimat untuk snippet Google pencarian Indonesia..."><%= typeof formData !== 'undefined' && formData?.meta_desc_id ? formData.meta_desc_id : '' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="meta_desc_en">Meta Description (EN)</label>
        <textarea id="meta_desc_en" name="meta_desc_en" class="form-textarea" placeholder="1-2 sentences summary for Google English snippets..."><%= typeof formData !== 'undefined' && formData?.meta_desc_en ? formData.meta_desc_en : '' %></textarea>
      </div>
    </div>
  </div>

  <div class="form-actions-bar form-actions-sticky">
    <a href="/admin/products" class="adm-btn adm-btn-neutral" aria-label="Batalkan penambahan produk">
      <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      <span>Batal</span>
    </a>
    <button type="submit" class="adm-btn adm-btn-primary btn-submit-form" aria-label="Simpan produk baru">
      <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
      <span>Simpan</span>
    </button>
  </div>
</form>

<script>
  (function() {
    function setupCharCounter(textareaId, counterId, maxLen) {
      const textarea = document.getElementById(textareaId);
      const counter = document.getElementById(counterId);
      if (!textarea || !counter) return;

      function update() {
        const len = textarea.value.length;
        counter.textContent = `${len}/${maxLen}`;
        if (maxLen - len <= 10) {
          counter.classList.add('text-danger', 'counter-danger');
        } else {
          counter.classList.remove('text-danger', 'counter-danger');
        }
      }

      textarea.addEventListener('input', update);
      update();
    }

    setupCharCounter('short_description_id', 'counter_short_desc_id', 200);
    setupCharCounter('short_description_en', 'counter_short_desc_en', 200);

    const galleryStrip = document.getElementById('prodGalleryStrip');
    const galleryInput = document.getElementById('gallery_images_input');
    const btnOpenGallery = document.getElementById('btnOpenGalleryPicker');

    function updateGalleryInput() {
      if (!galleryStrip || !galleryInput) return;
      const items = galleryStrip.querySelectorAll('.prod-gallery-item');
      const list = [];
      items.forEach(el => {
        const id = el.getAttribute('data-id');
        if (id && /^\d+$/.test(id)) {
          list.push(parseInt(id, 10));
        } else if (el.getAttribute('data-url')) {
          list.push(el.getAttribute('data-url'));
        }
      });
      galleryInput.value = JSON.stringify(list);
    }

    function createGalleryItem(item) {
      const id = item.id || '';
      const url = item.file_url || item.url || '';
      if (!url) return null;

      const div = document.createElement('div');
      div.className = 'prod-gallery-item';
      div.setAttribute('data-id', id);
      div.setAttribute('data-url', url);

      div.innerHTML = `
        <div class="prod-gallery-thumb-box">
          <img src="${url}" alt="" class="prod-gallery-thumb" width="64" height="64" loading="lazy">
          <button type="button" class="prod-gallery-btn-del" title="Hapus foto" aria-label="Hapus foto">&times;</button>
        </div>
        <div class="prod-gallery-reorder">
          <button type="button" class="prod-gallery-btn-move prod-gallery-btn-up" title="Geser ke kiri / atas" aria-label="Geser ke kiri">&#9650;</button>
          <button type="button" class="prod-gallery-btn-move prod-gallery-btn-down" title="Geser ke kanan / bawah" aria-label="Geser ke kanan">&#9660;</button>
        </div>
      `;

      div.querySelector('.prod-gallery-btn-del').addEventListener('click', () => {
        div.remove();
        updateGalleryInput();
      });

      div.querySelector('.prod-gallery-btn-up').addEventListener('click', () => {
        const prev = div.previousElementSibling;
        if (prev) {
          galleryStrip.insertBefore(div, prev);
          updateGalleryInput();
        }
      });

      div.querySelector('.prod-gallery-btn-down').addEventListener('click', () => {
        const next = div.nextElementSibling;
        if (next) {
          galleryStrip.insertBefore(next, div);
          updateGalleryInput();
        }
      });

      return div;
    }

    if (btnOpenGallery) {
      btnOpenGallery.addEventListener('click', () => {
        if (typeof window.openMediaPicker === 'function') {
          window.openMediaPicker({
            multiple: true,
            type: 'image',
            onSelect: (selectedList) => {
              if (Array.isArray(selectedList)) {
                selectedList.forEach(m => {
                  const existing = galleryStrip.querySelector(`[data-id="${m.id}"], [data-url="${m.file_url}"]`);
                  if (!existing) {
                    const el = createGalleryItem(m);
                    if (el) galleryStrip.appendChild(el);
                  }
                });
                updateGalleryInput();
              }
            }
          });
        }
      });
    }

    const btnAddVariant = document.getElementById('btnAddVariant');
    const variantsContainer = document.getElementById('variantsContainer');

    function createVariantRow(val = '') {
      const div = document.createElement('div');
      div.className = 'prod-variant-row-item';
      div.innerHTML = `
        <input type="text" name="variant_labels[]" class="form-input" placeholder="Contoh: 24 x 40 cm (40 Micron)" value="${val}">
        <button type="button" class="btn-row-action btn-row-delete btn-remove-variant" title="Hapus varian" aria-label="Hapus varian">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
        </button>
      `;
      div.querySelector('.btn-remove-variant').addEventListener('click', () => {
        const rows = variantsContainer.querySelectorAll('.prod-variant-row-item');
        if (rows.length > 1) {
          div.remove();
        } else {
          div.querySelector('input').value = '';
        }
      });
      return div;
    }

    if (btnAddVariant && variantsContainer) {
      btnAddVariant.addEventListener('click', () => {
        const row = createVariantRow('');
        variantsContainer.appendChild(row);
        row.querySelector('input').focus();
      });

      variantsContainer.querySelectorAll('.btn-remove-variant').forEach(btn => {
        btn.addEventListener('click', () => {
          const row = btn.closest('.prod-variant-row-item');
          const rows = variantsContainer.querySelectorAll('.prod-variant-row-item');
          if (rows.length > 1) {
            row.remove();
          } else {
            row.querySelector('input').value = '';
          }
        });
      });
    }

  })();
</script>


<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Tambah Produk Baru</h1>
    <p>Daftarkan produk kemasan manufaktur lengkap dengan spesifikasi teknis dan varian.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/products" class="btn btn-secondary">&larr; Kembali ke Katalog</a>
  </div>
</div>

<form action="/admin/products?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
  <!-- Card 1: Informasi Utama -->
  <div class="form-card">
    <div class="form-card-title">1. Informasi Pokok Produk</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="name_id">Nama Produk (Bahasa Indonesia) *</label>
        <input type="text" id="name_id" name="name_id" class="form-input" required placeholder="Contoh: Kantong Kresek HDPE Super Tebal">
      </div>
      <div class="form-group">
        <label class="form-label" for="name_en">Nama Produk (English)</label>
        <input type="text" id="name_en" name="name_en" class="form-input" placeholder="Example: Heavy Duty HDPE Shopping Bag">
      </div>
    </div>

    <div class="form-row-3">
      <div class="form-group">
        <label class="form-label" for="category_id">Kategori Produk *</label>
        <select id="category_id" name="category_id" class="form-select">
          <option value="">Pilih Kategori...</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>"><%= cat.name_id %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="status">Status Publikasi</label>
        <select id="status" name="status" class="form-select">
          <option value="published" selected>Published (Tayang Publik)</option>
          <option value="draft">Draft (Disimpan Sementara)</option>
          <option value="archived">Archived (Diarsipkan)</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="sort_order">Nomor Urutan Tampil</label>
        <input type="number" id="sort_order" name="sort_order" class="form-input" value="0" min="0">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="material_specs">Ringkasan Karakteristik Material</label>
      <input type="text" id="material_specs" name="material_specs" class="form-input" placeholder="Contoh: 100% Virgin HDPE Resins &bull; Food Contact Grade &bull; Ekolabel Ramah Lingkungan">
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="description_id">Deskripsi Lengkap (Bahasa Indonesia)</label>
        <textarea id="description_id" name="description_id" class="form-textarea" placeholder="Jelaskan aplikasi penggunaan, ketahanan beban, dan keunggulan produk..."></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="description_en">Deskripsi Lengkap (English)</label>
        <textarea id="description_en" name="description_en" class="form-textarea" placeholder="Explain product applications, tensile strength, and key features..."></textarea>
      </div>
    </div>

    <div class="form-group">
      <label class="form-check">
        <input type="checkbox" name="featured" value="1">
        <span>Tampilkan sebagai Produk Unggulan (Featured Product) di Beranda</span>
      </label>
    </div>
  </div>

  <!-- Card 2: Foto Produk -->
  <div class="form-card">
    <div class="form-card-title">2. Foto Utama Produk</div>
    <div class="form-group" style="margin-bottom: 0;">
      <label class="form-label">Foto Utama Produk (Media Library)</label>
      <div class="media-picker-component">
        <input type="hidden" id="product_image_url" name="image_url" value="<%= typeof formData !== 'undefined' && formData?.image_url ? formData.image_url : '' %>">
        <div class="media-picker-preview-box">
          <img src="<%= typeof formData !== 'undefined' && formData?.image_url ? formData.image_url : '' %>" alt="Pratinjau Produk" style="<%= typeof formData !== 'undefined' && formData?.image_url ? 'display: block;' : 'display: none;' %>">
          <div class="media-picker-empty" style="<%= typeof formData !== 'undefined' && formData?.image_url ? 'display: none;' : '' %>">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Belum ada foto produk dipilih</span>
          </div>
        </div>
        <div class="media-picker-ctrls">
          <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="product_image_url" data-picker-type="image">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            Pilih dari Media Library
          </button>
          <button type="button" class="btn btn-ghost btn-sm btn-clear-media" style="<%= typeof formData !== 'undefined' && formData?.image_url ? '' : 'display: none;' %>">Hapus</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 3: Spesifikasi Teknis Dinamis -->
  <div class="form-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 8px;">
      <div class="form-card-title" style="margin-bottom: 0; border: none; padding: 0;">3. Tabel Spesifikasi Teknis (Parameter &amp; Nilai)</div>
      <button type="button" id="btnAddSpecRow" class="btn-add-row" onclick="addSpecRow()">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span>Tambah Baris Parameter</span>
      </button>
    </div>

    <div id="specsContainer">
      <div class="spec-item-row">
        <div class="spec-col-key">
          <input type="text" name="spec_key[]" class="form-input" placeholder="Parameter (misal: Bahan Baku)" value="Bahan Baku">
        </div>
        <div class="spec-col-val">
          <input type="text" name="spec_val[]" class="form-input" placeholder="Nilai (misal: High Density Polyethylene)" value="High Density Polyethylene (HDPE)">
        </div>
        <div class="spec-col-action">
          <button type="button" class="btn-row-action btn-row-delete btn-remove-spec" onclick="removeSpecRow(this)" title="Hapus baris" aria-label="Hapus baris">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          </button>
        </div>
      </div>
      <div class="spec-item-row">
        <div class="spec-col-key">
          <input type="text" name="spec_key[]" class="form-input" placeholder="Parameter" value="Standar Mutu">
        </div>
        <div class="spec-col-val">
          <input type="text" name="spec_val[]" class="form-input" placeholder="Nilai" value="SNI &amp; ISO 9001:2015">
        </div>
        <div class="spec-col-action">
          <button type="button" class="btn-row-action btn-row-delete btn-remove-spec" onclick="removeSpecRow(this)" title="Hapus baris" aria-label="Hapus baris">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          </button>
        </div>
      </div>
      <div class="spec-item-row">
        <div class="spec-col-key">
          <input type="text" name="spec_key[]" class="form-input" placeholder="Parameter" value="Sifat Biodegradable">
        </div>
        <div class="spec-col-val">
          <input type="text" name="spec_val[]" class="form-input" placeholder="Nilai" value="Tersedia varian 100% degradable (Oxo/Bio)">
        </div>
        <div class="spec-col-action">
          <button type="button" class="btn-row-action btn-row-delete btn-remove-spec" onclick="removeSpecRow(this)" title="Hapus baris" aria-label="Hapus baris">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 4: Varian Produk Dinamis -->
  <div class="form-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 8px;">
      <div class="form-card-title" style="margin-bottom: 0; border: none; padding: 0;">4. Varian Ukuran &amp; Spesifikasi Produk</div>
      <button type="button" id="btnAddVariantRow" class="btn-add-row" onclick="addVariantRow()">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span>Tambah Baris Varian</span>
      </button>
    </div>

    <div class="table-scroll-wrapper">
      <table class="data-table" id="variantsTable">
        <thead>
          <tr>
            <th>Ukuran / Dimensi (cm/inch)</th>
            <th>Ketebalan (Micron)</th>
            <th>Pilihan Warna</th>
            <th>Bahan / Tipe</th>
            <th style="width: 54px; text-align: center;">Aksi</th>
          </tr>
        </thead>
        <tbody id="variantsBody">
          <tr>
            <td><input type="text" name="var_size[]" class="form-input" placeholder="24 x 40 cm" value="24 x 40 cm"></td>
            <td><input type="text" name="var_thickness[]" class="form-input" placeholder="0.035 mm" value="0.035 mm"></td>
            <td><input type="text" name="var_color[]" class="form-input" placeholder="Putih, Hitam, Merah" value="Putih, Merah"></td>
            <td><input type="text" name="var_material[]" class="form-input" placeholder="HDPE Standard" value="HDPE Virgin"></td>
            <td style="text-align: center; vertical-align: middle;">
              <button type="button" class="btn-row-action btn-row-delete btn-remove-variant" onclick="removeVariantRow(this)" title="Hapus varian" aria-label="Hapus varian">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
              </button>
            </td>
          </tr>
          <tr>
            <td><input type="text" name="var_size[]" class="form-input" placeholder="28 x 48 cm" value="28 x 48 cm"></td>
            <td><input type="text" name="var_thickness[]" class="form-input" placeholder="0.040 mm" value="0.040 mm"></td>
            <td><input type="text" name="var_color[]" class="form-input" placeholder="Putih, Hitam" value="Putih, Hitam"></td>
            <td><input type="text" name="var_material[]" class="form-input" placeholder="HDPE Standard" value="HDPE Virgin"></td>
            <td style="text-align: center; vertical-align: middle;">
              <button type="button" class="btn-row-action btn-row-delete btn-remove-variant" onclick="removeVariantRow(this)" title="Hapus varian" aria-label="Hapus varian">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Card 5: Optimasi SEO -->
  <div class="form-card">
    <div class="form-card-title">5. Pengaturan Meta SEO (Mesin Pencari Google)</div>
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="meta_title_id">Meta Title (ID)</label>
        <input type="text" id="meta_title_id" name="meta_title_id" class="form-input" placeholder="Judul pada tab browser &amp; Google">
      </div>
      <div class="form-group">
        <label class="form-label" for="meta_title_en">Meta Title (EN)</label>
        <input type="text" id="meta_title_en" name="meta_title_en" class="form-input" placeholder="Browser title for English visitors">
      </div>
    </div>
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="meta_desc_id">Meta Description (ID)</label>
        <textarea id="meta_desc_id" name="meta_desc_id" class="form-textarea" placeholder="Ringkasan 1-2 kalimat untuk snippet Google pencarian Indonesia..."></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="meta_desc_en">Meta Description (EN)</label>
        <textarea id="meta_desc_en" name="meta_desc_en" class="form-textarea" placeholder="1-2 sentences summary for Google English snippets..."></textarea>
      </div>
    </div>
  </div>

  <div class="form-actions-bar" style="margin-bottom: 2rem;">
    <a href="/admin/products" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary" style="padding: 8px 20px; font-size: 13px;">Simpan Produk Baru</button>
  </div>
</form>

<script>
  function addSpecRow() {
    const container = document.getElementById('specsContainer');
    const div = document.createElement('div');
    div.className = 'spec-item-row';
    div.innerHTML = `
      <div class="spec-col-key">
        <input type="text" name="spec_key[]" class="form-input" placeholder="Parameter (misal: Warna)">
      </div>
      <div class="spec-col-val">
        <input type="text" name="spec_val[]" class="form-input" placeholder="Nilai (misal: Transparan / Custom)">
      </div>
      <div class="spec-col-action">
        <button type="button" class="btn-row-action btn-row-delete btn-remove-spec" onclick="removeSpecRow(this)" title="Hapus baris" aria-label="Hapus baris">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
        </button>
      </div>
    `;
    container.appendChild(div);
    div.querySelector('input').focus();
  }
  window.addSpecRow = addSpecRow;

  function removeSpecRow(btn) {
    const container = document.getElementById('specsContainer');
    const rows = container.querySelectorAll('.spec-item-row, .form-row-2');
    if (rows.length <= 1) {
      if (typeof showToast === 'function') {
        showToast('Minimal 1 baris spesifikasi teknis harus tersedia.');
      } else {
        alert('Minimal 1 baris spesifikasi teknis harus tersedia.');
      }
      return;
    }
    const row = btn.closest('.spec-item-row, .form-row-2');
    if (row) row.remove();
  }
  window.removeSpecRow = removeSpecRow;

  function addVariantRow() {
    const tbody = document.getElementById('variantsBody');
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><input type="text" name="var_size[]" class="form-input" placeholder="Ukuran"></td>
      <td><input type="text" name="var_thickness[]" class="form-input" placeholder="Tebal"></td>
      <td><input type="text" name="var_color[]" class="form-input" placeholder="Warna"></td>
      <td><input type="text" name="var_material[]" class="form-input" placeholder="Bahan"></td>
      <td style="text-align: center; vertical-align: middle;">
        <button type="button" class="btn-row-action btn-row-delete btn-remove-variant" onclick="removeVariantRow(this)" title="Hapus varian" aria-label="Hapus varian">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
        </button>
      </td>
    `;
    tbody.appendChild(tr);
    tr.querySelector('input').focus();
  }
  window.addVariantRow = addVariantRow;

  function removeVariantRow(btn) {
    const tbody = document.getElementById('variantsBody');
    const rows = tbody.querySelectorAll('tr');
    if (rows.length <= 1) {
      if (typeof showToast === 'function') {
        showToast('Minimal 1 baris varian ukuran harus tersedia.');
      } else {
        alert('Minimal 1 baris varian ukuran harus tersedia.');
      }
      return;
    }
    const row = btn.closest('tr');
    if (row) row.remove();
  }
  window.removeVariantRow = removeVariantRow;

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('btnAddSpecRow')?.addEventListener('click', addSpecRow);
    document.getElementById('btnAddVariantRow')?.addEventListener('click', addVariantRow);
  });
</script>

<%- include('../../partials/admin-footer') %>

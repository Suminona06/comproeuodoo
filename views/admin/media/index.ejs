<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Media Library Terpadu</h1>
    <p>Penyimpanan aset terpusat untuk gambar WebP terkompresi, video MP4/WebM, dokumen PDF, dan video YouTube.</p>
  </div>
  <div class="header-actions">
    <button type="button" class="btn btn-secondary" onclick="openAdminModal('youtubeModal')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
      <span>Tautan YouTube</span>
    </button>
    <button type="button" class="btn btn-primary" onclick="openAdminModal('uploadModal')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
      <span>Unggah Berkas</span>
    </button>
  </div>
</div>

<div class="table-card">
  <div class="table-toolbar">
    <div class="filter-tabs-wrap">
      <a href="/admin/media?type=all" class="tab-btn <%= currentType === 'all' ? 'active' : '' %>">
        Semua (<%= countsByType.all %>)
      </a>
      <a href="/admin/media?type=image" class="tab-btn <%= currentType === 'image' ? 'active' : '' %>">
        Gambar (<%= countsByType.image %>)
      </a>
      <a href="/admin/media?type=video" class="tab-btn <%= currentType === 'video' ? 'active' : '' %>">
        Video (<%= countsByType.video %>)
      </a>
      <a href="/admin/media?type=document" class="tab-btn <%= currentType === 'document' ? 'active' : '' %>">
        Dokumen (<%= countsByType.document %>)
      </a>
      <a href="/admin/media?type=youtube" class="tab-btn <%= currentType === 'youtube' ? 'active' : '' %>">
        YouTube (<%= countsByType.youtube %>)
      </a>
    </div>

    <form action="/admin/media" method="GET" class="search-input-wrap">
      <input type="hidden" name="type" value="<%= currentType %>">
      <svg class="search-icon-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" name="search" placeholder="Cari nama berkas..." value="<%= searchQuery %>" aria-label="Cari berkas">
    </form>
  </div>

  <div style="padding: 1.25rem;">
    <% if (mediaList && mediaList.length > 0) { %>
      <div class="media-grid">
        <% mediaList.forEach(function(item) { %>
          <div class="media-item">
            <div class="media-preview-box">
              <% if (item.media_type === 'image') { %>
                <img src="<%= item.file_url %>" alt="<%= item.filename %>" loading="lazy">
              <% } else if (item.media_type === 'youtube') { %>
                <div style="display: flex; flex-direction: column; align-items: center; gap: 4px; color: #dc2626;">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  <span style="font-size: 10px; font-weight: 700;">YouTube</span>
                </div>
              <% } else if (item.media_type === 'video') { %>
                <div style="display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--primary);">
                  <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                  <span style="font-size: 10px; font-weight: 700;">Video File</span>
                </div>
              <% } else { %>
                <div style="display: flex; flex-direction: column; align-items: center; gap: 4px; color: #b45309;">
                  <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  <span style="font-size: 10px; font-weight: 700;">Dokumen PDF</span>
                </div>
              <% } %>
            </div>

            <div class="media-info">
              <div class="media-name" title="<%= item.filename %>"><%= item.filename %></div>
              <div class="media-meta-txt">
                <%= item.media_type.toUpperCase() %>
                <% if (item.file_size > 0) { %>
                  &bull; <%= (item.file_size / 1024).toFixed(0) %> KB
                <% } %>
              </div>
            </div>

            <div class="media-actions">
              <button type="button" class="btn-action btn-action-view" onclick="copyToClipboard('<%= item.file_url %>')">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span>Salin URL</span>
              </button>

              <% if (['superadmin', 'admin'].includes(user?.role)) { %>
                <form action="/admin/media/<%= item.id %>/delete?_csrf=<%= csrfToken %>" method="POST" data-confirm-delete="true" data-confirm-message="Hapus berkas media ini secara permanen?" data-confirm-title="Hapus Media" data-media-url="<%= item.file_url %>" style="margin: 0; display: inline-flex;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-action btn-action-delete" title="Hapus Berkas">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <span>Hapus</span>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div style="display: flex; justify-content: center; gap: 6px; margin-top: 1.5rem;">
          <% for (let p = 1; p <= totalPages; p++) { %>
            <a href="/admin/media?type=<%= currentType %>&search=<%= searchQuery %>&page=<%= p %>"
               class="btn btn-sm <%= p === currentPage ? 'btn-primary' : 'btn-secondary' %>">
              <%= p %>
            </a>
          <% } %>
        </div>
      <% } %>

    <% } else { %>
      <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
        <p style="font-weight: 600; font-size: 14px;">Belum ada berkas media yang tersimpan.</p>
        <p style="font-size: 12px; margin-top: 4px;">Klik tombol "Unggah Berkas" untuk menambahkan gambar, dokumen, atau video.</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Modal 1: Upload File -->
<div class="admin-modal-backdrop" id="uploadModal">
  <div class="admin-modal-card">
    <div class="admin-modal-header">
      <div class="admin-modal-title">
        <svg width="18" height="18" fill="none" stroke="var(--primary)" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        <span>Unggah Berkas ke Media Library</span>
      </div>
      <button type="button" class="modal-close-btn admin-modal-close" onclick="closeAdminModal('uploadModal')" aria-label="Tutup Dialog">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form action="/admin/media/upload?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
      <div class="admin-modal-body">
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="file">Pilih Berkas *</label>
          <div class="custom-file-upload">
            <input type="file" id="file" name="file" required accept="image/*,video/mp4,video/webm,application/pdf">
            <div class="file-upload-dropzone" tabindex="0" role="button" aria-label="Pilih atau seret berkas">
              <div class="file-upload-preview">
                <img src="" alt="Pratinjau" style="display: none;">
                <div class="preview-placeholder-icon">
                  <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                </div>
              </div>
              <div class="file-upload-content">
                <div class="file-upload-header">
                  <span class="file-upload-btn-pill">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                    <span>Pilih Berkas</span>
                  </span>
                  <span class="file-upload-label">atau seret ke sini</span>
                </div>
                <div class="file-upload-filename">Belum ada berkas dipilih</div>
                <div class="file-upload-meta">Gambar (JPG, PNG, WebP), Video (MP4, WebM maks 30MB), PDF.</div>
              </div>
              <button type="button" class="file-upload-clear-btn" title="Hapus berkas" style="display: none;">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeAdminModal('uploadModal')">Batal</button>
        <button type="submit" class="btn btn-primary">Unggah Sekarang</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal 2: YouTube Link -->
<div class="admin-modal-backdrop" id="youtubeModal">
  <div class="admin-modal-card">
    <div class="admin-modal-header">
      <div class="admin-modal-title">
        <svg width="18" height="18" fill="none" stroke="#dc2626" stroke-width="2" viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
        <span>Daftarkan Tautan Video YouTube</span>
      </div>
      <button type="button" class="modal-close-btn admin-modal-close" onclick="closeAdminModal('youtubeModal')" aria-label="Tutup Dialog">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form action="/admin/media/youtube?_csrf=<%= csrfToken %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="admin-modal-body">
        <div class="form-group">
          <label class="form-label" for="title">Judul Video (Opsional)</label>
          <input type="text" id="title" name="title" class="form-input" placeholder="Contoh: Profil Pabrik Plastik Euodoo 2026">
        </div>
        <div class="form-group">
          <label class="form-label" for="youtube_url">URL Tautan YouTube *</label>
          <input type="url" id="youtube_url" name="youtube_url" class="form-input" required placeholder="https://www.youtube.com/watch?v=..." oninput="previewYoutube(this.value)">
          <div class="form-hint">Mendukung format https://youtu.be/ID atau https://youtube.com/watch?v=ID</div>
        </div>
        <div id="ytPreviewWrap" style="display: none; margin-top: 10px;">
          <iframe id="ytIframe" width="100%" height="200" src="" frameborder="0" allowfullscreen style="border-radius: var(--r-md); border: 1px solid var(--border-main);"></iframe>
        </div>
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeAdminModal('youtubeModal')">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan Tautan YouTube</button>
      </div>
    </form>
  </div>
</div>

<script>
  function previewYoutube(url) {
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
    const match = url.match(regExp);
    const wrap = document.getElementById('ytPreviewWrap');
    const iframe = document.getElementById('ytIframe');
    if (match && match[2].length === 11) {
      iframe.src = 'https://www.youtube.com/embed/' + match[2];
      wrap.style.display = 'block';
    } else {
      wrap.style.display = 'none';
      iframe.src = '';
    }
  }
</script>

<%- include('../../partials/admin-footer') %>

<div class="form-card">
  <div class="form-card-title">1. Identitas Visual &amp; Media (Favicon &amp; Dual Logo)</div>

  <div class="stg-visual-grid">
    <div class="form-group stg-media-card">
      <label class="form-label stg-media-label">Favicon Situs (Simbol Logo Persegi 1:1 Tanpa Teks)</label>        
      <div class="media-picker-component">
        <input type="hidden" id="setting_site_favicon" name="site_favicon" value="<%= settings.site_favicon_source || settings.site_favicon || '' %>">
        <div class="media-picker-preview-box stg-preview-box">
          <img src="<%= settings.site_favicon_32 || settings.site_favicon || '/uploads/settings/favicon-32x32.png' %>" alt="Favicon" class="stg-favicon-img <%= (settings.site_favicon || settings.site_favicon_32) ? 'stg-d-block' : 'stg-d-none' %>">
          <div class="media-picker-empty <%= (settings.site_favicon || settings.site_favicon_32) ? 'stg-d-none' : '' %>">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Belum ada favicon khusus (menggunakan fallback logo)</span>
          </div>
        </div>
        <div class="media-picker-ctrls">
          <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="setting_site_favicon" data-picker-type="image" aria-label="Pilih favicon khusus dari Media Library">
            <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Pilih Media</span>
          </button>
          <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media <%= (settings.site_favicon || settings.site_favicon_source) ? '' : 'stg-d-none' %>" title="Hapus untuk menggunakan fallback otomatis logo" aria-label="Reset favicon ke fallback logo">
            <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <span>Reset</span>
          </button>
        </div>
      </div>
    </div>

    <div class="form-group stg-media-card">
      <label class="form-label stg-media-label">Logo Header (Navbar)</label>
      <div class="media-picker-component">
        <input type="hidden" id="setting_site_logo_header" name="site_logo_header" value="<%= settings.site_logo_header || '' %>">
        <div class="media-picker-preview-box stg-preview-box">
          <img src="<%= settings.site_logo_header || '' %>" alt="Logo Header" class="stg-logo-img <%= settings.site_logo_header ? 'stg-d-block' : 'stg-d-none' %>">
          <div class="media-picker-empty <%= settings.site_logo_header ? 'stg-d-none' : '' %>">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Belum ada logo navbar</span>
          </div>
        </div>
        <div class="media-picker-ctrls">
          <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="setting_site_logo_header" data-picker-type="image" aria-label="Pilih logo header navbar dari Media Library">
            <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Pilih Media</span>
          </button>
          <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media <%= settings.site_logo_header ? '' : 'stg-d-none' %>" aria-label="Hapus logo header">
            <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <span>Hapus</span>
          </button>
        </div>
      </div>
    </div>

    <div class="form-group stg-media-card">
      <label class="form-label stg-media-label">Logo Footer (Latar Gelap)</label>
      <div class="media-picker-component">
        <input type="hidden" id="setting_site_logo_footer" name="site_logo_footer" value="<%= settings.site_logo_footer || '' %>">
        <div class="media-picker-preview-box stg-preview-box stg-preview-box--dark">
          <img src="<%= settings.site_logo_footer || '' %>" alt="Logo Footer" class="stg-logo-img <%= settings.site_logo_footer ? 'stg-d-block' : 'stg-d-none' %>">
          <div class="media-picker-empty stg-empty-muted <%= settings.site_logo_footer ? 'stg-d-none' : 'stg-d-flex' %>">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Belum ada logo footer</span>
          </div>
        </div>
        <div class="media-picker-ctrls">
          <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="setting_site_logo_footer" data-picker-type="image" aria-label="Pilih logo footer dari Media Library">
            <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Pilih Media</span>
          </button>
          <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media <%= settings.site_logo_footer ? '' : 'stg-d-none' %>" aria-label="Hapus logo footer">
            <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <span>Hapus</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Pengaturan Situs &amp; Kontak Perusahaan</h1>
    <p>Konfigurasi identitas korporasi, alamat ganda kantor/pabrik, nomor WhatsApp resmi, dan tautan sosial media.</p>
  </div>
</div>

<form action="/admin/settings?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <!-- Card 0: Identitas Visual (Favicon & Dual Logo) -->
  <div class="form-card">
    <div class="form-card-title">1. Identitas Visual &amp; Media (Favicon &amp; Dual Logo)</div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
      <!-- Favicon -->
      <div class="form-group" style="padding: 16px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px;">
        <label class="form-label" for="favicon_file" style="font-weight: 600;">Favicon Situs (.ico / .png / .svg)</label>
        <div class="custom-file-upload" data-initial-preview="<%= settings.site_favicon || '/favicon.ico' %>">
          <input type="file" id="favicon_file" name="favicon_file" accept=".ico,image/png,image/svg+xml">
          <div class="file-upload-dropzone" tabindex="0" role="button" aria-label="Pilih atau seret favicon">
            <div class="file-upload-preview">
              <img src="<%= settings.site_favicon || '/favicon.ico' %>" alt="Favicon" style="display: none; width: 28px; height: 28px; object-fit: contain;">
              <div class="preview-placeholder-icon">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </div>
            </div>
            <div class="file-upload-content">
              <div class="file-upload-header">
                <span class="file-upload-btn-pill">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                  <span>Pilih Berkas</span>
                </span>
                <span class="file-upload-label">atau seret ke sini</span>
              </div>
              <div class="file-upload-filename">Favicon aktif tersimpan</div>
              <div class="file-upload-meta">.ico, .png, .svg (optimal 32x32 / 64x64 px).</div>
            </div>
            <button type="button" class="file-upload-clear-btn" title="Hapus berkas" style="display: none;">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Logo Header -->
      <div class="form-group" style="padding: 16px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px;">
        <label class="form-label" for="logo_header_file" style="font-weight: 600;">Logo Header (Navbar)</label>
        <div class="custom-file-upload" data-initial-preview="<%= settings.site_logo_header || '' %>">
          <input type="file" id="logo_header_file" name="logo_header_file" accept="image/png,image/webp,image/svg+xml">
          <div class="file-upload-dropzone" tabindex="0" role="button" aria-label="Pilih atau seret logo navbar">
            <div class="file-upload-preview">
              <img src="<%= settings.site_logo_header || '' %>" alt="Logo Header" style="display: none; object-fit: contain;">
              <div class="preview-placeholder-icon">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </div>
            </div>
            <div class="file-upload-content">
              <div class="file-upload-header">
                <span class="file-upload-btn-pill">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                  <span>Pilih Berkas</span>
                </span>
                <span class="file-upload-label">atau seret ke sini</span>
              </div>
              <div class="file-upload-filename"><%= settings.site_logo_header ? 'Logo aktif tersimpan' : 'Belum ada berkas dipilih' %></div>
              <div class="file-upload-meta">PNG transparan, WebP, SVG. Tampil di navbar.</div>
            </div>
            <button type="button" class="file-upload-clear-btn" title="Hapus berkas" style="display: none;">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Logo Footer -->
      <div class="form-group" style="padding: 16px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px;">
        <label class="form-label" for="logo_footer_file" style="font-weight: 600;">Logo Footer (Latar Gelap)</label>
        <div class="custom-file-upload" data-initial-preview="<%= settings.site_logo_footer || '' %>">
          <input type="file" id="logo_footer_file" name="logo_footer_file" accept="image/png,image/webp,image/svg+xml">
          <div class="file-upload-dropzone" tabindex="0" role="button" aria-label="Pilih atau seret logo footer">
            <div class="file-upload-preview" style="background: #0a192f; border-color: #1e293b;">
              <img src="<%= settings.site_logo_footer || '' %>" alt="Logo Footer" style="display: none; object-fit: contain;">
              <div class="preview-placeholder-icon" style="color: #94a3b8;">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </div>
            </div>
            <div class="file-upload-content">
              <div class="file-upload-header">
                <span class="file-upload-btn-pill">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                  <span>Pilih Berkas</span>
                </span>
                <span class="file-upload-label">atau seret ke sini</span>
              </div>
              <div class="file-upload-filename"><%= settings.site_logo_footer ? 'Logo aktif tersimpan' : 'Belum ada berkas dipilih' %></div>
              <div class="file-upload-meta">PNG transparan, WebP, SVG (latar gelap).</div>
            </div>
            <button type="button" class="file-upload-clear-btn" title="Hapus berkas" style="display: none;">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 1: Identitas Korporat -->
  <div class="form-card">
    <div class="form-card-title">2. Identitas &amp; Kontak Resmi Korporat</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="company_name">Nama Resmi Perusahaan *</label>
        <input type="text" id="company_name" name="company_name" class="form-input" required value="<%= settings.company_name || 'PT Euodoo Presisi Indonesia' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="company_email">Email Kontak Utama *</label>
        <input type="email" id="company_email" name="company_email" class="form-input" required value="<%= settings.company_email || 'info@euodoo.com' %>">
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="company_tagline_id">Slogan Perusahaan (Bahasa Indonesia)</label>
        <input type="text" id="company_tagline_id" name="company_tagline_id" class="form-input" value="<%= settings.company_tagline_id || 'Pabrik & Manufaktur Kantong Plastik Ramah Lingkungan' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="company_phone">Nomor Telepon Kantor</label>
        <input type="text" id="company_phone" name="company_phone" class="form-input" value="<%= settings.company_phone || '(021) 5366-0000' %>">
      </div>
    </div>
  </div>

  <!-- Card 2: Alamat Ganda & Embed Peta -->
  <div class="form-card">
    <div class="form-card-title">3. Alamat Kantor Jakarta &amp; Pabrik Manufaktur Bandung</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="office_address">Alamat Kantor Pemasaran (Jakarta Barat) *</label>
        <textarea id="office_address" name="office_address" class="form-textarea" required><%= settings.office_address || 'Jl. Palmerah Barat No. 29, Jakarta Barat 11480' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="factory_address">Alamat Pabrik Manufaktur (Bandung) *</label>
        <textarea id="factory_address" name="factory_address" class="form-textarea" required><%= settings.factory_address || 'Kawasan Industri Cigondewah, Jl. Cigondewah Kaler No. 88, Kota Bandung, Jawa Barat 40214' %></textarea>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="google_maps_embed">Kode Embed Google Maps (URL iframe)</label>
      <input type="text" id="google_maps_embed" name="google_maps_embed" class="form-input" value="<%= settings.google_maps_embed || '' %>" placeholder="https://www.google.com/maps/embed?pb=...">
      <div class="form-hint">Salin URL dari atribut 'src' pada kode embed Google Maps resmi.</div>
    </div>
  </div>

  <!-- Card 3: WhatsApp & Floating Button -->
  <div class="form-card">
    <div class="form-card-title">4. Layanan WhatsApp &amp; Tombol Melayang (Floating CTA)</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="whatsapp_number">Nomor WhatsApp Resmi (Konsultasi Sales) *</label>
        <input type="text" id="whatsapp_number" name="whatsapp_number" class="form-input" required value="<%= settings.whatsapp_number || '6281234567890' %>" placeholder="081234567890 atau 6281234567890">
        <div class="form-hint">Otomatis dinormalisasi ke format internasional (misal: 6281234567890).</div>
      </div>
      <div class="form-group">
        <label class="form-label" for="whatsapp_button_theme">Tema Tampilan Tombol Floating</label>
        <select id="whatsapp_button_theme" name="whatsapp_button_theme" class="form-select">
          <option value="corporate" <%= settings.whatsapp_button_theme === 'corporate' ? 'selected' : '' %>>Corporate (Deep Cobalt Blue)</option>
          <option value="emerald" <%= settings.whatsapp_button_theme === 'emerald' ? 'selected' : '' %>>Emerald (WhatsApp Brand Green)</option>
          <option value="dark" <%= settings.whatsapp_button_theme === 'dark' ? 'selected' : '' %>>Dark Mode (Sleek Slate)</option>
          <option value="minimal" <%= settings.whatsapp_button_theme === 'minimal' ? 'selected' : '' %>>Minimal Outline</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="whatsapp_default_message">Pesan Pembuka Otomatis (Default Greeting Message)</label>
      <textarea id="whatsapp_default_message" name="whatsapp_default_message" class="form-textarea"><%= settings.whatsapp_default_message || 'Halo PT Euodoo, saya ingin berkonsultasi mengenai pemesanan kantong plastik ramah lingkungan (100% degradable).' %></textarea>
    </div>
  </div>

  <!-- Card 4: Media Sosial -->
  <div class="form-card">
    <div class="form-card-title">5. Akun Media Sosial Resmi Perusahaan</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="linkedin_url">LinkedIn URL</label>
        <input type="url" id="linkedin_url" name="linkedin_url" class="form-input" placeholder="https://linkedin.com/company/pt-euodoo" value="<%= settings.linkedin_url || '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="instagram_url">Instagram URL</label>
        <input type="url" id="instagram_url" name="instagram_url" class="form-input" placeholder="https://instagram.com/euodoo.id" value="<%= settings.instagram_url || '' %>">
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="facebook_url">Facebook URL</label>
        <input type="url" id="facebook_url" name="facebook_url" class="form-input" placeholder="https://facebook.com/pteuodoo" value="<%= settings.facebook_url || '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="youtube_url">YouTube Channel URL</label>
        <input type="url" id="youtube_url" name="youtube_url" class="form-input" placeholder="https://youtube.com/@pteuodoo" value="<%= settings.youtube_url || '' %>">
      </div>
    </div>
  </div>

  <div class="form-actions-bar" style="margin-bottom: 2rem;">
    <button type="submit" class="btn btn-primary" style="padding: 8px 24px; font-size: 13px;">Simpan Semua Pengaturan</button>
  </div>
</form>

<%- include('../../partials/admin-footer') %>

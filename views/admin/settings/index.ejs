<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Pengaturan Situs &amp; Kontak Perusahaan</h1>
    <p>Konfigurasi identitas korporasi, alamat ganda kantor/pabrik, nomor WhatsApp resmi, dan tautan sosial media.</p>
  </div>
</div>

<form action="/admin/settings?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <!-- Card 0: Identitas Visual (Favicon & Dual Logo) -->
  <div class="form-card">
    <div class="form-card-title">1. Identitas Visual &amp; Media (Favicon &amp; Dual Logo)</div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
      <!-- Favicon -->
      <div class="form-group" style="padding: 16px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px;">
        <label class="form-label" style="font-weight: 600;">Favicon Situs (.ico / .png / .svg)</label>
        <div class="media-picker-component">
          <input type="hidden" id="setting_site_favicon" name="site_favicon" value="<%= settings.site_favicon || '/favicon.ico' %>">
          <div class="media-picker-preview-box" style="height: 100px;">
            <img src="<%= settings.site_favicon || '/favicon.ico' %>" alt="Favicon" style="<%= settings.site_favicon ? 'display: block; width: 32px; height: 32px; object-fit: contain;' : 'display: none;' %>">
            <div class="media-picker-empty" style="<%= settings.site_favicon ? 'display: none;' : '' %>">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <span>Belum ada favicon</span>
            </div>
          </div>
          <div class="media-picker-ctrls">
            <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="setting_site_favicon" data-picker-type="image">
              Pilih Favicon
            </button>
            <button type="button" class="btn btn-ghost btn-sm btn-clear-media" style="<%= settings.site_favicon ? '' : 'display: none;' %>">Hapus</button>
          </div>
        </div>
      </div>

      <!-- Logo Header -->
      <div class="form-group" style="padding: 16px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px;">
        <label class="form-label" style="font-weight: 600;">Logo Header (Navbar)</label>
        <div class="media-picker-component">
          <input type="hidden" id="setting_site_logo_header" name="site_logo_header" value="<%= settings.site_logo_header || '' %>">
          <div class="media-picker-preview-box" style="height: 100px;">
            <img src="<%= settings.site_logo_header || '' %>" alt="Logo Header" style="<%= settings.site_logo_header ? 'display: block; max-height: 60px; object-fit: contain;' : 'display: none;' %>">
            <div class="media-picker-empty" style="<%= settings.site_logo_header ? 'display: none;' : '' %>">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <span>Belum ada logo navbar</span>
            </div>
          </div>
          <div class="media-picker-ctrls">
            <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="setting_site_logo_header" data-picker-type="image">
              Pilih Logo Header
            </button>
            <button type="button" class="btn btn-ghost btn-sm btn-clear-media" style="<%= settings.site_logo_header ? '' : 'display: none;' %>">Hapus</button>
          </div>
        </div>
      </div>

      <!-- Logo Footer -->
      <div class="form-group" style="padding: 16px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px;">
        <label class="form-label" style="font-weight: 600;">Logo Footer (Latar Gelap)</label>
        <div class="media-picker-component">
          <input type="hidden" id="setting_site_logo_footer" name="site_logo_footer" value="<%= settings.site_logo_footer || '' %>">
          <div class="media-picker-preview-box" style="height: 100px; background: #0a192f; border-color: #1e293b;">
            <img src="<%= settings.site_logo_footer || '' %>" alt="Logo Footer" style="<%= settings.site_logo_footer ? 'display: block; max-height: 60px; object-fit: contain;' : 'display: none;' %>">
            <div class="media-picker-empty" style="<%= settings.site_logo_footer ? 'display: none;' : 'display: flex;' %> color: #94a3b8;">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <span style="color: #94a3b8;">Belum ada logo footer</span>
            </div>
          </div>
          <div class="media-picker-ctrls">
            <button type="button" class="btn btn-secondary btn-sm btn-open-media-picker" data-target="setting_site_logo_footer" data-picker-type="image">
              Pilih Logo Footer
            </button>
            <button type="button" class="btn btn-ghost btn-sm btn-clear-media" style="<%= settings.site_logo_footer ? '' : 'display: none;' %>">Hapus</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 1: Identitas Korporat -->
  <div class="form-card">
    <div class="form-card-title">2. Identitas &amp; Kontak Resmi Korporat</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="company_name">Nama Resmi Perusahaan *</label>
        <input type="text" id="company_name" name="company_name" class="form-input" required value="<%= settings.company_name || 'PT Euodoo Presisi Indonesia' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="company_email">Email Kontak Utama *</label>
        <input type="email" id="company_email" name="company_email" class="form-input" required value="<%= settings.company_email || 'info@euodoo.com' %>">
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="company_tagline_id">Slogan Perusahaan (Bahasa Indonesia)</label>
        <input type="text" id="company_tagline_id" name="company_tagline_id" class="form-input" value="<%= settings.company_tagline_id || 'Pabrik & Manufaktur Kantong Plastik Ramah Lingkungan' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="company_phone">Nomor Telepon Kantor</label>
        <input type="text" id="company_phone" name="company_phone" class="form-input" value="<%= settings.company_phone || '(021) 5366-0000' %>">
      </div>
    </div>
  </div>

  <!-- Card 2: Alamat Ganda & Embed Peta -->
  <div class="form-card">
    <div class="form-card-title">3. Alamat Kantor Jakarta &amp; Pabrik Manufaktur Bandung</div>

    <!-- Lokasi 1: Jakarta -->
    <div style="background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px; padding: 18px; margin-bottom: 20px;">
      <div style="font-weight: 700; font-size: 14px; color: var(--navy, #0a192f); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--primary, #0055b8);"></span>
        Lokasi 1: Kantor Pusat (Jakarta)
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label class="form-label" for="office_name_id">Nama Label Lokasi (Bahasa Indonesia) *</label>
          <input type="text" id="office_name_id" name="office_name_id" class="form-input" required value="<%= settings.office_name_id || 'Kantor Pusat (Jakarta)' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="office_name_en">Nama Label Lokasi (English) *</label>
          <input type="text" id="office_name_en" name="office_name_en" class="form-input" required value="<%= settings.office_name_en || 'Head Office (Jakarta)' %>">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="office_address">Alamat Lengkap Kantor Jakarta *</label>
        <textarea id="office_address" name="office_address" class="form-textarea" rows="2" required><%= settings.office_address || 'Karindra Building Jl. Palmerah Selatan 30 A Suite 02-07, Jakarta Pusat 10270' %></textarea>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label class="form-label" for="office_phone">Nomor Telepon Kantor Jakarta *</label>
          <input type="text" id="office_phone" name="office_phone" class="form-input" required value="<%= settings.office_phone || settings.company_phone || '(021) 53668626' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="office_fax">Nomor Fax Kantor Jakarta (Opsional)</label>
          <input type="text" id="office_fax" name="office_fax" class="form-input" value="<%= settings.office_fax || '+6221-53668648' %>">
        </div>
      </div>
    </div>

    <!-- Lokasi 2: Bandung -->
    <div style="background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px; padding: 18px; margin-bottom: 20px;">
      <div style="font-weight: 700; font-size: 14px; color: var(--navy, #0a192f); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #059669;"></span>
        Lokasi 2: Pabrik Manufaktur (Bandung)
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label class="form-label" for="factory_name_id">Nama Label Lokasi (Bahasa Indonesia) *</label>
          <input type="text" id="factory_name_id" name="factory_name_id" class="form-input" required value="<%= settings.factory_name_id || 'Pabrik Manufaktur (Bandung)' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="factory_name_en">Nama Label Lokasi (English) *</label>
          <input type="text" id="factory_name_en" name="factory_name_en" class="form-input" required value="<%= settings.factory_name_en || 'Manufacturing Plant (Bandung)' %>">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="factory_address">Alamat Lengkap Pabrik Bandung *</label>
        <textarea id="factory_address" name="factory_address" class="form-textarea" rows="2" required><%= settings.factory_address || 'Kawasan Industri Cigondewah, Jl. Cigondewah Kaler No. 88, Kota Bandung, Jawa Barat 40214' %></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="factory_phone">Nomor Telepon Pabrik / Hotline *</label>
        <input type="text" id="factory_phone" name="factory_phone" class="form-input" required value="<%= settings.factory_phone || '(022) 6012519' %>">
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label class="form-label" for="factory_working_hours_id">Jam Operasional (Bahasa Indonesia)</label>
          <input type="text" id="factory_working_hours_id" name="factory_working_hours_id" class="form-input" value="<%= settings.factory_working_hours_id || 'Senin - Jumat: 08.00 - 17.00 WIB | Sabtu: 08.00 - 13.00 WIB' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="factory_working_hours_en">Jam Operasional (English)</label>
          <input type="text" id="factory_working_hours_en" name="factory_working_hours_en" class="form-input" value="<%= settings.factory_working_hours_en || 'Monday - Friday: 08:00 - 17:00 WIB | Saturday: 08:00 - 13:00 WIB' %>">
        </div>
      </div>
    </div>

    <!-- Peta Google Maps Terpadu -->
    <div class="form-group">
      <label class="form-label" for="google_maps_embed">Kode Embed Google Maps Pabrik Bandung (URL iframe atau kode sematan utuh)</label>
      <input type="text" id="google_maps_embed" name="google_maps_embed" class="form-input" value="<%= settings.google_maps_embed || '' %>" placeholder="https://www.google.com/maps/embed?pb=... atau <iframe src='...'></iframe>">
      <div class="form-hint">Dapat berupa URL langsung atau seluruh kode tag &lt;iframe&gt; dari Google Maps resmi (sistem akan mengekstrak URL secara otomatis dan aman).</div>
      <% if (settings.google_maps_embed) { %>
        <div style="margin-top: 12px; border-radius: 8px; overflow: hidden; height: 180px; border: 1px solid #e2e8f0;">
          <iframe src="<%= settings.google_maps_embed %>" width="100%" height="180" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Card 4: WhatsApp & Floating Button -->
  <div class="form-card">
    <div class="form-card-title">4. Layanan WhatsApp &amp; Tombol Melayang (Floating CTA)</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="whatsapp_number">Nomor WhatsApp Resmi (Konsultasi Sales) *</label>
        <input type="text" id="whatsapp_number" name="whatsapp_number" class="form-input" required value="<%= settings.whatsapp_number || '6281234567890' %>" placeholder="081234567890 atau 6281234567890">
        <div class="form-hint">Otomatis dinormalisasi ke format internasional (misal: 6281234567890).</div>
      </div>
      <div class="form-group">
        <label class="form-label" for="whatsapp_button_theme">Tema Tampilan Tombol Floating</label>
        <select id="whatsapp_button_theme" name="whatsapp_button_theme" class="form-select">
          <option value="corporate" <%= settings.whatsapp_button_theme === 'corporate' ? 'selected' : '' %>>Corporate (Deep Cobalt Blue)</option>
          <option value="emerald" <%= settings.whatsapp_button_theme === 'emerald' ? 'selected' : '' %>>Emerald (WhatsApp Brand Green)</option>
          <option value="dark" <%= settings.whatsapp_button_theme === 'dark' ? 'selected' : '' %>>Dark Mode (Sleek Slate)</option>
          <option value="minimal" <%= settings.whatsapp_button_theme === 'minimal' ? 'selected' : '' %>>Minimal Outline</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="whatsapp_default_message">Pesan Pembuka Otomatis (Default Greeting Message)</label>
      <textarea id="whatsapp_default_message" name="whatsapp_default_message" class="form-textarea"><%= settings.whatsapp_default_message || 'Halo PT Euodoo, saya ingin berkonsultasi mengenai pemesanan kantong plastik ramah lingkungan (100% degradable).' %></textarea>
    </div>
  </div>

  <!-- Card 5: Media Sosial -->
  <div class="form-card">
    <div class="form-card-title">5. Akun Media Sosial Resmi Perusahaan</div>
    <div style="color: var(--text-variant, #64748b); font-size: 13px; margin-bottom: 16px;">
      Aktifkan atau sembunyikan ikon media sosial di footer publik. Masukkan URL akun dengan awalan protokol <code>https://</code>.
    </div>

    <div class="form-row-2">
      <!-- LinkedIn -->
      <div class="form-group" style="padding: 14px 16px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px; margin-bottom: 0;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label class="form-label" for="social_linkedin_url" style="font-weight: 700; color: var(--navy, #0a192f); margin-bottom: 0;">LinkedIn</label>
          <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; cursor: pointer; color: var(--text-secondary, #475569);">
            <input type="checkbox" name="social_linkedin_visible" value="1" <%= (settings.social_linkedin_visible !== '0' && settings.social_linkedin_visible !== 0) ? 'checked' : '' %> style="width: 16px; height: 16px; accent-color: var(--primary, #0055b8);">
            <span>Tampilkan</span>
          </label>
        </div>
        <input type="url" id="social_linkedin_url" name="social_linkedin_url" class="form-input" placeholder="https://linkedin.com/company/pt-euodoo" value="<%= settings.social_linkedin_url || settings.linkedin_url || '' %>">
      </div>

      <!-- Instagram -->
      <div class="form-group" style="padding: 14px 16px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px; margin-bottom: 0;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label class="form-label" for="social_instagram_url" style="font-weight: 700; color: var(--navy, #0a192f); margin-bottom: 0;">Instagram</label>
          <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; cursor: pointer; color: var(--text-secondary, #475569);">
            <input type="checkbox" name="social_instagram_visible" value="1" <%= (settings.social_instagram_visible !== '0' && settings.social_instagram_visible !== 0) ? 'checked' : '' %> style="width: 16px; height: 16px; accent-color: var(--primary, #0055b8);">
            <span>Tampilkan</span>
          </label>
        </div>
        <input type="url" id="social_instagram_url" name="social_instagram_url" class="form-input" placeholder="https://instagram.com/euodoo.id" value="<%= settings.social_instagram_url || settings.instagram_url || '' %>">
      </div>
    </div>

    <div class="form-row-2" style="margin-top: 1rem;">
      <!-- Facebook -->
      <div class="form-group" style="padding: 14px 16px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px; margin-bottom: 0;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label class="form-label" for="social_facebook_url" style="font-weight: 700; color: var(--navy, #0a192f); margin-bottom: 0;">Facebook</label>
          <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; cursor: pointer; color: var(--text-secondary, #475569);">
            <input type="checkbox" name="social_facebook_visible" value="1" <%= (settings.social_facebook_visible !== '0' && settings.social_facebook_visible !== 0) ? 'checked' : '' %> style="width: 16px; height: 16px; accent-color: var(--primary, #0055b8);">
            <span>Tampilkan</span>
          </label>
        </div>
        <input type="url" id="social_facebook_url" name="social_facebook_url" class="form-input" placeholder="https://facebook.com/pteuodoo" value="<%= settings.social_facebook_url || settings.facebook_url || '' %>">
      </div>

      <!-- YouTube -->
      <div class="form-group" style="padding: 14px 16px; background: #f8fafc; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px; margin-bottom: 0;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label class="form-label" for="social_youtube_url" style="font-weight: 700; color: var(--navy, #0a192f); margin-bottom: 0;">YouTube</label>
          <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; cursor: pointer; color: var(--text-secondary, #475569);">
            <input type="checkbox" name="social_youtube_visible" value="1" <%= (settings.social_youtube_visible !== '0' && settings.social_youtube_visible !== 0) ? 'checked' : '' %> style="width: 16px; height: 16px; accent-color: var(--primary, #0055b8);">
            <span>Tampilkan</span>
          </label>
        </div>
        <input type="url" id="social_youtube_url" name="social_youtube_url" class="form-input" placeholder="https://youtube.com/@pteuodoo" value="<%= settings.social_youtube_url || settings.youtube_url || '' %>">
      </div>
    </div>
  </div>

  <!-- Sticky Actions Bar -->
  <div class="settings-sticky-actions">
    <div class="actions-left" style="display: flex; align-items: center; gap: 8px;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
      <span style="font-size: 13px; color: var(--text-muted, #64748b); font-weight: 500;">
        Perubahan pengaturan langsung diterapkan pada seluruh halaman publik.
      </span>
    </div>
    <div class="actions-right" style="display: flex; align-items: center; gap: 10px;">
      <a href="/admin/dashboard" class="btn btn-secondary">
        Batal
      </a>
      <button type="submit" class="btn btn-primary" style="min-width: 220px;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
        <span>Simpan Semua Pengaturan</span>
      </button>
    </div>
  </div>
</form>

<%- include('../../partials/admin-footer') %>

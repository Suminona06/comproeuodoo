<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Manajemen Pengguna &amp; Hak Akses</h1>
    <p>Kelola akun administrator, staf admin, dan editor konten portal CMS.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/users/create" class="btn btn-primary">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <span>Tambah Pengguna</span>
    </a>
  </div>
</div>

<div class="table-card">
  <div class="table-toolbar">
    <h2 class="toolbar-title">Daftar Akun Pengguna</h2>
    <div class="search-input-wrap">
      <svg class="search-icon-svg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="liveSearchInput" placeholder="Cari nama atau email..." aria-label="Cari data">
    </div>
  </div>

  <div class="table-scroll-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>Pengguna</th>
          <th>Email</th>
          <th>Hak Akses (Role)</th>
          <th>Status Keamanan</th>
          <th>Terdaftar</th>
          <th style="text-align: right; width: 120px;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (users && users.length > 0) { %>
          <% users.forEach(function(u) { %>
            <tr>
              <td>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <% const uName = u.full_name || u.name || u.email || 'User'; %>
                  <div class="user-avatar-badge" style="width: 28px; height: 28px; font-size: 11px;">
                    <%= uName.charAt(0).toUpperCase() %>
                  </div>
                  <div class="td-client-title"><%= uName %></div>
                </div>
              </td>
              <td>
                <div class="td-muted-text"><%= u.email %></div>
              </td>
              <td>
                <span class="badge-role <%= u.role %>">
                  <%= u.role %>
                </span>
              </td>
              <td>
                <% if (u.locked_until && new Date(u.locked_until) > new Date()) { %>
                  <span class="badge-status st-ditolak" style="font-size: 11px; padding: 2px 6px; border-radius: 4px;">
                    Terkunci s/d <%= new Date(u.locked_until).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %>
                  </span>
                <% } else if (u.failed_attempts > 0) { %>
                  <span class="badge-status st-baru" style="font-size: 11px; padding: 2px 6px; border-radius: 4px;">
                    <%= u.failed_attempts %>x Gagal Login
                  </span>
                <% } else { %>
                  <span class="badge-status st-selesai" style="font-size: 11px; padding: 2px 6px; border-radius: 4px;">
                    Normal
                  </span>
                <% } %>
              </td>
              <td>
                <div style="font-size: 11.5px; color: var(--text-muted);">
                  <%= new Date(u.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </div>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 6px;">
                  <a href="/admin/users/<%= u.id %>/edit" class="btn-action-view" title="Edit Akun">
                    Edit
                  </a>
                  <% if (currentUser && currentUser.id !== u.id) { %>
                    <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus akun <%= u.name %>? Tindakan ini tidak dapat dibatalkan.');" style="display: inline;">
                      <button type="submit" class="btn btn-danger btn-sm" style="padding: 2px 6px; font-size: 11px;">
                        Hapus
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">
              Tidak ada data pengguna.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/admin-footer') %>

<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Edit Pengguna: <%= targetUser.name %></h1>
    <p>Perbarui profil, ganti role hak akses, atau atur ulang kata sandi pengguna.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/users" class="adm-btn adm-btn-neutral" aria-label="Kembali ke daftar pengguna">
      <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
      <span>Kembali</span>
    </a>
  </div>
</div>

<div class="form-card" style="max-width: 680px; margin: 0 auto;">
  <div class="form-card-title">Perbarui Data Akun</div>

  <form action="/admin/users/<%= targetUser.id %>?_csrf=<%= csrfToken %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="name">Nama Lengkap *</label>
        <input type="text" id="name" name="name" class="form-input" required value="<%= targetUser.name %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="email">Alamat Email *</label>
        <input type="email" id="email" name="email" class="form-input" required value="<%= targetUser.email %>">
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="role">Hak Akses (Role) *</label>
        <select id="role" name="role" class="form-select" required>
          <option value="editor" <%= targetUser.role === 'editor' ? 'selected' : '' %>>Editor (Kelola Artikel &amp; Media)</option>
          <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>Admin (Kelola Katalog, Banners &amp; Inquiry)</option>
          <option value="superadmin" <%= targetUser.role === 'superadmin' ? 'selected' : '' %>>Superadmin (Akses Penuh Seluruh Sistem)</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="new_password">Kata Sandi Baru (Opsional)</label>
        <input type="password" id="new_password" name="new_password" class="form-input" minlength="6" placeholder="Biarkan kosong jika tidak diganti">
      </div>
    </div>

    <div class="form-actions-bar">
      <a href="/admin/users" class="adm-btn adm-btn-neutral" aria-label="Batalkan perubahan data pengguna">
        <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>Batal</span>
      </a>
      <button type="submit" class="adm-btn adm-btn-primary" aria-label="Simpan perubahan data pengguna">
        <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Simpan</span>
      </button>
    </div>
  </form>
</div>

<%- include('../../partials/admin-footer') %>

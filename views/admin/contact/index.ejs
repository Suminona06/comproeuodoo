<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>CMS Konten Halaman Kontak &amp; Inquiry</h1>
    <p>Kelola jam kerja operasional dwibahasa serta teks judul dan pengantar formulir konsultasi penawaran.</p>
  </div>
  <div class="header-actions">
    <a href="/contact" target="_blank" class="btn btn-secondary" title="Buka Halaman Kontak Publik">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      <span>Lihat Halaman Publik</span>
    </a>
  </div>
</div>

<div class="alert alert-info" style="margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; background: rgba(0, 117, 90, 0.08); border: 1px solid rgba(0, 117, 90, 0.2); border-radius: var(--r-md, 8px); padding: 14px 18px;">
  <div style="display: flex; align-items: center; gap: 12px;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary, #00755a)" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
    <div>
      <strong style="color: var(--primary, #00755a); display: block; font-size: 13.5px;">Sentralisasi Master Data Kontak</strong>
      <span style="font-size: 12.5px; color: var(--text-variant, #424753);">Alamat kantor, pabrik, telepon, email, dan peta Google Maps dikelola secara terpusat di Pengaturan Umum.</span>
    </div>
  </div>
  <a href="/admin/settings" class="btn btn-outline btn-sm" style="flex-shrink: 0;">Buka Pengaturan</a>
</div>

<form action="/admin/contact?_csrf=<%= csrfToken %>" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <input type="hidden" name="contact_address_id" value="<%= settings.contact_address_id || settings.factory_address || '' %>">
  <input type="hidden" name="contact_address_en" value="<%= settings.contact_address_en || settings.factory_address || '' %>">

  <!-- Card 1: Jam Operasional Kerja -->
  <div class="form-card">
    <div class="form-card-title">1. Jam Operasional Kerja (Bilingual)</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="contact_working_hours_id">Jam Operasional (Bahasa Indonesia) *</label>
        <input type="text" id="contact_working_hours_id" name="contact_working_hours_id" class="form-input" required value="<%= settings.contact_working_hours_id || settings.factory_working_hours_id || 'Senin - Jumat: 08.00 - 17.00 WIB | Sabtu: 08.00 - 13.00 WIB' %>" placeholder="Senin - Jumat: 08.00 - 17.00 WIB">
      </div>
      <div class="form-group">
        <label class="form-label" for="contact_working_hours_en">Jam Operasional (English) *</label>
        <input type="text" id="contact_working_hours_en" name="contact_working_hours_en" class="form-input" required value="<%= settings.contact_working_hours_en || settings.factory_working_hours_en || 'Monday - Friday: 08:00 - 17:00 WIB | Saturday: 08:00 - 13:00 WIB' %>" placeholder="Monday - Friday: 08:00 - 17:00 WIB">
      </div>
    </div>
  </div>

  <!-- Card 2: Teks Seksi Formulir Inquiry -->
  <div class="form-card">
    <div class="form-card-title">2. Teks Seksi Formulir Inquiry &amp; Penawaran (Bilingual)</div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="contact_form_title_id">Judul Form (Bahasa Indonesia) *</label>
        <input type="text" id="contact_form_title_id" name="contact_form_title_id" class="form-input" required value="<%= settings.contact_form_title_id || 'Konsultasi & Permintaan Penawaran' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="contact_form_title_en">Judul Form (English) *</label>
        <input type="text" id="contact_form_title_en" name="contact_form_title_en" class="form-input" required value="<%= settings.contact_form_title_en || 'Consultation & Request for Quotation' %>">
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="contact_form_subtitle_id">Subjudul / Deskripsi Pengantar (Bahasa Indonesia)</label>
        <textarea id="contact_form_subtitle_id" name="contact_form_subtitle_id" class="form-textarea" rows="2"><%= settings.contact_form_subtitle_id || 'Kirimkan rincian kebutuhan kantong plastik, ukuran kustom, dan volume pesanan bisnis Anda.' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="contact_form_subtitle_en">Subjudul / Deskripsi Pengantar (English)</label>
        <textarea id="contact_form_subtitle_en" name="contact_form_subtitle_en" class="form-textarea" rows="2"><%= settings.contact_form_subtitle_en || 'Submit your plastic bag requirements, custom specifications, and corporate order volume.' %></textarea>
      </div>
    </div>
  </div>

  <!-- Sticky Actions Bar -->
  <div class="settings-sticky-actions">
    <div class="actions-left" style="display: flex; align-items: center; gap: 8px;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
      <span style="font-size: 13px; color: var(--text-muted, #64748b); font-weight: 500;">
        Perubahan konten langsung diterapkan pada formulir kontak publik.
      </span>
    </div>
    <div class="actions-right" style="display: flex; align-items: center; gap: 10px;">
      <a href="/admin/dashboard" class="btn btn-secondary">
        Batal
      </a>
      <button type="submit" class="btn btn-primary" style="min-width: 220px;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
        <span>Simpan Konten Kontak</span>
      </button>
    </div>
  </div>
</form>

<%- include('../../partials/admin-footer') %>

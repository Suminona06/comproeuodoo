<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Manajemen Banner Hero Beranda</h1>
    <p>Kelola media video background atau gambar WebP, teks headline sisi kiri, dan tombol CTA tunggal.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/banners/create" class="adm-btn adm-btn-primary" aria-label="Tambah banner hero baru">
      <svg class="adm-btn-icon adm-btn-icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <span>Tambah</span>
    </a>
  </div>
</div>

<div class="table-card">
  <div class="table-toolbar">
    <h2 class="toolbar-title">Daftar Banner Slide Beranda</h2>
  </div>

  <div class="table-scroll-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th class="adm-banner-th-media">Media</th>
          <th>Judul Banner</th>
          <th>Teks Caption &amp; Tombol CTA</th>
          <th class="adm-banner-th-order">Urutan</th>
          <th class="adm-banner-th-status">Status</th>
          <th class="adm-banner-th-action">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (banners && banners.length > 0) { %>
          <% banners.forEach(function(b) { %>
            <tr>
              <td>
                <div class="adm-banner-thumb">
                  <% if (b.media_type === 'video') { %>
                    <span class="adm-banner-video-badge">VIDEO</span>
                    <svg class="adm-banner-video-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  <% } else if (b.image_url) { %>
                    <img src="<%= b.image_url %>" alt="<%= b.title_id %>" class="adm-banner-thumb-img">
                  <% } else { %>
                    <span class="adm-banner-no-media">NO MEDIA</span>
                  <% } %>
                </div>
              </td>
              <td>
                <div class="td-client-title"><%= b.title_id %></div>
                <div class="td-client-sub"><%= b.title_en || '-' %></div>
              </td>
              <td>
                <div class="td-req-text" title="<%= b.caption_id || '' %>">
                  <%= b.caption_id || '-' %>
                </div>
                <% if (b.cta_text_id || b.cta_url) { %>
                  <div class="adm-banner-cta-primary">
                    CTA 1: "<%= b.cta_text_id || 'Hubungi Kami' %>" &rarr; <%= b.cta_url || '/contact' %>
                  </div>
                <% } %>
                <% if (b.cta_secondary_text_id) { %>
                  <div class="adm-banner-cta-secondary">
                    CTA 2: "<%= b.cta_secondary_text_id %>" &rarr; <%= b.cta_secondary_url || '-' %>
                  </div>
                <% } %>
              </td>
              <td class="adm-banner-td-order">
                <%= b.sort_order %>
              </td>
              <td>
                <form action="/admin/banners/<%= b.id %>/status?_csrf=<%= csrfToken %>" method="POST" class="adm-banner-inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-action btn-action-status <%= b.is_active ? 'active' : 'inactive' %>" title="Ubah Status Banner">
                    <%= b.is_active ? 'Aktif' : 'Nonaktif' %>
                  </button>
                </form>
              </td>
              <td class="adm-banner-td-action">
                <div class="table-actions">
                  <a href="/admin/banners/<%= b.id %>/edit" class="btn-action btn-action-edit" title="Edit Banner">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 1-2 2v14a2 2 0 0 1 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    <span>Edit</span>
                  </a>
                  <form action="/admin/banners/<%= b.id %>/delete?_csrf=<%= csrfToken %>" method="POST" data-confirm-delete="true" data-confirm-message="Hapus banner ini? Minimal harus ada 1 banner aktif di sistem." data-confirm-title="Hapus Banner">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-action btn-action-delete" title="Hapus Banner">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      <span>Hapus</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="adm-banner-empty-td">
              Belum ada banner hero yang terdaftar.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/admin-footer') %>

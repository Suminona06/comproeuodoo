<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Manajemen Banner Hero Beranda</h1>
    <p>Kelola media video background atau gambar WebP, teks headline sisi kiri, dan tombol CTA tunggal.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/banners/create" class="btn btn-primary">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <span>Tambah Banner</span>
    </a>
  </div>
</div>

<div class="table-card">
  <div class="table-toolbar">
    <h2 class="toolbar-title">Daftar Banner Slide Beranda</h2>
  </div>

  <div class="table-scroll-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width: 100px;">Media</th>
          <th>Judul Banner</th>
          <th>Teks Caption &amp; Tombol CTA</th>
          <th style="width: 80px; text-align: center;">Urutan</th>
          <th style="width: 100px;">Status</th>
          <th style="text-align: right; width: 120px;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (banners && banners.length > 0) { %>
          <% banners.forEach(function(b) { %>
            <tr>
              <td>
                <div style="width: 80px; height: 50px; background: #0f172a; border-radius: var(--r-sm); overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
                  <% if (b.media_type === 'video') { %>
                    <span style="position: absolute; top: 4px; right: 4px; background: rgba(0,0,0,0.6); color: #fff; font-size: 9px; padding: 1px 4px; border-radius: 2px;">VIDEO</span>
                    <svg width="24" height="24" fill="none" stroke="#ffffff" stroke-width="2" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  <% } else if (b.image_url) { %>
                    <img src="<%= b.image_url %>" alt="<%= b.title_id %>" style="width: 100%; height: 100%; object-fit: cover;">
                  <% } else { %>
                    <span style="font-size: 10px; color: #fff;">NO MEDIA</span>
                  <% } %>
                </div>
              </td>
              <td>
                <div class="td-client-title"><%= b.title_id %></div>
                <div class="td-client-sub"><%= b.title_en || '-' %></div>
              </td>
              <td>
                <div class="td-req-text" title="<%= b.caption_id || '' %>">
                  <%= b.caption_id || '-' %>
                </div>
                <% if (b.cta_text_id && b.cta_url) { %>
                  <div style="font-size: 11px; color: var(--primary); font-weight: 600; margin-top: 2px;">
                    CTA: "<%= b.cta_text_id %>" &rarr; <%= b.cta_url %>
                  </div>
                <% } %>
              </td>
              <td style="text-align: center; font-weight: 600;">
                <%= b.sort_order %>
              </td>
              <td>
                <form action="/admin/banners/<%= b.id %>/status?_csrf=<%= csrfToken %>" method="POST" style="display: inline;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-action btn-action-status <%= b.is_active ? 'active' : 'inactive' %>" title="Ubah Status Banner">
                    <%= b.is_active ? 'Aktif' : 'Nonaktif' %>
                  </button>
                </form>
              </td>
              <td style="text-align: right;">
                <div class="table-actions">
                  <a href="/admin/banners/<%= b.id %>/edit" class="btn-action btn-action-edit" title="Edit Banner">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    <span>Edit</span>
                  </a>
                  <form action="/admin/banners/<%= b.id %>/delete?_csrf=<%= csrfToken %>" method="POST" onsubmit="return confirm('Hapus banner ini? Minimal harus ada 1 banner aktif di sistem.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-action btn-action-delete" title="Hapus Banner">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      <span>Hapus</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
              Belum ada banner hero yang terdaftar.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/admin-footer') %>

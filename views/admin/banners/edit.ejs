<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Edit Banner Hero: <%= banner.title_id %></h1>
    <p>Perbarui judul headline, caption, tautan CTA, atau ganti file media.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/banners" class="btn btn-secondary">&larr; Kembali ke Daftar</a>
  </div>
</div>

<div class="form-card" style="max-width: 680px; margin: 0 auto;">
  <div class="form-card-title">Perbarui Banner Hero</div>

  <form action="/admin/banners/<%= banner.id %>?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="title_id">Judul Headline (Bahasa Indonesia) *</label>
        <input type="text" id="title_id" name="title_id" class="form-input" required value="<%= banner.title_id %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="title_en">Judul Headline (English)</label>
        <input type="text" id="title_en" name="title_en" class="form-input" value="<%= banner.title_en || '' %>">
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="caption_id">Sub-headline / Caption (Bahasa Indonesia)</label>
        <textarea id="caption_id" name="caption_id" class="form-textarea"><%= banner.caption_id || '' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="caption_en">Sub-headline / Caption (English)</label>
        <textarea id="caption_en" name="caption_en" class="form-textarea"><%= banner.caption_en || '' %></textarea>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="media_type">Tipe Media *</label>
      <select id="media_type" name="media_type" class="form-select">
        <option value="image" <%= banner.media_type === 'image' ? 'selected' : '' %>>Gambar Beresolusi Tinggi (WebP)</option>
        <option value="video" <%= banner.media_type === 'video' ? 'selected' : '' %>>Video Background (MP4 / WebM)</option>
      </select>
    </div>

    <div class="form-group">
      <label class="form-label" for="media_file">Ganti Berkas Media (Opsional)</label>
      <div class="custom-file-upload" data-initial-preview="<%= (banner.media_type !== 'video' && banner.image_url) ? banner.image_url : '' %>">
        <input type="file" id="media_file" name="media_file" accept="image/*,video/mp4,video/webm">
        <div class="file-upload-dropzone" tabindex="0" role="button" aria-label="Pilih atau seret berkas media">
          <div class="file-upload-preview">
            <img src="<%= (banner.media_type !== 'video' && banner.image_url) ? banner.image_url : '' %>" alt="Pratinjau" style="display: none;">
            <div class="preview-placeholder-icon">
              <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            </div>
          </div>
          <div class="file-upload-content">
            <div class="file-upload-header">
              <span class="file-upload-btn-pill">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                <span>Pilih Berkas</span>
              </span>
              <span class="file-upload-label">atau seret dan lepas ke sini</span>
            </div>
            <div class="file-upload-filename"><%= (banner.image_url || banner.video_url) ? 'Media aktif tersimpan' : 'Belum ada berkas dipilih' %></div>
            <div class="file-upload-meta">
              <% if (banner.media_type === 'video' && banner.video_url) { %>
                Format aktif: Video MP4. Unggah file baru untuk menggantinya.
              <% } else { %>
                Gambar (JPG, PNG, WebP) atau Video (MP4, WebM). Maks 25MB.
              <% } %>
            </div>
          </div>
          <button type="button" class="file-upload-clear-btn" title="Hapus berkas" style="display: none;">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="form-row-3">
      <div class="form-group">
        <label class="form-label" for="cta_text_id">Teks Tombol CTA (ID)</label>
        <input type="text" id="cta_text_id" name="cta_text_id" class="form-input" value="<%= banner.cta_text_id || '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="cta_text_en">Teks Tombol CTA (EN)</label>
        <input type="text" id="cta_text_en" name="cta_text_en" class="form-input" value="<%= banner.cta_text_en || '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="cta_url">URL Tujuan Tombol CTA</label>
        <input type="text" id="cta_url" name="cta_url" class="form-input" value="<%= banner.cta_url || '' %>">
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="sort_order">Nomor Urutan Tampil (Slide)</label>
        <input type="number" id="sort_order" name="sort_order" class="form-input" value="<%= banner.sort_order %>" min="0">
      </div>
      <div class="form-group" style="justify-content: flex-end;">
        <label class="form-check" style="margin-bottom: 8px;">
          <input type="checkbox" name="is_active" value="1" <%= banner.is_active ? 'checked' : '' %>>
          <span>Aktifkan banner ini dalam slider</span>
        </label>
      </div>
    </div>

    <div class="form-actions-bar">
      <a href="/admin/banners" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
    </div>
  </form>
</div>

<%- include('../../partials/admin-footer') %>

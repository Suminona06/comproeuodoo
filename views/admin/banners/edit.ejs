<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Edit Banner Hero: <%= banner.title_id %></h1>
    <p>Perbarui judul headline, caption, tautan CTA, atau ganti file media/YouTube.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/banners" class="adm-btn adm-btn-neutral" aria-label="Kembali ke daftar banner">
      <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      <span>Kembali</span>
    </a>
  </div>
</div>

<div class="form-card adm-banner-form-card">
  <div class="form-card-title">Perbarui Banner Hero</div>

  <form action="/admin/banners/<%= banner.id %>?_csrf=<%= csrfToken %>" method="POST" novalidate>
    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="title_id">Judul Headline (Bahasa Indonesia) *</label>
        <input type="text" id="title_id" name="title_id" class="form-input" required value="<%= banner.title_id %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="title_en">Judul Headline (English)</label>
        <input type="text" id="title_en" name="title_en" class="form-input" value="<%= banner.title_en || '' %>">
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="caption_id">Sub-headline / Caption (Bahasa Indonesia)</label>
        <textarea id="caption_id" name="caption_id" class="form-textarea"><%= banner.caption_id || '' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="caption_en">Sub-headline / Caption (English)</label>
        <textarea id="caption_en" name="caption_en" class="form-textarea"><%= banner.caption_en || '' %></textarea>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="media_type">Tipe Sumber Media Latar Belakang *</label>
      <select id="media_type" name="media_type" class="form-select" data-eu-dropdown="outlined">
        <option value="image" <%= banner.media_type === 'image' ? 'selected' : '' %>>Gambar Beresolusi Tinggi (WebP / JPG / PNG)</option>
        <option value="video" <%= banner.media_type === 'video' ? 'selected' : '' %>>Berkas Video Lokal (MP4 / WebM)</option>
        <option value="youtube" <%= banner.media_type === 'youtube' ? 'selected' : '' %>>Streaming Video YouTube (URL Embed Resmi)</option>
      </select>
    </div>

    <div class="form-group <%= banner.media_type === 'youtube' ? 'adm-d-none' : '' %>" id="groupMediaPicker">
      <label class="form-label" id="labelMediaPicker">Berkas Media (Gambar / Video)</label>
      <div class="media-picker-component">
        <input type="hidden" id="banner_file_url" name="file_url" value="<%= banner.media_type !== 'youtube' ? (banner.file_url || banner.image_url || '') : '' %>">
        <div class="media-picker-preview-box">
          <% if (banner.media_type === 'image' && (banner.file_url || banner.image_url)) { %>
            <img src="<%= banner.file_url || banner.image_url %>" alt="Pratinjau" class="adm-d-block">
            <video src="" controls class="adm-d-none"></video>
            <div class="media-picker-empty adm-d-none"></div>
          <% } else if (banner.media_type === 'video' && (banner.file_url || banner.video_url)) { %>
            <img src="" alt="Pratinjau" class="adm-d-none">
            <video src="<%= banner.file_url || banner.video_url %>" controls class="adm-d-block"></video>
            <div class="media-picker-empty adm-d-none"></div>
          <% } else { %>
            <img src="" alt="Pratinjau" class="adm-d-none">
            <video src="" controls class="adm-d-none"></video>
            <div class="media-picker-empty">
              <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <span>Belum ada aset media dipilih</span>
            </div>
          <% } %>
        </div>
        <div class="media-picker-ctrls">
          <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="banner_file_url" data-picker-type="<%= banner.media_type === 'video' ? 'video' : 'image' %>" id="btnBannerOpenPicker" aria-label="Pilih aset media banner dari Media Library">
            <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Pilih Media</span>
          </button>
          <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media <%= (banner.file_url || banner.image_url) ? '' : 'adm-d-none' %>" aria-label="Hapus aset media banner">
            <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <span>Hapus</span>
          </button>
        </div>
      </div>
    </div>

    <div class="form-group <%= banner.media_type === 'youtube' ? '' : 'adm-d-none' %>" id="groupYouTubeInput">
      <label class="form-label" for="youtube_url">Tautan / URL Video YouTube</label>
      <input type="text" id="youtube_url" name="youtube_url" class="form-input" value="<%= banner.media_type === 'youtube' ? (banner.file_url?.length === 11 ? 'https://www.youtube.com/watch?v=' + banner.file_url : banner.file_url) : '' %>" placeholder="Contoh: https://www.youtube.com/watch?v=dQw4w9WgXcQ">
      <span class="adm-banner-hint">Mendukung format tautan YouTube reguler, share youtu.be, shorts, atau ID video 11 karakter.</span>
      <div id="bannerYtPreview" class="adm-banner-yt-preview <%= (banner.media_type === 'youtube' && banner.file_url) ? '' : 'adm-d-none' %>">
        <iframe id="bannerYtIframe" width="100%" height="220" src="<%= (banner.media_type === 'youtube' && banner.file_url) ? ('https://www.youtube.com/embed/' + (banner.file_url.includes('embed/') ? banner.file_url.split('embed/')[1] : banner.file_url)) : '' %>" title="Pratinjau YouTube" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen class="adm-banner-yt-iframe"></iframe>
      </div>
    </div>

    <div class="form-group <%= (banner.media_type === 'video' || banner.media_type === 'youtube') ? '' : 'adm-d-none' %>" id="groupPosterPicker">
      <label class="form-label">Gambar Poster Fallback (Disarankan untuk Tampilan Ponsel / Mobile)</label>
      <div class="media-picker-component">
        <input type="hidden" id="banner_poster_url" name="poster_url" value="<%= banner.poster_url || '' %>">
        <div class="media-picker-preview-box adm-banner-poster-preview">
          <% if (banner.poster_url) { %>
            <img src="<%= banner.poster_url %>" alt="Poster Pratinjau" class="adm-d-block">
            <div class="media-picker-empty adm-d-none"></div>
          <% } else { %>
            <img src="" alt="Poster Pratinjau" class="adm-d-none">
            <div class="media-picker-empty">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <span class="adm-banner-empty-text">Belum ada poster dipilih</span>
            </div>
          <% } %>
        </div>
        <div class="media-picker-ctrls">
          <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="banner_poster_url" data-picker-type="image" aria-label="Pilih gambar poster fallback dari Media Library">
            <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Pilih Poster</span>
          </button>
          <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media <%= banner.poster_url ? '' : 'adm-d-none' %>" aria-label="Hapus poster fallback">
            <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <span>Hapus</span>
          </button>
        </div>
      </div>
    </div>

    <div class="adm-banner-section-divider">
      <h3 class="adm-banner-section-title">Tombol Utama (Primary CTA)</h3>
      <p class="adm-banner-section-desc">Tombol solid utama. Jika URL dikosongkan, secara otomatis mengarah ke halaman kontak (/contact).</p>
      
      <div class="form-row-3">
        <div class="form-group">
          <label class="form-label" for="cta_text_id">Teks Tombol (ID)</label>
          <input type="text" id="cta_text_id" name="cta_text_id" class="form-input" maxlength="100" value="<%= banner.cta_text_id || '' %>" placeholder="Contoh: Hubungi Kami">
        </div>
        <div class="form-group">
          <label class="form-label" for="cta_text_en">Teks Tombol (EN)</label>
          <input type="text" id="cta_text_en" name="cta_text_en" class="form-input" maxlength="100" value="<%= banner.cta_text_en || '' %>" placeholder="Example: Contact Us">
        </div>
        <div class="form-group">
          <label class="form-label" for="cta_url">URL Tujuan</label>
          <input type="text" id="cta_url" name="cta_url" class="form-input" maxlength="500" value="<%= banner.cta_url || '' %>" placeholder="Contoh: /contact atau #kontak">
        </div>
      </div>
    </div>

    <div class="adm-banner-section-divider-bottom">
      <h3 class="adm-banner-section-title">Tombol Kedua (Secondary CTA)</h3>
      <p class="adm-banner-section-desc">Tombol outline pendamping. Kosongkan teks jika hanya butuh 1 tombol. Mendukung internal path (diawali / atau #) dan link eksternal (http/https).</p>
      
      <div class="form-row-3">
        <div class="form-group">
          <label class="form-label" for="cta_secondary_text_id">Teks Tombol Kedua (ID)</label>
          <input type="text" id="cta_secondary_text_id" name="cta_secondary_text_id" class="form-input" maxlength="100" value="<%= banner.cta_secondary_text_id || '' %>" placeholder="Contoh: Lihat Detail">
        </div>
        <div class="form-group">
          <label class="form-label" for="cta_secondary_text_en">Teks Tombol Kedua (EN)</label>
          <input type="text" id="cta_secondary_text_en" name="cta_secondary_text_en" class="form-input" maxlength="100" value="<%= banner.cta_secondary_text_en || '' %>" placeholder="Example: Learn More">
        </div>
        <div class="form-group">
          <label class="form-label" for="cta_secondary_url">URL Tujuan Tombol Kedua</label>
          <input type="text" id="cta_secondary_url" name="cta_secondary_url" class="form-input" maxlength="500" value="<%= banner.cta_secondary_url || '' %>" placeholder="Contoh: /products atau https://wa.me/...">
        </div>
      </div>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <label class="form-label" for="sort_order">Nomor Urutan Tampil (Slide)</label>
        <input type="number" id="sort_order" name="sort_order" class="form-input" value="<%= banner.sort_order %>" min="0">
      </div>
      <div class="form-group adm-banner-align-end">
        <label class="form-check adm-banner-check-mb">
          <input type="checkbox" name="is_active" value="1" <%= (banner.is_active === 1 || banner.is_active === true) ? 'checked' : '' %>>
          <span>Aktifkan banner ini dalam slider</span>
        </label>
      </div>
    </div>

    <div class="form-actions-bar">
      <a href="/admin/banners" class="adm-btn adm-btn-neutral" aria-label="Batalkan perubahan">
        <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        <span>Batal</span>
      </a>
      <button type="submit" class="adm-btn adm-btn-primary" aria-label="Simpan perubahan banner">
        <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Simpan</span>
      </button>
    </div>
  </form>
</div>

<script src="/js/admin-banners.js"></script>

<%- include('../../partials/admin-footer') %>

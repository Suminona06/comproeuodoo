<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Manajemen Konten Homepage</h1>
    <p>Kelola narasi intro pabrik, 3 pilar keunggulan, sertifikasi mutu, dan banner CTA global pre-footer.</p>
  </div>
  <div class="header-actions">
    <a href="/" target="_blank" class="adm-btn adm-btn-secondary" aria-label="Buka halaman beranda publik">
      <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      <span>Pratinjau</span>
    </a>
  </div>
</div>

<form action="/admin/home-content?_csrf=<%= csrfToken %>" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="about-tabs-nav" role="tablist">
    <button type="button" class="about-tab-btn active" data-tab="tab-home-intro" role="tab" aria-selected="true">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
      <span>1. Intro Homepage</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-home-wcu" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      <span>2. Kenapa Memilih Kami</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-home-categories" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="18" rx="1"></rect><rect x="14" y="3" width="7" height="18" rx="1"></rect></svg>
      <span>3. 4 Kategori Beranda</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-home-certs" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      <span>4. Sertifikasi Mutu</span>
    </button>
    <button type="button" class="about-tab-btn" data-tab="tab-home-cta" role="tab" aria-selected="false">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
      <span>5. CTA Global Pre-Footer</span>
    </button>
  </div>

  <!-- TAB PANE 1: INTRO HOMEPAGE -->
  <div class="about-tab-pane active" id="tab-home-intro" role="tabpanel">
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Pengantar Profil &amp; Sejarah Perusahaan (#intro)</span>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; font-weight: 600;">
          <input type="checkbox" name="intro_is_active" value="1" <%= (homeContent.intro.is_active === 1 || homeContent.intro.is_active === '1' || homeContent.intro.is_active === true) ? 'checked' : '' %>>
          <span>Tampilkan Seksi Intro</span>
        </label>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="intro_eyebrow_id" class="form-label">Eyebrow / Sub-label (Indonesia)</label>
          <input type="text" id="intro_eyebrow_id" name="intro_eyebrow_id" class="form-input" value="<%= homeContent.intro.eyebrow_id || '' %>" placeholder="TENTANG PT EUODOO">
          <div class="form-hint">Label kecil di atas judul utama.</div>
        </div>
        <div class="form-group">
          <label for="intro_eyebrow_en" class="form-label">Eyebrow / Sub-label (English)</label>
          <input type="text" id="intro_eyebrow_en" name="intro_eyebrow_en" class="form-input" value="<%= homeContent.intro.eyebrow_en || '' %>" placeholder="ABOUT PT EUODOO">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="intro_title_id" class="form-label">Judul Utama (Indonesia)</label>
          <input type="text" id="intro_title_id" name="intro_title_id" class="form-input" value="<%= homeContent.intro.title_id || '' %>" placeholder="Dedikasi Manufaktur Plastik Berkualitas Sejak 1990">
        </div>
        <div class="form-group">
          <label for="intro_title_en" class="form-label">Judul Utama (English)</label>
          <input type="text" id="intro_title_en" name="intro_title_en" class="form-input" value="<%= homeContent.intro.title_en || '' %>" placeholder="Over Three Decades of Plastic Film Manufacturing Excellence">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="intro_paragraph_1_id" class="form-label">Paragraf 1 (Indonesia)</label>
          <textarea id="intro_paragraph_1_id" name="intro_paragraph_1_id" class="form-textarea" style="min-height: 110px;"><%= homeContent.intro.paragraph_1_id || '' %></textarea>
        </div>
        <div class="form-group">
          <label for="intro_paragraph_1_en" class="form-label">Paragraf 1 (English)</label>
          <textarea id="intro_paragraph_1_en" name="intro_paragraph_1_en" class="form-textarea" style="min-height: 110px;"><%= homeContent.intro.paragraph_1_en || '' %></textarea>
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="intro_paragraph_2_id" class="form-label">Paragraf 2 (Indonesia)</label>
          <textarea id="intro_paragraph_2_id" name="intro_paragraph_2_id" class="form-textarea" style="min-height: 110px;"><%= homeContent.intro.paragraph_2_id || '' %></textarea>
        </div>
        <div class="form-group">
          <label for="intro_paragraph_2_en" class="form-label">Paragraf 2 (English)</label>
          <textarea id="intro_paragraph_2_en" name="intro_paragraph_2_en" class="form-textarea" style="min-height: 110px;"><%= homeContent.intro.paragraph_2_en || '' %></textarea>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Gambar Fasilitas / Visual Intro (Opsional via Media Library)</label>
        <div class="media-picker-component">
          <input type="hidden" id="home_intro_image_url" name="intro_image_url" value="<%= homeContent.intro.image_url || '' %>">
          <div class="media-picker-preview-box">
            <img src="<%= homeContent.intro.image_url || '' %>" alt="Pratinjau Intro" style="<%= homeContent.intro.image_url ? 'display: block;' : 'display: none;' %>">
            <div class="media-picker-empty" style="<%= homeContent.intro.image_url ? 'display: none;' : '' %>">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <span>Belum ada gambar visual dipilih (layout teks 2-kolom default tetap rapi)</span>
            </div>
          </div>
          <div class="media-picker-ctrls">
            <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="home_intro_image_url" data-picker-type="image" aria-label="Pilih foto intro beranda dari Media Library">
              <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <span>Pilih Media</span>
            </button>
            <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media" style="<%= homeContent.intro.image_url ? '' : 'display: none;' %>" aria-label="Hapus foto intro beranda">
              <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB PANE 2: KENAPA MEMILIH KAMI (WHY CHOOSE US) -->
  <div class="about-tab-pane" id="tab-home-wcu" role="tabpanel">
    <!-- Header & Status Seksi -->
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Header &amp; Status Seksi Why Choose Us (#why-us)</span>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; font-weight: 600;">
          <input type="checkbox" name="wcu_is_active" value="1" <%= (homeContent.why_choose_us?.is_active === 1 || homeContent.why_choose_us?.is_active === '1' || homeContent.why_choose_us?.is_active === true) ? 'checked' : '' %>>
          <span>Tampilkan Seksi Why Choose Us</span>
        </label>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="wcu_eyebrow_id" class="form-label">Eyebrow / Sub-label (Indonesia)</label>
          <input type="text" id="wcu_eyebrow_id" name="wcu_eyebrow_id" class="form-input" value="<%= homeContent.why_choose_us?.eyebrow_id || '' %>" placeholder="Inovasi untuk masa depan">
          <div class="form-hint">Label kecil di atas judul utama seksi.</div>
        </div>
        <div class="form-group">
          <label for="wcu_eyebrow_en" class="form-label">Eyebrow / Sub-label (English)</label>
          <input type="text" id="wcu_eyebrow_en" name="wcu_eyebrow_en" class="form-input" value="<%= homeContent.why_choose_us?.eyebrow_en || '' %>" placeholder="Innovation for the future">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="wcu_title_id" class="form-label">Judul Utama Seksi (Indonesia)</label>
          <input type="text" id="wcu_title_id" name="wcu_title_id" class="form-input" value="<%= homeContent.why_choose_us?.title_id || '' %>" placeholder="Why choose us[accent]?[/accent]">
          <div class="form-hint">Dukungan format markup: <code>[accent]?[/accent]</code> untuk aksen warna gradien hijau.</div>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="wcu_title_en" class="form-label">Judul Utama Seksi (English)</label>
          <input type="text" id="wcu_title_en" name="wcu_title_en" class="form-input" value="<%= homeContent.why_choose_us?.title_en || '' %>" placeholder="Why choose us[accent]?[/accent]">
        </div>
      </div>
    </div>

    <!-- Konten Editorial & Nilai Unggulan -->
    <div class="about-glass-card">
      <div class="form-card-title">
        <span>Konten Editorial &amp; Narasi Nilai Unggulan (Kolom Kiri)</span>
      </div>

      <div class="form-row-3">
        <div class="form-group">
          <label for="wcu_chip_icon" class="form-label">Ikon Kicker Chip</label>
          <select id="wcu_chip_icon" name="wcu_chip_icon" class="form-input">
            <option value="tree" <%= (homeContent.why_choose_us?.chip_icon === 'tree' || !homeContent.why_choose_us?.chip_icon) ? 'selected' : '' %>>Pohon Botani Eco (tree)</option>
            <option value="leaf" <%= homeContent.why_choose_us?.chip_icon === 'leaf' ? 'selected' : '' %>>Daun Hijau (leaf)</option>
            <option value="sparkle" <%= homeContent.why_choose_us?.chip_icon === 'sparkle' ? 'selected' : '' %>>Kilau Inovasi (sparkle)</option>
          </select>
          <div class="form-hint">Ikon interaktif mikro di samping label chip.</div>
        </div>
        <div class="form-group">
          <label for="wcu_chip_label_id" class="form-label">Label Chip Kicker (Indonesia)</label>
          <input type="text" id="wcu_chip_label_id" name="wcu_chip_label_id" class="form-input" value="<%= homeContent.why_choose_us?.chip_label_id || '' %>" placeholder="Solusi ramah lingkungan">
        </div>
        <div class="form-group">
          <label for="wcu_chip_label_en" class="form-label">Label Chip Kicker (English)</label>
          <input type="text" id="wcu_chip_label_en" name="wcu_chip_label_en" class="form-input" value="<%= homeContent.why_choose_us?.chip_label_en || '' %>" placeholder="Eco-friendly solutions">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="wcu_headline_id" class="form-label">Headline / Pernyataan Nilai (Indonesia)</label>
          <input type="text" id="wcu_headline_id" name="wcu_headline_id" class="form-input" value="<%= homeContent.why_choose_us?.headline_id || '' %>" placeholder="Inovasi material, dengan [mark]dampak yang lebih baik.[/mark]">
          <div class="form-hint">Dukungan format markup: <code>[mark]teks[/mark]</code> atau <code>==teks==</code> untuk highlight hijau.</div>
        </div>
        <div class="form-group">
          <label for="wcu_headline_en" class="form-label">Headline / Pernyataan Nilai (English)</label>
          <input type="text" id="wcu_headline_en" name="wcu_headline_en" class="form-input" value="<%= homeContent.why_choose_us?.headline_en || '' %>" placeholder="Material innovation, with [mark]better impact.[/mark]">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="wcu_desc_id" class="form-label">Paragraf Deskripsi Narasi (Indonesia)</label>
          <textarea id="wcu_desc_id" name="wcu_desc_id" class="form-textarea" style="min-height: 100px;"><%= homeContent.why_choose_us?.desc_id || '' %></textarea>
          <div class="form-hint">Dukungan format markup: <code>[strong]teks[/strong]</code> atau <code>**teks**</code> untuk teks tebal.</div>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="wcu_desc_en" class="form-label">Paragraf Deskripsi Narasi (English)</label>
          <textarea id="wcu_desc_en" name="wcu_desc_en" class="form-textarea" style="min-height: 100px;"><%= homeContent.why_choose_us?.desc_en || '' %></textarea>
        </div>
      </div>
    </div>

    <!-- Visual Artbox & Floating Card -->
    <div class="about-glass-card">
      <div class="form-card-title">
        <span>Artbox Ilustrasi &amp; Kartu Mengambang (Kolom Kanan)</span>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="wcu_art_label_id" class="form-label">Label Pita Artbox (Indonesia)</label>
          <input type="text" id="wcu_art_label_id" name="wcu_art_label_id" class="form-input" value="<%= homeContent.why_choose_us?.art_label_id || '' %>" placeholder="Material · Alam · Masa depan">
          <div class="form-hint">Label kecil di pojok kiri atas wadah ilustrasi SVG.</div>
        </div>
        <div class="form-group">
          <label for="wcu_art_label_en" class="form-label">Label Pita Artbox (English)</label>
          <input type="text" id="wcu_art_label_en" name="wcu_art_label_en" class="form-input" value="<%= homeContent.why_choose_us?.art_label_en || '' %>" placeholder="Material · Nature · Future">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="wcu_float_eyebrow_id" class="form-label">Floating Card Eyebrow (Indonesia)</label>
          <input type="text" id="wcu_float_eyebrow_id" name="wcu_float_eyebrow_id" class="form-input" value="<%= homeContent.why_choose_us?.float_eyebrow_id || '' %>" placeholder="Berorientasi masa depan">
        </div>
        <div class="form-group">
          <label for="wcu_float_eyebrow_en" class="form-label">Floating Card Eyebrow (English)</label>
          <input type="text" id="wcu_float_eyebrow_en" name="wcu_float_eyebrow_en" class="form-input" value="<%= homeContent.why_choose_us?.float_eyebrow_en || '' %>" placeholder="Future-oriented">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="wcu_float_title_id" class="form-label">Floating Card Judul (Indonesia)</label>
          <input type="text" id="wcu_float_title_id" name="wcu_float_title_id" class="form-input" value="<%= homeContent.why_choose_us?.float_title_id || '' %>" placeholder="Better by design.">
        </div>
        <div class="form-group">
          <label for="wcu_float_title_en" class="form-label">Floating Card Judul (English)</label>
          <input type="text" id="wcu_float_title_en" name="wcu_float_title_en" class="form-input" value="<%= homeContent.why_choose_us?.float_title_en || '' %>" placeholder="Better by design.">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="wcu_float_desc_id" class="form-label">Floating Card Keterangan (Indonesia)</label>
          <input type="text" id="wcu_float_desc_id" name="wcu_float_desc_id" class="form-input" value="<%= homeContent.why_choose_us?.float_desc_id || '' %>" placeholder="Inovasi material untuk langkah yang lebih bertanggung jawab.">
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="wcu_float_desc_en" class="form-label">Floating Card Keterangan (English)</label>
          <input type="text" id="wcu_float_desc_en" name="wcu_float_desc_en" class="form-input" value="<%= homeContent.why_choose_us?.float_desc_en || '' %>" placeholder="Material innovation for a more responsible path.">
        </div>
      </div>
    </div>
  </div>

  <!-- TAB PANE 3: 4 KATEGORI BERANDA -->
  <div class="about-tab-pane" id="tab-home-categories" role="tabpanel">
    <!-- Header Seksi Produk Beranda -->
    <div class="about-glass-card">
      <div class="form-card-title">
        <span>Header Seksi Kategori Produk (#produk)</span>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="cat_title_id" class="form-label">Judul Seksi (Indonesia)</label>
          <input type="text" id="cat_title_id" name="cat_title_id" class="form-input" value="<%= homeContent.categories?.title_id || '' %>" placeholder="Produk Unggulan Manufaktur">
        </div>
        <div class="form-group">
          <label for="cat_title_en" class="form-label">Judul Seksi (English)</label>
          <input type="text" id="cat_title_en" name="cat_title_en" class="form-input" value="<%= homeContent.categories?.title_en || '' %>" placeholder="Featured Manufacturing Products">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="cat_subtitle_id" class="form-label">Subtitle Pengantar (Indonesia)</label>
          <textarea id="cat_subtitle_id" name="cat_subtitle_id" class="form-textarea" style="min-height: 70px;"><%= homeContent.categories?.subtitle_id || '' %></textarea>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="cat_subtitle_en" class="form-label">Subtitle Pengantar (English)</label>
          <textarea id="cat_subtitle_en" name="cat_subtitle_en" class="form-textarea" style="min-height: 70px;"><%= homeContent.categories?.subtitle_en || '' %></textarea>
        </div>
      </div>
    </div>

    <!-- 4 Slot Panel Kategori Primer -->
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Manajemen 4 Panel Kategori Primer Homepage</span>
        <span class="badge badge-info" style="font-size: 11px;">Fixed 4 Slot Panel</span>
      </div>
      <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 1.25rem;">
        Pilih kategori produk dari database untuk masing-masing slot panel di beranda. Cover image bersifat kustom via Media Library; jika tidak diisi, sistem akan otomatis menggunakan gambar segmen bawaan kategori.
      </p>

      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <% 
          const defaultSlotIds = [4, 5, 6, 7];
          const activeHomeCats = (homeContent.homepage_categories && homeContent.homepage_categories.length > 0)
            ? homeContent.homepage_categories
            : [
                { category_id: 4, image_url: '/images/segment-retail.jpg' },
                { category_id: 5, image_url: '/images/segment-industrial.jpg' },
                { category_id: 6, image_url: '/images/segment-traditional.jpg' },
                { category_id: 7, image_url: '/images/segment-sustainability.jpg' }
              ];
        %>
        <% [0, 1, 2, 3].forEach(function(idx) { 
          const catItem = activeHomeCats[idx] || { category_id: defaultSlotIds[idx], image_url: '' };
          const selectedCatId = Number(catItem.category_id || defaultSlotIds[idx]);
        %>
          <div style="background: #ffffff; border: 1px solid var(--border-main); border-radius: var(--r-lg); padding: 1.25rem; box-shadow: var(--shadow-xs);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle, #f1f5f9); padding-bottom: 0.75rem;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 13px; font-weight: 700; width: 30px; height: 30px; border-radius: 50%; background: var(--primary, #00755a); color: #ffffff; display: inline-flex; align-items: center; justify-content: center;">
                  #<%= idx + 1 %>
                </span>
                <strong style="color: var(--secondary, #071f17); font-size: 14px;">Panel Slot <%= idx + 1 %></strong>
              </div>
              <span class="badge badge-secondary" style="font-size: 11px;">Slot Urutan <%= idx + 1 %></span>
            </div>

            <div class="form-row-2">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="home_cat_<%= idx %>_id" class="form-label">Kategori Produk Terpilih *</label>
                <select id="home_cat_<%= idx %>_id" name="home_cat_<%= idx %>_id" class="form-input" required>
                  <option value="">-- Pilih Kategori --</option>
                  <% (allCategories || []).forEach(function(cat) { %>
                    <option value="<%= cat.id %>" <%= cat.id === selectedCatId ? 'selected' : '' %>>
                      <%= cat.name_id %> (<%= cat.slug %>) - <%= cat.product_count || 0 %> Produk
                    </option>
                  <% }); %>
                </select>
                <div class="form-hint">Target link panel di homepage akan mengarah ke <code>/products?category={slug}</code>.</div>
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Gambar Cover Panel (Media Library)</label>
                <div class="media-picker-component">
                  <input type="hidden" id="home_cat_<%= idx %>_image_url" name="home_cat_<%= idx %>_image_url" value="<%= catItem.image_url || '' %>">
                  <div class="media-picker-preview-box">
                    <img src="<%= catItem.image_url || '' %>" alt="Pratinjau Cover" style="<%= catItem.image_url ? 'display: block;' : 'display: none;' %>">
                    <div class="media-picker-empty" style="<%= catItem.image_url ? 'display: none;' : '' %>">
                      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                      <span>Gambar cover custom (opsional, jika kosong fallback bawaan)</span>
                    </div>
                  </div>
                  <div class="media-picker-ctrls">
                    <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="home_cat_<%= idx %>_image_url" data-picker-type="image" aria-label="Pilih foto kategori dari Media Library">
                      <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                      <span>Pilih Media</span>
                    </button>
                    <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media" style="<%= catItem.image_url ? '' : 'display: none;' %>" aria-label="Hapus foto kategori">
                      <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- TAB PANE 4: SERTIFIKASI MUTU -->
  <div class="about-tab-pane" id="tab-home-certs" role="tabpanel">
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Header Seksi Sertifikasi Mutu (#sertifikasi)</span>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; font-weight: 600;">
          <input type="checkbox" name="cert_is_active" value="1" <%= (homeContent.certifications.is_active === 1 || homeContent.certifications.is_active === '1' || homeContent.certifications.is_active === true) ? 'checked' : '' %>>
          <span>Tampilkan Seksi Sertifikasi</span>
        </label>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="cert_title_id" class="form-label">Judul Seksi (Indonesia)</label>
          <input type="text" id="cert_title_id" name="cert_title_id" class="form-input" value="<%= homeContent.certifications.title_id || '' %>">
        </div>
        <div class="form-group">
          <label for="cert_title_en" class="form-label">Judul Seksi (English)</label>
          <input type="text" id="cert_title_en" name="cert_title_en" class="form-input" value="<%= homeContent.certifications.title_en || '' %>">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="cert_body_id" class="form-label">Paragraf Pengantar (Indonesia)</label>
          <textarea id="cert_body_id" name="cert_body_id" class="form-textarea" style="min-height: 80px;"><%= homeContent.certifications.body_id || '' %></textarea>
        </div>
        <div class="form-group">
          <label for="cert_body_en" class="form-label">Paragraf Pengantar (English)</label>
          <textarea id="cert_body_en" name="cert_body_en" class="form-textarea" style="min-height: 80px;"><%= homeContent.certifications.body_en || '' %></textarea>
        </div>
      </div>

      <div class="form-row-3" style="margin-bottom: 0;">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="cert_btn_text_id" class="form-label">Teks Tombol CTA (ID)</label>
          <input type="text" id="cert_btn_text_id" name="cert_btn_text_id" class="form-input" value="<%= homeContent.certifications.btn_text_id || '' %>">
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="cert_btn_text_en" class="form-label">Teks Tombol CTA (EN)</label>
          <input type="text" id="cert_btn_text_en" name="cert_btn_text_en" class="form-input" value="<%= homeContent.certifications.btn_text_en || '' %>">
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label for="cert_btn_url" class="form-label">URL Tombol CTA</label>
          <input type="text" id="cert_btn_url" name="cert_btn_url" class="form-input" value="<%= homeContent.certifications.btn_url || '/about#sertifikasi' %>">
        </div>
      </div>

      <div style="margin-top: 1rem;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px;">
          <input type="checkbox" name="cert_show_btn" value="1" <%= (homeContent.certifications.show_btn === 1 || homeContent.certifications.show_btn === '1' || homeContent.certifications.show_btn === true) ? 'checked' : '' %>>
          <span>Tampilkan Tombol CTA di Seksi Sertifikasi</span>
        </label>
      </div>
    </div>

    <!-- Certification Items -->
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Daftar Sertifikasi &amp; Standar Mutu Homepage</span>
        <span class="badge badge-info" style="font-size: 11px;">Maksimal 4 Item</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <% 
          const cItems = (homeContent.certifications.items && homeContent.certifications.items.length > 0)
            ? homeContent.certifications.items
            : [
                { name: 'SNI 7188.7:2011', desc_id: '', desc_en: '', logo_url: '', sort_order: 1, is_active: 1 },
                { name: 'OXIUM® Technology', desc_id: '', desc_en: '', logo_url: '', sort_order: 2, is_active: 1 },
                { name: 'InSWA Eco Label', desc_id: '', desc_en: '', logo_url: '', sort_order: 3, is_active: 1 },
                { name: 'Virgin Food-Grade Contact', desc_id: '', desc_en: '', logo_url: '', sort_order: 4, is_active: 1 }
              ];
        %>
        <% [0, 1, 2, 3].forEach(function(idx) { 
          const item = cItems[idx] || {};
        %>
          <div style="background: #ffffff; border: 1px solid var(--border-main); border-radius: var(--r-lg); padding: 1.25rem; box-shadow: var(--shadow-xs);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle, #f1f5f9); padding-bottom: 0.75rem;">
              <strong style="color: var(--secondary, #071f17); font-size: 14px;">Item Sertifikasi #<%= idx + 1 %></strong>
              <div style="display: flex; align-items: center; gap: 16px;">
                <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; cursor: pointer;">
                  <span>Urutan:</span>
                  <input type="number" name="cert_<%= idx %>_sort_order" class="form-input" style="width: 60px; padding: 4px 8px;" value="<%= item.sort_order || (idx + 1) %>" min="1" max="10">
                </label>
                <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">
                  <input type="checkbox" name="cert_<%= idx %>_is_active" value="1" <%= (item.is_active === 1 || item.is_active === '1' || item.is_active === true) ? 'checked' : '' %>>
                  <span>Aktif</span>
                </label>
              </div>
            </div>

            <div class="form-row-3" style="margin-bottom: 0.75rem;">
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Nama Sertifikasi *</label>
                <input type="text" name="cert_<%= idx %>_name" class="form-input" value="<%= item.name || '' %>" placeholder="Mis. SNI 7188.7:2011">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Deskripsi Singkat (ID)</label>
                <input type="text" name="cert_<%= idx %>_desc_id" class="form-input" value="<%= item.desc_id || '' %>">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 12px;">Deskripsi Singkat (EN)</label>
                <input type="text" name="cert_<%= idx %>_desc_en" class="form-input" value="<%= item.desc_en || '' %>">
              </div>
            </div>

            <div class="form-group" style="margin-bottom: 0; margin-top: 0.75rem;">
              <label class="form-label" style="font-size: 12px;">Logo Sertifikasi (Media Library - Kosongkan jika ingin checkmark centang otomatis)</label>
              <div class="media-picker-component">
                <input type="hidden" id="cert_logo_<%= idx %>" name="cert_<%= idx %>_logo_url" value="<%= item.logo_url || '' %>">
                <div class="media-picker-preview-box" style="height: 60px; max-width: 160px;">
                  <img src="<%= item.logo_url || '' %>" alt="Logo Sertifikasi" style="<%= item.logo_url ? 'display: block;' : 'display: none;' %>">
                  <div class="media-picker-empty" style="<%= item.logo_url ? 'display: none;' : '' %>">
                    <span style="font-size: 11px;">Ikon Centang &#10003;</span>
                  </div>
                </div>
                <div class="media-picker-ctrls">
                  <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="cert_logo_<%= idx %>" data-picker-type="image" aria-label="Pilih logo sertifikat dari Media Library">
                    <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    <span>Pilih Media</span>
                  </button>
                  <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media" style="<%= item.logo_url ? '' : 'display: none;' %>" aria-label="Hapus logo sertifikat">
                    <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <span>Hapus</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- TAB PANE 5: CTA GLOBAL PRE-FOOTER -->
  <div class="about-tab-pane" id="tab-home-cta" role="tabpanel">
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Konten Banner CTA Pre-Footer Terpusat</span>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; font-weight: 600;">
          <input type="checkbox" name="cta_is_active" value="1" <%= (homeContent.cta.is_active === 1 || homeContent.cta.is_active === '1' || homeContent.cta.is_active === true) ? 'checked' : '' %>>
          <span>Master Aktif CTA Global</span>
        </label>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="cta_title_id" class="form-label">Judul Banner (Indonesia)</label>
          <input type="text" id="cta_title_id" name="cta_title_id" class="form-input" value="<%= homeContent.cta.title_id || '' %>">
        </div>
        <div class="form-group">
          <label for="cta_title_en" class="form-label">Judul Banner (English)</label>
          <input type="text" id="cta_title_en" name="cta_title_en" class="form-input" value="<%= homeContent.cta.title_en || '' %>">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="cta_subtitle_id" class="form-label">Subjudul / Penjelasan (Indonesia)</label>
          <textarea id="cta_subtitle_id" name="cta_subtitle_id" class="form-textarea" style="min-height: 80px;"><%= homeContent.cta.subtitle_id || '' %></textarea>
        </div>
        <div class="form-group">
          <label for="cta_subtitle_en" class="form-label">Subjudul / Penjelasan (English)</label>
          <textarea id="cta_subtitle_en" name="cta_subtitle_en" class="form-textarea" style="min-height: 80px;"><%= homeContent.cta.subtitle_en || '' %></textarea>
        </div>
      </div>

      <!-- Tombol 1: Utama / RFQ -->
      <div style="background: #f8fafc; border: 1px solid var(--border-main); border-radius: var(--r-md); padding: 1rem; margin-bottom: 1.25rem;">
        <strong style="display: block; color: var(--secondary, #071f17); font-size: 13px; margin-bottom: 0.75rem;">Tombol Utama (Default: Hubungi Tim Pemasaran / Form RFQ)</strong>
        <div class="form-row-2" style="margin-bottom: 0.5rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 12px;">Judul Tombol (ID)</label>
            <input type="text" name="cta_btn1_title_id" class="form-input" value="<%= homeContent.cta.btn1_title_id || '' %>">
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 12px;">Judul Tombol (EN)</label>
            <input type="text" name="cta_btn1_title_en" class="form-input" value="<%= homeContent.cta.btn1_title_en || '' %>">
          </div>
        </div>
        <div class="form-row-2" style="margin-bottom: 0.5rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 12px;">Keterangan / Sub-teks (ID)</label>
            <input type="text" name="cta_btn1_sub_id" class="form-input" value="<%= homeContent.cta.btn1_sub_id || '' %>">
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 12px;">Keterangan / Sub-teks (EN)</label>
            <input type="text" name="cta_btn1_sub_en" class="form-input" value="<%= homeContent.cta.btn1_sub_en || '' %>">
          </div>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" style="font-size: 12px;">URL Tujuan Link</label>
          <input type="text" name="cta_btn1_url" class="form-input" value="<%= homeContent.cta.btn1_url || '/contact' %>" placeholder="/contact">
        </div>
      </div>

      <!-- Tombol 2: Sekunder / WhatsApp -->
      <div style="background: #f8fafc; border: 1px solid var(--border-main); border-radius: var(--r-md); padding: 1rem; margin-bottom: 0;">
        <strong style="display: block; color: var(--secondary, #071f17); font-size: 13px; margin-bottom: 0.75rem;">Tombol Sekunder (Default: Kirim Pesan WhatsApp)</strong>
        <div class="form-row-2" style="margin-bottom: 0.5rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 12px;">Judul Tombol (ID)</label>
            <input type="text" name="cta_btn2_title_id" class="form-input" value="<%= homeContent.cta.btn2_title_id || '' %>">
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 12px;">Judul Tombol (EN)</label>
            <input type="text" name="cta_btn2_title_en" class="form-input" value="<%= homeContent.cta.btn2_title_en || '' %>">
          </div>
        </div>
        <div class="form-row-2" style="margin-bottom: 0.5rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 12px;">Keterangan / Sub-teks (ID)</label>
            <input type="text" name="cta_btn2_sub_id" class="form-input" value="<%= homeContent.cta.btn2_sub_id || '' %>">
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 12px;">Keterangan / Sub-teks (EN)</label>
            <input type="text" name="cta_btn2_sub_en" class="form-input" value="<%= homeContent.cta.btn2_sub_en || '' %>">
          </div>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" style="font-size: 12px;">URL Tujuan Link (Kosongkan untuk otomatis pakai WhatsApp Pengaturan Situs)</label>
          <input type="text" name="cta_btn2_url" class="form-input" value="<%= homeContent.cta.btn2_url || '' %>" placeholder="Otomatis fallback ke setting whatsapp_url jika kosong">
        </div>
      </div>
    </div>

    <!-- Page Visibility Checkboxes (Q4 Opsi B) -->
    <div class="about-glass-card">
      <div class="form-card-title" style="display: flex; align-items: center; justify-content: space-between;">
        <span>Pengaturan Visibilitas Per Halaman Publik (9 Halaman)</span>
        <span class="badge badge-primary" style="font-size: 11px;">Kontrol Admin Penuh</span>
      </div>
      <p style="font-size: 13px; color: var(--text-muted); margin: -0.5rem 0 1.25rem 0;">
        Pilih halaman mana saja yang akan menampilkan banner CTA Global pre-footer ini:
      </p>

      <% 
        const pConf = homeContent.cta.pages || {};
        const isPageOn = (k) => pConf[k] === 1 || pConf[k] === '1' || pConf[k] === true;
      %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
        <label style="display: flex; align-items: center; gap: 10px; background: #ffffff; border: 1px solid var(--border-main); padding: 0.85rem 1rem; border-radius: var(--r-md); cursor: pointer;">
          <input type="checkbox" name="cta_page_home" value="1" <%= isPageOn('home') ? 'checked' : '' %>>
          <span style="font-size: 13px; font-weight: 500;">Beranda (Homepage)</span>
        </label>
        <label style="display: flex; align-items: center; gap: 10px; background: #ffffff; border: 1px solid var(--border-main); padding: 0.85rem 1rem; border-radius: var(--r-md); cursor: pointer;">
          <input type="checkbox" name="cta_page_about" value="1" <%= isPageOn('about') ? 'checked' : '' %>>
          <span style="font-size: 13px; font-weight: 500;">Tentang Kami (/about)</span>
        </label>
        <label style="display: flex; align-items: center; gap: 10px; background: #ffffff; border: 1px solid var(--border-main); padding: 0.85rem 1rem; border-radius: var(--r-md); cursor: pointer;">
          <input type="checkbox" name="cta_page_products" value="1" <%= isPageOn('products') ? 'checked' : '' %>>
          <span style="font-size: 13px; font-weight: 500;">Katalog Produk (/products)</span>
        </label>
        <label style="display: flex; align-items: center; gap: 10px; background: #ffffff; border: 1px solid var(--border-main); padding: 0.85rem 1rem; border-radius: var(--r-md); cursor: pointer;">
          <input type="checkbox" name="cta_page_product_detail" value="1" <%= isPageOn('product_detail') ? 'checked' : '' %>>
          <span style="font-size: 13px; font-weight: 500;">Detail Produk (/products/:slug)</span>
        </label>
        <label style="display: flex; align-items: center; gap: 10px; background: #ffffff; border: 1px solid var(--border-main); padding: 0.85rem 1rem; border-radius: var(--r-md); cursor: pointer;">
          <input type="checkbox" name="cta_page_capabilities" value="1" <%= isPageOn('capabilities') ? 'checked' : '' %>>
          <span style="font-size: 13px; font-weight: 500;">Kapabilitas Mesin (/capabilities)</span>
        </label>
        <label style="display: flex; align-items: center; gap: 10px; background: #ffffff; border: 1px solid var(--border-main); padding: 0.85rem 1rem; border-radius: var(--r-md); cursor: pointer;">
          <input type="checkbox" name="cta_page_news" value="1" <%= isPageOn('news') ? 'checked' : '' %>>
          <span style="font-size: 13px; font-weight: 500;">Berita &amp; Artikel (/news)</span>
        </label>
        <label style="display: flex; align-items: center; gap: 10px; background: #ffffff; border: 1px solid var(--border-main); padding: 0.85rem 1rem; border-radius: var(--r-md); cursor: pointer;">
          <input type="checkbox" name="cta_page_news_detail" value="1" <%= isPageOn('news_detail') ? 'checked' : '' %>>
          <span style="font-size: 13px; font-weight: 500;">Detail Berita (/news/:slug)</span>
        </label>
        <label style="display: flex; align-items: center; gap: 10px; background: #ffffff; border: 1px solid var(--border-main); padding: 0.85rem 1rem; border-radius: var(--r-md); cursor: pointer;">
          <input type="checkbox" name="cta_page_contact" value="1" <%= isPageOn('contact') ? 'checked' : '' %>>
          <span style="font-size: 13px; font-weight: 500;">Kontak Kami (/contact)</span>
        </label>
        <label style="display: flex; align-items: center; gap: 10px; background: #ffffff; border: 1px solid var(--border-main); padding: 0.85rem 1rem; border-radius: var(--r-md); cursor: pointer;">
          <input type="checkbox" name="cta_page_404" value="1" <%= isPageOn('404') ? 'checked' : '' %>>
          <span style="font-size: 13px; font-weight: 500;">Halaman 404 (Not Found)</span>
        </label>
      </div>
    </div>
  </div>

  <!-- Sticky Actions Bar -->
  <div class="about-sticky-actions">
    <div class="actions-left" style="display: flex; align-items: center; gap: 8px;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
      <span style="font-size: 13px; color: var(--text-muted); font-weight: 500;">
        Semua 5 tab tersimpan sekaligus dalam satu klik.
      </span>
    </div>
    <div class="actions-right" style="display: flex; align-items: center; gap: 10px;">
      <a href="/admin/dashboard" class="adm-btn adm-btn-neutral" aria-label="Batalkan perubahan beranda">
        <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>Batal</span>
      </a>
      <button type="submit" class="adm-btn adm-btn-primary" aria-label="Simpan perubahan konten beranda">
        <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Simpan</span>
      </button>
    </div>
  </div>
</form>

<%- include('../../partials/admin-footer') %>

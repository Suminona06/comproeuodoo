<div class="about-glass-card">
  <div class="form-card-title"><span>Visual Artbox &amp; Kartu Mengambang (Kolom Kanan)</span></div>
  <div class="form-group">
    <label class="form-label">Gambar Utama Artbox Why Choose Us (Opsional via Media Library)</label>
    <div class="media-picker-component">
      <input type="hidden" id="home_wcu_image_url" name="wcu_image_url" value="<%= wcu.image_url || '' %>">
      <div class="media-picker-preview-box">
        <img src="<%= wcu.image_url || '' %>" alt="Pratinjau Gambar Why Choose Us" class="media-picker-preview-img <%= wcu.image_url ? '' : 'hidden' %>">
        <div class="media-picker-empty <%= wcu.image_url ? 'hidden' : '' %>">
          <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span>Belum ada gambar dipilih (otomatis memakai ilustrasi SVG bawaan dengan gradasi hijau)</span>
        </div>
      </div>
      <div class="media-picker-ctrls">
        <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="home_wcu_image_url" data-picker-type="image" aria-label="Pilih gambar Why Choose Us dari Media Library">
          <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span>Pilih Media</span>
        </button>
        <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media <%= wcu.image_url ? '' : 'hidden' %>" aria-label="Hapus gambar Why Choose Us">
          <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          <span>Hapus</span>
        </button>
      </div>
    </div>
  </div>
  <% [
    { key: 'art_label', label: 'Label Pita Artbox', phId: 'Material · Alam · Masa depan', phEn: 'Material · Nature · Future', hint: 'Label pita di bagian atas wadah visual artbox.' },
    { key: 'float_eyebrow', label: 'Floating Card Eyebrow', phId: 'Berorientasi masa depan', phEn: 'Future-oriented' },
    { key: 'float_title', label: 'Floating Card Judul', phId: 'Better by design.', phEn: 'Better by design.' },
    { key: 'float_desc', label: 'Floating Card Keterangan', phId: 'Inovasi material untuk langkah bertanggung jawab.', phEn: 'Material innovation for a responsible path.' }
  ].forEach(function(f, fIdx) { %>
    <div class="form-row-2">
      <div class="form-group <%= fIdx === 3 ? 'adm-home-mb-0' : '' %>">
        <label for="wcu_<%= f.key %>_id" class="form-label"><%= f.label %> (Indonesia)</label>
        <input type="text" id="wcu_<%= f.key %>_id" name="wcu_<%= f.key %>_id" class="form-input" value="<%= wcu[f.key + '_id'] || '' %>" placeholder="<%= f.phId %>">
        <% if (f.hint) { %><div class="form-hint"><%= f.hint %></div><% } %>
      </div>
      <div class="form-group <%= fIdx === 3 ? 'adm-home-mb-0' : '' %>">
        <label for="wcu_<%= f.key %>_en" class="form-label"><%= f.label %> (English)</label>
        <input type="text" id="wcu_<%= f.key %>_en" name="wcu_<%= f.key %>_en" class="form-input" value="<%= wcu[f.key + '_en'] || '' %>" placeholder="<%= f.phEn %>">
      </div>
    </div>
  <% }); %>
</div>

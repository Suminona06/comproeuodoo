<%- include('../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Ganti Kata Sandi Administrator</h1>
    <p>Perbarui kata sandi secara berkala untuk menjaga keamanan akun administrator.</p>
  </div>
  <div class="header-actions">
    <a href="/admin/dashboard" class="adm-btn adm-btn-neutral" aria-label="Kembali ke Dashboard">
      <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
      <span>Kembali</span>
    </a>
  </div>
</div>

<div class="form-card" style="max-width: 580px; margin: 0 auto;">
  <div class="form-card-title">Pengaturan Kredensial Keamanan</div>

  <form action="/admin/change-password?_csrf=<%= csrfToken %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label for="current_password" class="form-label">Kata Sandi Saat Ini *</label>
      <input type="password" id="current_password" name="current_password" class="form-input" placeholder="Masukkan kata sandi saat ini" required autocomplete="current-password">
    </div>

    <div class="form-group">
      <label for="new_password" class="form-label">Kata Sandi Baru *</label>
      <input type="password" id="new_password" name="new_password" class="form-input" placeholder="Minimal 8 karakter" required autocomplete="new-password" minlength="8">
      <div class="form-hint">Gunakan kombinasi huruf besar, huruf kecil, dan angka untuk proteksi optimal.</div>
    </div>

    <div class="form-group">
      <label for="confirm_password" class="form-label">Ulangi Kata Sandi Baru *</label>
      <input type="password" id="confirm_password" name="confirm_password" class="form-input" placeholder="Ketik ulang kata sandi baru" required autocomplete="new-password" minlength="8">
    </div>

    <div class="form-actions" style="margin-top: 1.5rem; display: flex; gap: 0.75rem;">
      <a href="/admin/dashboard" class="adm-btn adm-btn-neutral" aria-label="Batalkan ubah kata sandi">
        <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>Batal</span>
      </a>
      <button type="submit" class="adm-btn adm-btn-primary" aria-label="Simpan kata sandi baru">
        <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Simpan</span>
      </button>
    </div>
  </form>
</div>

<%- include('../partials/admin-footer') %>

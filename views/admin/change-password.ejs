<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Ganti Kata Sandi - PT Euodoo CMS' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body style="background-color: var(--color-workspace-bg); min-height: 100vh; display: flex; flex-direction: column;">
  <!-- Admin Top Bar -->
  <header style="background-color: var(--color-navy-deep); color: #ffffff; padding: var(--space-sm) 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
    <div class="container flex items-center justify-between">
      <div class="flex items-center gap-md">
        <span style="font-weight: 700; letter-spacing: -0.02em;">PT EUODOO CMS</span>
        <span class="badge badge-info" style="font-size: 11px;">Admin Panel</span>
      </div>
      <div class="flex items-center gap-md">
        <span style="font-size: var(--font-size-body-sm); color: #cbd5e1;"><%= user ? user.name : 'Admin' %></span>
        <a href="/admin/logout" style="color: #fca5a5; font-size: var(--font-size-body-sm);">Keluar</a>
      </div>
    </div>
  </header>

  <!-- Admin Sub Navigation -->
  <nav style="background-color: #ffffff; border-bottom: 1px solid var(--color-border); padding: 0;">
    <div class="container flex items-center gap-lg" style="height: 52px; overflow-x: auto;">
      <a href="/admin/dashboard" class="nav-link" style="color: var(--color-text-muted);">Dashboard</a>
      <a href="/admin/banners" class="nav-link" style="color: var(--color-text-muted);">Banners</a>
      <a href="/admin/products" class="nav-link" style="color: var(--color-text-muted);">Produk</a>
      <a href="/admin/posts" class="nav-link" style="color: var(--color-text-muted);">Berita</a>
      <a href="/admin/leads" class="nav-link" style="color: var(--color-text-muted);">Leads Masuk</a>
      <a href="/admin/change-password" class="nav-link active" style="font-weight: 600;">Ganti Kata Sandi</a>
    </div>
  </nav>

  <!-- Admin Main Content -->
  <main class="section-sm" style="flex: 1;">
    <div class="container" style="max-width: 640px;">
      <div style="margin-bottom: var(--space-lg);">
        <h1 style="font-size: 1.5rem; color: var(--color-secondary-navy);">Ganti Kata Sandi Administrator</h1>
        <p style="color: var(--color-text-muted); font-size: var(--font-size-body-sm);">
          Perbarui kata sandi secara berkala untuk menjaga keamanan akses sistem CMS.
        </p>
      </div>

      <div class="card" style="box-shadow: var(--shadow-level-1);">
        <div class="card-body">
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error" role="alert">
              <%= error %>
            </div>
          <% } %>

          <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" role="alert">
              <%= success %>
            </div>
          <% } %>

          <form action="/admin/change-password?_csrf=<%= csrfToken %>" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-group">
              <label for="current_password" class="form-label form-label-required">Kata Sandi Saat Ini</label>
              <input type="password" id="current_password" name="current_password" class="form-control" placeholder="••••••••" required autocomplete="current-password">
            </div>

            <div class="form-group">
              <label for="new_password" class="form-label form-label-required">Kata Sandi Baru</label>
              <input type="password" id="new_password" name="new_password" class="form-control" placeholder="Minimal 8 karakter" required autocomplete="new-password" minlength="8">
              <div class="form-hint">Gunakan kombinasi huruf besar, huruf kecil, dan angka untuk keamanan optimal.</div>
            </div>

            <div class="form-group">
              <label for="confirm_password" class="form-label form-label-required">Ulangi Kata Sandi Baru</label>
              <input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="Ketik ulang kata sandi baru" required autocomplete="new-password" minlength="8">
            </div>

            <div class="flex gap-md" style="margin-top: var(--space-lg);">
              <button type="submit" class="btn btn-primary btn-md">
                Simpan Kata Sandi Baru
              </button>
              <a href="/admin/dashboard" class="btn btn-secondary btn-md">
                Batal
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <footer style="background-color: #ffffff; border-top: 1px solid var(--color-border); padding: var(--space-md) 0; font-size: var(--font-size-body-sm); color: var(--color-text-muted); text-align: center;">
    <div class="container">
      PT Euodoo CMS &copy; <%= currentYear %>
    </div>
  </footer>
</body>
</html>

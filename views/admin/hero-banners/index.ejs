<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Hero Banner Per Halaman Publik</h1>
    <p>Kelola gambar latar belakang, judul headline bilingual, subjudul, dan tingkat kegelapan overlay untuk 4 halaman publik utama.</p>
  </div>
</div>

<%
  const pageConfigs = [
    { key: 'about', label: 'Tentang Kami', route: '/about', defaultImg: '/images/hero-factory-precision.webp', desc: 'Tampil di bagian paling atas halaman Profil & Sejarah Perusahaan' },
    { key: 'products', label: 'Katalog Produk', route: '/products', defaultImg: '/images/hero-factory-precision.webp', desc: 'Tampil di bagian atas katalog produk retail & industri' },
    { key: 'news', label: 'Berita & Artikel', route: '/news', defaultImg: '/images/hero-factory.jpg', desc: 'Tampil di halaman wawasan industri dan blog resmi' },
    { key: 'contact', label: 'Kontak & RFQ', route: '/contact', defaultImg: '/images/hero-factory.jpg', desc: 'Tampil di bagian atas halaman formulir kontak dan alamat pabrik' }
  ];
%>

<div class="adm-hbn-cards-container">
  <% pageConfigs.forEach(function(cfg, index) { 
       const banner = (banners || []).find(b => b.page_key === cfg.key) || {
         page_key: cfg.key,
         title_id: '',
         title_en: '',
         subtitle_id: '',
         subtitle_en: '',
         image_url: cfg.defaultImg,
         overlay_opacity: 0.60,
         cta_text_id: '',
         cta_text_en: '',
         cta_url: '',
         is_active: 1
       };
  %>
    <div class="form-card" id="card-<%= cfg.key %>">
      <div class="adm-hbn-card-header">
        <div>
          <div class="adm-hbn-title-group">
            <span class="adm-hbn-page-title"><%= index + 1 %>. Halaman <%= cfg.label %></span>
            <span class="adm-hbn-route-badge"><%= cfg.route %></span>
          </div>
          <div class="adm-hbn-page-desc"><%= cfg.desc %></div>
        </div>
        <div>
          <a href="<%= cfg.route %>" target="_blank" class="adm-btn adm-btn-secondary adm-btn-sm" aria-label="Lihat halaman <%= cfg.label %> di publik">
            <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            <span>Pratinjau</span>
          </a>
        </div>
      </div>

      <form action="/admin/hero-banners/<%= cfg.key %>?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="adm-hbn-preview-mockup">
          <img src="<%= banner.image_url || cfg.defaultImg %>" alt="Hero Preview <%= cfg.label %>" class="adm-hbn-mockup-img">
          <div class="adm-hbn-mockup-overlay">
            <div class="adm-hbn-mockup-tag">PRATINJAU TAMPILAN HERO</div>
            <div class="adm-hbn-mockup-title"><%= banner.title_id || cfg.label %></div>
            <div class="adm-hbn-mockup-subtitle"><%= banner.subtitle_id || 'Deskripsi pengantar hero banner...' %></div>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">Gambar Latar Hero (Media Library)</label>
            <div class="media-picker-component">
              <input type="hidden" id="hero_image_<%= cfg.key %>" name="image_url" value="<%= banner.image_url || cfg.defaultImg %>">
              <div class="media-picker-preview-box">
                <img src="<%= banner.image_url || cfg.defaultImg %>" alt="Hero Preview" class="<%= (banner.image_url || cfg.defaultImg) ? '' : 'hidden' %>">
                <div class="media-picker-empty <%= (banner.image_url || cfg.defaultImg) ? 'hidden' : '' %>">
                  <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                  <span>Belum ada gambar hero dipilih</span>
                </div>
              </div>
              <div class="media-picker-ctrls">
                <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="hero_image_<%= cfg.key %>" data-picker-type="image" aria-label="Pilih foto banner hero dari Media Library">
                  <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                  <span>Pilih Media</span>
                </button>
                <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media <%= banner.image_url ? '' : 'hidden' %>" aria-label="Hapus foto banner hero">
                  <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  <span>Hapus</span>
                </button>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="overlay_opacity_<%= cfg.key %>">Tingkat Kegelapan Overlay (0.00 - 1.00)</label>
            <select id="overlay_opacity_<%= cfg.key %>" name="overlay_opacity" class="form-select" data-eu-dropdown="outlined">
              <option value="0.40" <%= String(banner.overlay_opacity) === '0.40' ? 'selected' : '' %>>40% (Terang)</option>
              <option value="0.50" <%= String(banner.overlay_opacity) === '0.50' ? 'selected' : '' %>>50% (Sedang-Terang)</option>
              <option value="0.60" <%= String(banner.overlay_opacity) === '0.60' || !banner.overlay_opacity ? 'selected' : '' %>>60% (Standar / Rekomendasi)</option>
              <option value="0.70" <%= String(banner.overlay_opacity) === '0.70' ? 'selected' : '' %>>70% (Kontras Tinggi)</option>
              <option value="0.80" <%= String(banner.overlay_opacity) === '0.80' ? 'selected' : '' %>>80% (Gelap Pekat)</option>
            </select>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label" for="title_id_<%= cfg.key %>">Judul Headline (Bahasa Indonesia) *</label>
            <input type="text" id="title_id_<%= cfg.key %>" name="title_id" class="form-input" required value="<%= banner.title_id %>">
          </div>
          <div class="form-group">
            <label class="form-label" for="title_en_<%= cfg.key %>">Judul Headline (English)</label>
            <input type="text" id="title_en_<%= cfg.key %>" name="title_en" class="form-input" value="<%= banner.title_en %>">
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label" for="subtitle_id_<%= cfg.key %>">Subjudul / Deskripsi (Bahasa Indonesia)</label>
            <textarea id="subtitle_id_<%= cfg.key %>" name="subtitle_id" class="form-textarea" rows="2"><%= banner.subtitle_id %></textarea>
          </div>
          <div class="form-group">
            <label class="form-label" for="subtitle_en_<%= cfg.key %>">Subjudul / Deskripsi (English)</label>
            <textarea id="subtitle_en_<%= cfg.key %>" name="subtitle_en" class="form-textarea" rows="2"><%= banner.subtitle_en %></textarea>
          </div>
        </div>

        <div class="form-row-3 adm-hbn-form-row-3">
          <div class="form-group">
            <label class="form-label" for="cta_text_id_<%= cfg.key %>">Teks Tombol CTA (ID - Opsional)</label>
            <input type="text" id="cta_text_id_<%= cfg.key %>" name="cta_text_id" class="form-input" placeholder="Misal: Hubungi Kami" value="<%= banner.cta_text_id || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label" for="cta_text_en_<%= cfg.key %>">Teks Tombol CTA (EN - Opsional)</label>
            <input type="text" id="cta_text_en_<%= cfg.key %>" name="cta_text_en" class="form-input" placeholder="e.g.: Contact Us" value="<%= banner.cta_text_en || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label" for="cta_url_<%= cfg.key %>">URL Target Tombol CTA</label>
            <input type="text" id="cta_url_<%= cfg.key %>" name="cta_url" class="form-input" placeholder="/contact atau https://..." value="<%= banner.cta_url || '' %>">
          </div>
        </div>

        <div class="adm-hbn-card-footer">
          <div class="adm-hbn-active-toggle">
            <input type="checkbox" id="is_active_<%= cfg.key %>" name="is_active" value="1" <%= banner.is_active ? 'checked' : '' %>>
            <label for="is_active_<%= cfg.key %>" class="adm-hbn-active-label">Aktifkan Hero Banner pada Halaman</label>
          </div>
          <button type="submit" class="adm-btn adm-btn-primary" aria-label="Simpan banner <%= cfg.label %>">
            <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Simpan</span>
          </button>
        </div>
      </form>
    </div>
  <% }); %>
</div>

<%- include('../../partials/admin-footer') %>

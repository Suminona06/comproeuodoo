<%- include('../../partials/admin-header') %>

<div class="content-header">
  <div class="content-title-text">
    <h1>Kapabilitas Fasilitas &amp; Mesin Pabrik</h1>
    <p>Kelola informasi lini mesin produksi (tonase, kapasitas bulanan, dan dokumentasi fasilitas).</p>
  </div>
</div>

<div class="grid adm-cap-grid">
  <div class="form-card">
    <div class="form-card-title">Tambah Mesin / Fasilitas Baru</div>

    <form action="/admin/capabilities?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-row-2">
        <div class="form-group">
          <label for="title_id" class="form-label">Nama Fasilitas (Indonesia) *</label>
          <input type="text" id="title_id" name="title_id" class="form-input" placeholder="Lini Mesin Servo Injection 850T" required>
        </div>
        <div class="form-group">
          <label for="title_en" class="form-label">Nama Fasilitas (English)</label>
          <input type="text" id="title_en" name="title_en" class="form-input" placeholder="850T Servo Injection Machine Line">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="machine_type" class="form-label">Tipe Mesin &amp; Tonase *</label>
          <input type="text" id="machine_type" name="machine_type" class="form-input" placeholder="Injection Molding 850 Ton" required>
        </div>
        <div class="form-group">
          <label for="capacity" class="form-label">Estimasi Kapasitas Produksi</label>
          <input type="text" id="capacity" name="capacity" class="form-input" placeholder="Contoh: 500.000 unit / bulan">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="description_id" class="form-label">Deskripsi Fasilitas (Indonesia)</label>
          <textarea id="description_id" name="description_id" class="form-textarea" placeholder="Pencetakan komponen plastik dimensi besar dengan akurasi mikro..."></textarea>
        </div>
        <div class="form-group">
          <label for="description_en" class="form-label">Deskripsi Fasilitas (English)</label>
          <textarea id="description_en" name="description_en" class="form-textarea" placeholder="Large-dimension plastic component molding with micro precision..."></textarea>
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="sort_order" class="form-label">Urutan Tampil</label>
          <input type="number" id="sort_order" name="sort_order" class="form-input" value="0">
        </div>
        <div class="form-group">
          <label class="form-label">Status Tayang</label>
          <div class="adm-cap-status-wrapper">
            <label class="adm-cap-checkbox-label">
              <input type="checkbox" name="is_active" value="1" checked class="adm-cap-checkbox">
              <span>Aktif Tampil di Web</span>
            </label>
          </div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Foto Mesin / Fasilitas (Media Library)</label>
        <div class="media-picker-component">
          <input type="hidden" id="capability_image_url" name="image_url" value="">
          <div class="media-picker-preview-box adm-cap-preview-box">
            <img src="" alt="Pratinjau Fasilitas" class="hidden">
            <div class="media-picker-empty">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <span>Belum ada foto fasilitas dipilih</span>
            </div>
          </div>
          <div class="media-picker-ctrls">
            <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm btn-open-media-picker" data-target="capability_image_url" data-picker-type="image" aria-label="Pilih foto fasilitas dari Media Library">
              <svg class="adm-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <span>Pilih Media</span>
            </button>
            <button type="button" class="adm-btn adm-btn-danger adm-btn-sm btn-clear-media hidden" aria-label="Hapus foto fasilitas">
              <svg class="adm-btn-icon adm-btn-icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus</span>
            </button>
          </div>
        </div>
      </div>

      <button type="submit" class="adm-btn adm-btn-primary" aria-label="Simpan kapabilitas mesin">
        <svg class="adm-btn-icon adm-btn-icon-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Simpan</span>
      </button>
    </form>
  </div>

  <div class="table-card">
    <div class="table-toolbar">
      <h2 class="toolbar-title">Daftar Fasilitas Mesin</h2>
      <span class="badge badge-info"><%= capabilities.length %> Unit</span>
    </div>
    <div class="table-scroll-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fasilitas / Mesin</th>
            <th>Tipe Mesin</th>
            <th>Kapasitas</th>
            <th class="adm-cap-th-order">Urutan</th>
            <th class="adm-cap-th-status">Status</th>
            <th class="adm-cap-th-actions">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (capabilities && capabilities.length > 0) { %>
            <% capabilities.forEach(function(cap) { %>
              <tr>
                <td>
                  <strong><%= cap.title_id %></strong>
                  <% if (cap.title_en) { %>
                    <div class="adm-cap-subtitle"><%= cap.title_en %></div>
                  <% } %>
                </td>
                <td><span class="badge badge-primary"><%= cap.machine_type %></span></td>
                <td><%= cap.capacity || '-' %></td>
                <td class="adm-cap-td-order"><%= cap.sort_order %></td>
                <td>
                  <% if (cap.is_active) { %>
                    <span class="badge badge-success">Aktif</span>
                  <% } else { %>
                    <span class="badge badge-neutral">Nonaktif</span>
                  <% } %>
                </td>
                <td class="adm-cap-td-actions">
                  <div class="table-actions adm-cap-table-actions">
                    <form action="/admin/capabilities/<%= cap.id %>/delete?_csrf=<%= csrfToken %>" method="POST" data-confirm-delete="true" data-confirm-message="Hapus data kapabilitas mesin ini?" data-confirm-title="Hapus Kapabilitas Mesin" class="adm-cap-delete-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn-action btn-action-delete" title="Hapus Mesin">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        <span>Hapus</span>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="adm-cap-empty-cell">
                Belum ada data mesin yang ditambahkan.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../../partials/admin-footer') %>

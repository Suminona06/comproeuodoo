<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : '403 Akses Ditolak - PT Euodoo CMS' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin.css">

  <% 
    const fav32 = (typeof settings !== 'undefined' && settings && settings.site_favicon_32) ? settings.site_favicon_32 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-32x32.png');
    const fav16 = (typeof settings !== 'undefined' && settings && settings.site_favicon_16) ? settings.site_favicon_16 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-16x16.png');
    const fav180 = (typeof settings !== 'undefined' && settings && settings.site_favicon_180) ? settings.site_favicon_180 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-180x180.png');
    const fav192 = (typeof settings !== 'undefined' && settings && settings.site_favicon_192) ? settings.site_favicon_192 : ((typeof settings !== 'undefined' && settings && settings.site_favicon) ? settings.site_favicon : '/uploads/settings/favicon-192x192.png');
  %>
  <link rel="icon" type="image/png" sizes="32x32" href="<%= fav32 %>?v=3">
  <link rel="icon" type="image/png" sizes="16x16" href="<%= fav16 %>?v=3">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= fav180 %>?v=3">
  <link rel="icon" type="image/png" sizes="192x192" href="<%= fav192 %>?v=3">
</head>
<body class="err403-body">
  <header class="err403-header">
    <div class="container flex items-center justify-between">
      <div class="flex items-center gap-md">
        <span class="err403-brand-title">PT EUODOO CMS</span>
        <span class="badge badge-info err403-badge">Admin Panel</span>
      </div>
      <div class="flex items-center gap-md">
        <span class="err403-user-meta"><%= user ? (user.name || user.email) : 'User' %> (<%= user ? user.role : 'Guest' %>)</span>
        <a href="/admin/logout" class="err403-logout-link">Keluar</a>
      </div>
    </div>
  </header>

  <main class="err403-main">
    <div class="err403-card">
      <div class="err403-icon">
        !
      </div>
      <h1 class="err403-title">403 - Akses Ditolak</h1>
      <p class="err403-desc">
        <%= typeof message !== 'undefined' ? message : 'Role akun Anda tidak memiliki hak akses untuk membuka halaman ini.' %>
      </p>
      <div class="err403-actions">
        <a href="/admin/dashboard" class="adm-btn adm-btn-neutral" aria-label="Kembali ke Dashboard">
          <svg class="adm-btn-icon adm-btn-icon-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
          <span>Kembali</span>
        </a>
      </div>
    </div>
  </main>
</body>
</html>

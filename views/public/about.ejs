<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<% const lang = typeof currentLang !== 'undefined' ? currentLang : 'id'; %>
<% const data = typeof about !== 'undefined' && about ? about : {}; %>
<% 
  const heroObj = typeof heroBanner !== 'undefined' && heroBanner && heroBanner.is_active ? heroBanner : null;
  const heroBg = heroObj && heroObj.image_url ? `style="background: linear-gradient(rgba(10, 25, 47, ${heroObj.overlay_opacity || 0.65}), rgba(10, 25, 47, ${heroObj.overlay_opacity || 0.65})), url('${heroObj.image_url}') center/cover no-repeat;"` : '';
%>

<main id="main-content">
  <!-- 1. PAGE HERO -->
  <section class="page-hero" <%- heroBg %>>
    <div class="container">
      <div class="breadcrumbs">
        <a href="/"><%= lang === 'en' ? 'Home' : 'Beranda' %></a>
        <span>&rsaquo;</span>
        <span class="current"><%= lang === 'en' ? 'About Us' : 'Tentang Kami' %></span>
      </div>

      <div style="max-width: 840px;">
        <span class="page-hero-kicker">
          <%= lang === 'en' ? 'ABOUT PT. EUODOO' : 'TENTANG PT. EUODOO' %>
        </span>
        <h1 class="page-hero-title">
          <%= (typeof heroBanner !== 'undefined' && heroBanner && heroBanner.is_active && (lang === 'en' ? heroBanner.title_en : heroBanner.title_id))
              ? (lang === 'en' ? heroBanner.title_en : heroBanner.title_id)
              : (lang === 'en' ? (data.slogan_en || 'Passion to Build a Better Quality of Life') : (data.slogan_id || 'Semangat Membangun Kualitas Hidup yang Lebih Baik')) %>
        </h1>
        <p class="page-hero-desc">
          <%= (typeof heroBanner !== 'undefined' && heroBanner && heroBanner.is_active && (lang === 'en' ? heroBanner.subtitle_en : heroBanner.subtitle_id))
              ? (lang === 'en' ? heroBanner.subtitle_en : heroBanner.subtitle_id)
              : (lang === 'en'
                  ? 'Pioneering high-grade HDPE and LLDPE plastic film manufacturing in Bandung since 1990, dedicated to certified 100% degradable environmental solutions for modern retail and industrial sectors.'
                  : 'Perusahaan manufaktur dan perdagangan kantong plastik HDPE dan LLDPE terkemuka di Bandung sejak tahun 1990, berdedikasi pada penyediaan solusi kemasan ramah lingkungan yang 100% degradable.') %>
        </p>
      </div>
    </div>
  </section>

  <!-- 2. SEJARAH & LATAR BELAKANG PERUSAHAAN -->
  <section class="sec-story" id="sejarah" data-od-id="company-story">
    <div class="container">
      <div class="story-layout">
        <div class="story-sticky reveal">
          <span class="story-kicker"><%= (lang === 'en' ? storyHeader?.kicker_en : storyHeader?.kicker_id) || (lang === 'en' ? 'Our Story' : 'Kisah Kami') %></span>
          <h2><%= lang === 'en' ? (data.history_title_en || 'Building Quality of Life for a Better Tomorrow') : (data.history_title_id || 'Semangat Membangun Kualitas Hidup yang Lebih Baik') %></h2>
          <p><%= lang === 'en' ? (data.history_en || 'Starting by serving traditional markets, we grew into a manufacturing partner for modern retail networks and the national industrial sector.') : (data.history_id || 'Berawal dari melayani pasar tradisional, kami tumbuh menjadi mitra manufaktur bagi jaringan retail modern dan sektor industri nasional. Perjalanan kami ditopang satu keyakinan: mutu yang konsisten dan komitmen pada kelestarian lingkungan adalah fondasi kemitraan jangka panjang.') %></p>
          
          <% if (typeof stats !== 'undefined' && stats && stats.length > 0) { %>
            <div class="story-stats">
              <% stats.forEach(stat => { %>
                <div class="story-stat">
                  <div class="story-stat-num"><%= stat.stat_value %></div>
                  <div class="story-stat-label"><%= lang === 'en' ? (stat.label_en || stat.label_id) : stat.label_id %></div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="timeline reveal" data-od-id="company-timeline">
          <% if (typeof timeline !== 'undefined' && timeline && timeline.length > 0) { %>
            <% timeline.forEach(item => { %>
              <div class="tl-item">
                <div class="tl-year"><%= lang === 'en' ? (item.year_label_en || item.year_label_id) : item.year_label_id %></div>
                <div class="tl-title"><%= lang === 'en' ? (item.title_en || item.title_id) : item.title_id %></div>
                <div class="tl-desc"><%= lang === 'en' ? (item.description_en || item.description_id) : item.description_id %></div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="tl-empty" style="padding: 24px; color: var(--text-muted); font-size: 14px; font-style: italic;">
              <%= lang === 'en' ? 'Company journey timeline will be updated soon.' : 'Linimasa perjalanan perusahaan akan segera diperbarui.' %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. VISI & MISI PERUSAHAAN -->
  <%
    const visionImg = (typeof visionMissionImages !== 'undefined' && visionMissionImages?.vision_image_url) ? visionMissionImages.vision_image_url.trim() : '';
    const missionImg = (typeof visionMissionImages !== 'undefined' && visionMissionImages?.mission_image_url) ? visionMissionImages.mission_image_url.trim() : '';
    const rawMission = lang === 'en' ? (data.mission_en || '') : (data.mission_id || '');
    const missionPoints = rawMission.split('\n').map(p => p.trim()).filter(p => p.length > 0);
  %>
  <section class="sec-vm" id="visi-misi" data-od-id="vision-mission">
    <div class="container">
      <div class="vm-header reveal">
        <span class="vm-kicker"><%= lang === 'en' ? 'OUR GUIDING PURPOSE' : 'ARAHAN STRATEGIS' %></span>
        <h2><%= lang === 'en' ? 'Vision & Mission' : 'Visi & Misi Perusahaan' %></h2>
        <p>
          <%= lang === 'en'
            ? 'Core commitments driving our manufacturing quality, workforce welfare, and sustainable environmental preservation.'
            : 'Pondasi utama yang mengarahkan kualitas manufaktur, kesejahteraan insan perusahaan, dan kelestarian lingkungan hidup.' %>
        </p>
      </div>

      <div class="vm-rows">
        <!-- Visi Row: Card Teks Kiri + Gambar Kanan (Jika Ada) -->
        <div class="vm-row reveal <%= visionImg ? 'has-image' : 'no-image' %>">
          <div class="vm-card">
            <span class="vm-card-kicker"><%= lang === 'en' ? 'CORPORATE VISION' : 'VISI' %></span>
            <h3 class="vm-card-title"><%= lang === 'en' ? data.vision_en : data.vision_id %></h3>
            <p class="vm-card-desc">
              <%= lang === 'en'
                ? 'We continuously aim to improve the quality of life within and outside the company, ensuring environmental preservation alongside commercial excellence.'
                : 'Kami berupaya terus-menerus meningkatkan kualitas kehidupan di dalam dan luar perusahaan, mengutamakan kelestarian alam dan pendidikan karyawan.' %>
            </p>
          </div>
          <% if (visionImg) { %>
            <div class="vm-media">
              <img src="<%= visionImg %>" alt="<%= lang === 'en' ? 'PT Euodoo Corporate Vision' : 'Visi PT Euodoo' %>" loading="lazy">
            </div>
          <% } %>
        </div>

        <!-- Misi Row: Gambar Kiri (Jika Ada) + Card Teks Kanan -->
        <div class="vm-row reveal <%= missionImg ? 'has-image' : 'no-image' %>">
          <% if (missionImg) { %>
            <div class="vm-media">
              <img src="<%= missionImg %>" alt="<%= lang === 'en' ? 'PT Euodoo Corporate Mission' : 'Misi PT Euodoo' %>" loading="lazy">
            </div>
          <% } %>
          <div class="vm-card">
            <span class="vm-card-kicker"><%= lang === 'en' ? 'STRATEGIC MISSION' : 'MISI' %></span>
            <% if (missionPoints.length > 1) { %>
              <ul class="vm-list">
                <% missionPoints.forEach(function(point, idx) { %>
                  <% 
                    const cleanPoint = point.replace(/^\d+[\.\)]\s*/, '');
                  %>
                  <li>
                    <span class="vm-list-badge"><%= idx + 1 %></span>
                    <span style="font-size: 15px; color: var(--text-main, #0f172a); font-weight: 500; line-height: 1.6;">
                      <%= cleanPoint %>
                    </span>
                  </li>
                <% }); %>
              </ul>
            <% } else { %>
              <h3 class="vm-card-title"><%= rawMission %></h3>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. NILAI-NILAI INTI BUDAYA KERJA T-I-C-K-E-T -->
  <section class="sec-values" id="core-values">
    <div class="container">
      <div class="pillars-header reveal">
        <span class="brands-kicker"><%= lang === 'en' ? 'CORE VALUES' : 'NILAI INTI BUDAYA' %></span>
        <h2>Budaya Kerja T - I - C - K - E - T</h2>
        <p>
          <%= lang === 'en'
            ? 'The six foundational pillars guiding moral integrity, human potential, and manufacturing dedication.'
            : 'Enam pilar utama yang membina karakter positif, potensi insan, dan profesionalisme di setiap lini kerja.' %>
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        <% (data.values || []).forEach(function(val) { %>
          <div class="pillar-card reveal" style="padding: 24px;">
            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 12px;">
              <div style="width: 44px; height: 44px; border-radius: var(--r-lg, 8px); background: #eff6ff; border: 1px solid #bfdbfe; color: var(--primary, #0055b8); display: flex; align-items: center; justify-content: center; font-size: 1.35rem; font-weight: 800;">
                <%= val.letter %>
              </div>
              <h3 style="font-size: 1.15rem; color: var(--navy, #0a192f); margin: 0; font-weight: 700;">
                <%= lang === 'en' ? val.title_en : val.title_id %>
              </h3>
            </div>
            <p style="font-size: 13.5px; color: var(--text-variant, #424753); line-height: 1.6; margin: 0;">
              <%= lang === 'en' ? val.desc_en : val.desc_id %>
            </p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- 5. GALERI FASILITAS & OPERASIONAL (Bento Mosaic Grid) -->
  <% if (typeof gallerySlides !== 'undefined' && gallerySlides && gallerySlides.length > 0) { %>
    <section class="sec-gallery" id="galeri" data-od-id="gallery">
      <div class="container">
        <div class="gal-header reveal">
          <div class="gal-header-text">
            <span class="gal-kicker"><%= (lang === 'en' ? galleryHeader?.kicker_en : galleryHeader?.kicker_id) || (lang === 'en' ? 'OUR GALLERY' : 'GALERI KAMI') %></span>
            <h2><%= (lang === 'en' ? galleryHeader?.title_en : galleryHeader?.title_id) || (lang === 'en' ? 'Inside Our Operations' : 'Di Dalam Operasional Kami') %></h2>
            <p><%= (lang === 'en' ? galleryHeader?.body_en : galleryHeader?.body_id) || (lang === 'en' ? 'A glimpse of our production activity, modern extrusion lines, and industrial capabilities.' : 'Sepintas aktivitas produksi, lini ekstrusi film mutakhir, pengujian laboratorium, dan standar kebersihan manufaktur PT EUODOO.') %></p>
          </div>
        </div>

        <% 
          const totalSlides = gallerySlides.length;
          const initialPageCount = Math.ceil(totalSlides / 6);
          const initialSlice = gallerySlides.slice(0, Math.min(6, totalSlides));
          let gridModifier = '';
          if (initialSlice.length === 5) gridModifier = 'abt-gal-grid--5 bento-grid--5';
          else if (initialSlice.length === 4) gridModifier = 'abt-gal-grid--4 bento-grid--4';
          else if (initialSlice.length === 3) gridModifier = 'abt-gal-grid--3 bento-grid--3';
          else if (initialSlice.length === 2) gridModifier = 'abt-gal-grid--2 bento-grid--2';
          else if (initialSlice.length === 1) gridModifier = 'abt-gal-grid--1 bento-grid--1';
        %>

        <div class="abt-gal-container bento-gallery" id="bentoGallery">
          <div class="abt-gal-viewport" id="abtGalViewport">
            <div class="abt-gal-grid bento-grid <%= gridModifier %>" id="bentoGrid">
              <% initialSlice.forEach((slide, idx) => { 
                   let posClass = 'abt-gal-tile--pos-' + (idx + 1) + ' bento-tile--pos-' + (idx + 1);
                   if (initialSlice.length === 6) {
                     if (idx === 0) posClass = 'abt-gal-tile--pos-1 abt-gal-tile--tall bento-tile--pos-1 bento-tile--tall';
                     else if (idx === 1 || idx === 4) posClass = 'abt-gal-tile--pos-' + (idx + 1) + ' abt-gal-tile--wide bento-tile--pos-' + (idx + 1) + ' bento-tile--wide';
                   }
                   const tag = (lang === 'en' ? (slide.category_en || slide.category_id) : slide.category_id) || '';
                   const titleText = (lang === 'en' ? (slide.title_en || slide.title_id) : slide.title_id) || '';
                   const cleanTag = tag.trim();
                   const cleanTitle = titleText.trim();
                   const photoNum = String(idx + 1).padStart(2, '0');
                   const fallbackLabel = lang === 'en' 
                     ? ('PT Euodoo Manufacturing & Operations Facility (Photo ' + photoNum + ')')
                     : ('Fasilitas Manufaktur & Operasional PT Euodoo (Foto ' + photoNum + ')');
                   const altText = cleanTitle || cleanTag || fallbackLabel;
                   const hasCaption = Boolean(cleanTag || cleanTitle);
              %>
                <div class="bento-tile abt-gal-tile <%= posClass %>" tabindex="0" style="--tile-i: <%= idx %>;" aria-label="<%= altText %>">
                  <img 
                    src="<%= slide.image_url %>" 
                    alt="<%= altText %>"
                    decoding="async"
                    <%- idx > 0 ? 'loading="lazy"' : '' %>>
                  <% if (hasCaption) { %>
                    <div class="abt-gal-cap bento-cap">
                      <% if (cleanTag) { %>
                        <span class="abt-gal-cat bento-cat"><%= cleanTag %></span>
                      <% } %>
                      <% if (cleanTitle) { %>
                        <div class="abt-gal-title bento-title"><%= cleanTitle %></div>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              <% }); %>
            </div>
          </div>

          <div class="abt-gal-pager bento-pager" id="bentoPager" <%- totalSlides <= 1 ? 'style="display: none;"' : '' %>>
            <span class="abt-gal-pager-count bento-pager-count" aria-live="polite" aria-atomic="true"><strong id="bentoCur">01</strong> / <span id="bentoTotal"><%= String(initialPageCount).padStart(2, '0') %></span></span>
            <div class="abt-gal-pager-arrows bento-pager-arrows">
              <button type="button" class="abt-gal-pager-btn bento-pager-btn" id="bentoPrev" aria-label="<%= lang === 'en' ? 'Previous gallery page' : 'Halaman galeri sebelumnya' %>" disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>
              </button>
              <button type="button" class="abt-gal-pager-btn bento-pager-btn" id="bentoNext" aria-label="<%= lang === 'en' ? 'Next gallery page' : 'Halaman galeri berikutnya' %>" <%- initialPageCount <= 1 ? 'disabled' : '' %>>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
              </button>
            </div>
          </div>
        </div>

        <script type="application/json" id="bentoGalleryData">
          <%- JSON.stringify(gallerySlides.map(s => ({
            image_url: s.image_url,
            category: lang === 'en' ? (s.category_en || s.category_id || '') : (s.category_id || ''),
            title: lang === 'en' ? (s.title_en || s.title_id || '') : (s.title_id || '')
          }))) %>
        </script>
      </div>
    </section>
  <% } %>

</main>

<%- include('../partials/footer') %>

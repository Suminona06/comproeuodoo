<%- include('../partials/header', { pageStyle: 'about' }) %>
<%- include('../partials/navbar') %>

<%
  const lang = typeof currentLang !== 'undefined' ? currentLang : 'id';
  const data = typeof about !== 'undefined' && about ? about : {};
  const heroObj = typeof heroBanner !== 'undefined' && heroBanner && heroBanner.is_active ? heroBanner : null;
  const userOpacity = heroObj && heroObj.overlay_opacity ? parseFloat(heroObj.overlay_opacity) : 0.35;
  let scrimLevel = 'standard';
  if (userOpacity <= 0.35) scrimLevel = 'soft';
  else if (userOpacity <= 0.45) scrimLevel = 'light';
  else if (userOpacity <= 0.55) scrimLevel = 'medium';
  const hasHeroBg = Boolean(heroObj && heroObj.image_url);
  const heroTitle = (heroObj && (lang === 'en' ? heroObj.title_en : heroObj.title_id))
    || (lang === 'en' ? data.slogan_en : data.slogan_id)
    || t('about.hero_default_title');
  const heroDesc = (heroObj && (lang === 'en' ? heroObj.subtitle_en : heroObj.subtitle_id))
    || t('about.hero_default_desc');
  const hasGallery = typeof gallerySlides !== 'undefined' && Array.isArray(gallerySlides) && gallerySlides.length > 0;
%>

<main id="main-content">
  <section class="page-hero <%= hasHeroBg ? 'page-hero--has-bg' : '' %>">
    <% if (hasHeroBg) { %>
      <img src="<%= heroObj.image_url %>" alt="" class="page-hero-bg-img" fetchpriority="high" decoding="async">
      <div class="page-hero-scrim" data-scrim-level="<%= scrimLevel %>" aria-hidden="true"></div>
    <% } %>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/"><%= t('nav.home') %></a>
        <span class="separator" aria-hidden="true">&rsaquo;</span>
        <span class="current"><%= t('nav.about') %></span>
      </nav>

      <div class="page-hero-content abt-hero-content">
        <h1 class="page-hero-title"><%= heroTitle %></h1>
        <p class="page-hero-desc"><%= heroDesc %></p>
      </div>
    </div>
  </section>

  <section class="sec-story" id="sejarah" data-od-id="company-story">
    <div class="container">
      <%- include('../partials/about/story-counter') %>
      <%- include('../partials/about/history-timeline') %>
    </div>
  </section>

  <%- include('../partials/about/vision-mission', { lang, data }) %>
  <%- include('../partials/about/ticket-accordion') %>

  <% if (hasGallery) { %>
    <%- include('../partials/about/gallery-bento', { lang, gallerySlides }) %>
  <% } %>
</main>

<script src="/js/ticket-accordion.js?v=20261106-2" defer></script>
<script src="/js/about-story.js" defer></script>
<%- include('../partials/footer') %>

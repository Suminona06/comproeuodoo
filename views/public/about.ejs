<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<% const lang = typeof currentLang !== 'undefined' ? currentLang : 'id'; %>
<% const data = typeof about !== 'undefined' && about ? about : {}; %>

<main id="main-content">
  <!-- 1. PAGE HERO -->
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/"><%= lang === 'en' ? 'Home' : 'Beranda' %></a>
        <span>&rsaquo;</span>
        <span style="color: var(--sky, #38bdf8);"><%= lang === 'en' ? 'About Us' : 'Tentang Kami' %></span>
      </div>

      <div style="max-width: 840px;">
        <span class="brands-kicker" style="color: var(--sky, #38bdf8); margin-bottom: 8px;">
          <%= lang === 'en' ? 'ABOUT PT. EUODOO' : 'TENTANG PT. EUODOO' %>
        </span>
        <h1 class="page-hero-title">
          <%= lang === 'en' ? (data.slogan_en || 'Passion to Build a Better Quality of Life') : (data.slogan_id || 'Semangat Membangun Kualitas Hidup yang Lebih Baik') %>
        </h1>
        <p class="page-hero-desc">
          <%= lang === 'en'
            ? 'Pioneering high-grade HDPE and LLDPE plastic film manufacturing in Bandung since 1990, dedicated to certified 100% degradable environmental solutions for modern retail and industrial sectors.'
            : 'Perusahaan manufaktur dan perdagangan kantong plastik HDPE dan LLDPE terkemuka di Bandung sejak tahun 1990, berdedikasi pada penyediaan solusi kemasan ramah lingkungan yang 100% degradable.' %>
        </p>
      </div>
    </div>
  </section>

  <!-- 2. SEJARAH & LATAR BELAKANG PERUSAHAAN -->
  <section class="sec-intro" id="history">
    <div class="container">
      <div class="intro-layout reveal">
        <div>
          <span class="brands-kicker"><%= lang === 'en' ? 'OUR HERITAGE & ORIGINS' : 'JEJAK LANGKAH SEJAK 1990' %></span>
          <h2>
            <%= lang === 'en' ? (data.history_title_en || 'Company Background & History') : (data.history_title_id || 'Latar Belakang & Sejarah Perusahaan') %>
          </h2>
          <div style="margin-top: 24px; padding: 20px 24px; background: var(--workspace, #f8fafc); border-left: 4px solid var(--primary, #0055b8); border-radius: var(--r-md, 6px);">
            <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted, #64748b); font-weight: 700;">
              <%= lang === 'en' ? 'ESTABLISHED' : 'TAHUN PENDIRIAN & ENTITAS AWAL' %>
            </div>
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--navy, #0a192f); margin-top: 4px;">
              <%= data.founded_year || '1990' %>
              <span style="font-size: 14px; font-weight: 500; color: var(--text-variant, #424753);">
                (<%= data.former_names || 'PT. Sahabat Baru & PT. Pelita Baru' %>)
              </span>
            </div>
          </div>
        </div>

        <div>
          <p style="font-size: 16px; color: var(--text-variant, #424753); line-height: 1.8; margin-bottom: 20px;">
            <%= lang === 'en' ? data.history_en : data.history_id %>
          </p>

          <div style="background: linear-gradient(145deg, #0a192f 0%, #0d2040 100%); color: #ffffff; padding: 28px; border-radius: var(--r-xl, 12px); box-shadow: var(--shadow-2);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
              <span style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--r-md, 6px); background: rgba(56, 189, 248, 0.2); color: var(--sky, #38bdf8);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </span>
              <h3 style="color: #ffffff; font-size: 1.15rem; font-weight: 700; margin: 0;">
                LET'S SAVE OUR EARTH!
              </h3>
            </div>
            <p style="color: #cbd5e1; font-size: 14px; line-height: 1.65; margin-bottom: 16px;">
              <%= lang === 'en' ? data.eco_statement_en : data.eco_statement_id %>
            </p>
            <div style="padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.12); font-size: 13px; color: var(--sky, #38bdf8); font-style: italic;">
              "<%= lang === 'en' ? data.goal_en : data.goal_id %>"
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. VISI & MISI PERUSAHAAN -->
  <section class="sec-pillars" id="vision-mission">
    <div class="container">
      <div class="pillars-header reveal">
        <span class="brands-kicker"><%= lang === 'en' ? 'STRATEGIC DIRECTION' : 'ARAHAN STRATEGIS' %></span>
        <h2><%= lang === 'en' ? 'Our Guiding Principles & Purpose' : 'Visi & Misi Perusahaan' %></h2>
        <p>
          <%= lang === 'en'
            ? 'Core commitments driving our manufacturing quality, workforce welfare, and sustainable environmental preservation.'
            : 'Pondasi utama yang mengarahkan kualitas manufaktur, kesejahteraan insan perusahaan, dan kelestarian lingkungan hidup.' %>
        </p>
      </div>

      <div class="grid grid-cols-2" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        <!-- Visi Card -->
        <div class="pillar-card reveal" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="color: var(--primary, #0055b8); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 12px;">
              <%= lang === 'en' ? 'CORPORATE VISION' : 'VISI PERUSAHAAN' %>
            </div>
            <h3 style="font-size: 1.35rem; color: var(--navy, #0a192f); margin-bottom: 16px; line-height: 1.35; font-weight: 700;">
              <%= lang === 'en' ? data.vision_en : data.vision_id %>
            </h3>
            <p style="font-size: 14.5px; color: var(--text-variant, #424753); line-height: 1.7; margin: 0;">
              <%= lang === 'en'
                ? 'We continuously aim to improve the quality of life within and outside the company, ensuring environmental preservation alongside commercial excellence.'
                : 'Kami berupaya terus-menerus meningkatkan kualitas kehidupan di dalam dan luar perusahaan, mengutamakan kelestarian alam dan pendidikan karyawan.' %>
            </p>
          </div>
        </div>

        <!-- Misi Card -->
        <div class="pillar-card reveal" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="color: var(--success, #16a34a); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 12px;">
              <%= lang === 'en' ? 'STRATEGIC MISSION' : 'MISI PERUSAHAAN' %>
            </div>
            <ul style="list-style: none; padding: 0; margin: 0;">
              <% 
                const rawMission = lang === 'en' ? (data.mission_en || '') : (data.mission_id || '');
                const missionPoints = rawMission.split('\n').filter(p => p.trim().length > 0);
              %>
              <% missionPoints.forEach(function(point, idx) { %>
                <li style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px;">
                  <span style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: var(--surface-container, #eaedff); color: var(--primary, #0055b8); font-size: 12px; font-weight: 700; flex-shrink: 0; margin-top: 2px;">
                    <%= idx + 1 %>
                  </span>
                  <span style="font-size: 14.5px; color: var(--text-main, #0f172a); font-weight: 500; line-height: 1.55;">
                    <%= point.trim() %>
                  </span>
                </li>
              <% }); %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. NILAI-NILAI INTI BUDAYA KERJA T-I-C-K-E-T -->
  <section class="sec-intro" id="core-values">
    <div class="container">
      <div class="pillars-header reveal">
        <span class="brands-kicker"><%= lang === 'en' ? 'CORE VALUES' : 'NILAI INTI BUDAYA' %></span>
        <h2>Budaya Kerja T - I - C - K - E - T</h2>
        <p>
          <%= lang === 'en'
            ? 'The six foundational pillars guiding moral integrity, human potential, and manufacturing dedication.'
            : 'Enam pilar utama yang membina karakter positif, potensi insan, dan profesionalisme di setiap lini kerja.' %>
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        <% (data.values || []).forEach(function(val) { %>
          <div class="pillar-card reveal" style="padding: 24px;">
            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 12px;">
              <div style="width: 44px; height: 44px; border-radius: var(--r-lg, 8px); background: var(--surface-container, #eaedff); color: var(--primary, #0055b8); display: flex; align-items: center; justify-content: center; font-size: 1.35rem; font-weight: 800;">
                <%= val.letter %>
              </div>
              <h3 style="font-size: 1.15rem; color: var(--navy, #0a192f); margin: 0; font-weight: 700;">
                <%= lang === 'en' ? val.title_en : val.title_id %>
              </h3>
            </div>
            <p style="font-size: 13.5px; color: var(--text-variant, #424753); line-height: 1.6; margin: 0;">
              <%= lang === 'en' ? val.desc_en : val.desc_id %>
            </p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- 5. FASILITAS OPERASIONAL & PABRIK -->
  <section class="sec-pillars" id="facilities">
    <div class="container">
      <div class="pillars-header reveal">
        <span class="brands-kicker"><%= lang === 'en' ? 'OPERATIONAL FACILITIES' : 'LOKASI OPERASIONAL' %></span>
        <h2><%= lang === 'en' ? 'Production Plant & Management Offices' : 'Fasilitas Pabrik & Kantor Manajemen' %></h2>
      </div>

      <div class="grid grid-cols-2" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        <!-- Pabrik Bandung -->
        <div class="pillar-card reveal">
          <div style="font-size: 11px; color: var(--sky, #0284c7); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">
            <%= lang === 'en' ? 'PRODUCTION PLANT & WAREHOUSE' : 'PABRIK PRODUKSI & LOGISTIK' %>
          </div>
          <h3 style="font-size: 1.25rem; color: var(--navy, #0a192f); margin-bottom: 12px; font-weight: 700;">
            Bandung, Jawa Barat
          </h3>
          <p style="font-size: 14.5px; color: var(--text-variant, #424753); line-height: 1.6; margin-bottom: 16px;">
            <%= data.factory_address || 'Jl. Paralon II No. 21 Cijerah Bandung 40214 - Indonesia' %>
          </p>
          <div style="font-size: 13px; color: var(--text-muted, #64748b); line-height: 1.8;">
            <div>Telepon: <strong style="color: var(--navy, #0a192f);"><%= data.factory_phone || '(022) 6012519' %></strong></div>
            <div>Fax: <%= data.factory_fax || '(022) 6074730' %></div>
          </div>
        </div>

        <!-- Kantor Jakarta -->
        <div class="pillar-card reveal">
          <div style="font-size: 11px; color: var(--primary, #0055b8); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">
            <%= lang === 'en' ? 'CORPORATE & MARKETING OFFICE' : 'KANTOR PUSAT & PEMASARAN' %>
          </div>
          <h3 style="font-size: 1.25rem; color: var(--navy, #0a192f); margin-bottom: 12px; font-weight: 700;">
            Jakarta Pusat
          </h3>
          <p style="font-size: 14.5px; color: var(--text-variant, #424753); line-height: 1.6; margin-bottom: 16px;">
            <%= data.office_address || 'Karindra Building Jl. Palmerah Selatan 30 A Suite 02 - 07, Jakarta Pusat 10270' %>
          </p>
          <div style="font-size: 13px; color: var(--text-muted, #64748b); line-height: 1.8;">
            <div>Telepon: <strong style="color: var(--navy, #0a192f);"><%= data.office_phone || '(021) 53668626' %></strong></div>
            <div>Fax: <%= data.office_fax || '(021) 53668648' %></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. CTA KEMITRAAN B2B -->
  <section class="sec-cta" id="partnership">
    <div class="container">
      <div class="cta-layout reveal">
        <div>
          <h2><%= lang === 'en' ? 'Partner with PT. EUODOO for High-Volume Packaging' : 'Siap Berkonsultasi Kebutuhan Kemasan Ramah Lingkungan?' %></h2>
          <p>
            <%= lang === 'en'
              ? 'Contact our sales and engineering team for custom sizes, specifications, and volume pricing.'
              : 'Hubungi tim pemasaran dan teknis kami untuk konsultasi spesifikasi ukuran khusus, material degradable, dan penawaran harga kemitraan.' %>
          </p>
        </div>

        <div class="cta-actions">
          <a href="/contact" class="cta-card">
            <div>
              <div class="cta-card-title"><%= lang === 'en' ? 'Request Consultation' : 'Minta Penawaran Kemitraan' %></div>
              <div class="cta-card-sub"><%= lang === 'en' ? 'Direct RFQ submission' : 'Formulir penawaran harga dan konsultasi' %></div>
            </div>
            <span class="cta-card-arrow">&#8594;</span>
          </a>
          <a href="/products" class="cta-card">
            <div>
              <div class="cta-card-title"><%= lang === 'en' ? 'Explore Products' : 'Lihat Katalog Produk' %></div>
              <div class="cta-card-sub"><%= lang === 'en' ? 'Complete packaging line' : 'Jelajahi spesifikasi produk kami' %></div>
            </div>
            <span class="cta-card-arrow">&#8594;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>

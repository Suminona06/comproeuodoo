<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main id="main-content" class="section" style="background: var(--bg-subtle, #f8fafc); min-height: 65vh; display: flex; align-items: center; padding: 64px 0;">
  <div class="container" style="max-width: 580px;">
    <div style="background: var(--bg-base, #ffffff); border: 1px solid var(--border, #e2e8f0); border-radius: var(--r-xl, 12px); padding: 48px 36px; box-shadow: var(--shadow-1); text-align: center;">
      <span class="badge badge-error" style="margin-bottom: var(--space-md); font-size: 13px; font-weight: 700; padding: 6px 14px;">Status 404</span>
      <h1 style="font-size: clamp(1.85rem, 3vw, 2.5rem); font-weight: 800; margin-bottom: 12px; color: var(--navy, #0a192f); line-height: 1.25;">Halaman Tidak Ditemukan</h1>
      <p style="font-size: 15px; color: var(--text-variant, #424753); margin-bottom: 28px; line-height: 1.6;">
        Halaman yang Anda tuju tidak ditemukan atau telah dialihkan ke rute lain.
      </p>
      <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary btn-md">Kembali ke Beranda</a>
        <a href="/contact" class="btn btn-secondary btn-md">Hubungi Dukungan</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

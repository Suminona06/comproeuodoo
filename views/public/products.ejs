<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<% const lang = typeof currentLang !== 'undefined' ? currentLang : 'id'; %>
<% 
  const heroObj = typeof heroBanner !== 'undefined' && heroBanner && heroBanner.is_active ? heroBanner : null;
  const userOpacity = heroObj && heroObj.overlay_opacity ? parseFloat(heroObj.overlay_opacity) : 0.50;
  const midOpacity = Math.min(0.72, 0.35 + (userOpacity * 0.40)).toFixed(2);
  const edgeOpacity = Math.max(0.08, (userOpacity * 0.35)).toFixed(2);
  const heroBg = heroObj && heroObj.image_url 
    ? `style="background-image: url('${heroObj.image_url}'); --hero-scrim-mid: ${midOpacity}; --hero-scrim-edge: ${edgeOpacity};"` 
    : '';
%>

<main id="main-content">
  <!-- PAGE HERO -->
  <section class="page-hero <%= heroObj && heroObj.image_url ? 'page-hero--has-bg' : '' %>" <%- heroBg %>>
    <% if (heroObj && heroObj.image_url) { %>
      <div class="page-hero-scrim" aria-hidden="true"></div>
    <% } %>
    <div class="container">

      <div class="page-hero-content" style="max-width: 840px;">
        <h1 class="page-hero-title">
          <%= (heroObj && (lang === 'en' ? heroObj.title_en : heroObj.title_id))
              ? (lang === 'en' ? heroObj.title_en : heroObj.title_id)
              : (lang === 'en' ? 'Eco-Friendly & Industrial Plastic Bags' : 'Katalog Kantong Plastik HDPE & LLDPE') %>
        </h1>
        <p class="page-hero-desc">
          <%= (heroObj && (lang === 'en' ? heroObj.subtitle_en : heroObj.subtitle_id))
              ? (lang === 'en' ? heroObj.subtitle_en : heroObj.subtitle_id)
              : (lang === 'en'
                  ? 'Discover our complete range of certified degradable shopping bags, heavy-duty industrial liners, and commercial wholesale packaging produced in Bandung, West Java.'
                  : 'Jelajahi lini produk kantong belanja ramah lingkungan 100% degradable, kantong sampah heavy-duty, dan kemasan industri berkualitas tinggi bersertifikasi resmi SNI.') %>
        </p>
        <% if (heroObj && heroObj.cta_url && (lang === 'en' ? heroObj.cta_text_en : heroObj.cta_text_id)) { %>
          <div style="margin-top: 20px;">
            <a href="<%= heroObj.cta_url %>" class="btn btn-primary">
              <%= lang === 'en' ? heroObj.cta_text_en : heroObj.cta_text_id %>
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- CATALOG & FILTER SECTION (.plp-*) -->
  <section class="sec-products plp-section">
    <div class="container plp-container">

      <div class="plp-layout">
        <!-- SIDEBAR (LEFT COLUMN: FILTER BY / MOBILE DRAWER) -->
        <aside class="plp-sidebar" id="plp-sidebar" aria-label="Filter By">
          <div class="plp-drawer-header">
            <h2 class="plp-sidebar-title plp-drawer-title">FILTER BY</h2>
            <button type="button" class="plp-drawer-close" id="plp-filter-drawer-close" aria-label="<%= lang === 'en' ? 'Close Category Filter' : 'Tutup Filter Kategori' %>">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <ul class="plp-sidebar-list" role="list" id="plp-sidebar-list">
            <li class="plp-sidebar-item">
              <a href="/products<%= search ? '?search=' + encodeURIComponent(search) : '' %><%= sort && sort !== 'newest' ? (search ? '&' : '?') + 'sort=' + encodeURIComponent(sort) : '' %>"
                 class="plp-sidebar-link <%= !selectedCategory ? 'active' : '' %>"
                 data-category=""
                 aria-current="<%= !selectedCategory ? 'true' : 'false' %>">
                <span class="plp-sidebar-name"><%= lang === 'en' ? 'ALL PRODUCTS' : 'SEMUA PRODUK' %></span>
                <% if (typeof totalAllProducts !== 'undefined' && totalAllProducts !== null) { %>
                  <span class="plp-cat-count" id="plp-total-all-count">(<%= totalAllProducts %>)</span>
                <% } %>
              </a>
            </li>
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(cat => { %>
                <% const isActiveCat = selectedCategory && selectedCategory.id === cat.id; %>
                <% const catHref = '/products?category=' + encodeURIComponent(cat.slug) + (search ? '&search=' + encodeURIComponent(search) : '') + (sort && sort !== 'newest' ? '&sort=' + encodeURIComponent(sort) : ''); %>
                <li class="plp-sidebar-item">
                  <a href="<%= catHref %>"
                     class="plp-sidebar-link <%= isActiveCat ? 'active' : '' %>"
                     data-category="<%= cat.slug %>"
                     data-category-id="<%= cat.id %>"
                     aria-current="<%= isActiveCat ? 'true' : 'false' %>">
                    <span class="plp-sidebar-name"><%= lang === 'en' ? (cat.name_en || cat.name_id) : cat.name_id %></span>
                    <span class="plp-cat-count">(<%= cat.product_count || 0 %>)</span>
                  </a>
                </li>
              <% }); %>
            <% } %>
          </ul>
        </aside>

        <!-- MOBILE DRAWER BACKDROP -->
        <div class="plp-drawer-backdrop" id="plp-filter-drawer-backdrop" aria-hidden="true"></div>

        <!-- MAIN CATALOG (RIGHT COLUMN): TOOLBAR + GRID + SHOW MORE -->
        <div class="plp-main">
          <!-- TOOLBAR: SEARCH INPUT (DEBOUNCED) + FILTER DRAWER TRIGGER (MOBILE) + SORT SELECT -->
          <div class="plp-toolbar">
            <button type="button" class="plp-drawer-trigger" id="plp-filter-drawer-open" aria-controls="plp-sidebar" aria-expanded="false" aria-label="<%= lang === 'en' ? 'Open Category Filter' : 'Buka Filter Kategori' %>">
              <svg class="plp-drawer-trigger-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="4" y1="21" x2="4" y2="14"></line>
                <line x1="4" y1="10" x2="4" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12" y2="3"></line>
                <line x1="20" y1="21" x2="20" y2="16"></line>
                <line x1="20" y1="12" x2="20" y2="3"></line>
                <line x1="1" y1="14" x2="7" y2="14"></line>
                <line x1="9" y1="8" x2="15" y2="8"></line>
                <line x1="17" y1="16" x2="23" y2="16"></line>
              </svg>
              <span class="plp-drawer-trigger-text">FILTER</span>
              <% if (selectedCategory) { %>
                <span class="plp-drawer-trigger-badge" aria-hidden="true">1</span>
              <% } %>
            </button>

            <form action="/products" method="GET" class="plp-search-wrap" id="plp-search-form" role="search" aria-label="<%= lang === 'en' ? 'Product search' : 'Pencarian produk' %>">
              <% if (selectedCategory) { %>
                <input type="hidden" name="category" value="<%= selectedCategory.slug %>" />
              <% } %>
              <input type="search"
                     name="search"
                     id="plp-search-input"
                     class="plp-search-input"
                     value="<%= search || '' %>"
                     placeholder="<%= lang === 'en' ? 'Search name or specs...' : 'Cari nama atau spesifikasi...' %>"
                     aria-label="<%= lang === 'en' ? 'Search products' : 'Cari produk' %>"
                     autocomplete="off" />
              <button type="button" class="plp-search-clear <%= search ? 'visible' : '' %>" id="plp-search-clear" aria-label="<%= lang === 'en' ? 'Clear search' : 'Hapus pencarian' %>">
                &times;
              </button>
              <button type="submit" class="plp-search-btn" id="plp-search-btn" aria-label="<%= lang === 'en' ? 'Search' : 'Cari' %>" title="<%= lang === 'en' ? 'Search' : 'Cari' %>">
                <svg class="plp-search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </button>
            </form>

            <div class="plp-sort-wrap">
              <label for="plp-sort-select" class="sr-only"><%= lang === 'en' ? 'Sort By' : 'Urutkan' %></label>
              <select name="sort" id="plp-sort-select" class="plp-sort-select" aria-label="<%= lang === 'en' ? 'Sort by' : 'Urutkan berdasarkan' %>">
                <option value="newest" <%= (!sort || sort === 'newest') ? 'selected' : '' %>>
                  <%= lang === 'en' ? 'SORT : NEWEST' : 'URUTKAN : TERBARU' %>
                </option>
                <option value="alpha-asc" <%= sort === 'alpha-asc' ? 'selected' : '' %>>
                  <%= lang === 'en' ? 'SORT : NAME A-Z' : 'URUTKAN : NAMA A-Z' %>
                </option>
                <option value="alpha-desc" <%= sort === 'alpha-desc' ? 'selected' : '' %>>
                  <%= lang === 'en' ? 'SORT : NAME Z-A' : 'URUTKAN : NAMA Z-A' %>
                </option>
                <option value="catalog" <%= sort === 'catalog' ? 'selected' : '' %>>
                  <%= lang === 'en' ? 'SORT : CATALOG' : 'URUTKAN : KATALOG' %>
                </option>
              </select>
              <svg class="plp-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>

          <!-- Products Grid (.plp-grid) -->
          <% if (products && products.length > 0) { %>
            <div class="plp-grid" id="plp-products-grid">
              <%- include('partials/product-card-fragment', { products, currentLang: lang }) %>
            </div>

            <!-- SHOW MORE BUTTON (PROGRESSIVE ENHANCEMENT) -->
            <div class="plp-more-wrap" id="plp-more-wrap" <% if (!hasMore || totalProducts <= 9) { %>style="display: none;"<% } %>>
              <a href="/products?page=<%= page + 1 %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory.slug) : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= sort && sort !== 'newest' ? '&sort=' + encodeURIComponent(sort) : '' %>"
                 class="plp-more-btn"
                 id="plp-load-more-btn"
                 role="button"
                 aria-busy="false"
                 data-current-page="<%= page %>"
                 data-total-pages="<%= totalPages %>">
                <span class="plp-more-btn-text"><%= lang === 'en' ? 'SHOW MORE' : 'MUAT LEBIH BANYAK' %></span>
              </a>
            </div>

            <!-- Accessible Pagination Fallback Controls -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
              <nav class="plp-pagination" aria-label="<%= lang === 'en' ? 'Pagination' : 'Paginasi Halaman' %>">
                <% if (page > 1) { %>
                  <a href="/products?page=<%= page - 1 %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory.slug) : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= sort && sort !== 'newest' ? '&sort=' + encodeURIComponent(sort) : '' %>"
                     class="plp-pagination-btn"
                     aria-label="<%= lang === 'en' ? 'Previous page' : 'Halaman sebelumnya' %>">
                    &larr; <%= lang === 'en' ? 'PREV' : 'SEBELUMNYA' %>
                  </a>
                <% } %>

                <% for (let p = 1; p <= totalPages; p++) { %>
                  <a href="/products?page=<%= p %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory.slug) : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= sort && sort !== 'newest' ? '&sort=' + encodeURIComponent(sort) : '' %>"
                     class="plp-pagination-num <%= page === p ? 'active' : '' %>"
                     aria-current="<%= page === p ? 'page' : 'false' %>">
                    <%= p %>
                  </a>
                <% } %>

                <% if (page < totalPages) { %>
                  <a href="/products?page=<%= page + 1 %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory.slug) : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= sort && sort !== 'newest' ? '&sort=' + encodeURIComponent(sort) : '' %>"
                     class="plp-pagination-btn"
                     aria-label="<%= lang === 'en' ? 'Next page' : 'Halaman berikutnya' %>">
                    <%= lang === 'en' ? 'NEXT' : 'BERIKUTNYA' %> &rarr;
                  </a>
                <% } %>
              </nav>
            <% } %>

          <% } else { %>
            <!-- Empty State -->
            <div style="background: #ffffff; border: 1px solid var(--color-border, #e2e8f0); padding: 56px 24px; text-align: center; max-width: 480px; margin: 40px auto;">
              <h2 style="font-size: 1.1rem; color: var(--color-text-main, #0f172a); margin-bottom: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                <%= lang === 'en' ? 'No Products Found' : 'Produk Tidak Ditemukan' %>
              </h2>
              <p style="font-size: 12px; color: var(--color-text-variant, #64748b); line-height: 1.6; margin-bottom: 20px;">
                <%= lang === 'en'
                  ? 'Try adjusting your search query or selecting a different product category.'
                  : 'Silakan sesuaikan kata kunci pencarian atau pilih kategori produk lain.' %>
              </p>
              <a href="/products" class="plp-more-btn" style="display: inline-flex;">
                <%= lang === 'en' ? 'RESET ALL FILTERS' : 'TAMPILKAN SEMUA PRODUK' %>
              </a>
            </div>
          <% } %>
        </div>
      </div>

      <div id="plp-live-region" class="sr-only" aria-live="polite" role="status"></div>
    </div>
  </section>
</main>

<script src="/js/products.js" defer></script>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main id="main-content">
  <section class="section section-bg-navy" style="padding-top: var(--space-2xl); padding-bottom: var(--space-2xl);">
    <div class="container">
      <span class="section-kicker">Katalog Produk</span>
      <h1 style="color: #ffffff; margin-bottom: var(--space-sm);">Produk & Komponen Plastik Presisi</h1>
      <p style="color: #cbd5e1; max-width: 680px;">
        Solusi cetakan plastik berkualitas tinggi untuk beragam sektor industri dengan standar material terverifikasi.
      </p>
    </div>
  </section>

  <section class="section section-bg-workspace">
    <div class="container">
      <div class="grid grid-cols-3">
        <div class="card card-interactive">
          <div class="card-body">
            <span class="badge badge-primary" style="margin-bottom: var(--space-sm);">Injection</span>
            <h3>Komponen Presisi Otomotif</h3>
            <p style="color: var(--color-text-muted); font-size: var(--font-size-body-sm); margin-top: var(--space-xs);">
              Komponen interior dan kompartemen mesin dengan ketahanan panas dan benturan tinggi.
            </p>
            <div style="margin-top: var(--space-md);">
              <a href="/contact" class="btn btn-secondary btn-sm">Minta Spesifikasi</a>
            </div>
          </div>
        </div>

        <div class="card card-interactive">
          <div class="card-body">
            <span class="badge badge-primary" style="margin-bottom: var(--space-sm);">Blow Molding</span>
            <h3>Kemasan Cairan Industri</h3>
            <p style="color: var(--color-text-muted); font-size: var(--font-size-body-sm); margin-top: var(--space-xs);">
              Wadah jerigen dan botol HDPE tahan bahan kimia dengan penutup bersegel presisi.
            </p>
            <div style="margin-top: var(--space-md);">
              <a href="/contact" class="btn btn-secondary btn-sm">Minta Spesifikasi</a>
            </div>
          </div>
        </div>

        <div class="card card-interactive">
          <div class="card-body">
            <span class="badge badge-primary" style="margin-bottom: var(--space-sm);">Custom Tooling</span>
            <h3>Barang Konsumen & Wadah</h3>
            <p style="color: var(--color-text-muted); font-size: var(--font-size-body-sm); margin-top: var(--space-xs);">
              Cetakan fleksibel untuk produk FMCG dan perkakas rumah tangga berstandar food-grade.
            </p>
            <div style="margin-top: var(--space-md);">
              <a href="/contact" class="btn btn-secondary btn-sm">Minta Spesifikasi</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>

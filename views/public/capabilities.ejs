<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<% const currentLangCode = currentLang || 'id'; %>

<main id="main-content">
  <section class="section section-bg-navy cap-hero">
    <div class="container">
      <span class="section-kicker cap-kicker"><%= t('capabilities.page_title') %></span>
      <h1 class="cap-hero-title">
        <%= t('capabilities.page_title') %>
      </h1>
      <p class="cap-hero-desc">
        <%= t('capabilities.page_subtitle') %>
      </p>
    </div>
  </section>

  <section class="section section-bg-workspace cap-list-section">
    <div class="container">
      <div class="flex items-center justify-between cap-list-head">
        <div>
          <span class="section-kicker"><%= t('capabilities.section_specs') %></span>
          <h2 class="cap-heading"><%= t('capabilities.section_specs') %></h2>
        </div>
      </div>

      <% if (capabilities && capabilities.length > 0) { %>
        <div class="grid grid-cols-2 gap-xl">
          <% capabilities.forEach(cap => { %>
            <%
              const capTitle = currentLangCode === 'en' ? (cap.title_en || cap.title_id) : cap.title_id;
              const capDesc = currentLangCode === 'en' ? (cap.description_en || cap.description_id) : cap.description_id;
            %>
            <div class="card card-interactive flex flex-col justify-between cap-card">
              <% if (cap.image_url) { %>
                <div class="cap-media">
                  <img src="<%= cap.image_url %>"
                       alt="<%= capTitle %>"
                       class="cap-media-img"
                       loading="lazy">
                </div>
              <% } %>

              <div class="card-body flex flex-col justify-between cap-body">
                <div>
                  <div class="flex items-center justify-between gap-sm cap-meta-row">
                    <span class="badge badge-primary"><%= cap.machine_type || 'Industrial Line' %></span>
                    <% if (cap.capacity) { %>
                      <span class="badge badge-neutral cap-cap-badge">
                        <%= cap.capacity %>
                      </span>
                    <% } %>
                  </div>

                  <h3 class="cap-card-title">
                    <%= capTitle %>
                  </h3>

                  <p class="cap-card-desc">
                    <%= capDesc %>
                  </p>
                </div>

                <div class="flex items-center justify-between pt-sm cap-card-foot">
                  <span class="cap-status-label">
                    Status: <strong class="cap-status-value"><%= t('common.status_active') %></strong>
                  </span>
                  <a href="/contact" class="btn btn-secondary btn-sm">
                    <%= t('home.cta_quote') %>
                  </a>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="grid grid-cols-2 gap-xl">
          <div class="card">
            <div class="card-body">
              <span class="badge badge-primary cap-default-badge">Film Blowing</span>
              <h3 class="cap-default-title">Lini Mesin Ekstrusi Film HDPE &amp; LLDPE</h3>
              <p class="cap-default-desc">
                Lini ekstrusi film tiup presisi tinggi dengan teknologi pencampuran aditif degradasi ramah lingkungan OXIUM untuk kantong belanja dan industri.
              </p>
            </div>
          </div>
          <div class="card">
            <div class="card-body">
              <span class="badge badge-primary cap-default-badge">Bag Converting</span>
              <h3 class="cap-default-title">Lini Cutting, Sealing &amp; Bag Making Otomatis</h3>
              <p class="cap-default-desc">
                Pembuatan tas belanja soft loop, patch handle, roll bags, dan kantong sampah bottom sealed berkapasitas jutaan lembar per bulan.
              </p>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </section>

  <section class="section section-bg-base cap-qa-section">
    <div class="container">
      <div class="card cap-qa-card">
        <div class="flex flex-col md:flex-row items-start justify-between gap-lg">
          <div class="cap-qa-body">
            <span class="section-kicker"><%= t('capabilities.quality_assurance_title') %></span>
            <h3 class="cap-qa-title">
              <%= t('capabilities.quality_assurance_title') %>
            </h3>
            <p class="cap-qa-desc">
              <%= t('capabilities.quality_assurance_desc') %>
            </p>
          </div>
          <div class="cap-qa-action">
            <a href="/contact" class="btn btn-primary btn-md">
              <%= t('home.consultation_banner_btn') %>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>

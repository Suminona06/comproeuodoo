<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main id="main-content">
  <section class="section section-bg-navy" style="padding-top: var(--space-2xl); padding-bottom: var(--space-2xl);">
    <div class="container">
      <span class="section-kicker">Fasilitas & Kapabilitas</span>
      <h1 style="color: #ffffff; margin-bottom: var(--space-sm);">Infrastruktur & Mesin Manufaktur</h1>
      <p style="color: #cbd5e1; max-width: 680px;">
        Teknologi injection molding dan blow molding modern dengan kontrol toleransi ketat dan pemeliharaan berkala.
      </p>
    </div>
  </section>

  <section class="section section-bg-workspace">
    <div class="container">
      <div class="grid grid-cols-2">
        <div class="card">
          <div class="card-body">
            <h3>Mesin Injection Molding</h3>
            <p style="color: var(--color-text-muted); margin-top: var(--space-xs);">
              Lini mesin hidrolik dan servo elektrik mulai dari 80 Ton hingga 850 Ton untuk pencetakan berkecepatan tinggi dengan kestabilan dimensi konsisten.
            </p>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <h3>Mesin Extrusion Blow Molding</h3>
            <p style="color: var(--color-text-muted); margin-top: var(--space-xs);">
              Fasilitas produksi botol, wadah jerigen, dan drum kimia dengan distribusi ketebalan dinding yang presisi serta uji kebocoran otomatis.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  const currentLangCode = currentLang || 'id';
  const isEn = currentLangCode === 'en';
  const companyPhone = (settings && (settings.contact_phone || settings.company_phone)) || '(021) 5366-0000';
  const companyEmail = (settings && (settings.contact_email || settings.company_email)) || 'info@euodoo.com';
  const waNum = (settings && settings.whatsapp_number) ? settings.whatsapp_number.replace(/\D/g, '') : '6281234567890';
  const contactAddress = isEn 
    ? (settings && (settings.contact_address_en || settings.factory_address) || 'Cigondewah Industrial Estate, Jl. Cigondewah Kaler No. 88, Bandung City, West Java 40214')
    : (settings && (settings.contact_address_id || settings.factory_address) || 'Kawasan Industri Cigondewah, Jl. Cigondewah Kaler No. 88, Kota Bandung, Jawa Barat 40214');
  const workingHours = isEn
    ? (settings && settings.contact_working_hours_en || 'Monday - Friday: 08:00 - 17:00 WIB | Saturday: 08:00 - 13:00 WIB')
    : (settings && settings.contact_working_hours_id || 'Senin - Jumat: 08.00 - 17.00 WIB | Sabtu: 08.00 - 13.00 WIB');
  const mapsEmbed = (settings && (settings.contact_maps_embed_url || settings.google_maps_embed)) || 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126748.56347862248!2d107.5731168!3d-6.9034443!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e68e6398252477f%3A0x146a1f93d3e215ac!2sBandung%2C%20Bandung%20City%2C%20West%20Java!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid';
  const formHeading = isEn
    ? ((settings && settings.contact_form_title_en) || t('contact.form_heading'))
    : ((settings && settings.contact_form_title_id) || t('contact.form_heading'));
  const formSubheading = isEn
    ? ((settings && settings.contact_form_subtitle_en) || t('contact.form_subheading'))
    : ((settings && settings.contact_form_subtitle_id) || t('contact.form_subheading'));

  const heroObj = typeof heroBanner !== 'undefined' && heroBanner && heroBanner.is_active ? heroBanner : null;
  const heroBg = heroObj && heroObj.image_url ? `style="background: linear-gradient(rgba(10, 25, 47, ${heroObj.overlay_opacity || 0.60}), rgba(10, 25, 47, ${heroObj.overlay_opacity || 0.60})), url('${heroObj.image_url}') center/cover no-repeat;"` : '';
%>

<main id="main-content">
  <!-- Page Hero Header -->
  <section class="page-hero" <%- heroBg %>>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/"><%= t('nav.home') %></a>
        <span aria-hidden="true">/</span>
        <span style="color: #ffffff; font-weight: 600;"><%= t('nav.contact') %></span>
      </nav>
      <div style="font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sky, #38bdf8); margin-bottom: 10px;">
        SALES & ENTERPRISE PROCUREMENT
      </div>
      <h1 class="page-hero-title">
        <%= (heroObj && (isEn ? heroObj.title_en : heroObj.title_id))
            ? (isEn ? heroObj.title_en : heroObj.title_id)
            : t('contact.page_title') %>
      </h1>
      <p class="page-hero-desc">
        <%= (heroObj && (isEn ? heroObj.subtitle_en : heroObj.subtitle_id))
            ? (isEn ? heroObj.subtitle_en : heroObj.subtitle_id)
            : t('contact.page_subtitle') %>
      </p>
      <% if (heroObj && heroObj.cta_url && (isEn ? heroObj.cta_text_en : heroObj.cta_text_id)) { %>
        <div style="margin-top: 20px;">
          <a href="<%= heroObj.cta_url %>" class="btn btn-primary">
            <%= isEn ? heroObj.cta_text_en : heroObj.cta_text_id %>
          </a>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Split Form & Information Section -->
  <section class="section section-bg-workspace" style="padding-top: var(--space-2xl); padding-bottom: var(--space-3xl);">
    <div class="container">

      <!-- Status Alerts -->
      <div id="form-status">
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success" style="margin-bottom: 32px; padding: 20px 24px; border-radius: 12px; background-color: #ecfdf5; border: 1.5px solid #a7f3d0; color: #065f46; display: flex; align-items: flex-start; gap: 14px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <div>
              <h3 style="font-size: 1.1rem; margin: 0 0 4px 0; color: #065f46; font-weight: 700;">
                Permintaan Penawaran Berhasil Dikirim!
              </h3>
              <p style="font-size: 14px; margin: 0; line-height: 1.5; color: #047857;">
                <%= t('contact.success_alert') %>
              </p>
            </div>
          </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error" style="margin-bottom: 32px; padding: 20px 24px; border-radius: 12px; background-color: #fef2f2; border: 1.5px solid #fecaca; color: #991b1b; display: flex; align-items: flex-start; gap: 14px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div>
              <h3 style="font-size: 1.1rem; margin: 0 0 4px 0; color: #991b1b; font-weight: 700;">
                Perhatian
              </h3>
              <p style="font-size: 14px; margin: 0; line-height: 1.5; color: #b91c1c;">
                <%= typeof errorMsg !== 'undefined' && errorMsg ? errorMsg : t('contact.error_alert') %>
              </p>
            </div>
          </div>
        <% } %>
      </div>

      <div class="contact-split-grid">

        <!-- Column 1: RFQ Form -->
        <div class="contact-card-box">
          <div style="margin-bottom: 28px;">
            <div style="display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--primary, #0055b8); margin-bottom: 6px;">
              FORMULIR RFQ B2B
            </div>
            <h2 style="font-size: 1.65rem; color: var(--navy, #0a192f); font-weight: 800; margin: 0 0 8px 0; line-height: 1.3;">
              <%= formHeading %>
            </h2>
            <p style="color: var(--text-variant, #424753); font-size: 14.5px; line-height: 1.6; margin: 0;">
              <%= formSubheading %>
            </p>
          </div>

          <form id="rfqForm" action="/contact" method="POST">
            <!-- CSRF Protection -->
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- Honeypot anti-spam (hidden from users) -->
            <div style="display: none !important;" aria-hidden="true">
              <label for="hp_website">Do not fill this field</label>
              <input type="text" id="hp_website" name="hp_website" tabindex="-1" autocomplete="off">
            </div>

            <!-- Name & Company Row -->
            <div class="grid grid-cols-2 gap-md" style="margin-bottom: 16px;">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="name" class="form-label form-label-required">
                  <%= t('contact.name_label') %>
                </label>
                <input type="text"
                       id="name"
                       name="name"
                       class="form-control"
                       placeholder="<%= t('contact.name_placeholder') %>"
                       required
                       style="height: 44px; border-radius: 8px;">
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label for="company" class="form-label">
                  <%= t('contact.company_label') %>
                </label>
                <input type="text"
                       id="company"
                       name="company"
                       class="form-control"
                       placeholder="<%= t('contact.company_placeholder') %>"
                       style="height: 44px; border-radius: 8px;">
              </div>
            </div>

            <!-- Email & Phone Row -->
            <div class="grid grid-cols-2 gap-md" style="margin-bottom: 16px;">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="email" class="form-label form-label-required">
                  <%= t('contact.email_label') %>
                </label>
                <input type="email"
                       id="email"
                       name="email"
                       class="form-control"
                       placeholder="<%= t('contact.email_placeholder') %>"
                       required
                       style="height: 44px; border-radius: 8px;">
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label for="phone" class="form-label form-label-required">
                  <%= t('contact.phone_label') %>
                </label>
                <input type="tel"
                       id="phone"
                       name="phone"
                       class="form-control"
                       placeholder="<%= t('contact.phone_placeholder') %>"
                       required
                       style="height: 44px; border-radius: 8px;">
              </div>
            </div>

            <!-- Product Selection & Quantity Row -->
            <div class="grid grid-cols-2 gap-md" style="margin-bottom: 16px;">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="product_id" class="form-label">
                  <%= t('contact.product_label') || 'Produk yang Diminati' %>
                </label>
                <select id="product_id" name="product_id" class="form-select" style="height: 44px; border-radius: 8px;">
                  <option value=""><%= t('contact.product_select_default') || '-- Pilih Produk (Opsional) --' %></option>
                  <% if (products && products.length > 0) { %>
                    <% products.forEach(prod => { %>
                      <%
                        const isSel = selectedProduct && (selectedProduct.id === prod.id || selectedProduct.slug === prod.slug);
                        const pName = currentLangCode === 'en' ? (prod.name_en || prod.name_id) : prod.name_id;
                        const pCat = currentLangCode === 'en' ? (prod.category_name_en || prod.category_name_id) : prod.category_name_id;
                      %>
                      <option value="<%= prod.id %>" <%= isSel ? 'selected' : '' %>>
                        <%= pName %> <%= pCat ? '(' + pCat + ')' : '' %>
                      </option>
                    <% }); %>
                  <% } %>
                </select>
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label for="quantity" class="form-label">
                  <%= t('contact.quantity_label') %>
                </label>
                <input type="text"
                       id="quantity"
                       name="quantity"
                       class="form-control"
                       placeholder="<%= t('contact.quantity_placeholder') %>"
                       style="height: 44px; border-radius: 8px;">
              </div>
            </div>

            <!-- Inquiry Type Selector -->
            <div class="form-group" style="margin-bottom: 16px;">
              <label for="inquiry_type" class="form-label">
                Tipe Permintaan
              </label>
              <select id="inquiry_type" name="type" class="form-select" style="height: 44px; border-radius: 8px;">
                <option value="inquiry" selected>Permintaan Penawaran Harga (RFQ)</option>
                <option value="partnership">Kemitraan Distributor / Reseller</option>
                <option value="general">Pertanyaan Umum & Konsultasi Spesifikasi</option>
              </select>
            </div>

            <!-- Message / Technical Specs -->
            <div class="form-group" style="margin-bottom: 24px;">
              <label for="message" class="form-label form-label-required">
                <%= t('contact.message_label') %>
              </label>
              <textarea id="message"
                        name="message"
                        class="form-textarea"
                        rows="5"
                        placeholder="<%= t('contact.message_placeholder') %>"
                        required
                        style="min-height: 120px; border-radius: 8px;"></textarea>
            </div>

            <!-- Cloudflare Turnstile CAPTCHA (Item 7 / T-68) -->
            <% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
              <div class="form-group" style="margin-bottom: 20px;">
                <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="light"></div>
              </div>
            <% } %>

            <!-- Submit Button -->
            <button type="submit"
                    id="submitBtn"
                    class="btn btn-primary btn-lg btn-block">
              <span><%= t('contact.submit_btn') %></span>
              <span aria-hidden="true">&rarr;</span>
            </button>
          </form>
        </div>

        <!-- Column 2: Dual Office Locations & Google Maps -->
        <div>
          <!-- Jakarta Palmerah Head Office Card -->
          <div class="office-info-card">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
              <div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(0, 85, 184, 0.1); color: var(--primary, #0055b8); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              </div>
              <div>
                <span class="badge badge-primary" style="font-size: 10px; text-transform: uppercase;">Kantor Pusat & Sales</span>
                <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--navy, #0a192f); margin: 2px 0 0 0;">Jakarta Pusat</h3>
              </div>
            </div>
            <p style="font-size: 13.5px; color: var(--text-variant, #424753); line-height: 1.6; margin-bottom: 10px;">
              Karindra Building Jl. Palmerah Selatan 30 A Suite 02 - 07, Jakarta Pusat 10270 - Indonesia
            </p>
            <div style="font-size: 13px; color: var(--navy, #0a192f); line-height: 1.6;">
              <div><strong>Telepon:</strong> +6221-53668626</div>
              <div><strong>Fax:</strong> +6221-53668648</div>
              <div><strong>Email:</strong> <a href="mailto:<%= companyEmail %>" style="color: var(--primary, #0055b8);"><%= companyEmail %></a></div>
            </div>
          </div>

          <!-- Bandung Cigondewah Factory Card -->
          <div class="office-info-card">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
              <div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(16, 185, 129, 0.1); color: #059669; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>
              <div>
                <span class="badge badge-success" style="font-size: 10px; text-transform: uppercase;">Pabrik Manufaktur & Gudang</span>
                <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--navy, #0a192f); margin: 2px 0 0 0;">Bandung, Jawa Barat</h3>
              </div>
            </div>
            <p style="font-size: 13.5px; color: var(--text-variant, #424753); line-height: 1.6; margin-bottom: 10px;">
              <%= contactAddress %>
            </p>
            <div style="font-size: 13px; color: var(--navy, #0a192f); line-height: 1.6;">
              <div><strong>Telepon / Hotline:</strong> <%= companyPhone %></div>
              <div><strong>Email:</strong> <a href="mailto:<%= companyEmail %>" style="color: var(--primary, #0055b8);"><%= companyEmail %></a></div>
              <div><strong>Operasional:</strong> <%= workingHours %></div>
            </div>
          </div>

          <!-- Direct WhatsApp Consultation Card -->
          <div class="office-info-card" style="background: linear-gradient(135deg, #0a192f 0%, #0d2040 100%); color: #ffffff; border-color: rgba(56, 189, 248, 0.2);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
              <span class="wa-pulse-indicator">
                <span class="wa-pulse-ring"></span>
                <span class="wa-pulse-dot"></span>
              </span>
              <span style="font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sky, #38bdf8);">
                RESPONS CEPAT SALES
              </span>
            </div>
            <h3 style="font-size: 1.15rem; color: #ffffff; margin-bottom: 6px; font-weight: 700;">
              Konsultasi WhatsApp Langsung
            </h3>
            <p style="font-size: 13px; color: #cbd5e1; margin-bottom: 16px; line-height: 1.5;">
              Butuh penawaran mendesak atau konsultasi spesifikasi teknis cetak kantong plastik segera? Hubungi representatif sales kami.
            </p>
            <a href="https://wa.me/<%= waNum %>?text=Halo%20Tim%20Sales%20PT%20EUODOO,%20saya%20ingin%20berkonsultasi%20mengenai%20kantong%20plastik%20ramah%20lingkungan."
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-primary btn-block">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink: 0;">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
              </svg>
              <span>Chat WhatsApp Sales</span>
            </a>
          </div>

          <!-- Google Maps Responsive Embed -->
          <div style="border-radius: 16px; overflow: hidden; border: 1px solid var(--border, #e2e8f0); height: 260px; box-shadow: 0 4px 14px -2px rgba(10, 25, 47, 0.05); background: #e2e8f0;">
            <iframe
              src="<%= mapsEmbed %>"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Peta Lokasi Pabrik PT Euodoo Bandung">
            </iframe>
          </div>
        </div>

      </div>

    </div>
  </section>
</main>

<script>
  // Progressive enhancement for RFQ form submission
  document.getElementById('rfqForm')?.addEventListener('submit', async function(e) {
    const btn = document.getElementById('submitBtn');
    if (!btn) return;
    btn.disabled = true;
    btn.innerHTML = '<span>Mengirimkan Permintaan...</span>';
  });
</script>

<% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<% } %>

<%- include('../partials/footer') %>

<%- include('../partials/header', { pageStyle: 'contact' }) %>
<%- include('../partials/navbar') %>

<%
  const currentLangCode = typeof currentLang !== 'undefined' && currentLang ? currentLang : 'id';
  const isEn = currentLangCode === 'en';
  const settingsObj = typeof settings !== 'undefined' && settings ? settings : {};
  const heroObj = typeof heroBanner !== 'undefined' && heroBanner && heroBanner.is_active ? heroBanner : null;
  const userOpacity = heroObj && heroObj.overlay_opacity ? parseFloat(heroObj.overlay_opacity) : 0.35;
  let scrimLevel = 'standard';
  if (userOpacity <= 0.35) scrimLevel = 'soft';
  else if (userOpacity <= 0.45) scrimLevel = 'light';
  else if (userOpacity <= 0.55) scrimLevel = 'medium';
  const hasHeroBg = Boolean(heroObj && heroObj.image_url);
  const heroTitle = (heroObj && (isEn ? heroObj.title_en : heroObj.title_id)) || t('contact.page_title');
  const heroDesc = (heroObj && (isEn ? heroObj.subtitle_en : heroObj.subtitle_id)) || t('contact.page_subtitle');
  const heroCtaText = heroObj ? (isEn ? heroObj.cta_text_en : heroObj.cta_text_id) : '';
%>

<main id="main-content">
  <section class="page-hero <%= hasHeroBg ? 'page-hero--has-bg' : '' %>">
    <% if (hasHeroBg) { %>
      <img src="<%= heroObj.image_url %>" alt="" class="page-hero-bg-img" fetchpriority="high" decoding="async">
      <div class="page-hero-scrim" data-scrim-level="<%= scrimLevel %>" aria-hidden="true"></div>
    <% } %>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/"><%= t('nav.home') %></a>
        <span class="separator" aria-hidden="true">&rsaquo;</span>
        <span class="current"><%= t('nav.contact') %></span>
      </nav>
      <div class="page-hero-content cf-hero-content">
        <h1 class="page-hero-title"><%= heroTitle %></h1>
        <p class="page-hero-desc"><%= heroDesc %></p>
        <% if (heroObj && heroObj.cta_url && heroCtaText) { %>
          <div class="cf-hero-cta">
            <a href="<%= heroObj.cta_url %>" class="btn btn-primary"><%= heroCtaText %></a>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <section class="section section-bg-workspace cf-section">
    <div class="container">
      <%- include('../partials/contact/status-alerts') %>

      <div class="contact-split-grid cf-split-grid">
        <%- include('../partials/contact/rfq-form', { isEn, settingsObj }) %>
        <%- include('../partials/contact/locations-map', { isEn, settingsObj }) %>
      </div>
    </div>
  </section>
</main>

<script src="/js/contact.js" defer></script>
<% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<% } %>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  const currentLangCode = currentLang || 'id';
  const postTitle = currentLangCode === 'en' ? (post.title_en || post.title_id) : post.title_id;
  const postContent = currentLangCode === 'en' ? (post.content_en || post.content_id) : post.content_id;
  const pubDate = post.published_at ? new Date(post.published_at).toLocaleDateString(currentLangCode === 'en' ? 'en-US' : 'id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
%>

<main id="main-content">
  <!-- Breadcrumb Navigation -->
  <nav aria-label="Breadcrumb" style="background-color: var(--color-bg-base); border-bottom: 1px solid var(--color-border-subtle); padding: var(--space-md) 0;">
    <div class="container">
      <ol class="flex items-center gap-xs" style="list-style: none; margin: 0; padding: 0; font-size: var(--font-size-label-sm); color: var(--color-text-muted);">
        <li><a href="/" style="color: var(--color-text-muted); text-decoration: none;"><%= t('nav.home') %></a></li>
        <li aria-hidden="true" style="user-select: none;">/</li>
        <li><a href="/news" style="color: var(--color-text-muted); text-decoration: none;"><%= t('nav.news') %></a></li>
        <li aria-hidden="true" style="user-select: none;">/</li>
        <li aria-current="page" style="color: var(--color-secondary-navy); font-weight: 600;"><%= postTitle %></li>
      </ol>
    </div>
  </nav>

  <!-- Article Container -->
  <article class="section section-bg-workspace" style="padding-top: var(--space-2xl); padding-bottom: var(--space-3xl);">
    <div class="container">
      <div style="max-width: 820px; margin: 0 auto;">
        <!-- Header -->
        <header style="margin-bottom: var(--space-xl);">
          <div class="flex items-center gap-sm" style="margin-bottom: var(--space-sm);">
            <span class="badge badge-info">Publikasi</span>
            <% if (pubDate) { %>
              <time datetime="<%= post.published_at %>" style="font-size: var(--font-size-label-sm); color: var(--color-text-muted);">
                <%= pubDate %>
              </time>
            <% } %>
          </div>

          <h1 style="font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--color-secondary-navy); line-height: 1.25; margin-bottom: var(--space-lg);">
            <%= postTitle %>
          </h1>
        </header>

        <!-- Cover Image -->
        <% if (post.cover_image) { %>
          <div class="card" style="overflow: hidden; margin-bottom: var(--space-2xl); padding: 0;">
            <img src="<%= post.cover_image %>"
                 alt="<%= postTitle %>"
                 style="width: 100%; max-height: 480px; object-fit: cover;"
                 loading="eager">
          </div>
        <% } %>

        <!-- Content Body -->
        <div class="card" style="padding: var(--space-2xl); background-color: #ffffff; line-height: 1.8; font-size: var(--font-size-body-md); color: var(--color-text-body);">
          <% if (postContent) { %>
            <div class="prose" style="white-space: pre-line;">
              <%- postContent %>
            </div>
          <% } else { %>
            <p style="color: var(--color-text-muted); font-style: italic;">
              Konten lengkap artikel ini sedang dalam proses pembaruan oleh redaksi.
            </p>
          <% } %>
        </div>

        <!-- Back Link & Footer Actions -->
        <div class="flex items-center justify-between" style="margin-top: var(--space-xl); padding-top: var(--space-lg); border-top: 1px solid var(--color-border-subtle);">
          <a href="/news" class="btn btn-secondary btn-md" style="min-height: 44px; display: inline-flex; align-items: center;">
            &larr; <%= t('news.back_to_news') %>
          </a>
          <a href="/contact" class="btn btn-primary btn-md" style="min-height: 44px; display: inline-flex; align-items: center;">
            <%= t('home.cta_quote') %> &rarr;
          </a>
        </div>
      </div>

      <!-- Recent Articles Recommendation -->
      <% if (recentPosts && recentPosts.length > 0) { %>
        <div style="margin-top: var(--space-3xl); max-width: 820px; margin-left: auto; margin-right: auto; padding-top: var(--space-2xl); border-top: 1px solid var(--color-border-subtle);">
          <h2 style="font-size: 1.35rem; color: var(--color-secondary-navy); margin-bottom: var(--space-lg);">
            Publikasi Terkait Lainnya
          </h2>

          <div class="grid grid-cols-2 gap-lg">
            <% recentPosts.forEach(rec => { %>
              <%
                const recTitle = currentLangCode === 'en' ? (rec.title_en || rec.title_id) : rec.title_id;
                const recDate = rec.published_at ? new Date(rec.published_at).toLocaleDateString(currentLangCode === 'en' ? 'en-US' : 'id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
              %>
              <div class="card card-interactive">
                <div class="card-body">
                  <% if (recDate) { %>
                    <span style="font-size: var(--font-size-label-sm); color: var(--color-text-muted); display: block; margin-bottom: var(--space-xs);">
                      <%= recDate %>
                    </span>
                  <% } %>
                  <h3 style="font-size: 1.1rem; color: var(--color-secondary-navy); margin-bottom: var(--space-xs); line-height: 1.35;">
                    <a href="/news/<%= rec.slug %>" style="color: inherit; text-decoration: none;">
                      <%= recTitle %>
                    </a>
                  </h3>
                  <div style="margin-top: var(--space-sm);">
                    <a href="/news/<%= rec.slug %>" class="font-semibold text-primary" style="font-size: var(--font-size-label-sm); min-height: 44px; display: inline-flex; align-items: center;">
                      <%= t('common.read_more') %> &rarr;
                    </a>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </article>
</main>

<%- include('../partials/footer') %>

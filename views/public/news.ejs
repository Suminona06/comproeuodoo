<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main id="main-content">
  <section class="section section-bg-navy" style="padding-top: var(--space-2xl); padding-bottom: var(--space-2xl);">
    <div class="container">
      <span class="section-kicker">Wawasan & Informasi</span>
      <h1 style="color: #ffffff; margin-bottom: var(--space-sm);">Publikasi & Berita Industri</h1>
      <p style="color: #cbd5e1; max-width: 680px;">
        Kabar terbaru seputar inovasi manufaktur polimer, perkembangan operasional, dan kegiatan perusahaan.
      </p>
    </div>
  </section>

  <section class="section section-bg-workspace">
    <div class="container">
      <div class="grid grid-cols-2">
        <div class="card card-interactive">
          <div class="card-body">
            <span class="badge badge-info" style="margin-bottom: var(--space-sm);">Operasional</span>
            <h3>Peningkatan Efisiensi Energi Melalui Mesin Servo Injection Generasi Baru</h3>
            <p style="color: var(--color-text-muted); font-size: var(--font-size-body-sm); margin-top: var(--space-xs);">
              Komitmen kami dalam mengadopsi teknologi manufaktur ramah lingkungan dengan penghematan konsumsi daya listrik operasional.
            </p>
          </div>
        </div>

        <div class="card card-interactive">
          <div class="card-body">
            <span class="badge badge-success" style="margin-bottom: var(--space-sm);">Mutu & Kualitas</span>
            <h3>Penerapan Pengawasan Dimensi Optik Otomatis pada Lini Produksi</h3>
            <p style="color: var(--color-text-muted); font-size: var(--font-size-body-sm); margin-top: var(--space-xs);">
              Memastikan kepatuhan toleransi mikro untuk produk komponen otomotif secara real-time di pabrik.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>

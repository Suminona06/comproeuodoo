<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  const currentLangCode = currentLang || 'id';
  const buildQuery = (overridePage, overrideType, overrideCategory) => {
    const params = new URLSearchParams();
    const t = overrideType !== undefined ? overrideType : activeType;
    if (t && t !== 'all') params.set('type', t);
    const c = overrideCategory !== undefined ? overrideCategory : activeCategory;
    if (c) params.set('category', c);
    if (search) params.set('search', search);
    const p = overridePage !== undefined ? overridePage : currentPage;
    if (p && p > 1) params.set('page', p);
    const q = params.toString();
    return q ? '/news?' + q : '/news';
  };
  const heroObj = typeof heroBanner !== 'undefined' && heroBanner && heroBanner.is_active ? heroBanner : null;
  const userOpacity = heroObj && heroObj.overlay_opacity ? parseFloat(heroObj.overlay_opacity) : 0.50;
  const midOpacity = Math.min(0.72, 0.35 + (userOpacity * 0.40)).toFixed(2);
  const edgeOpacity = Math.max(0.08, (userOpacity * 0.35)).toFixed(2);
  const heroBg = heroObj && heroObj.image_url 
    ? `style="background-image: url('${heroObj.image_url}'); --hero-scrim-mid: ${midOpacity}; --hero-scrim-edge: ${edgeOpacity};"` 
    : '';
%>

<main id="main-content">
  <!-- Page Hero Header -->
  <section class="page-hero <%= heroObj && heroObj.image_url ? 'page-hero--has-bg' : '' %>" <%- heroBg %>>
    <% if (heroObj && heroObj.image_url) { %>
      <div class="page-hero-scrim" aria-hidden="true"></div>
    <% } %>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/"><%= t('nav.home') %></a>
        <span class="separator" aria-hidden="true">&rsaquo;</span>
        <span class="current"><%= t('nav.news') %></span>
      </nav>
      <div class="page-hero-content" style="max-width: 840px;">
        <h1 class="page-hero-title">
          <%= (heroObj && (currentLangCode === 'en' ? heroObj.title_en : heroObj.title_id))
              ? (currentLangCode === 'en' ? heroObj.title_en : heroObj.title_id)
              : t('news.page_title') %>
        </h1>
        <p class="page-hero-desc">
          <%= (heroObj && (currentLangCode === 'en' ? heroObj.subtitle_en : heroObj.subtitle_id))
              ? (currentLangCode === 'en' ? heroObj.subtitle_en : heroObj.subtitle_id)
              : t('news.page_subtitle') %>
        </p>
      <% if (heroObj && heroObj.cta_url && (currentLangCode === 'en' ? heroObj.cta_text_en : heroObj.cta_text_id)) { %>
        <div style="margin-top: 20px;">
          <a href="<%= heroObj.cta_url %>" class="btn btn-primary">
            <%= currentLangCode === 'en' ? heroObj.cta_text_en : heroObj.cta_text_id %>
          </a>
        </div>
      <% } %>
    </div>
  </section>

  <!-- News Content Section -->
  <section class="section" style="background-color: var(--bg-base, #ffffff); padding-top: var(--space-xl); padding-bottom: var(--space-3xl);">
    <div class="container">

      <%
        const headlinesList = (typeof headlinePosts !== 'undefined' && Array.isArray(headlinePosts) && headlinePosts.length > 0)
          ? headlinePosts
          : (typeof headlinePost !== 'undefined' && headlinePost ? [headlinePost] : []);
      %>
      <% if (headlinesList.length > 0 && currentPage === 1 && !search) { %>
        <section class="nwl-headline-sec" id="nwlHeadlineSec" aria-label="<%= currentLangCode === 'en' ? 'Featured News' : 'Berita Utama' %>">
          <h2 class="nwl-headline-sec-title"><%= currentLangCode === 'en' ? 'News' : 'Berita' %></h2>

          <div class="nwl-headline-slider" id="nwlHeadlineSlider" role="region" aria-roledescription="carousel">
            <div class="nwl-slider-track" id="nwlSliderTrack">
              <% headlinesList.forEach((hl, idx) => { %>
                <%
                  const hlTitle = currentLangCode === 'en' ? (hl.title_en || hl.title_id) : hl.title_id;
                  const hlExcerpt = currentLangCode === 'en' ? (hl.excerpt_en || hl.excerpt_id) : hl.excerpt_id;
                  const hlDate = hl.published_at ? new Date(hl.published_at).toLocaleDateString(currentLangCode === 'en' ? 'en-US' : 'id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
                  const isHlPlaceholder = !(hl.cover_image && hl.cover_image.trim());
                  const hlImage = isHlPlaceholder ? '/uploads/media/media-1792035656935-732682512.webp' : hl.cover_image.trim();
                %>
                <div class="nwl-slide <%= idx === 0 ? 'active' : '' %>" data-slide-index="<%= idx %>" role="group" aria-roledescription="slide" aria-label="<%= (idx + 1) + ' / ' + headlinesList.length %>" <%= idx !== 0 ? 'aria-hidden="true"' : '' %>>
                  <div class="nwl-slide-grid">
                    <div class="nwl-slide-media<%= isHlPlaceholder ? ' nwl-slide-media-placeholder' : '' %>">
                      <img src="<%= hlImage %>" alt="<%= hlTitle %>" loading="<%= idx === 0 ? 'eager' : 'lazy' %>" class="<%= isHlPlaceholder ? 'nwl-img-placeholder' : '' %>" onerror="this.onerror=null;this.src='/uploads/media/media-1792035656935-732682512.webp';this.classList.add('nwl-img-placeholder');this.parentElement.classList.add('nwl-slide-media-placeholder');">
                    </div>
                    <div class="nwl-slide-content">
                      <% if (hlDate) { %>
                        <time datetime="<%= hl.published_at %>" class="nwl-slide-date">
                          <%= hlDate %>
                        </time>
                      <% } %>
                      <h3 class="nwl-slide-title">
                        <a href="/news/<%= hl.slug %>" class="nwl-slide-title-link" <%= idx !== 0 ? 'tabindex="-1"' : '' %>>
                          <%= hlTitle %>
                        </a>
                      </h3>
                      <% if (hlExcerpt) { %>
                        <p class="nwl-slide-excerpt">
                          <%= hlExcerpt %>
                        </p>
                      <% } %>
                      <div class="nwl-slide-action">
                        <a href="/news/<%= hl.slug %>" class="nwl-slide-link" <%= idx !== 0 ? 'tabindex="-1"' : '' %>>
                          <span><%= currentLangCode === 'en' ? 'Read more' : 'Baca selengkapnya' %></span>
                          <span aria-hidden="true">&rarr;</span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>

            <% if (headlinesList.length > 1) { %>
              <div class="nwl-slider-controls">
                <div class="nwl-slider-indicators" role="tablist" aria-label="Slide indicators">
                  <% headlinesList.forEach((_, idx) => { %>
                    <button type="button" class="nwl-indicator-bar <%= idx === 0 ? 'active' : '' %>" data-slide-to="<%= idx %>" role="tab" aria-selected="<%= idx === 0 %>" aria-label="Slide <%= idx + 1 %>"></button>
                  <% }); %>
                </div>
                <div class="nwl-slider-arrows">
                  <button type="button" class="nwl-arrow-btn nwl-arrow-prev" id="nwlPrevBtn" aria-label="<%= currentLangCode === 'en' ? 'Previous slide' : 'Slide sebelumnya' %>">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                  </button>
                  <button type="button" class="nwl-arrow-btn nwl-arrow-next" id="nwlNextBtn" aria-label="<%= currentLangCode === 'en' ? 'Next slide' : 'Slide berikutnya' %>">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </button>
                </div>
              </div>
            <% } %>
          </div>
        </section>
        <% if (headlinesList.length > 1) { %>
          <script>
            (function() {
              var slider = document.getElementById('nwlHeadlineSlider');
              if (!slider) return;
              var slides = slider.querySelectorAll('.nwl-slide');
              var indicators = slider.querySelectorAll('.nwl-indicator-bar');
              var prevBtn = document.getElementById('nwlPrevBtn');
              var nextBtn = document.getElementById('nwlNextBtn');
              if (slides.length <= 1) return;

              var currentIndex = 0;
              var totalSlides = slides.length;
              var isTransitioning = false;
              var isPaused = false;
              var timer = null;

              function goToSlide(targetIndex) {
                if (isTransitioning) return;
                var normalized = (targetIndex % totalSlides + totalSlides) % totalSlides;
                if (normalized === currentIndex) return;
                isTransitioning = true;

                slides[currentIndex].classList.remove('active');
                slides[currentIndex].setAttribute('aria-hidden', 'true');
                var prevLinks = slides[currentIndex].querySelectorAll('a, button');
                for (var i = 0; i < prevLinks.length; i++) {
                  prevLinks[i].setAttribute('tabindex', '-1');
                }
                if (indicators[currentIndex]) {
                  indicators[currentIndex].classList.remove('active');
                  indicators[currentIndex].setAttribute('aria-selected', 'false');
                }

                currentIndex = normalized;

                slides[currentIndex].classList.add('active');
                slides[currentIndex].removeAttribute('aria-hidden');
                var nextLinks = slides[currentIndex].querySelectorAll('a, button');
                for (var j = 0; j < nextLinks.length; j++) {
                  nextLinks[j].removeAttribute('tabindex');
                }
                if (indicators[currentIndex]) {
                  indicators[currentIndex].classList.add('active');
                  indicators[currentIndex].setAttribute('aria-selected', 'true');
                }

                setTimeout(function() {
                  isTransitioning = false;
                }, 400);
              }

              function startTimer() {
                if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                  return;
                }
                stopTimer();
                timer = setInterval(function() {
                  if (!isPaused) {
                    goToSlide(currentIndex + 1);
                  }
                }, 6000);
              }

              function stopTimer() {
                if (timer) {
                  clearInterval(timer);
                  timer = null;
                }
              }

              function resetTimer() {
                stopTimer();
                startTimer();
              }

              if (nextBtn) {
                nextBtn.addEventListener('click', function() {
                  goToSlide(currentIndex + 1);
                  resetTimer();
                });
              }

              if (prevBtn) {
                prevBtn.addEventListener('click', function() {
                  goToSlide(currentIndex - 1);
                  resetTimer();
                });
              }

              for (var k = 0; k < indicators.length; k++) {
                (function(idx) {
                  indicators[idx].addEventListener('click', function() {
                    goToSlide(idx);
                    resetTimer();
                  });
                })(k);
              }

              slider.addEventListener('mouseenter', function() { isPaused = true; });
              slider.addEventListener('mouseleave', function() { isPaused = false; });
              slider.addEventListener('focusin', function() { isPaused = true; });
              slider.addEventListener('focusout', function() { isPaused = false; });

              slider.addEventListener('keydown', function(e) {
                if (e.key === 'ArrowLeft') {
                  e.preventDefault();
                  goToSlide(currentIndex - 1);
                  resetTimer();
                } else if (e.key === 'ArrowRight') {
                  e.preventDefault();
                  goToSlide(currentIndex + 1);
                  resetTimer();
                }
              });

              var touchStartX = 0;
              var touchStartY = 0;
              slider.addEventListener('touchstart', function(e) {
                if (e.touches && e.touches.length > 0) {
                  touchStartX = e.touches[0].clientX;
                  touchStartY = e.touches[0].clientY;
                }
              }, { passive: true });

              slider.addEventListener('touchend', function(e) {
                if (e.changedTouches && e.changedTouches.length > 0) {
                  var deltaX = e.changedTouches[0].clientX - touchStartX;
                  var deltaY = e.changedTouches[0].clientY - touchStartY;
                  if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
                    if (deltaX < 0) {
                      goToSlide(currentIndex + 1);
                    } else {
                      goToSlide(currentIndex - 1);
                    }
                    resetTimer();
                  }
                }
              }, { passive: true });

              startTimer();
            })();
          </script>
        <% } %>
      <% } %>

      <div class="nwl-tab-bar" role="tablist" aria-label="Tipe Publikasi">
        <a href="<%= buildQuery(1, 'all', null) %>"
           class="nwl-tab-item <%= activeType === 'all' ? 'active' : '' %>"
           role="tab"
           aria-selected="<%= activeType === 'all' %>"
           data-type="all">
          <%= currentLangCode === 'en' ? 'All Publications' : 'Semua Publikasi' %>
        </a>
        <a href="<%= buildQuery(1, 'berita', null) %>"
           class="nwl-tab-item <%= activeType === 'berita' ? 'active' : '' %>"
           role="tab"
           aria-selected="<%= activeType === 'berita' %>"
           data-type="berita">
          <%= currentLangCode === 'en' ? 'Corporate News' : 'Berita Perusahaan' %>
        </a>
        <a href="<%= buildQuery(1, 'pers', null) %>"
           class="nwl-tab-item <%= activeType === 'pers' ? 'active' : '' %>"
           role="tab"
           aria-selected="<%= activeType === 'pers' %>"
           data-type="pers">
          <%= currentLangCode === 'en' ? 'Press Releases' : 'Siaran Pers' %>
        </a>
        <a href="<%= buildQuery(1, 'blog', null) %>"
           class="nwl-tab-item <%= activeType === 'blog' ? 'active' : '' %>"
           role="tab"
           aria-selected="<%= activeType === 'blog' %>"
           data-type="blog">
          <% if (currentLangCode === 'en') { %>Articles & Blog<% } else { %>Artikel & Blog<% } %>
        </a>
      </div>

      <div class="nwl-filter-row">
        <div class="nwl-cat-pills" id="nwlCatPills" role="navigation" aria-label="<%= currentLangCode === 'en' ? 'Topics' : 'Topik' %>">
          <a href="<%= buildQuery(1, activeType, null) %>"
             class="nwl-cat-pill <%= !activeCategory ? 'active' : '' %>"
             data-category="">
            <%= currentLangCode === 'en' ? 'All' : 'Semua' %>
          </a>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <% const catName = currentLangCode === 'en' ? (cat.name_en || cat.name_id) : cat.name_id; %>
              <a href="<%= buildQuery(1, activeType, cat.slug) %>"
                 class="nwl-cat-pill <%= activeCategory === cat.slug ? 'active' : '' %>"
                 data-category="<%= cat.slug %>">
                <%= catName %>
              </a>
            <% }); %>
          <% } %>
        </div>

        <form action="/news" method="GET" class="nwl-search-form" id="newsSearchForm" role="search">
          <input type="hidden" name="type" id="newsSearchType" value="<%= activeType %>">
          <input type="hidden" name="category" id="newsSearchCategory" value="<%= activeCategory || '' %>">
          <div class="nwl-search-input-wrap">
            <input type="search"
                   name="search"
                   id="newsSearchInput"
                   class="nwl-search-input"
                   value="<%= search || '' %>"
                   placeholder="<%= currentLangCode === 'en' ? 'Search articles...' : 'Cari artikel...' %>"
                   aria-label="<%= currentLangCode === 'en' ? 'Search articles' : 'Cari artikel publikasi' %>">
            <button type="submit" class="nwl-search-btn" aria-label="<%= currentLangCode === 'en' ? 'Submit search' : 'Kirim pencarian' %>">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
          </div>
          <a href="<%= buildQuery(1, activeType, activeCategory).replace(/[?&]search=[^&]*/, '') %>"
             class="nwl-search-reset"
             id="newsSearchReset"
             <%= search ? '' : 'hidden' %>
             title="<%= currentLangCode === 'en' ? 'Reset search' : 'Hapus pencarian' %>">
            Reset
          </a>
        </form>
      </div>

      <div class="nwl-grid-wrapper" id="newsGridWrapper" data-lang="<%= currentLangCode %>">
        <div class="nwl-grid" id="newsGrid" <%= (!posts || posts.length === 0) ? 'hidden' : '' %>>
          <% if (posts && posts.length > 0) { %>
            <% posts.forEach(post => { %>
              <%- include('../partials/news-card', { post, currentLangCode }) %>
            <% }); %>
          <% } %>
        </div>

        <nav class="pagination-bar" id="newsPagination" aria-label="Navigasi Halaman Berita" <%= (posts && posts.length > 0 && totalPages > 1) ? '' : 'hidden' %>>
          <% if (posts && posts.length > 0 && totalPages > 1) { %>
            <% if (currentPage > 1) { %>
              <a href="<%= buildQuery(currentPage - 1) %>"
                 class="pagination-item"
                 data-page="<%= currentPage - 1 %>"
                 aria-label="Halaman Sebelumnya">
                &larr; <%= t('common.previous') %>
              </a>
            <% } else { %>
              <span class="pagination-item disabled" aria-disabled="true">
                &larr; <%= t('common.previous') %>
              </span>
            <% } %>

            <% for (let p = 1; p <= totalPages; p++) { %>
              <% if (p === currentPage) { %>
                <span class="pagination-item active" aria-current="page"><%= p %></span>
              <% } else if (p === 1 || p === totalPages || (p >= currentPage - 2 && p <= currentPage + 2)) { %>
                <a href="<%= buildQuery(p) %>" class="pagination-item" data-page="<%= p %>"><%= p %></a>
              <% } else if (p === currentPage - 3 || p === currentPage + 3) { %>
                <span class="pagination-item disabled">...</span>
              <% } %>
            <% } %>

            <% if (currentPage < totalPages) { %>
              <a href="<%= buildQuery(currentPage + 1) %>"
                 class="pagination-item"
                 data-page="<%= currentPage + 1 %>"
                 aria-label="Halaman Berikutnya">
                <%= t('common.next') %> &rarr;
              </a>
            <% } else { %>
              <span class="pagination-item disabled" aria-disabled="true">
                <%= t('common.next') %> &rarr;
              </span>
            <% } %>
          <% } %>
        </nav>

        <div class="nwl-empty-state" id="newsEmptyState" <%= (!posts || posts.length === 0) ? '' : 'hidden' %>>
          <div class="nwl-empty-icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h3 class="nwl-empty-title">
            <%= t('news.empty_posts') %>
          </h3>
          <p class="nwl-empty-desc">
            <%= currentLangCode === 'en' ? 'No articles match your selected filter criteria.' : 'Tidak ditemukan artikel atau publikasi yang cocok dengan kriteria filter yang Anda pilih.' %>
          </p>
          <a href="/news" class="nwl-empty-reset-btn" id="nwlEmptyResetBtn">
            <%= currentLangCode === 'en' ? 'View All Publications' : 'Lihat Semua Publikasi' %>
          </a>
        </div>
      </div>

    </div>
  </section>
  <script src="/js/news-filter.js" defer></script>
</main>

<%- include('../partials/footer') %>

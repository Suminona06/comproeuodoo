<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  const lang = typeof currentLang !== 'undefined' ? currentLang : 'id';
  const prodName = lang === 'en' ? (product.name_en || product.name_id) : product.name_id;
  const prodDesc = lang === 'en' ? (product.description_en || product.description_id) : product.description_id;
  const catName = lang === 'en' ? (product.category_name_en || product.category_name_id || 'Industrial') : (product.category_name_id || 'Industri');
  const catSlug = product.category_slug || '';
  const mainImage = product.main_image || product.image_url || '/images/products/retail-softloop.webp';
  
  // Gallery images array
  let gallery = [];
  if (Array.isArray(product.images) && product.images.length > 0) {
    gallery = product.images;
  } else if (mainImage) {
    gallery = [mainImage];
  }

  // Variants array
  const variants = Array.isArray(product.variants) ? product.variants : [];

  // Specifications
  const specs = typeof product.specifications === 'object' && product.specifications !== null ? product.specifications : {};

  // WhatsApp CTA message
  const waNumber = (typeof settings !== 'undefined' && settings?.whatsapp_formatted_number)
    ? settings.whatsapp_formatted_number
    : (settings?.whatsapp_number ? settings.whatsapp_number.replace(/[^0-9]/g, '') : '628123456789');
  const prodUrl = typeof canonicalUrl !== 'undefined' ? canonicalUrl : `https://euodoo.com/products/${product.slug || product.id}`;
  const waMessage = `Halo PT Euodoo, saya tertarik dengan produk ${prodName}. Detail: ${prodUrl}`;
  const waQuoteUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`;
%>

<main id="main-content">
  <!-- PAGE HERO BREADCRUMB -->
  <section class="page-hero" style="padding-bottom: 40px;">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/"><%= lang === 'en' ? 'Home' : 'Beranda' %></a>
        <span>&rsaquo;</span>
        <a href="/products"><%= lang === 'en' ? 'Products' : 'Produk' %></a>
        <% if (catName) { %>
          <span>&rsaquo;</span>
          <a href="/products?category=<%= catSlug %>"><%= catName %></a>
        <% } %>
        <span>&rsaquo;</span>
        <span style="color: var(--sky, #38bdf8);"><%= prodName %></span>
      </nav>

      <span class="brands-kicker" style="color: var(--sky, #38bdf8); margin-bottom: 8px;">
        <%= catName.toUpperCase() %>
      </span>
      <h1 class="page-hero-title" style="margin-bottom: 0;">
        <%= prodName %>
      </h1>
    </div>
  </section>

  <!-- PRODUCT SHOWCASE SECTION -->
  <section style="background: var(--workspace, #f8fafc); padding: 56px 0 96px;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1.15fr; gap: 48px; align-items: start;" class="intro-layout">
        <!-- LEFT: Media & Photo Gallery -->
        <div>
          <div style="background: #ffffff; border: 1px solid var(--border, #e2e8f0); border-radius: var(--r-xl, 12px); overflow: hidden; box-shadow: var(--shadow-1);">
            <div style="height: 420px; background: var(--container-light, #f1f5f9); display: flex; align-items: center; justify-content: center; position: relative;">
              <img id="mainProductPhoto"
                   src="<%= mainImage %>"
                   alt="<%= prodName %>"
                   style="width: 100%; height: 100%; object-fit: contain; padding: 16px;"
                   fetchpriority="high">
              <span class="media-overlay-pill" style="top: 16px; left: 16px; bottom: auto; right: auto;">
                <%= catName %>
              </span>
            </div>

            <!-- Thumbnail Selector -->
            <% if (gallery.length > 1) { %>
              <div style="display: flex; gap: 10px; padding: 16px; border-top: 1px solid var(--border, #e2e8f0); overflow-x: auto; background: #ffffff;">
                <% gallery.forEach((img, i) => { %>
                  <button type="button"
                          onclick="selectProductImage('<%= img %>')"
                          style="width: 64px; height: 64px; border: 2px solid var(--border, #e2e8f0); border-radius: var(--r-md, 6px); overflow: hidden; padding: 0; background: #ffffff; cursor: pointer; flex-shrink: 0;"
                          aria-label="Foto <%= i + 1 %>">
                    <img src="<%= img %>" alt="Thumbnail <%= i + 1 %>" style="width: 100%; height: 100%; object-fit: cover;">
                  </button>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- RIGHT: Product Information, Specs & Actions -->
        <div>
          <div style="margin-bottom: 24px;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
              <span class="bento-badge bento-badge-blue" style="margin-bottom: 0;">
                <%= catName %>
              </span>
              <span class="brand-reg-tag" style="background: var(--success-bg, #dcfce7); color: var(--success, #16a34a);">
                SNI &amp; ISO CERTIFIED
              </span>
            </div>
            
            <h2 style="font-size: clamp(1.75rem, 2.5vw, 2.25rem); font-weight: 800; color: var(--navy, #0a192f); line-height: 1.25; margin-bottom: 16px;">
              <%= prodName %>
            </h2>
            
            <p style="font-size: 15.5px; color: var(--text-variant, #424753); line-height: 1.7; margin-bottom: 28px;">
              <%= prodDesc || 'Kantong plastik berkualitas tinggi dari lini ekstrusi presisi PT. EUODOO untuk kebutuhan kemasan komersial dan industri.' %>
            </p>
          </div>

          <!-- Product Variants Selector (Pills) -->
          <% if (variants.length > 0) { %>
            <div style="margin-bottom: 32px; background: #ffffff; border: 1px solid var(--border, #e2e8f0); border-radius: var(--r-lg, 8px); padding: 20px;">
              <div style="font-size: 13px; font-weight: 700; color: var(--navy, #0a192f); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">
                <%= lang === 'en' ? 'Available Product Variants' : 'Pilihan Varian & Ukuran' %>
              </div>
              <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                <% variants.forEach((v, idx) => { 
                  const vLabel = v.name || v.size || (typeof v === 'string' ? v : `Varian ${idx + 1}`);
                  const vSpec = v.thickness ? ` (${v.thickness})` : '';
                %>
                  <button type="button"
                          class="pill-filter <%= idx === 0 ? 'active' : '' %>"
                          onclick="selectVariant(this, '<%= vLabel %><%= vSpec %>')"
                          style="cursor: pointer; font-size: 13px;">
                    <%= vLabel %><%= vSpec %>
                  </button>
                <% }); %>
              </div>
              <div id="selectedVariantNotice" style="margin-top: 12px; font-size: 12px; color: var(--text-muted, #64748b);">
                <%= lang === 'en' ? 'Selected variant:' : 'Varian terpilih:' %> <strong style="color: var(--primary, #0055b8);"><%= variants[0]?.name || variants[0]?.size || 'Standar Manufaktur' %></strong>
              </div>
            </div>
          <% } %>

          <!-- Technical Specifications Table (.spec-table) -->
          <div style="margin-bottom: 36px;">
            <div style="font-size: 13px; font-weight: 700; color: var(--navy, #0a192f); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">
              <%= lang === 'en' ? 'Technical Specifications' : 'Spesifikasi Teknis Manufaktur' %>
            </div>
            <div class="spec-table-wrap">
              <table class="spec-table">
                <tbody>
                  <tr>
                    <th style="width: 40%;"><%= lang === 'en' ? 'Material Grade' : 'Material Utama' %></th>
                    <td><%= specs.material || 'HDPE / LLDPE Virgin Resin Grade' %></td>
                  </tr>
                  <tr>
                    <th><%= lang === 'en' ? 'Degradability Standard' : 'Standar Ramah Lingkungan' %></th>
                    <td><%= specs.eco || 'OXIUM® Oxo-Biodegradable (SNI 7188.7:2011)' %></td>
                  </tr>
                  <tr>
                    <th><%= lang === 'en' ? 'Thickness Range' : 'Kisaran Ketebalan' %></th>
                    <td><%= specs.thickness || '15 mikron s/d 100 mikron (Customizable)' %></td>
                  </tr>
                  <tr>
                    <th><%= lang === 'en' ? 'Sealing & Strength' : 'Tipe Segel & Kekuatan' %></th>
                    <td><%= specs.sealing || 'Star-Seal / Bottom-Seal Anti Bocor (Drop-test teruji)' %></td>
                  </tr>
                  <tr>
                    <th><%= lang === 'en' ? 'Printing Capability' : 'Opsi Cetak Logo' %></th>
                    <td><%= specs.printing || 'Flexographic Printing s/d 6 warna presisi tinggi' %></td>
                  </tr>
                  <tr>
                    <th><%= lang === 'en' ? 'Minimum Order Quantity (MOQ)' : 'Kuantitas Minimum (MOQ)' %></th>
                    <td><%= lang === 'en' ? 'Custom B2B wholesale volume based on specification' : 'Sesuai pesanan industri & kesepakatan B2B' %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- STRICT COMPLIANCE: NO PRICE DISPLAYED -->
          <!-- Primary CTA: WhatsApp Quote Link & Sales Form Link -->
          <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
            <a href="<%= waQuoteUrl %>"
               target="_blank"
               rel="noopener noreferrer"
               class="btn-primary"
               style="padding: 14px 28px; font-size: 15px; border-radius: var(--r-pill, 9999px); display: inline-flex; align-items: center; gap: 10px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
              <span><%= lang === 'en' ? 'Request Quote via WhatsApp' : 'Minta Penawaran via WhatsApp' %></span>
            </a>

            <a href="/contact?product=<%= product.id %>"
               class="btn-secondary"
               style="padding: 14px 28px; font-size: 15px; border-radius: var(--r-pill, 9999px);">
              <%= lang === 'en' ? 'Submit RFQ Form' : 'Kirim Formulir Penawaran' %>
            </a>
          </div>
        </div>
      </div>

      <!-- RELATED PRODUCTS SECTION (Symmetrical Grid) -->
      <% if (relatedProducts && relatedProducts.length > 0) { %>
        <div style="margin-top: 80px; padding-top: 56px; border-top: 1px solid var(--border, #e2e8f0);">
          <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
            <div>
              <span class="brands-kicker"><%= lang === 'en' ? 'RELATED PACKAGING' : 'REKOMENDASI PRODUK' %></span>
              <h2 style="font-size: 1.75rem; font-weight: 700; color: var(--navy, #0a192f); margin-top: 4px;">
                <%= lang === 'en' ? 'Related Products You May Need' : 'Produk Terkait Lainnya' %>
              </h2>
            </div>
            <a href="/products?category=<%= catSlug %>" class="btn-secondary" style="padding: 8px 20px; font-size: 13px;">
              <%= lang === 'en' ? 'View Full Category' : 'Lihat Seluruh Kategori' %> &rarr;
            </a>
          </div>

          <div class="bento-grid">
            <% relatedProducts.forEach((rel, idx) => { 
              const relName = lang === 'en' ? (rel.name_en || rel.name_id) : rel.name_id;
              const relDesc = lang === 'en' ? (rel.description_en || rel.description_id) : rel.description_id;
              const relImg = rel.image_url || rel.main_image || `/images/products/prod-${(idx % 4) + 1}.webp`;
            %>
              <article class="bento-col-6">
                <a href="/products/<%= rel.slug || rel.id %>" class="bento-card" aria-label="Lihat detail <%= relName %>">
                  <div class="bento-split">
                    <div class="bento-split-content">
                      <div>
                        <div class="bento-badge bento-badge-blue">
                          <%= rel.category_name_id || 'PRODUK TERKAIT' %>
                        </div>
                        <h3 class="bento-card-title"><%= relName %></h3>
                        <p class="bento-card-desc">
                          <%= relDesc ? (relDesc.length > 100 ? relDesc.substring(0, 100) + '...' : relDesc) : 'Pilihan kemasan berkualitas tinggi bersertifikasi SNI.' %>
                        </p>
                      </div>

                      <div class="bento-card-footer">
                        <span class="bento-card-link">
                          <%= lang === 'en' ? 'Details' : 'Lihat Detail' %>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </span>
                        <span class="bento-meta-badge">B2B Order</span>
                      </div>
                    </div>

                    <div class="bento-split-media">
                      <img src="<%= relImg %>" alt="<%= relName %>" loading="lazy">
                    </div>
                  </div>
                </a>
              </article>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </section>
</main>

<script>
  function selectProductImage(url) {
    var main = document.getElementById('mainProductPhoto');
    if (main && url) {
      main.src = url;
    }
  }

  function selectVariant(btn, name) {
    var parent = btn.parentElement;
    if (parent) {
      parent.querySelectorAll('.pill-filter').forEach(function(el) {
        el.classList.remove('active');
      });
      btn.classList.add('active');
    }
    var notice = document.getElementById('selectedVariantNotice');
    if (notice) {
      notice.innerHTML = '<%= lang === "en" ? "Selected variant:" : "Varian terpilih:" %> <strong style="color: var(--primary, #0055b8);">' + name + '</strong>';
    }
  }
</script>

<%- include('../partials/footer') %>

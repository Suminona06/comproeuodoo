<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main id="main-content">
  <!-- Hero Section -->
  <section class="section section-bg-navy" style="padding-top: var(--space-3xl); padding-bottom: var(--space-3xl);">
    <div class="container">
      <div class="grid" style="align-items: center;">
        <div class="col-span-full" style="max-width: 840px;">
          <span class="section-kicker">Manufaktur Plastik Presisi Tinggi</span>
          <h1 style="margin-bottom: var(--space-md); color: #ffffff;">
            Solusi Rekayasa Komponen dan Kemasan Plastik Industri Berstandar Internasional
          </h1>
          <p style="font-size: var(--font-size-body-lg); line-height: 1.6; margin-bottom: var(--space-xl); color: #cbd5e1;">
            PT Euodoo memproduksi komponen presisi dengan teknologi injection molding dan blow molding modern untuk kebutuhan sektor otomotif, kemasan industri, kosmetik, dan barang konsumen.
          </p>
          <div class="flex flex-wrap gap-md">
            <a href="/contact" class="btn btn-primary btn-lg">Konsultasikan Kebutuhan</a>
            <a href="/products" class="btn btn-outline-white btn-lg">Lihat Katalog Produk</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industrial Pillars / Capabilities Preview -->
  <section class="section section-bg-workspace">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-kicker">Fondasi Kualitas</span>
        <h2>Keunggulan Rekayasa & Keandalan Produksi</h2>
        <p>
          Dedikasi kami berfokus pada toleransi dimensi yang ketat, ketahanan material, serta efisiensi rantai pasok industri.
        </p>
      </div>

      <div class="grid grid-cols-3">
        <!-- Pillar 1 -->
        <div class="card card-interactive">
          <div class="card-body">
            <span class="badge badge-primary" style="margin-bottom: var(--space-md);">Pilar 01</span>
            <h3 style="font-size: 1.25rem; margin-bottom: var(--space-sm);">Presisi Cetakan Mikro</h3>
            <p style="font-size: var(--font-size-body-sm); color: var(--color-text-muted);">
              Dukungan fasilitas tooling dan mesin injection multi-cavity memastikan akurasi dimensi komponen hingga satuan milimeter terkecil.
            </p>
            <div style="margin-top: var(--space-md);">
              <a href="/capabilities" class="font-semibold text-primary" style="font-size: var(--font-size-label-lg);">Pelajari Kapabilitas Mesin &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Pillar 2 -->
        <div class="card card-interactive">
          <div class="card-body">
            <span class="badge badge-primary" style="margin-bottom: var(--space-md);">Pilar 02</span>
            <h3 style="font-size: 1.25rem; margin-bottom: var(--space-sm);">Material Polimer Unggul</h3>
            <p style="font-size: var(--font-size-body-sm); color: var(--color-text-muted);">
              Pemilihan biji plastik murni kualitas tinggi (PP, PE, HDPE, PET, ABS) yang ramah lingkungan dan memenuhi standar sertifikasi industri.
            </p>
            <div style="margin-top: var(--space-md);">
              <a href="/products" class="font-semibold text-primary" style="font-size: var(--font-size-label-lg);">Eksplorasi Varian Material &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Pillar 3 -->
        <div class="card card-interactive">
          <div class="card-body">
            <span class="badge badge-primary" style="margin-bottom: var(--space-md);">Pilar 03</span>
            <h3 style="font-size: 1.25rem; margin-bottom: var(--space-sm);">Kapasitas Skala Masal</h3>
            <p style="font-size: var(--font-size-body-sm); color: var(--color-text-muted);">
              Operasional lini produksi terstruktur 24/7 dengan manajemen logistik terintegrasi untuk menjamin pengiriman tepat waktu bagi mitra B2B.
            </p>
            <div style="margin-top: var(--space-md);">
              <a href="/contact" class="font-semibold text-primary" style="font-size: var(--font-size-label-lg);">Minta Jadwal Produksi &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Banner -->
  <section class="section section-bg-white">
    <div class="container">
      <div class="flex flex-col items-center text-center" style="max-width: 760px; margin: 0 auto;">
        <span class="section-kicker">Kemitraan Industri</span>
        <h2 style="margin-bottom: var(--space-sm);">Mulai Konsultasi Teknis & Penawaran Kebutuhan Anda</h2>
        <p style="margin-bottom: var(--space-lg);">
          Tim ahli cetakan plastik kami siap membantu mengevaluasi desain cetakan, spesifikasi material, serta perkiraan efisiensi biaya proyek Anda.
        </p>
        <div class="flex flex-wrap gap-md justify-center">
          <a href="/contact" class="btn btn-primary btn-md">Kirimkan Permintaan Penawaran (RFQ)</a>
          <a href="/products" class="btn btn-secondary btn-md">Lihat Semua Kategori Produk</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>

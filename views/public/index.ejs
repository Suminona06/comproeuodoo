<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main id="main-content">
  <%- include('../partials/home/hero-slider', { hero: homeView.hero }) %>
  <% if (homeView.intro.isActive) { %>
    <%- include('../partials/home/intro', { intro: homeView.intro }) %>
  <% } %>
  <% if (homeView.categories.isVisible) { %>
    <%- include('../partials/home/categories', { categories: homeView.categories }) %>
  <% } %>
  <% if (homeView.whyChooseUs.isActive) { %>
    <%- include('../partials/home/why-choose-us', { whyChooseUs: homeView.whyChooseUs }) %>
  <% } %>
  <% if (homeView.certifications.isActive) { %>
    <%- include('../partials/home/certifications', { certifications: homeView.certifications }) %>
  <% } %>
  <% if (homeView.brands.isVisible) { %>
    <%- include('../partials/home/brands-marquee', { brands: homeView.brands }) %>
  <% } %>
  <%- include('../partials/home/news', { news: homeView.news }) %>
</main>

<script src="/js/home.js" defer></script>
<script src="/js/home-news-carousel.js" defer></script>
<%- include('../partials/footer') %>

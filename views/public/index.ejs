<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main id="main-content">
  <!-- 1. SECTION HERO 90vh (Exact Prototype v2 Architecture) -->
  <% 
    const primaryBanner = (typeof banners !== 'undefined' && banners.length > 0) ? banners[0] : null; 
    const heroTitle = primaryBanner 
      ? (currentLang === 'en' ? (primaryBanner.title_en || primaryBanner.title_id) : primaryBanner.title_id)
      : (currentLang === 'en' ? 'Leading Eco-Friendly HDPE & LLDPE Plastic Bag Manufacturer' : 'Solusi Manufaktur Kantong Plastik HDPE & LLDPE Ramah Lingkungan');
    const heroCaption = primaryBanner
      ? (currentLang === 'en' ? (primaryBanner.caption_en || primaryBanner.caption_id) : primaryBanner.caption_id)
      : (currentLang === 'en' ? 'Serving national modern retail networks, industrial partners, and wholesale markets with certified 100% oxo-biodegradable formulation since 1990.' : 'Melayani jaringan ritel modern, mitra industri, dan pasar grosir nasional dengan formulasi 100% degradable berstandar SNI sejak 1990.');
    const heroCtaText = primaryBanner && (primaryBanner.cta_text_id || primaryBanner.cta_text_en)
      ? (currentLang === 'en' ? (primaryBanner.cta_text_en || primaryBanner.cta_text_id) : primaryBanner.cta_text_id)
      : (currentLang === 'en' ? 'Request a Quote' : 'Minta Penawaran');
    const heroCtaUrl = primaryBanner && primaryBanner.cta_url ? primaryBanner.cta_url : '/contact';
    const heroMediaUrl = primaryBanner && (primaryBanner.image_url || primaryBanner.file_url) ? (primaryBanner.image_url || primaryBanner.file_url) : '/images/hero-factory.jpg';
    const isVideoBanner = primaryBanner && primaryBanner.media_type === 'video' && (primaryBanner.video_url || primaryBanner.file_url);
  %>
  <section class="hero" id="hero">
    <div class="hero-bg">
      <% if (isVideoBanner) { %>
        <video autoplay muted loop playsinline preload="metadata" poster="<%= primaryBanner.poster_url || '/images/hero-factory.jpg' %>">
          <source src="<%= primaryBanner.video_url || primaryBanner.file_url %>" type="video/mp4">
        </video>
      <% } else { %>
        <img src="<%= heroMediaUrl %>" alt="Pabrik Manufaktur PT. EUODOO Bandung" fetchpriority="high">
      <% } %>
      <div class="hero-grad"></div>
    </div>

    <div class="hero-content">
      <div class="hero-inner">
        <div class="hero-welcome">
          <%= currentLang === 'en' ? 'WELCOME TO PT. EUODOO' : 'SELAMAT DATANG DI PT. EUODOO' %>
        </div>
        <h1><%= heroTitle %></h1>
        <p class="hero-body"><%= heroCaption %></p>
        <div class="hero-actions">
          <a href="<%= heroCtaUrl %>" class="btn-pill-solid-white">
            <%= heroCtaText %>
          </a>
          <a href="/about" class="btn-pill-white">
            <%= currentLang === 'en' ? 'Learn More' : 'Lihat Detail' %>
          </a>
        </div>
      </div>
    </div>

    <div class="hero-explore-indicator" aria-hidden="true">
      <span class="hero-explore-text">EXPLORE MORE</span>
      <span class="hero-explore-line"></span>
    </div>
  </section>

  <!-- 2. SECTION COMPANY INTRO -->
  <section class="sec-intro" id="intro">
    <div class="container">
      <div class="intro-layout reveal">
        <h2>
          <%= currentLang === 'en' ? 'Over Three Decades of Plastic Film Manufacturing Excellence' : 'Dedikasi Manufaktur Plastik Berkualitas Sejak 1990' %>
        </h2>
        <div>
          <p style="margin-bottom: 16px;">
            <%= currentLang === 'en' 
                ? 'Since our founding in 1990 in Bandung, West Java (originating from PT Sahabat Baru and PT Pelita Baru), PT EUODOO has been producing high-grade HDPE and LLDPE plastic bags for modern retail chains, traditional wholesale hubs, and industrial sectors.'
                : 'Sejak berdiri pada tahun 1990 di Bandung, Jawa Barat (bermula dari PT Sahabat Baru dan PT Pelita Baru), PT EUODOO telah memproduksi kantong plastik HDPE dan LLDPE berkualitas tinggi untuk jaringan ritel modern, pasar grosir tradisional, dan sektor industri nasional.' %>
          </p>
          <p>
            <%= currentLang === 'en'
                ? 'With high-capacity production facilities in Cigondewah and corporate offices in Palmerah Jakarta, we integrate advanced blown film extrusion lines, certified 100% degradable formulations under SNI standards, and strict quality control for partners across Indonesia.'
                : 'Dengan fasilitas produksi berkapasitas tinggi di Cigondewah dan kantor manajemen di Palmerah Jakarta, kami menggabungkan teknologi ekstrusi film mutakhir, formula ramah lingkungan 100% degradable berstandar SNI, serta ketelitian presisi demi kepuasan mitra usaha di seluruh Indonesia.' %>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SECTION PRODUK UNGGULAN (Symmetrical Bento Grid) -->
  <section class="sec-products" id="produk">
    <div class="container">
      <div class="prod-header reveal">
        <div>
          <h2 class="prod-title"><%= currentLang === 'en' ? 'Featured Manufacturing Products' : 'Produk Unggulan Manufaktur' %></h2>
          <p class="prod-subtitle">
            <%= currentLang === 'en' 
                ? 'High-grade HDPE, LLDPE, and woven PP plastic bags manufactured to exact customer specifications.'
                : 'Kantong plastik HDPE dan LLDPE berkualitas tinggi untuk berbagai kebutuhan retail, industri, dan pasar komersial.' %>
          </p>
        </div>
        <a href="/products" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
          <span><%= currentLang === 'en' ? 'View All Catalog' : 'Lihat Seluruh Katalog' %></span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="bento-grid">
        <% if (featuredProducts && featuredProducts.length > 0) { %>
          <% featuredProducts.slice(0, 4).forEach((product, idx) => { 
            const prodName = currentLang === 'en' ? (product.name_en || product.name_id) : product.name_id;
            const prodDesc = currentLang === 'en' ? (product.description_en || product.description_id) : product.description_id;
            const prodImg = product.image_url || `/images/products/prod-${(idx % 4) + 1}.webp`;
            const badgeClass = idx === 0 ? 'bento-badge-blue' : (idx === 1 ? 'bento-badge-navy' : (idx === 2 ? 'bento-badge-green' : 'bento-badge-blue'));
            const cardThemeClass = idx === 0 ? 'bento-card-featured' : (idx === 1 ? 'bento-card-tech' : (idx === 2 ? 'bento-card-eco' : 'bento-card-pb'));
            const overlayText = idx === 2 ? '100% ECO' : (idx === 1 ? 'HEAVY DUTY' : 'RETAIL READY');
          %>
            <article class="bento-col-6 reveal">
              <a href="/products/<%= product.slug || product.id %>" class="bento-card <%= cardThemeClass %>" aria-label="Lihat detail <%= prodName %>">
                <div class="bento-split">
                  <div class="bento-split-content">
                    <div>
                      <div class="bento-badge <%= badgeClass %>">
                        <% if (idx === 2) { %><span class="dot-green"></span><% } %>
                        <%= product.category_name_id || (idx === 2 ? 'OXIUM DEGRADABLE' : 'RETAIL MODERN') %>
                      </div>
                      <h3 class="bento-card-title"><%= prodName %></h3>
                      <p class="bento-card-desc">
                        <%= prodDesc ? (prodDesc.length > 120 ? prodDesc.substring(0, 120) + '...' : prodDesc) : 'Diproduksi dengan bahan baku murni virgin grade dan ketahanan beban optimal.' %>
                      </p>
                      
                      <div class="bento-specs">
                        <span class="bento-spec-tag">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                          Virgin HDPE / LLDPE
                        </span>
                        <span class="bento-spec-tag">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                          Drop-Test Teruji
                        </span>
                        <span class="bento-spec-tag">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                          Custom Printing
                        </span>
                      </div>
                    </div>

                    <div class="bento-card-footer">
                      <span class="bento-card-link">
                        <%= currentLang === 'en' ? 'Product Specifications' : 'Lihat Detail Produk' %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </span>
                      <span class="bento-meta-badge <%= idx === 2 ? 'eco' : '' %>">
                        <%= idx === 2 ? 'SNI 7188.7:2011' : 'B2B Custom' %>
                      </span>
                    </div>
                  </div>

                  <div class="bento-split-media">
                    <img src="<%= prodImg %>" alt="<%= prodName %>" loading="lazy">
                    <span class="media-overlay-pill <%= idx === 2 ? 'eco' : '' %>"><%= overlayText %></span>
                  </div>
                </div>
              </a>
            </article>
          <% }); %>
        <% } %>
      </div>

      <div class="prod-more-wrap reveal">
        <a href="/products" class="btn-see-more">
          <span><%= currentLang === 'en' ? 'Explore Complete Product Catalog' : 'Jelajahi Seluruh Katalog Produk' %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. SECTION 3 PILAR KEUNGGULAN -->
  <section class="sec-pillars" id="pilar">
    <div class="container">
      <div class="pillars-header reveal">
        <h2><%= currentLang === 'en' ? 'Three Pillars of Manufacturing Excellence' : 'Tiga Pilar Keunggulan Kami' %></h2>
        <p>
          <%= currentLang === 'en' 
              ? 'Our unwavering commitment to precision, production capacity, and environmental sustainability.'
              : 'Komitmen menyeluruh dalam menghadirkan standar mutu plastik terdepan bagi mitra B2B.' %>
        </p>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card reveal">
          <div class="pillar-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="pillar-title">
            <%= currentLang === 'en' ? 'High-Volume Production Capacity' : 'Teknologi & Kapasitas Produksi' %>
          </h3>
          <p class="pillar-desc">
            <%= currentLang === 'en'
                ? 'Equipped with multi-layer blown film extruders, automated precision bag-making lines, and multi-color flexographic printing machines.'
                : 'Didukung deretan mesin ekstrusi multi-layer modern dan converting line berkecepatan tinggi di Cigondewah untuk menjamin ketepatan jadwal pasokan skala besar.' %>
          </p>
        </div>

        <div class="pillar-card reveal">
          <div class="pillar-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="pillar-title">
            <%= currentLang === 'en' ? 'Consistent Quality & Precision' : 'Standar Mutu & Presisi Konsisten' %>
          </h3>
          <p class="pillar-desc">
            <%= currentLang === 'en'
                ? 'Rigorous quality control protocols verifying tensile elongation, drop-impact resistance, seal integrity, and micron uniformity.'
                : 'Penerapan kontrol kualitas berkala meliputi uji ketahanan jatuh (drop-test), segel anti-bocor star-seal, dan ketebalan mikron yang konsisten di setiap batch.' %>
          </p>
        </div>

        <div class="pillar-card reveal">
          <div class="pillar-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
            </svg>
          </div>
          <h3 class="pillar-title">
            <%= currentLang === 'en' ? 'Sustainable OXIUM® Degradable' : 'Solusi Ramah Lingkungan OXIUM' %>
          </h3>
          <p class="pillar-desc">
            <%= currentLang === 'en'
                ? 'Certified 100% degradable technology tested under US ASTM D6954 standards and Indonesian Green Label SNI 7188.7:2011.'
                : 'Pionir penerapan aditif OXIUM teruji 100% terdegradasi menjadi biomassa dan air tanpa menyisakan mikroplastik berbahaya, berstandar resmi SNI.' %>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. SECTION SERTIFIKASI & BUKTI MUTU -->
  <section class="sec-evidence" id="sertifikasi">
    <div class="container">
      <div class="ev-layout">
        <div class="reveal">
          <h2><%= currentLang === 'en' ? 'Verified Quality & Eco-Certifications' : 'Sertifikasi Mutu & Komitmen Lingkungan' %></h2>
          <p class="ev-body">
            <%= currentLang === 'en'
                ? 'Our manufacturing processes strictly comply with national standards and certified laboratory testing, ensuring packaging safety, durability, and full regulatory compliance.'
                : 'Standar produksi kami didukung sertifikasi resmi nasional dan pengujian laboratorium terakreditasi, memastikan setiap produk aman digunakan, kuat, dan memenuhi regulasi ramah lingkungan.' %>
          </p>
          <a href="/about#sertifikasi" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
            <span><%= currentLang === 'en' ? 'Learn More About Certifications' : 'Pelajari Detail Sertifikasi' %></span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="cert-grid reveal">
          <div class="cert-item">
            <span class="cert-chk">&#10003;</span>
            <div>
              <div class="cert-name">SNI 7188.7:2011</div>
              <div class="cert-desc"><%= currentLang === 'en' ? 'Indonesian National Standard for degradable shopping bags' : 'Standar Nasional Indonesia untuk kantong belanja mudah terurai' %></div>
            </div>
          </div>

          <div class="cert-item">
            <span class="cert-chk">&#10003;</span>
            <div>
              <div class="cert-name">OXIUM&reg; Technology</div>
              <div class="cert-desc"><%= currentLang === 'en' ? 'US ASTM D6954 certified oxo-biodegradable formulation' : 'Formula degradasi alami berstandar internasional ASTM D6954' %></div>
            </div>
          </div>

          <div class="cert-item">
            <span class="cert-chk">&#10003;</span>
            <div>
              <div class="cert-name">InSWA Eco Label</div>
              <div class="cert-desc"><%= currentLang === 'en' ? 'Endorsed by Indonesia Solid Waste Association' : 'Sertifikasi Resmi Asosiasi Pengelolaan Sampah Indonesia' %></div>
            </div>
          </div>

          <div class="cert-item">
            <span class="cert-chk">&#10003;</span>
            <div>
              <div class="cert-name">Virgin Food-Grade Contact</div>
              <div class="cert-desc"><%= currentLang === 'en' ? 'Pure non-recycled polymers safe for food contact' : 'Bahan baku murni higienis aman untuk produk pangan dan retail' %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. SECTION OUR BRANDS (Horizontal Marquee Slider) -->
  <section class="sec-brands" id="merek">
    <div class="container">
      <div class="brands-header reveal">
        <span class="brands-kicker"><%= currentLang === 'en' ? 'Registered Trademarks' : 'Merek Paten & Terdaftar' %></span>
        <h2 class="brands-title"><%= currentLang === 'en' ? 'Official Brand Portfolio of PT. EUODOO' : 'Portofolio Merek Resmi PT. EUODOO' %></h2>
        <p class="brands-desc">
          <%= currentLang === 'en'
              ? 'For more than three decades, our registered trademark brands have been the trusted choice for modern hypermarkets, wholesale traditional markets, and industrial supply chains across Indonesia.'
              : 'Selama lebih dari tiga dekade, kami memproduksi kantong plastik berkualitas di bawah merek-merek paten terdaftar yang menjadi pilihan utama jaringan ritel modern, pasar grosir tradisional, dan sektor industri nasional.' %>
        </p>
      </div>
    </div>

    <div class="marquee-wrapper reveal" aria-label="Slider Merek Resmi PT Euodoo">
      <div class="marquee-track">
        <!-- Group 1 -->
        <div class="marquee-group">
          <% if (brands && brands.length > 0) { %>
            <% brands.forEach(brand => { %>
              <div class="brand-card">
                <div class="brand-badge-icon brand-badge-<%= brand.name.toLowerCase().includes('berkah') ? 'berkah' : (brand.name.toLowerCase().includes('eco') ? 'oxium' : 'pb') %>">
                  <%= brand.name.substring(0, 2).toUpperCase() %>
                </div>
                <div class="brand-info">
                  <div class="brand-card-header">
                    <span class="brand-name-lg"><%= brand.name.toUpperCase() %></span>
                    <span class="brand-reg-tag <%= brand.name.toLowerCase().includes('eco') ? 'brand-tag-eco' : '' %>">
                      <%= brand.name.toLowerCase().includes('eco') ? 'PATEN DEGRADABLE' : 'DAFTAR RESMI' %>
                    </span>
                  </div>
                  <p class="brand-role"><%= currentLang === 'en' ? (brand.description_en || 'Registered Brand Portfolio') : (brand.description_id || 'Merek Terdaftar PT Euodoo') %></p>
                  <span class="brand-detail">Standar mutu presisi manufaktur sejak 1990</span>
                </div>
              </div>
            <% }); %>
          <% } %>
          <!-- Additional anchor brands from prototype -->
          <div class="brand-card">
            <div class="brand-badge-icon brand-badge-pb">PB</div>
            <div class="brand-info">
              <div class="brand-card-header">
                <span class="brand-name-lg">MEREK PB</span>
                <span class="brand-reg-tag">DAFTAR RESMI</span>
              </div>
              <p class="brand-role">Kantong Sampah &amp; Heavy Duty</p>
              <span class="brand-detail">Segel bintang star-seal anti-bocor dipercaya sejak 1990</span>
            </div>
          </div>
          <div class="brand-card">
            <div class="brand-badge-icon brand-badge-berkah">BK</div>
            <div class="brand-info">
              <div class="brand-card-header">
                <span class="brand-name-lg">MEREK BERKAH</span>
                <span class="brand-reg-tag">MEREK TERDAFTAR</span>
              </div>
              <p class="brand-role">Kantong Kresek Bening Higienis</p>
              <span class="brand-detail">HDPE murni tanpa bau untuk pasar grosir &amp; toko roti</span>
            </div>
          </div>
          <div class="brand-card">
            <div class="brand-badge-icon brand-badge-oxium">OX</div>
            <div class="brand-info">
              <div class="brand-card-header">
                <span class="brand-name-lg">OXIUM&reg;</span>
                <span class="brand-reg-tag brand-tag-eco">PATEN DEGRADABLE</span>
              </div>
              <p class="brand-role">100% Eco-Degradable Technology</p>
              <span class="brand-detail">Bersertifikasi SNI 7188.7:2011 &amp; InSWA Green Label</span>
            </div>
          </div>
        </div>

        <!-- Group 2 (Duplicate for seamless CSS Marquee Loop) -->
        <div class="marquee-group" aria-hidden="true">
          <% if (brands && brands.length > 0) { %>
            <% brands.forEach(brand => { %>
              <div class="brand-card">
                <div class="brand-badge-icon brand-badge-<%= brand.name.toLowerCase().includes('berkah') ? 'berkah' : (brand.name.toLowerCase().includes('eco') ? 'oxium' : 'pb') %>">
                  <%= brand.name.substring(0, 2).toUpperCase() %>
                </div>
                <div class="brand-info">
                  <div class="brand-card-header">
                    <span class="brand-name-lg"><%= brand.name.toUpperCase() %></span>
                    <span class="brand-reg-tag <%= brand.name.toLowerCase().includes('eco') ? 'brand-tag-eco' : '' %>">
                      <%= brand.name.toLowerCase().includes('eco') ? 'PATEN DEGRADABLE' : 'DAFTAR RESMI' %>
                    </span>
                  </div>
                  <p class="brand-role"><%= currentLang === 'en' ? (brand.description_en || 'Registered Brand Portfolio') : (brand.description_id || 'Merek Terdaftar PT Euodoo') %></p>
                  <span class="brand-detail">Standar mutu presisi manufaktur sejak 1990</span>
                </div>
              </div>
            <% }); %>
          <% } %>
          <div class="brand-card">
            <div class="brand-badge-icon brand-badge-pb">PB</div>
            <div class="brand-info">
              <div class="brand-card-header">
                <span class="brand-name-lg">MEREK PB</span>
                <span class="brand-reg-tag">DAFTAR RESMI</span>
              </div>
              <p class="brand-role">Kantong Sampah &amp; Heavy Duty</p>
              <span class="brand-detail">Segel bintang star-seal anti-bocor dipercaya sejak 1990</span>
            </div>
          </div>
          <div class="brand-card">
            <div class="brand-badge-icon brand-badge-berkah">BK</div>
            <div class="brand-info">
              <div class="brand-card-header">
                <span class="brand-name-lg">MEREK BERKAH</span>
                <span class="brand-reg-tag">MEREK TERDAFTAR</span>
              </div>
              <p class="brand-role">Kantong Kresek Bening Higienis</p>
              <span class="brand-detail">HDPE murni tanpa bau untuk pasar grosir &amp; toko roti</span>
            </div>
          </div>
          <div class="brand-card">
            <div class="brand-badge-icon brand-badge-oxium">OX</div>
            <div class="brand-info">
              <div class="brand-card-header">
                <span class="brand-name-lg">OXIUM&reg;</span>
                <span class="brand-reg-tag brand-tag-eco">PATEN DEGRADABLE</span>
              </div>
              <p class="brand-role">100% Eco-Degradable Technology</p>
              <span class="brand-detail">Bersertifikasi SNI 7188.7:2011 &amp; InSWA Green Label</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. SECTION BERITA & ARTIKEL TERBARU -->
  <section class="sec-news" id="berita">
    <div class="container">
      <div class="news-header reveal">
        <div>
          <h2><%= currentLang === 'en' ? 'Industry Insights & Company Updates' : 'Wawasan & Berita Industri' %></h2>
          <p style="color: var(--text-variant); margin-top: 6px;">
            <%= currentLang === 'en' ? 'Latest publications on plastic film technology and sustainable packaging.' : 'Publikasi terkini seputar inovasi manufaktur plastik ramah lingkungan dan regulasi industri.' %>
          </p>
        </div>
        <a href="/news" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
          <span><%= currentLang === 'en' ? 'View All News' : 'Lihat Semua Berita' %></span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="news-grid">
        <% if (latestPosts && latestPosts.length > 0) { %>
          <% latestPosts.forEach((post, i) => { 
            const postTitle = currentLang === 'en' ? (post.title_en || post.title_id) : post.title_id;
            const postImg = post.display_image || post.cover_image || `/images/news/news-${i + 1}.webp`;
            const dateStr = post.published_at ? new Date(post.published_at).toLocaleDateString(currentLang === 'en' ? 'en-US' : 'id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : '2026';
          %>
            <article class="news-card reveal">
              <a href="/news/<%= post.slug || post.id %>" style="color: inherit; text-decoration: none; display: flex; flex-direction: column; height: 100%; justify-content: flex-end;">
                <div class="bg">
                  <img src="<%= postImg %>" alt="<%= postTitle %>" loading="lazy">
                </div>
                <div class="ov"></div>
                <div class="ct">
                  <div class="news-date"><%= dateStr %> &bull; <%= post.category_name_id || (post.type === 'pers' ? 'Siaran Pers' : 'Berita') %></div>
                  <h3 class="news-title"><%= postTitle %></h3>
                </div>
              </a>
            </article>
          <% }); %>

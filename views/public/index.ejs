<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main id="main-content">
  <% 
    const activeBanners = (typeof banners !== 'undefined' && Array.isArray(banners) && banners.length > 0)
      ? banners.filter(b => b.is_active === 1 || b.is_active === true)
      : [];
    
    // Fallback banner jika database kosong
    const displayBanners = activeBanners.length > 0 ? activeBanners : [{
      title_id: 'Solusi Manufaktur Kantong Plastik HDPE & LLDPE Ramah Lingkungan',
      title_en: 'Leading Eco-Friendly HDPE & LLDPE Plastic Bag Manufacturer',
      caption_id: 'Melayani jaringan ritel modern, mitra industri, dan pasar grosir nasional dengan formulasi 100% degradable berstandar SNI sejak 1990.',
      caption_en: 'Serving national modern retail networks, industrial partners, and wholesale markets with certified 100% oxo-biodegradable formulation since 1990.',
      cta_text_id: 'Minta Penawaran',
      cta_text_en: 'Request a Quote',
      cta_url: '/contact',
      file_url: '/images/hero-factory.jpg',
      media_type: 'image'
    }];
  %>
  <section class="hero hero-slider" id="heroSlider" aria-roledescription="carousel" aria-label="Hero Banners" tabindex="0">
    <div class="hero-slides-wrapper" id="heroSlidesTrack">
      <% displayBanners.forEach((banner, index) => { 
        const bannerTitle = currentLang === 'en' ? (banner.title_en || banner.title_id) : banner.title_id;
        const bannerCaption = currentLang === 'en' ? (banner.caption_en || banner.caption_id) : banner.caption_id;
        const bannerCtaText = banner && (banner.cta_text_id || banner.cta_text_en)
          ? (currentLang === 'en' ? (banner.cta_text_en || banner.cta_text_id) : banner.cta_text_id)
          : (currentLang === 'en' ? 'Request a Quote' : 'Minta Penawaran');
        const bannerCtaUrl = banner.cta_url || banner.link_url || '/contact';
        const bannerMediaUrl = banner.file_url || banner.image_url || '/images/hero-factory.jpg';
        const isVideo = banner.media_type === 'video';
      %>
      <div class="hero-slide <%= index === 0 ? 'is-active' : '' %> <%= isVideo ? 'hero-slide-video' : (banner.media_type === 'youtube' ? 'hero-slide-youtube' : 'hero-slide-image') %>" data-slide-index="<%= index %>" role="group" aria-roledescription="slide" aria-label="Slide <%= index + 1 %> dari <%= displayBanners.length %>">
        <div class="hero-bg">
          <% if (banner.media_type === 'youtube') { 
            let ytId = banner.file_url || '';
            if (ytId.includes('embed/')) {
              ytId = ytId.split('embed/')[1].split('?')[0];
            } else if (ytId.includes('watch?v=') || ytId.includes('youtu.be/')) {
              const m = ytId.match(/(?:v=|youtu\.be\/)([^"&?\/\s]{11})/);
              if (m) ytId = m[1];
            }
          %>
            <div class="hero-youtube-wrapper">
              <iframe
                class="hero-youtube-iframe"
                src="https://www.youtube.com/embed/<%= ytId %>?autoplay=<%= index === 0 ? '1' : '0' %>&mute=1&controls=0&playsinline=1&rel=0&showinfo=0&modestbranding=1&disablekb=1&fs=0&iv_load_policy=3&enablejsapi=1"
                title="<%= bannerTitle %>"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                tabindex="-1"
                aria-hidden="true"
              ></iframe>
            </div>
            <% if (banner.poster_url) { %>
              <img src="<%= banner.poster_url %>" alt="<%= bannerTitle %>" class="hero-youtube-poster" aria-hidden="true">
            <% } %>
            <div class="hero-video-shield" aria-hidden="true"></div>
          <% } else if (isVideo) { %>
            <video <%= index === 0 ? 'autoplay' : '' %> muted loop playsinline preload="metadata" poster="<%= banner.poster_url || '/images/hero-factory.jpg' %>">
              <source src="<%= bannerMediaUrl %>" type="video/mp4">
            </video>
          <% } else { %>
            <img src="<%= bannerMediaUrl %>" alt="<%= bannerTitle %>" <%= index === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %>>
          <% } %>
          <div class="hero-grad"></div>
        </div>

        <div class="hero-content">
          <div class="hero-inner">
            <div class="hero-welcome">
              <%= currentLang === 'en' ? 'WELCOME TO PT. EUODOO' : 'SELAMAT DATANG DI PT. EUODOO' %>
            </div>
            <h1><%= bannerTitle %></h1>
            <% if (bannerCaption) { %>
              <p class="hero-body"><%= bannerCaption %></p>
            <% } %>
            <div class="hero-actions">
              <a href="<%= bannerCtaUrl %>" class="btn-pill-solid-white">
                <%= bannerCtaText %>
              </a>
              <a href="/about" class="btn-pill-white">
                <%= currentLang === 'en' ? 'Learn More' : 'Lihat Detail' %>
              </a>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <% if (displayBanners.length > 1) { %>

      <button type="button" class="hero-slider-nav hero-slider-prev" id="heroPrevBtn" aria-label="Slide Sebelumnya">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button type="button" class="hero-slider-nav hero-slider-next" id="heroNextBtn" aria-label="Slide Berikutnya">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>


      <div class="hero-slider-controls">
        <div class="hero-slider-dots" id="heroDots" role="tablist" aria-label="Pilih Slide">
          <% displayBanners.forEach((_, idx) => { %>
            <button type="button" class="hero-dot <%= idx === 0 ? 'is-active' : '' %>" data-slide-target="<%= idx %>" role="tab" aria-selected="<%= idx === 0 ? 'true' : 'false' %>" aria-label="Pergi ke slide <%= idx + 1 %>"></button>
          <% }) %>
        </div>
        <div class="hero-slide-counter" id="heroCounter" aria-live="polite">
          <span class="hero-counter-current" id="heroCurrentNum">01</span>
          <span class="hero-counter-sep">/</span>
          <span class="hero-counter-total"><%= String(displayBanners.length).padStart(2, '0') %></span>
        </div>
      </div>
    <% } %>

    <div class="hero-explore-indicator" aria-hidden="true">
      <span class="hero-explore-text">EXPLORE MORE</span>
      <span class="hero-explore-line"></span>
    </div>
  </section>


  <% if (typeof homeContent !== 'undefined' && homeContent?.intro && (homeContent.intro.is_active === 1 || homeContent.intro.is_active === '1' || homeContent.intro.is_active === true)) { 
    const intro = homeContent.intro;
    const introTitle = currentLang === 'en' ? (intro.title_en || intro.title_id) : intro.title_id;
    const introP1 = currentLang === 'en' ? (intro.paragraph_1_en || intro.paragraph_1_id) : intro.paragraph_1_id;
    const introP2 = currentLang === 'en' ? (intro.paragraph_2_en || intro.paragraph_2_id) : intro.paragraph_2_id;
    const introEyebrow = currentLang === 'en' ? (intro.eyebrow_en || intro.eyebrow_id) : intro.eyebrow_id;
  %>
  <section class="sec-intro" id="intro">
    <div class="container">
      <div class="intro-layout reveal <%= intro.image_url ? 'has-media' : '' %>">
        <div>
          <% if (introEyebrow) { %>
            <span class="intro-eyebrow" style="display:inline-block; font-size:12px; font-weight:700; letter-spacing:0.08em; color:var(--primary, #00755a); margin-bottom:8px; text-transform:uppercase;"><%= introEyebrow %></span>
          <% } %>
          <h2><%= introTitle %></h2>
          <% if (intro.image_url) { %>
            <div class="intro-media-wrap" style="margin-top:20px; border-radius:var(--r-xl, 1rem); overflow:hidden; border:1px solid var(--border, #e2e8f0); box-shadow:var(--shadow-sm, 0 1px 3px rgba(7,31,23,0.06));">
              <img src="<%= intro.image_url %>" alt="<%= introTitle %>" loading="lazy" style="width:100%; height:auto; display:block; object-fit:cover;">
            </div>
          <% } %>
        </div>
        <div>
          <p style="margin-bottom: 16px;"><%= introP1 %></p>
          <p><%= introP2 %></p>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <section class="sec-products" id="produk">
    <div class="container">
      <div class="prod-header reveal">
        <div>
          <% 
            const catSec = (typeof homeContent !== 'undefined' && homeContent?.categories) ? homeContent.categories : {};
            const catSecTitle = currentLang === 'en' 
              ? (catSec.title_en || 'Featured Manufacturing Products') 
              : (catSec.title_id || 'Produk Unggulan Manufaktur');
            const catSecSub = currentLang === 'en'
              ? (catSec.subtitle_en || 'High-grade HDPE, LLDPE, and woven PP plastic bags manufactured to exact customer specifications.')
              : (catSec.subtitle_id || 'Kantong plastik HDPE dan LLDPE berkualitas tinggi untuk berbagai kebutuhan retail, industri, dan pasar komersial.');
          %>
          <h2 class="prod-title"><%= catSecTitle %></h2>
          <p class="prod-subtitle"><%= catSecSub %></p>
        </div>
        <a href="/products" class="btn btn-primary">
          <span><%= currentLang === 'en' ? 'View All Catalog' : 'Lihat Seluruh Katalog' %></span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <% 
        const catsToDisplay = (typeof homepageCategories !== 'undefined' && homepageCategories && homepageCategories.length > 0) 
          ? homepageCategories 
          : []; 
      %>
      <div class="hcat-grid reveal" style="--hcat-cols: <%= catsToDisplay.length || 4 %>;">
        <% if (catsToDisplay.length > 0) { %>
          <% catsToDisplay.forEach((cat, idx) => { 
            const catName = currentLang === 'en' ? (cat.name_en || cat.name_id) : cat.name_id;
            const catCount = typeof cat.published_product_count !== 'undefined' ? parseInt(cat.published_product_count, 10) : 0;
            const segmentKeys = ['retail', 'industrial', 'traditional', 'sustainability'];
            const catImg = cat.image_url || `/images/segment-${segmentKeys[idx % 4]}.jpg`;
            const countLabel = currentLang === 'en' ? `${catCount} ${catCount === 1 ? 'Product' : 'Products'}` : `${catCount} Produk`;
          %>
            <a href="/products?category=<%= cat.slug %>" class="hcat-panel" aria-label="<%= catName %> (<%= countLabel %>)">
              <img class="hcat-img" src="<%= catImg %>" alt="<%= catName %>" loading="lazy" width="600" height="800">
              <div class="hcat-scrim" aria-hidden="true"></div>
              <div class="hcat-content">
                <h3 class="hcat-title"><%= catName %></h3>
                <div class="hcat-count">
                  <span><%= countLabel %></span>
                  <svg class="hcat-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </div>
            </a>
          <% }); %>
        <% } %>
      </div>

      <div class="prod-more-wrap reveal">
        <a href="/products" class="btn-see-more">
          <span><%= currentLang === 'en' ? 'Explore Complete Product Catalog' : 'Jelajahi Seluruh Katalog Produk' %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <% 
    const wcuData = homeContent?.why_choose_us;
    const isWcuActive = wcuData ? (wcuData.is_active === 1 || wcuData.is_active === '1' || wcuData.is_active === true) : true;
    if (typeof homeContent !== 'undefined' && isWcuActive) { 
      const wcu = wcuData || {};
      const isEn = currentLang === 'en';
      const wcuEyebrow = isEn ? (wcu.eyebrow_en || wcu.eyebrow_id || 'Innovation for the future') : (wcu.eyebrow_id || 'Inovasi untuk masa depan');
      const wcuTitle = isEn ? (wcu.title_en || wcu.title_id || 'Why choose us[accent]?[/accent]') : (wcu.title_id || 'Why choose us[accent]?[/accent]');
      const wcuChipLabel = isEn ? (wcu.chip_label_en || wcu.chip_label_id || 'Eco-friendly solutions') : (wcu.chip_label_id || 'Solusi ramah lingkungan');
      const wcuChipIcon = wcu.chip_icon || 'asterisk';
      const wcuHeadline = isEn ? (wcu.headline_en || wcu.headline_id || 'Material innovation, with [mark]better impact.[/mark]') : (wcu.headline_id || 'Inovasi material, dengan [mark]dampak yang lebih baik.[/mark]');
      const wcuDesc = isEn ? (wcu.desc_en || wcu.desc_id || 'As a [strong]pioneer in eco-friendly additives[/strong], we deliver solutions designed to help reduce plastic waste impact.') : (wcu.desc_id || 'Sebagai [strong]pionir penerapan aditif ramah lingkungan[/strong], kami menghadirkan solusi yang dirancang untuk membantu mengurangi dampak sampah plastik. Didukung formula aditif degradable yang telah teruji serta mengacu pada standar resmi [strong]SNI[/strong] untuk kemasan ramah lingkungan.');
      const wcuCalloutLead = isEn ? (wcu.callout_lead_en || wcu.callout_lead_id || 'Designed with care.') : (wcu.callout_lead_id || 'Dirancang dengan kepedulian.');
      const wcuCalloutBody = isEn ? (wcu.callout_body_en || wcu.callout_body_id || 'We prioritize eco-friendly additive innovations as part of our commitment to reducing environmental impact.') : (wcu.callout_body_id || 'Kami mengedepankan inovasi aditif ramah lingkungan sebagai bagian dari pendekatan untuk membantu mengurangi dampak lingkungan.');
      const wcuNote = isEn ? (wcu.note_en || wcu.note_id || 'Our commitment: innovation grounded in rigorous testing and environmental responsibility.') : (wcu.note_id || 'Komitmen kami: inovasi yang berpijak pada pengujian dan tanggung jawab lingkungan.');
      const wcuArtLabel = isEn ? (wcu.art_label_en || wcu.art_label_id || 'Material · Nature · Future') : (wcu.art_label_id || 'Material · Alam · Masa depan');
      const wcuFloatEyebrow = isEn ? (wcu.float_eyebrow_en || wcu.float_eyebrow_id || 'Future-oriented') : (wcu.float_eyebrow_id || 'Berorientasi masa depan');
      const wcuFloatTitle = isEn ? (wcu.float_title_en || wcu.float_title_id || 'Better by design.') : (wcu.float_title_id || 'Better by design.');
      const wcuFloatDesc = isEn ? (wcu.float_desc_en || wcu.float_desc_id || 'Material innovation for a more responsible path.') : (wcu.float_desc_id || 'Inovasi material untuk langkah yang lebih bertanggung jawab.');
      const fmt = typeof formatInlineText === 'function' ? formatInlineText : (t) => t;
  %>
  <section class="sec-why-us sec-pillars" id="why-us">
    <span id="pilar" class="sec-pillars" aria-hidden="true"></span>
    <div class="container">
      <div class="wcu-card reveal">
        <div class="wcu-header">
          <div class="wcu-eyebrow"><%= wcuEyebrow %></div>
          <h2 class="wcu-title"><%- fmt(wcuTitle) %></h2>
        </div>

        <div class="wcu-layout">
          <!-- Kolom Kiri: Narasi Editorial B2B -->
          <div class="wcu-copy">
            <div class="wcu-kicker" tabindex="0" role="status" aria-label="<%= wcuChipLabel %>">
              <span class="wcu-kicker-icon" aria-hidden="true">
                <% if (wcuChipIcon === 'leaf') { %>
                  <svg class="wcu-kicker-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                <% } else if (wcuChipIcon === 'sparkle') { %>
                  <svg class="wcu-kicker-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                <% } else { %>
                  <!-- Icon Pohon Botani Ramah Lingkungan -->
                  <svg class="wcu-kicker-svg wcu-tree-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 19h8a4 4 0 0 0 3.8-2.8 4 4 0 0 0-1.6-4.5A4 4 0 0 0 16 4a4 4 0 0 0-8 0 4 4 0 0 0-2.2 7.7 4 4 0 0 0-1.6 4.5A4 4 0 0 0 8 19Z" fill="currentColor" fill-opacity="0.18"/>
                    <path d="M12 19v3"/>
                    <path d="M12 14v-4" stroke-width="1.4"/>
                    <path d="m12 12 2.4-1.8" stroke-width="1.4"/>
                    <path d="m12 13.5-2.4-1.8" stroke-width="1.4"/>
                  </svg>
                <% } %>
              </span>
              <span class="wcu-kicker-text"><%= wcuChipLabel %></span>
            </div>

            <h3 class="wcu-headline"><%- fmt(wcuHeadline) %></h3>

            <p class="wcu-desc"><%- fmt(wcuDesc) %></p>
          </div>

          <!-- Kolom Kanan: Visual Artbox & Floating Badge -->
          <div class="wcu-artbox" aria-label="<%= isEn ? 'Conceptual illustration of sustainable packaging material' : 'Ilustrasi konseptual material ramah lingkungan' %>">
            <div class="wcu-art-label"><%= wcuArtLabel %></div>
            <svg class="wcu-art" viewBox="0 0 500 420" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <defs>
                <linearGradient id="wcu-grad-a" x1="110" y1="90" x2="340" y2="330" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#7CBE38"/>
                  <stop offset="1" stop-color="#00755A"/>
                </linearGradient>
                <linearGradient id="wcu-grad-b" x1="380" y1="70" x2="200" y2="320" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#00906E"/>
                  <stop offset="1" stop-color="#00573F"/>
                </linearGradient>
              </defs>
              <circle cx="250" cy="205" r="135" fill="#ffffff55" stroke="#fff" stroke-opacity=".8" stroke-width="2"/>
              <circle cx="250" cy="205" r="112" stroke="#fff" stroke-opacity=".7" stroke-dasharray="3 9" stroke-width="2"/>
              <path d="M247 318C241 259 244 204 253 132" stroke="#176c4b" stroke-width="7" stroke-linecap="round"/>
              <path d="M246 263C194 266 145 234 132 183C185 177 231 205 246 263Z" fill="url(#wcu-grad-a)"/>
              <path d="m246 263-96-71" stroke="#d8efb5" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M252 211C259 151 307 109 364 117C360 171 315 208 252 211Z" fill="url(#wcu-grad-b)"/>
              <path d="m252 211 94-76" stroke="#b9e5c8" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M247 318C202 305 181 275 184 240C222 249 245 280 247 318Z" fill="#7CBE38"/>
              <path d="m247 318-49-62" stroke="#e2f2bf" stroke-width="2" stroke-linecap="round"/>
              <path d="M253 132C238 105 246 75 273 60C294 89 282 115 253 132Z" fill="#00906E"/>
              <path d="m253 132 15-57" stroke="#d2f0dc" stroke-width="2"/>
              <circle cx="139" cy="121" r="19" fill="#fff" fill-opacity=".8"/>
              <path d="M130 121h18m-9-9v18" stroke="#00755A" stroke-width="2" stroke-linecap="round"/>
              <circle cx="385" cy="254" r="24" fill="#fff" fill-opacity=".85"/>
              <path d="M385 240c-8 9-11 16 0 27 11-11 8-18 0-27Z" fill="#00906E"/>
              <path d="M376 258c6-1 10-5 12-11" stroke="#7CBE38" stroke-width="2" stroke-linecap="round"/>
              <circle cx="358" cy="80" r="5" fill="#7CBE38"/>
              <circle cx="126" cy="287" r="7" fill="#00906E" opacity=".65"/>
              <circle cx="350" cy="325" r="4" fill="#7CBE38"/>
            </svg>
            <div class="wcu-float-card">
              <small class="wcu-float-eyebrow">
                <span class="wcu-float-dot" aria-hidden="true"></span>
                <%= wcuFloatEyebrow %>
              </small>
              <strong class="wcu-float-title"><%= wcuFloatTitle %></strong>
              <span class="wcu-float-desc"><%= wcuFloatDesc %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <% if (typeof homeContent !== 'undefined' && homeContent?.certifications && (homeContent.certifications.is_active === 1 || homeContent.certifications.is_active === '1' || homeContent.certifications.is_active === true)) { 
    const cert = homeContent.certifications;
    const certTitle = currentLang === 'en' ? (cert.title_en || cert.title_id) : cert.title_id;
    const certBody = currentLang === 'en' ? (cert.body_en || cert.body_id) : cert.body_id;
    const certBtnText = currentLang === 'en' ? (cert.btn_text_en || cert.btn_text_id) : cert.btn_text_id;
    const certItems = (cert.items || []).filter(i => i.is_active === 1 || i.is_active === '1' || i.is_active === true).sort((a,b) => (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0));
  %>
  <section class="sec-evidence" id="sertifikasi">
    <div class="container">
      <div class="ev-layout">
        <div class="reveal">
          <h2><%= certTitle %></h2>
          <p class="ev-body"><%= certBody %></p>
          <% if ((cert.show_btn === 1 || cert.show_btn === '1' || cert.show_btn === true) && certBtnText) { %>
            <a href="<%= cert.btn_url || '/about#sertifikasi' %>" class="btn btn-primary">
              <span><%= certBtnText %></span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          <% } %>
        </div>

        <div class="cert-grid reveal">
          <% certItems.forEach(item => { 
            const itemDesc = currentLang === 'en' ? (item.desc_en || item.desc_id) : item.desc_id;
          %>
            <div class="cert-item">
              <% if (item.logo_url) { %>
                <img src="<%= item.logo_url %>" alt="<%= item.name %>" class="cert-logo-img" loading="lazy" style="max-height: 36px; max-width: 48px; object-fit: contain; margin-right: 12px; display: inline-block;">
              <% } else { %>
                <span class="cert-chk" aria-hidden="true">&#10003;</span>
              <% } %>
              <div>
                <div class="cert-name"><%= item.name %></div>
                <div class="cert-desc"><%= itemDesc %></div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <section class="sec-brands" id="merek">
    <div class="container">
      <div class="brands-header reveal">
        <span class="brands-kicker"><%= currentLang === 'en' ? 'Registered Trademarks' : 'Merek Paten & Terdaftar' %></span>
        <h2 class="brands-title"><%= currentLang === 'en' ? 'Official Brand Portfolio of PT. EUODOO' : 'Portofolio Merek Resmi PT. EUODOO' %></h2>
        <p class="brands-desc">
          <%= currentLang === 'en'
              ? 'For more than three decades, our registered trademark brands have been the trusted choice for modern hypermarkets, wholesale traditional markets, and industrial supply chains across Indonesia.'
              : 'Selama lebih dari tiga dekade, kami memproduksi kantong plastik berkualitas di bawah merek-merek paten terdaftar yang menjadi pilihan utama jaringan ritel modern, pasar grosir tradisional, dan sektor industri nasional.' %>
        </p>
      </div>
    </div>

    <div class="marquee-wrapper reveal" aria-label="Slider Merek Resmi PT Euodoo">
      <div class="marquee-track">
        <!-- Group 1 -->
        <div class="marquee-group">
          <% if (brands && brands.length > 0) { %>
            <% brands.forEach(brand => { %>
              <div class="brand-card js-brand-preview-trigger" role="button" tabindex="0"
                   aria-haspopup="dialog"
                   aria-label="<%= currentLang === 'en' ? `Preview brand ${brand.name}` : `Preview merek ${brand.name}` %>"
                   data-brand-name="<%= brand.name %>"
                   data-brand-logo="<%= brand.logo_url || '' %>"
                   data-brand-initials="<%= brand.name.substring(0, 2).toUpperCase() %>">
                <div class="brand-logo-wrap">
                  <% if (brand.logo_url) { %>
                    <img src="<%= brand.logo_url %>" alt="<%= brand.name %>" class="brand-logo-img" loading="lazy">
                  <% } else { %>
                    <span class="brand-fallback-initials"><%= brand.name.substring(0, 2).toUpperCase() %></span>
                  <% } %>
                  <span class="brand-zoom-hint" aria-hidden="true" title="<%= currentLang === 'en' ? 'Click to enlarge' : 'Klik untuk perbesar' %>">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      <line x1="11" y1="8" x2="11" y2="14"></line>
                      <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                  </span>
                </div>
                <div class="brand-meta-wrap">
                  <span class="brand-name-text"><%= brand.name %></span>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <!-- Group 2 (Duplikasi untuk efek seamless scroll tanpa kartu statis) -->
        <div class="marquee-group" aria-hidden="true">
          <% if (brands && brands.length > 0) { %>
            <% brands.forEach(brand => { %>
              <div class="brand-card js-brand-preview-trigger" role="button" tabindex="0"
                   aria-haspopup="dialog"
                   aria-label="<%= currentLang === 'en' ? `Preview brand ${brand.name}` : `Preview merek ${brand.name}` %>"
                   data-brand-name="<%= brand.name %>"
                   data-brand-logo="<%= brand.logo_url || '' %>"
                   data-brand-initials="<%= brand.name.substring(0, 2).toUpperCase() %>">
                <div class="brand-logo-wrap">
                  <% if (brand.logo_url) { %>
                    <img src="<%= brand.logo_url %>" alt="<%= brand.name %>" class="brand-logo-img" loading="lazy">
                  <% } else { %>
                    <span class="brand-fallback-initials"><%= brand.name.substring(0, 2).toUpperCase() %></span>
                  <% } %>
                  <span class="brand-zoom-hint" aria-hidden="true">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      <line x1="11" y1="8" x2="11" y2="14"></line>
                      <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                  </span>
                </div>
                <div class="brand-meta-wrap">
                  <span class="brand-name-text"><%= brand.name %></span>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Brand Zoom Preview Modal Lightbox -->
    <div id="brandPreviewModal" class="brand-preview-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="brandModalTitle">
      <div class="brand-modal-backdrop" id="brandModalBackdrop"></div>
      <div class="brand-modal-dialog">
        <div class="brand-modal-header">
          <div class="brand-modal-header-info">
            <span class="brand-reg-tag"><%= currentLang === 'en' ? 'OFFICIAL PORTFOLIO' : 'PORTOFOLIO RESMI' %></span>
            <h3 id="brandModalTitle" class="brand-modal-title">Nama Merek</h3>
          </div>
          <button type="button" class="brand-modal-close" id="brandModalCloseBtn" aria-label="<%= currentLang === 'en' ? 'Close preview' : 'Tutup preview' %>">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="brand-modal-body">
          <div class="brand-modal-img-wrap" id="brandModalImgWrap"></div>
        </div>
        <div class="brand-modal-footer">
          <span class="brand-modal-caption">PT Euodoo - <%= currentLang === 'en' ? 'Registered Brand Partner' : 'Portofolio Merek Terdaftar' %></span>
          <button type="button" class="btn btn-secondary btn-sm" id="brandModalCloseAction"><%= currentLang === 'en' ? 'Close' : 'Tutup' %></button>
        </div>
      </div>
    </div>
  </section>


  <section class="sec-news" id="berita">
    <div class="container">
      <div class="news-header reveal">
        <h2><%= currentLang === 'en' ? 'Latest News' : 'Informasi Terbaru' %></h2>
        <a href="/news" class="btn-secondary"><%= currentLang === 'en' ? 'View All News' : 'Lihat Semua Berita' %></a>
      </div>

      <div class="news-grid reveal">
        <% 
          const displayPosts = (typeof latestPosts !== 'undefined' && Array.isArray(latestPosts) && latestPosts.length > 0)
            ? latestPosts.slice(0, 2)
            : [];
          if (displayPosts.length > 0) {
            displayPosts.forEach((post, i) => { 
              const postTitle = currentLang === 'en' ? (post.title_en || post.title_id) : post.title_id;
              const fallbackImg = i === 0 ? '/images/post-eco-community.jpg' : '/images/post-school-recycling.jpg';
              const postImg = (post.display_image || post.cover_image) && !(post.display_image || post.cover_image).includes('hero-factory-precision')
                ? (post.display_image || post.cover_image)
                : fallbackImg;
              
              let dateStr = '2026';
              if (post.published_at) {
                const d = new Date(post.published_at);
                const day = String(d.getDate()).padStart(2, '0');
                const month = d.toLocaleDateString(currentLang === 'en' ? 'en-US' : 'id-ID', { month: 'short' }).toUpperCase();
                const year = d.getFullYear();
                dateStr = `${day} ${month} ${year}`;
              }
        %>
          <a href="/news/<%= post.slug || post.id %>" class="news-card">
            <div class="bg">
              <img src="<%= postImg %>" alt="<%= postTitle %>" loading="lazy" onerror="this.onerror=null; this.src='<%= fallbackImg %>';">
            </div>
            <div class="ov"></div>
            <div class="ct">
              <div class="news-date"><%= dateStr %></div>
              <div class="news-title"><%= postTitle %></div>
            </div>
          </a>
        <% 
            });
          } else { 
        %>
          <a href="/news" class="news-card">
            <div class="bg"><img src="/images/post-eco-community.jpg" alt="Berita lingkungan" loading="lazy"></div>
            <div class="ov"></div>
            <div class="ct">
              <div class="news-date">25 SEP 2026</div>
              <div class="news-title"><%= currentLang === 'en' ? '[Main news title from CMS will appear here]' : '[Judul berita utama dari CMS akan tampil di sini]' %></div>
            </div>
          </a>
          <a href="/news" class="news-card">
            <div class="bg"><img src="/images/post-school-recycling.jpg" alt="Berita daur ulang" loading="lazy"></div>
            <div class="ov"></div>
            <div class="ct">
              <div class="news-date">18 SEP 2026</div>
              <div class="news-title"><%= currentLang === 'en' ? '[Second news title from CMS]' : '[Judul berita kedua dari CMS]' %></div>
            </div>
          </a>
        <% } %>
      </div>
    </div>
  </section>

</main>

<%- include('../partials/footer') %>
